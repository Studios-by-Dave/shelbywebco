---
interface Props {
  quote: string;
  name: string;
  class?: string;
  /**
   * Optional real photo of the reviewer. When omitted we render an initials
   * monogram instead — never a stock face, which would misrepresent the person.
   */
  photo?: string;
}

const { quote, name, class: className = '', photo } = Astro.props;

const initials = name
  .replace(/[^A-Za-z ]/g, ' ')
  .split(/\s+/)
  .filter(Boolean)
  .map((part) => part[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();

const stars = [0, 1, 2, 3, 4];
---

<figure class={`max-w-2xl mx-auto ${className}`}>
  <div class="rounded-3xl bg-white p-6 md:p-8 border border-white/60 shadow-[0_24px_60px_-24px_rgba(0,0,0,0.65)]">
    <div class="mb-4 flex items-center justify-between gap-4">
      <div class="flex gap-1" role="img" aria-label="Rated 5 out of 5 stars">
        {stars.map(() => (
          <svg viewBox="0 0 20 20" aria-hidden="true" class="h-7 w-7 fill-amber-400 md:h-8 md:w-8">
            <path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.644-.772-1.966 0l-1.05 2.553a1.18 1.18 0 0 1-.888.866l-2.78.64c-.816.189-1.103 1.22-.55 1.847l2.06 2.025a1.18 1.18 0 0 1 .34 1.123l-.512 2.73c-.144.77.659 1.364 1.368.99l2.482-1.344a1.18 1.18 0 0 1 1.1 0l2.482 1.344c.709.374 1.512-.221 1.368-.99l-.512-2.73a1.18 1.18 0 0 1 .34-1.123l2.06-2.025c.553-.627.266-1.658-.55-1.847l-2.78-.64a1.18 1.18 0 0 1-.888-.866l-1.05-2.553Z" clip-rule="evenodd" />
          </svg>
        ))}
      </div>

      <span class="inline-flex shrink-0 items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-slate-600 md:text-xs">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
        </svg>
        Google Review
      </span>
    </div>

    <blockquote class="text-lg leading-relaxed text-slate-800 italic md:text-xl">
      “{quote}”
    </blockquote>

    <figcaption class="mt-5 flex items-center gap-3">
      {photo ? (
        <img
          src={photo}
          alt=""
          width="44"
          height="44"
          loading="lazy"
          class="h-11 w-11 shrink-0 rounded-full object-cover shadow ring-2 ring-white"
        />
      ) : (
        <span
          aria-hidden="true"
          class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-brand-accent to-green-700 text-sm font-black text-white shadow ring-2 ring-white"
        >
          {initials}
        </span>
      )}
      <span class="min-w-0">
        <span class="block truncate font-bold text-slate-900">{name}</span>
        <span class="block text-xs text-slate-600">Posted on Google</span>
      </span>
    </figcaption>
  </div>
</figure>
