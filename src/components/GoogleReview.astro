---
interface Props {
  quote: string;
  name: string;
  class?: string;
}

const { quote, name, class: className = '' } = Astro.props;
---

<figure class={`max-w-md mx-auto text-center ${className}`}>
  <div class="text-brand-accent text-lg leading-none mb-2" aria-label="5 star Google review">★★★★★</div>
  <blockquote class="text-white/85 text-base italic leading-relaxed">“{quote}”</blockquote>
  <figcaption class="mt-3 text-white/60 text-sm">
    <span class="text-white/80 font-semibold">{name}</span> · Google Review
  </figcaption>
</figure>
