---
interface Props {
  quote?: string;
  author?: string;
  role?: string;
  town?: string;
}

const {
  quote,
  author,
  role,
  town,
} = Astro.props;

const hasQuote = Boolean(quote && author);
---

<section class="py-16 px-4" aria-labelledby="local-proof-heading" data-animate>
  <div class="max-w-3xl mx-auto bg-brand-dark border border-white/10 rounded-2xl p-8 md:p-10 text-center">
    <p class="text-brand-cyan text-xs font-bold uppercase tracking-widest mb-4">Local proof</p>
    <h2 id="local-proof-heading" class="font-heading text-2xl md:text-3xl font-bold text-white mb-6">
      What {town || 'local'} businesses say
    </h2>
    {hasQuote ? (
      <blockquote>
        <p class="text-lg text-white/90 italic leading-relaxed mb-4">“{quote}”</p>
        <footer class="text-white/60 text-sm">
          <cite class="not-italic font-semibold text-white">{author}</cite>
          {role ? <span class="italic text-white/50"> — {role}</span> : null}
        </footer>
      </blockquote>
    ) : (
      <p class="text-white/50 text-sm">
        Real client quote coming soon. Call or text <a href="tel:+17044738188" class="text-brand-cyan hover:text-white underline">(704) 473-8188</a> if you’d like to share feedback.
      </p>
    )}
  </div>
</section>
