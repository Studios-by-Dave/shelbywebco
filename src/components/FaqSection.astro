---
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  heading?: string;
}

const { items, heading = 'Frequently Asked Questions' } = Astro.props;
---

<section class="py-16 lg:py-20 px-4 border-y border-white/10" aria-labelledby="faq-heading" data-animate>
  <div class="max-w-3xl mx-auto">
    <h2 id="faq-heading" class="font-heading font-bold text-3xl md:text-4xl text-white mb-8 text-center">{heading}</h2>
    <div class="space-y-3">
      {items.map((item) => (
        <details class="group overflow-hidden rounded-2xl border border-white/10 bg-[#111214] text-white shadow-[0_10px_30px_rgba(0,0,0,0.18)]">
          <summary class="py-5 px-5 font-heading font-semibold text-lg text-white cursor-pointer list-none flex justify-between items-center gap-3 hover:bg-[#1a1b1f] transition-colors">
            <span>{item.question}</span>
            <span aria-hidden="true" class="text-brand-accent text-xl shrink-0 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="px-5 pb-5 text-white/80 leading-relaxed">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
