---
interface Props {
  term: string;
  slug: string;
  plain: string;
  long: string;
  category: string;
}
const { term, slug, plain, long, category } = Astro.props;
---
<div id={slug} class="scroll-mt-28 bg-brand-dark border border-white/5 rounded-2xl p-6 hover:border-brand-cyan/30 transition-colors">
  <div class="flex items-start justify-between gap-3 mb-3">
    <h3 class="text-xl font-bold text-white">{term}</h3>
    <span class="shrink-0 text-[10px] font-bold tracking-widest uppercase px-2.5 py-1 rounded-full border border-brand-cyan/20 bg-brand-cyan/10 text-brand-cyan">{category}</span>
  </div>
  <p class="text-brand-cyan text-sm font-medium mb-2">{plain}</p>
  <p class="text-white/70 text-sm leading-relaxed">{long}</p>
  <a href={`#${slug}`} class="inline-block mt-3 text-xs text-white/40 hover:text-brand-cyan transition-colors">#{slug}</a>
</div>
