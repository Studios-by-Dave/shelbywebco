---
/**
 * PricingFaqBoard — graphical conversion of the pricing page FAQ.
 * 11 accordion questions grouped into 3 visual categories.
 * Uses the same .faq-item / .faq-question / .faq-answer / .faq-icon classes
 * expected by the page's existing toggle script, and preserves all copy.
 */
const groups = [
  {
    label: 'Costs & Payments',
    accent: 'from-lime-400 to-lime-600',
    chip: 'bg-lime-400/15 text-lime-400',
    questions: [
      {
        q: "Do you offer payment plans?",
        a: `Growth Plans use a launch fee followed by one simple monthly payment for a six-month initial term — <strong class="text-white">Core is $497 to launch then $297/month</strong>, <strong class="text-white">Plus is $798–$998 to launch then $597/month</strong>, and <strong class="text-white">Ultra is $998–$1,498 to launch then $797/month</strong>. After the initial term, plans continue month-to-month and you can cancel at any time with 30 days’ written notice. Cancelling before six months carries a $297 early cancellation fee.`,
        rich: true,
      },
      {
        q: "Is there a discount if I pay upfront?",
        a: `Yes. If you pay your <strong class="text-white">entire build fee plus your first month of SEO service</strong> upfront in a single payment, we apply an <strong class="text-white">instant $50 discount</strong> to your total. It's the same plan and the same work — just one payment instead of two.`,
        rich: true,
      },
      {
        q: "What if I need more pages than my package includes?",
        a: `No problem! Additional pages beyond the package limit are billed at a flat rate of $75–$150 per page, depending on complexity. We can also help you prioritize which pages to launch with and add more later as your business grows.`,
      },
      {
        q: "Can I upgrade my package later?",
        a: `Absolutely. Your site is built on a scalable foundation, so upgrading is smooth. Whether you need to add e-commerce, a booking system, or more pages down the road, we can handle it. We'll simply quote the additional work based on your current package rate.`,
      },
    ],
  },
  {
    label: 'What You Get',
    accent: 'from-cyan-400 to-cyan-600',
    chip: 'bg-cyan-400/15 text-cyan-400',
    questions: [
      {
        q: "What's included in the price?",
        a: `Every package includes custom design, mobile responsiveness, basic SEO setup, and a contact form. Higher-tier packages add advanced functionality like booking systems, e-commerce, analytics integration, and more. All packages include web hosting setup assistance and a domain consultation.`,
      },
      {
        q: "Do you handle web hosting and domain setup?",
        a: `Yes, we handle the full setup. We'll help you choose a domain and get everything deployed. Web hosting, SSL, backups, security monitoring, and software updates are included with every Growth Plan while your plan is active — there are no separate hosting fees.`,
      },
      {
        q: "Do you offer ongoing maintenance?",
        a: `Yes! Every Growth Plan is ongoing by design — that is the whole point. Our plans are <strong class="text-white">Core ($497 launch + $297/month)</strong>, <strong class="text-white">Plus ($798–$998 launch + $597/month)</strong>, and <strong class="text-white">Ultra ($998–$1,498 launch + $797/month)</strong>. All include hosting, security, updates, foundational SEO, and monthly reporting. See <a href="/services/seo/#growth-pricing" class="text-brand-cyan underline">full SEO pricing</a>.`,
        rich: true,
      },
      {
        q: "Do website packages include SEO?",
        a: `Yes. Foundational on-page and local SEO is included with every plan, so there is no double-charging. If you already have a site and want active local visibility work, our Plus plan at $597/month covers keyword research, content, Google Business Profile optimization, and review generation — see <a href="/services/seo/#growth-pricing" class="text-brand-cyan underline">the SEO plans</a>.`,
        rich: true,
      },
    ],
  },
  {
    label: 'Working With Us',
    accent: 'from-blue-400 to-blue-600',
    chip: 'bg-blue-400/15 text-blue-400',
    questions: [
      {
        q: "How long does a typical project take?",
        a: `Most projects are completed within 2–4 weeks, depending on the scope. A simple 1–2 page site can be ready in as little as 1–2 weeks, while more complex builds (e-commerce, custom portals) typically take 4–6 weeks. We'll give you a clear timeline during the proposal phase.`,
      },
      {
        q: "What if I'm not satisfied with the design?",
        a: `Your satisfaction matters. Every Growth Plan includes <strong class="text-white">one small edit request per month</strong> (up to about 30 minutes of work) plus collaborative revision rounds during the initial build. We work iteratively, sharing progress along the way so there are no surprises. Larger redesigns, new pages, and major feature work are project-priced — just ask during your consultation.`,
        rich: true,
      },
      {
        q: "What is a milestone audit?",
        a: `Every monthly SEO plan is audited at each milestone, typically every 90 days. We review performance, rankings, technical health, and AI visibility together. If no further meaningful work is needed, we tell you and you can pause, reduce scope, or shift to lighter maintenance — no endless retainer.`,
      },
    ],
  },
];

const icons: Record<string, string> = {
  'Costs & Payments': 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  'What You Get':
    'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  'Working With Us':
    'M17 20h5v-2a4 4 0 013-3.857M9 20H4v-2a4 4 0 013-3.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
};
---

<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 items-start">
  {
    groups.map((group) => (
      <div class="rounded-2xl bg-gradient-to-b from-[#3a3f49]/60 to-transparent border border-white/10 p-4">
        <div class="flex items-center gap-3 mb-4 px-1">
          <span class={`inline-flex w-9 h-9 rounded-lg bg-gradient-to-br ${group.accent} shadow-[0_0_14px_rgba(132,204,22,0.25)] items-center justify-center text-[#1c1c1c]`}>
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons[group.label]} />
            </svg>
          </span>
          <h3 class="text-white font-bold text-sm uppercase tracking-widest">{group.label}</h3>
          <span class={`ml-auto text-xs font-bold px-2 py-0.5 rounded-full ${group.chip}`}>
            {group.questions.length} Q&As
          </span>
        </div>
        <div class="space-y-3">
          {group.questions.map((item) => (
            <div
              class="faq-item bg-[#26292f]/80 border border-white/5 rounded-xl overflow-hidden transition-all duration-300 hover:border-brand-accent/30"
            >
              <button
                class="faq-question w-full flex items-center justify-between p-4 text-left transition-colors hover:bg-[#2b2f36]"
                aria-expanded="false"
              >
                <span class="text-white font-semibold pr-3 text-sm">{item.q}</span>
                <span class="faq-icon text-brand-accent text-lg flex-shrink-0 transition-transform duration-300">+</span>
              </button>
              <div class="faq-answer max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
                <div class="px-4 pb-4 text-white/70 text-sm leading-relaxed">
                  {item.rich ? <Fragment set:html={item.a} /> : item.a}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))
  }
</div>
