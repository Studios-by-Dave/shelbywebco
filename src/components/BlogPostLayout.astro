---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from './JsonLd.astro';
import FaqSection from './FaqSection.astro';
import { articleSchema, breadcrumbSchema, faqSchema, absoluteUrl } from '../lib/schema';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  datePublished: string;
  dateModified: string;
  cluster?: string;
  faqs?: FaqItem[];
  pillar?: { label: string; href: string };
  serviceLink?: { label: string; href: string };
  related?: { label: string; href: string }[];
  authorName?: string;
}

const {
  title,
  description,
  datePublished,
  dateModified,
  cluster = 'Shelby Web Official',
  faqs = [],
  pillar,
  serviceLink,
  related = [],
  authorName = 'Dave Richardson',
} = Astro.props;

const url = absoluteUrl(Astro.url.pathname);
const publishedLabel = new Date(`${datePublished}T12:00:00`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const modifiedLabel = new Date(`${dateModified}T12:00:00`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Title accent gradient per topic cluster — white-rooted, brand-tinted tail.
const titleGradient =
  cluster === 'local-seo'
    ? 'from-white via-[#dbeafe] to-brand-cyan'
    : cluster === 'website-cost'
      ? 'from-white via-[#dbeafe] to-brand-blue-light'
      : 'from-white via-[#ecfccb] to-brand-accent-light';

const schemas: Record<string, unknown>[] = [
  articleSchema({
    headline: title,
    description,
    url,
    datePublished,
    dateModified,
  }),
  breadcrumbSchema([{ name: title, url }]),
];
if (faqs.length) schemas.push(faqSchema(faqs));
---

<BaseLayout title={title} description={description} breadcrumbs={[{ name: title, url }]}>
  <JsonLd data={schemas} />

  <article class="pt-16 pb-16 px-4">
    <div class="max-w-3xl mx-auto">
      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-2 mb-4 text-xs uppercase tracking-widest text-white/60">
          <span class="text-brand-cyan font-bold">{cluster}</span>
          <span aria-hidden="true">·</span>
          <time datetime={datePublished} class="italic">Published {publishedLabel}</time>
          <span aria-hidden="true">·</span>
          <time datetime={dateModified} class="italic">Updated {modifiedLabel}</time>
        </div>
        <h1 class={`font-heading text-4xl md:text-6xl font-black mb-6 tracking-tight leading-tight bg-gradient-to-br ${titleGradient} bg-clip-text text-transparent`}>
          {title}
        </h1>
        <p class="text-white/80 text-lg leading-relaxed">{description}</p>
      </header>

      <div class="prose prose-invert prose-lg max-w-none article-prose">
        <slot />
      </div>

      {faqs.length > 0 && <FaqSection items={faqs} />}

      <aside class="mt-12 p-6 bg-brand-dark border border-white/10 rounded-2xl">
        <p class="text-brand-cyan text-xs font-bold uppercase tracking-widest mb-3">About the author</p>
        <p class="text-white/85 mb-2">
          <strong class="text-white">{authorName}</strong> — Founder / Lead Developer, Shelby Web Company. Building hand-coded websites and local SEO systems for Cleveland and Gaston County businesses.
        </p>
        <a href="/about/" class="text-brand-cyan hover:text-white underline decoration-brand-cyan/30 text-sm">More about Dave</a>
      </aside>

      {(pillar || serviceLink || related.length > 0) && (
        <nav class="mt-10 p-6 bg-brand-darkest border border-white/5 rounded-2xl" aria-label="Related reading">
          <p class="text-white font-bold mb-3">Keep reading</p>
          <ul class="space-y-2 text-sm">
            {pillar && (
              <li>
                <a href={pillar.href} class="text-brand-cyan hover:text-white underline decoration-brand-cyan/30">{pillar.label}</a>
                <span class="text-white/40 italic"> (pillar guide)</span>
              </li>
            )}
            {serviceLink && (
              <li>
                <a href={serviceLink.href} class="text-brand-cyan hover:text-white underline decoration-brand-cyan/30">{serviceLink.label}</a>
                <span class="text-white/40 italic"> (service)</span>
              </li>
            )}
            {related.map((item) => (
              <li>
                <a href={item.href} class="text-brand-cyan hover:text-white underline decoration-brand-cyan/30">{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <p class="mt-10">
        <a href="/blog/" class="text-white/80 hover:text-white">← Back to Blog</a>
      </p>
    </div>
  </article>
</BaseLayout>

<style is:global>
  /* Heading treatment for content-collection posts.
     Scoped to .article-prose on purpose: a bare `.prose h2` rule outranks
     Tailwind's text-3xl (0,1,1 vs 0,1,0) and would silently restyle the
     hand-authored headings in the 27 standalone .astro posts, which also
     carry .prose. Only markdown-rendered articles have .article-prose. */
  .article-prose h2 {
    font-size: 1.875rem;
    line-height: 1.25;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.015em;
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
    padding-left: 1.1rem;
    border-left: 4px solid #84cc16;
  }

  .article-prose h3 {
    font-size: 1.375rem;
    line-height: 1.35;
    font-weight: 700;
    color: #ffffff;
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .article-prose h3::before {
    content: '▸ ';
    color: #22d3ee;
  }

  /* An h3 directly under an h2 is a sub-point, not a new section. */
  .article-prose h2 + h3 {
    margin-top: 1.1rem;
  }

  @media (max-width: 640px) {
    .article-prose h2 {
      font-size: 1.5rem;
      margin-top: 2.5rem;
    }
    .article-prose h3 {
      font-size: 1.2rem;
      margin-top: 1.75rem;
    }
  }
</style>
