---
interface Props {
  focus?: 'website' | 'seo' | 'leads';
  id?: string;
  title?: string;
  subtitle?: string;
  variant?: 'launch-first' | 'monthly-first';
}

const {
  focus = '',
  id = 'growth-pricing',
  title = 'One Simple Monthly Plan',
  subtitle = 'A professionally managed website with built-in ongoing SEO for <span class="text-brand-cyan font-semibold">$297/month</span> — no large upfront project bill. Build, host, maintain, and grow — all in one plan.',
  variant = 'launch-first',
} = Astro.props;

const tiers = [
  {
    key: 'website',
    name: 'Core',
    launch: '$497',
    monthly: '$297',
    term: '12 months',
    badge: null,
    description: 'A professionally managed website for $297/month — without a $3,000 to $8,000 upfront project bill.',
    features: [
      '4–5 page mobile-first website',
      'Hosting, SSL, backups & security',
      'Contact forms & lead notifications',
      'Google Analytics & Search Console',
      'Foundational on-page & local SEO',
      'One small monthly edit request',
      'Monthly performance snapshot',
      'Quarterly growth review',
      'Milestone audits every 90 days — pause or reduce if no meaningful work remains',
    ],
    bestFor: 'Small local businesses that want a professional web presence without a large upfront invoice',
  },
  {
    key: 'seo',
    name: 'Plus',
    launch: '$798 – $998',
    monthly: '$597',
    term: '6–12 months',
    badge: 'Most Popular',
    description: 'Active local SEO, content, Google Business Profile support, and reporting for real visibility growth.',
    features: [
      'Everything in Core',
      'Keyword & competitor research',
      'Search Console analysis & fixes',
      'New service/location content',
      'Google Business Profile optimization',
      'Review-generation system',
      'Local citation cleanup/buildout',
      'Conversion-rate improvements',
      'AI-visibility tracking & schema markup',
      'Milestone audits every 90 days — pause or reduce if no meaningful work remains',
    ],
    bestFor: 'Businesses ready to invest in meaningful local search visibility and lead generation',
  },
  {
    key: 'leads',
    name: 'Ultra',
    launch: '$998 – $1,498',
    monthly: '$797',
    term: '12 months',
    badge: null,
    description: 'SEO plus conversion optimization, lead tracking, follow-up workflows, and priority support.',
    features: [
      'Everything in Plus',
      'Conversion-rate optimization',
      'Lead tracking & attribution',
      'Follow-up workflows & automation',
      'Priority support & strategy',
      'Advanced analytics & reporting',
      'Dedicated growth manager',
      'Milestone audits every 90 days — pause or reduce if no meaningful work remains',
    ],
    bestFor: 'Businesses that want a full growth system — SEO, leads, and conversion optimization under one roof',
  },
 ];
---

<section id={id} class="py-24 px-4 bg-brand-darkest/50" data-animate>
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <p class="text-brand-purple text-sm uppercase tracking-widest mb-4">✦ Our Growth Plans</p>
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">{title}</h2>
      <p class="text-xl md:text-2xl text-white/80 max-w-3xl mx-auto leading-relaxed" set:html={subtitle} />
    </div>

    <div class="text-center mb-8">
      <p class="text-white/70 max-w-2xl mx-auto text-sm md:text-base leading-relaxed italic">
        Every website build comes with ongoing SEO built in — visibility is one of the core components of what turns a website into a lead-generating asset. Standalone builds available on request.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 mb-16">
      {tiers.map((tier) => (
        <div
          class:list={[
            'bg-gradient-to-br from-brand-dark via-brand-darkest to-[#050505] border rounded-2xl p-8 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),_0_20px_40px_rgba(0,0,0,0.5)] hover:shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),_0_24px_50px_rgba(0,0,0,0.6)] relative transition-all duration-300',
            tier.badge ? 'border-[#f3db70]/50 z-10 scale-100 lg:scale-105' : 'border-white/10',
            focus === tier.key ? 'ring-2 ring-brand-cyan ring-offset-2 ring-offset-brand-darkest' : '',
          ]}
        >
          {tier.badge && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#f3db70] text-[#1c1c1c] text-xs font-bold px-4 py-1 rounded-full uppercase tracking-wider drop-shadow-md whitespace-nowrap">
              {tier.badge}
            </div>
          )}
          <h3 class="font-heading text-4xl md:text-5xl font-black text-center mb-1 bg-[linear-gradient(110deg,#e8e8e8,45%,#ffffff,55%,#d0d0d0)] bg-[length:200%_auto] animate-shine bg-clip-text text-transparent drop-shadow-[0_0_12px_rgba(255,255,255,0.35)]">{tier.name}</h3>
          <p class="text-xs uppercase tracking-widest text-center mb-1 bg-[linear-gradient(110deg,#f3db70,45%,#fff,55%,#9b7b2a)] bg-[length:200%_auto] bg-clip-text text-transparent">{tier.term} initial term</p>
          <p class="text-white/70 text-sm mb-6 italic">{tier.description}</p>
          <div class="mb-6">
            <div class="flex flex-col items-center justify-center">
              {variant === 'monthly-first' ? (
                <>
                  <span class="text-white/60 text-xs uppercase tracking-widest">Per Month</span>
                  <span class="text-5xl md:text-6xl font-black font-nav text-brand-cyan drop-shadow-[0_0_12px_rgba(0,212,255,0.4)] whitespace-nowrap">
                    {tier.monthly}<span class="text-2xl">/mo</span>
                  </span>
                </>
              ) : (
                <>
                  <span class="inline-block bg-brand-cyan/15 border border-brand-cyan/30 text-brand-cyan text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-3">Bundle</span>
                  <span class="text-white/60 text-xs uppercase tracking-widest">Launch</span>
                  <span class="text-[2.75rem] md:text-5xl font-black font-nav bg-[linear-gradient(110deg,#f3db70,45%,#fff,55%,#9b7b2a)] bg-[length:200%_auto] bg-clip-text text-transparent drop-shadow-[0_0_12px_rgba(243,219,112,0.35)] whitespace-nowrap">
                    {tier.launch}
                  </span>
                  <span class="text-zinc-200 text-xs font-bold tracking-widest my-1">AND/OR</span>
                  <div class="w-full bg-brand-cyan/10 border border-brand-cyan/20 rounded-xl py-2 px-3 text-center">
                    <span class="text-brand-cyan font-black text-2xl">{tier.monthly}<span class="text-base font-bold">/mo</span></span>
                    <span class="text-white/70 text-xs block">Ongoing management</span>
                  </div>
                  <p class="text-white/50 text-xs text-center mt-3">12-month total: {tier.key === 'website' ? '$4,061' : tier.key === 'seo' ? '$7,962' : '$10,562'}</p>
                </>
              )}
            </div>
          </div>
          <ul class="space-y-3 text-sm text-white/70 mb-8 flex-1">
            {tier.features.map((feature) => (
              <li>• {feature}</li>
            ))}
          </ul>
          <p class="text-brand-cyan/80 text-xs font-semibold mb-4">Best for: {tier.bestFor}</p>
          <a
            href="/contact/"
            class:list={[
              'block w-full px-6 py-3 rounded-xl font-bold text-center mt-auto transition-all duration-300',
              tier.badge
                ? 'cta-glow-shine bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),inset_0_-2px_6px_rgba(0,0,0,0.25)] hover:brightness-110'
                : 'bg-brand-green text-white border border-white/20 hover:bg-brand-greenLight',
            ]}
          >
            Get Started
          </a>
        </div>
      ))}
    </div>

    <div class="text-center">
      <p class="text-white/80 text-sm md:text-base max-w-3xl mx-auto leading-relaxed">
        After your initial term, plans continue month-to-month. Cancel with 30 days' written notice. Your domain and content are always yours — website files and design are handed off to you upon completion of your initial term, or available for buyout if you cancel early.
      </p>
    </div>
  </div>
</section>
