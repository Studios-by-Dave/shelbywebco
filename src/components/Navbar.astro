---
import Image from './OptimizedImage.astro';
import logo from '../../assets/SWeblogo1.jpg';
import MobileNav from './MobileNav.jsx';
import DesktopNav from './DesktopNav.jsx';
import PixieDust from './PixieDust.jsx';
import GlobalSearch from './GlobalSearch.jsx';
---

<nav class="sticky top-0 z-50 bg-brand-darkest/90 border-b border-brand-blue/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-3">
        <div class="md:hidden bg-white rounded p-2">
          <Image
            src={logo}
            alt="Shelby Web Company Logo"
            width={168}
            height={112}
            class="h-14 w-auto"
          />
        </div>
        <div class="hidden md:block">
          <Image
            src={logo}
            alt="Shelby Web Company Logo"
            width={168}
            height={112}
            class="h-14 w-auto"
          />
        </div>
        <div class="hidden sm:block">
          <span class="font-heading text-2xl font-bold text-white block">Shelby Web Company</span>
          <span class="text-brand-cyan text-xs italic block">Formerly Studios by Dave</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <DesktopNav client:load />

      <div class="hidden md:flex items-center">
        <GlobalSearch client:idle />
      </div>

      <!-- Navbar Get Started Button -->
      <div class="hidden md:flex items-center space-x-6 relative group">
        <!-- Aurora Glow -->
        <div class="absolute inset-0 bg-brand-accent/30 blur-xl rounded-full opacity-60 group-hover:opacity-100 transition-opacity duration-500 animate-aurora-sm z-0 pointer-events-none"></div>

        <a 
          href="/promotions/free-seo-audit/" 
          class="bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-6 py-2.5 rounded-xl font-bold border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),inset_0_-2px_6px_rgba(0,0,0,0.25),0_4px_14px_rgba(0,0,0,0.4),0_2px_8px_rgba(132,204,22,0.35),0_0_20px_rgba(132,204,22,0.25)] hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.75),inset_0_-2px_6px_rgba(0,0,0,0.2),0_6px_20px_rgba(0,0,0,0.45),0_0_28px_rgba(132,204,22,0.5)] hover:from-[#b5f146] hover:via-brand-accent-light hover:to-[#4d7c0f] hover:-translate-y-[1px] active:translate-y-[1px] active:shadow-[inset_0_2px_4px_rgba(0,0,0,0.3),0_2px_6px_rgba(0,0,0,0.3)] transition-all duration-300 relative z-10"
        >
          <span class="text-base relative z-20 leading-tight text-center block drop-shadow-[0_1px_0_rgba(255,255,255,0.4)]">Free SEO<br>Audit</span>
        </a>
        <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none z-0">
          <PixieDust client:load />
        </div>
      </div>

      <!-- Mobile Menu Button -->
      <div class="md:hidden flex items-center justify-end">
        <MobileNav client:load />
      </div>
    </div>
  </div>
</nav>

<style>
  @keyframes aurora-sm {
    0%, 100% {
      transform: translate(0, 0) scale(1.0);
      filter: blur(12px) hue-rotate(0deg);
    }
    33% {
      transform: translate(5px, -3px) scale(1.1);
      filter: blur(16px) hue-rotate(15deg);
    }
    66% {
      transform: translate(-3px, 4px) scale(0.95);
      filter: blur(14px) hue-rotate(-15deg);
    }
  }

  .animate-aurora-sm {
    animation: aurora-sm 8s ease-in-out infinite;
  }

  @keyframes ctaGlowPulse {
    0%,
    100% {
      box-shadow: 0 0 0 rgba(132, 204, 22, 0.0), 0 0 14px rgba(132, 204, 22, 0.26);
    }
    50% {
      box-shadow: 0 0 0 rgba(132, 204, 22, 0.0), 0 0 22px rgba(132, 204, 22, 0.38);
    }
  }

  @keyframes ctaSweep {
    0% {
      transform: translateX(-130%);
      opacity: 0;
    }
    15% {
      opacity: 0.35;
    }
    45% {
      transform: translateX(130%);
      opacity: 0;
    }
    100% {
      transform: translateX(130%);
      opacity: 0;
    }
  }

  .cta-shine {
    overflow: hidden;
    animation: ctaGlowPulse 2.8s ease-in-out infinite;
  }

  .cta-reflection {
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    transform: rotate(35deg);
    animation: ctaReflectionMove 8s linear infinite;
  }

  @keyframes ctaReflectionMove {
    0% { transform: rotate(35deg) translateY(-20%); }
    50% { transform: rotate(35deg) translateY(20%); }
    100% { transform: rotate(35deg) translateY(-20%); }
  }

  .cta-shine-sweep {
    animation: ctaSweep 4.6s ease-in-out infinite;
    pointer-events: none;
  }
</style>
