---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.jsx';
import '../styles/global.css';
import jesusWatermark from '../../assets/jesuswatermark_1.jpg';

interface Breadcrumb {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  breadcrumbs?: Breadcrumb[];
}

const { 
  title, 
  description, 
  image = 'https://www.shelbywebco.com/og-image.jpg',
  canonical = new URL(Astro.url.pathname, Astro.site).href,
  breadcrumbs
} = Astro.props;

const isHomepage = Astro.url.pathname === '/' || Astro.url.pathname === '';

const fullTitle = `${title} | Shelby Web Company`;
const absoluteImageUrl = image.startsWith('http') ? image : `https://www.shelbywebco.com${image}`;

// Auto-generate breadcrumbs from the URL path when a page doesn't supply its own.
const siteOrigin = 'https://www.shelbywebco.com';

function titleize(segment: string) {
  return segment
    .replace(/-nc$/i, ' NC')
    .split('-')
    .map(word => {
      const upper = word.toUpperCase();
      if (['seo', 'nc', 'ai', 'llc'].includes(word.toLowerCase())) return upper;
      return word.charAt(0).toUpperCase() + word.slice(1);
    })
    .join(' ');
}

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);

const autoBreadcrumbs: Breadcrumb[] = pathSegments.map((segment: string, index: number) => {
  const url = `${siteOrigin}/${pathSegments.slice(0, index + 1).join('/')}`;
  const isLast = index === pathSegments.length - 1;
  const name = isLast ? title : titleize(segment);
  return { name, url };
});

const finalBreadcrumbs: Breadcrumb[] = breadcrumbs ?? autoBreadcrumbs;

const breadcrumbList = [
  { name: 'Home', url: siteOrigin },
  ...finalBreadcrumbs
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbList.map((crumb, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": crumb.name,
    "item": crumb.url
  }))
};

const showBreadcrumbBar = pathSegments.length > 0;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0EA5E9" />
    
    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageUrl} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={absoluteImageUrl} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonical} />
    
    <!-- Local Business Schema -->
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Shelby Web Company",
        "image": "https://www.shelbywebco.com/og-image.jpg",
        "@id": "https://www.shelbywebco.com",
        "url": "https://www.shelbywebco.com",
        "telephone": "(704) 473-8188",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Shelby",
          "addressRegion": "NC",
          "postalCode": "28150",
          "addressCountry": "US"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 35.2924,
          "longitude": -81.5356
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday",
              "Friday"
            ],
            "opens": "09:00",
            "closes": "17:00"
          },
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "Saturday",
              "Sunday"
            ],
            "opens": "10:00",
            "closes": "14:00"
          }
        ],
        "sameAs": [
          "https://www.facebook.com/profile.php?id=61591509287089",
          "https://www.linkedin.com/company/shelbywebco"
        ]
      }
    </script>

    <!-- Breadcrumb Schema -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    
    <!-- Fonts (self-hosted) -->
    <link rel="stylesheet" href="/fonts/fonts.css" />
    
    <!-- Google Fonts - Playfair Display & Montserrat & Fredoka -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700&family=Fredoka:wght@700&display=swap" rel="stylesheet">
    
    <title>{fullTitle}</title>
  </head>
  <body class="bg-brand-darkest text-white font-body antialiased relative overflow-x-hidden">
    <!-- Texture & Lighting Background -->
    <div class="fixed inset-0 -z-50 overflow-hidden pointer-events-none">
      <!-- Subtle Grid -->
      <div class={`absolute inset-0 opacity-[0.07] ${isHomepage ? 'opacity-20' : ''}`} style={isHomepage ? "background-image: linear-gradient(rgba(29, 78, 216, 0.7) 1px, transparent 1px), linear-gradient(90deg, rgba(29, 78, 216, 0.7) 1px, transparent 1px); background-size: 40px 40px;" : "background-image: linear-gradient(rgba(255, 255, 255, 0.16) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.16) 1px, transparent 1px); background-size: 56px 56px;"}></div>

      <!-- Noise Texture -->
      <div class="absolute inset-0 opacity-[0.05] mix-blend-overlay" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalSum%22 baseFrequency=%220.8%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"></div>
      
      <!-- Mood Lighting Glows -->
      {!isHomepage && (
        <>
          <div class="absolute top-[-20%] left-[-10%] w-[70%] h-[70%] bg-brand-blue/20 blur-[150px] rounded-full"></div>
          <div class="absolute bottom-[-10%] right-[-10%] w-[60%] h-[60%] bg-brand-cyan/15 blur-[130px] rounded-full"></div>
          <div class="absolute top-[20%] right-[5%] w-[40%] h-[40%] bg-brand-blue-light/10 blur-[100px] rounded-full animate-pulse" style="animation-duration: 4s;"></div>
          <div class="absolute bottom-[20%] left-[5%] w-[35%] h-[35%] bg-purple-500/5 blur-[110px] rounded-full"></div>
        </>
      )}
      {isHomepage && (
        <>
          <div class="absolute top-[-20%] left-[-10%] w-[80%] h-[80%] bg-brand-blue/10 blur-[160px] rounded-full"></div>
          <div class="absolute bottom-[-10%] right-[-10%] w-[70%] h-[70%] bg-brand-blue/5 blur-[140px] rounded-full"></div>
        </>
      )}
    </div>

    <Navbar />
    {showBreadcrumbBar && (
      <nav aria-label="Breadcrumb" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 text-sm text-white/60">
        <ol class="flex flex-wrap items-center gap-1">
          <li class="flex items-center gap-1">
            <a href="/" class="hover:text-brand-cyan transition-colors">Home</a>
            <span aria-hidden="true" class="px-1">/</span>
          </li>
          {finalBreadcrumbs.map((crumb, index) => (
            <li class="flex items-center gap-1">
              {index === finalBreadcrumbs.length - 1 ? (
                <span aria-current="page" class="text-white/90">{crumb.name}</span>
              ) : (
                <>
                  <a href={new URL(crumb.url).pathname} class="hover:text-brand-cyan transition-colors">{crumb.name}</a>
                  <span aria-hidden="true" class="px-1">/</span>
                </>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <main class="min-h-screen">
      <slot />
    </main>
    <div class="fixed bottom-4 right-4 md:bottom-5 md:right-5 z-[99999] pointer-events-none select-none" aria-hidden="true">
      <img
        src={jesusWatermark.src}
        alt=""
        class="w-8 md:w-10 h-auto opacity-70"
        loading="lazy"
        decoding="async"
      />
    </div>
    <Footer />
    <ChatWidget client:load />
    
    <script>
      // Scroll animation with IntersectionObserver
      document.addEventListener('DOMContentLoaded', () => {
        const observerOptions = {
          root: null,
          rootMargin: '0px',
          threshold: 0.1
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('animate-in');
            }
          });
        }, observerOptions);

        // Add fade-in-up animation to elements with data-animate attribute
        document.querySelectorAll('[data-animate]').forEach(el => {
          el.classList.add('opacity-0', 'translate-y-8', 'transition-all', 'duration-700', 'ease-out');
          observer.observe(el);
        });

        // Add CSS for animation
        const style = document.createElement('style');
        style.textContent = `
          .animate-in {
            opacity: 1 !important;
            transform: translateY(0) !important;
          }
        `;
        document.head.appendChild(style);
      });
    </script>
  </body>
</html>
