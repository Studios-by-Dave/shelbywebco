---
import BaseLayout from '../layouts/BaseLayout.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'serviceType': 'Websites & SEO for Bathroom Remodelers and Remodeling Contractors',
  'name': 'Bathroom Remodeler Websites & SEO in Shelby, NC',
  'description': 'Websites, local SEO, and website rescue for bathroom remodelers and remodeling contractors in Shelby, Gastonia, Kings Mountain, Forest City, and surrounding Western NC. $597 setup, then plans from $297/month.',
  'provider': {
    '@type': 'LocalBusiness',
    'name': 'Shelby Web Company',
    'url': 'https://www.shelbywebco.com',
    'telephone': '(704) 473-8188'
  },
  'areaServed': [
    { '@type': 'City', 'name': 'Shelby, NC' },
    { '@type': 'City', 'name': 'Gastonia, NC' },
    { '@type': 'City', 'name': 'Kings Mountain, NC' },
    { '@type': 'City', 'name': 'Forest City, NC' },
    { '@type': 'City', 'name': 'Boiling Springs, NC' },
    { '@type': 'City', 'name': 'Polkville, NC' }
  ],
  'url': 'https://www.shelbywebco.com/web-design-for-bathroom-remodelers-shelby-nc/'
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'Do bathroom remodelers need their own page?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Yes, if you want to be found for bath projects. Homeowners searching for a bathroom remodel want different proof than kitchen shoppers. A dedicated page with your own bath work, a typical range, and a clear process gives that search a useful answer.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Can I show a bathroom remodel cost range without scaring people off?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'A range with a short explanation of what moves it — tile, fixtures, layout changes — tends to build trust rather than lose it. It saves both you and the homeowner time.'
      }
    },
    {
      '@type': 'Question',
      'name': 'Do you guarantee map-pack rankings?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'No. We do the work — a complete Google Business Profile, correct categories, reviews, and location pages — but we never promise a rank or a number of leads.'
      }
    }
  ]
};
---

<BaseLayout
  bgVariant="blue"
  title="Websites & SEO for Bathroom Remodelers | Shelby, NC | Shelby Web Co."
  description="Websites and SEO for bathroom remodelers and remodeling contractors in Shelby and Cleveland County. $597 setup, then $297/month. Month-to-month. Call (704) 473-8188."
>
  <script is:inline set:html={JSON.stringify(serviceSchema)} type="application/ld+json"></script>
  <script is:inline set:html={JSON.stringify(faqSchema)} type="application/ld+json"></script>

  <section class="py-14 lg:py-20 px-4 relative overflow-hidden" data-animate>
    <div class="absolute inset-0 bg-gradient-to-b from-brand-dark via-brand-darkest to-brand-darkest z-0"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(0,180,216,0.12),transparent_55%)] z-0"></div>
    <div class="max-w-5xl mx-auto text-center relative z-10">
      <p class="inline-block px-4 py-1.5 mb-6 rounded-full border border-brand-accent/30 bg-brand-accent/20 text-brand-accent text-sm font-bold uppercase tracking-[0.2em] backdrop-blur-sm">✦ For Bathroom Remodelers &amp; Contractors</p>
      <h1 class="font-heading text-5xl md:text-7xl font-black text-white mb-6 tracking-tight leading-[0.95]">
        Bathroom Remodeling Websites That Get <span class="bg-clip-text text-transparent bg-gradient-to-r from-cyan-300 to-blue-500">Found and Called</span>
      </h1>
      <p class="text-2xl md:text-3xl font-bold text-[#f4c95d] mb-4">$597 setup. Month-to-month.</p>
      <p class="text-lg md:text-xl text-white/80 mb-8 max-w-3xl mx-auto leading-relaxed">
        Bath remodels are a trust decision. We give remodelers a dedicated page for it — your own finished work, a typical cost range, a short process, and real reviews — backed by local SEO across Shelby, Gastonia, Kings Mountain, and Forest City.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/promotions/free-seo-audit/" class="cta-glow-shine inline-block bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-9 py-4 rounded-xl font-bold text-lg border border-white/20 hover:-translate-y-[1px] transition-all duration-300">Get My Free Audit</a>
        <a href="tel:+17044738188" class="inline-flex items-center justify-center border border-brand-accent/40 text-brand-accent px-9 py-4 rounded-xl font-bold text-lg hover:bg-brand-accent/10 transition-all duration-300">(704) 473-8188</a>
      </div>
    </div>
  </section>

  <section class="py-20 px-4 bg-white/[0.04]" data-animate>
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-brand-accent text-label uppercase tracking-widest mb-4">✦ Built Around Bath Searches</p>
        <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-4">What Your Bath Page Actually Needs</h2>
        <p class="text-white/70 max-w-2xl mx-auto">The details that turn a searcher into a booked consultation.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-7">
          <h3 class="text-card-title font-bold text-brand-accent mb-3">Your Own Finished Baths</h3>
          <p class="text-white/80 leading-relaxed">Real before-and-after work — tile, vanities, showers, and accessibility changes — with the details homeowners look for.</p>
        </div>
        <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-7">
          <h3 class="text-card-title font-bold text-brand-accent mb-3">A Cost Range That Builds Trust</h3>
          <p class="text-white/80 leading-relaxed">A plain range and what moves it — finishes, layout, plumbing — so a homeowner knows what to expect before they call.</p>
        </div>
        <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-7">
          <h3 class="text-card-title font-bold text-brand-accent mb-3">Local Bath Pages</h3>
          <p class="text-white/80 leading-relaxed">A page for bathroom remodeling in each city you serve, so you show up for the searches happening in your area.</p>
        </div>
        <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-7">
          <h3 class="text-card-title font-bold text-brand-accent mb-3">Reviews &amp; Proof</h3>
          <p class="text-white/80 leading-relaxed">A review request system and replies, plus a Google Business Profile with the right categories and recent photos.</p>
        </div>
        <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-7">
          <h3 class="text-card-title font-bold text-brand-accent mb-3">Fast Follow-Up</h3>
          <p class="text-white/80 leading-relaxed">Tap-to-call, missed-call text-back, and an auto-reply to forms. Industry sources report many home-service calls go unanswered.</p>
        </div>
        <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-7">
          <h3 class="text-card-title font-bold text-brand-accent mb-3">Monthly Snapshot</h3>
          <p class="text-white/80 leading-relaxed">Traffic, rankings, calls, and forms tracked every month, with a 90-day audit and no endless retainer.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 px-4" data-animate aria-labelledby="bath-faq-heading">
    <div class="max-w-4xl mx-auto">
      <h2 id="bath-faq-heading" class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-10 text-center">Bathroom Remodeling Website FAQs</h2>
      <div class="space-y-4">
        {[
          { q: 'Do bathroom remodelers need their own page?', a: 'Yes. A dedicated page gives bath-intent searches somewhere useful to land and keeps them separate from kitchen work.' },
          { q: 'Can I show a cost range?', a: 'Yes. A range with a short explanation of what moves it tends to build trust and save everyone time.' },
          { q: 'Do you guarantee map-pack rankings?', a: 'No. We do the work — profile, categories, reviews, and location pages — but we never promise a rank or a lead count.' }
        ].map((item) => (
          <details class="bg-white/[0.04] border border-white/10 rounded-2xl p-5 group">
            <summary class="cursor-pointer font-semibold text-white text-lg flex items-center justify-between gap-4 list-none marker:hidden">{item.q}<span class="text-brand-accent text-2xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary>
            <p class="text-white/75 text-base leading-relaxed mt-4">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 px-4 bg-brand-accent/90" data-animate>
    <div class="max-w-4xl mx-auto text-center text-brand-darkest">
      <h2 class="font-heading text-4xl md:text-5xl font-black mb-6">Ready to Win More Bath Searches?</h2>
      <p class="text-xl font-medium mb-8 opacity-90">Start with a free audit. We'll tell you what's working, what's broken, and which path makes sense.</p>
      <a href="/contact/" class="inline-block bg-white text-brand-darkest px-9 py-4 rounded-xl font-black text-lg hover:scale-105 transition-all duration-300 shadow-2xl">Book a Free Chat</a>
    </div>
  </section>
</BaseLayout>
