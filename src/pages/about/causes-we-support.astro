---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Image from '../../components/OptimizedImage.astro';
import ourrescue1 from '../../../assets/ourrescue_1.webp';
import autismsociety1 from '../../../assets/autismsociety_1.png';
import communitySupport from '../../../assets/community-support.jpg';
---

<BaseLayout
  title="Causes We Support | Shelby Web Company"
  description="Shelby Web Company genuinely supports causes that make a real difference. Learn about the organizations, communities, and initiatives we stand behind."
>
  <!-- Hero Section -->
  <section class="py-10 lg:py-16 px-4 relative overflow-hidden" data-animate>
    <div class="absolute inset-0 bg-gradient-to-b from-brand-dark via-brand-darkest to-brand-darkest z-0"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(0,180,216,0.12),transparent_55%)] z-0"></div>
    <div class="max-w-5xl mx-auto text-center relative z-10">
      <div class="inline-block px-4 py-1.5 mb-6 rounded-full border border-brand-glow/30 bg-brand-glow/20 text-brand-glow text-sm font-bold uppercase tracking-[0.2em] backdrop-blur-sm">
        ✦ Causes We Support
      </div>
      <h1 class="font-heading text-5xl md:text-7xl font-black text-white mb-6 tracking-tight leading-[0.9]">
        Causes We Support.
      </h1>
      <p class="text-lg md:text-xl text-white/80 mb-8 max-w-3xl mx-auto leading-relaxed">
        Shelby Web Company believes in giving back. These are the causes, communities, and initiatives that align with our values and the work we do every day.
      </p>
    </div>
  </section>

  <!-- Causes Section -->
  <section class="py-24 px-4 bg-brand-darkest">
    <div class="max-w-7xl mx-auto">
      <div class="space-y-6">
        <!-- Cause 1 -->
        <div class="bg-brand-dark border border-white/10 rounded-2xl p-6 md:p-8 hover:border-brand-cyan/30 transition-all duration-300 flex flex-col md:flex-row md:items-center gap-6" data-animate>
          <div class="w-28 h-28 shrink-0 rounded-2xl overflow-hidden border border-red-500/30">
            <Image src={ourrescue1} alt="Our Rescue — Join the Fight against human trafficking" class="w-full h-full object-cover" />
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="font-heading text-2xl font-bold text-white mb-2">Our Rescue — Join the Fight</h3>
            <p class="text-white/80 text-sm leading-relaxed">
              We stand with Our Rescue against human trafficking and child exploitation. Join the Fight is a call to action we all share: empowering those on the frontlines and fighting for the freedom and safety of every survivor.
            </p>
          </div>
          <a href="https://ourrescue.org/" target="_blank" rel="noopener" class="shrink-0 inline-block text-brand-cyan font-semibold text-sm hover:underline md:text-right">Visit ourrescue.org →</a>
        </div>

        <!-- Cause 2 -->
        <div class="bg-brand-dark border border-white/10 rounded-2xl p-6 md:p-8 hover:border-brand-cyan/30 transition-all duration-300 flex flex-col md:flex-row md:items-center gap-6" data-animate>
          <div class="w-28 h-28 shrink-0 rounded-2xl overflow-hidden border border-purple-500/30">
            <Image src={autismsociety1} alt="Autism Society of America" class="w-full h-full object-cover" />
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="font-heading text-2xl font-bold text-white mb-2">Autism Society of America</h3>
            <p class="text-white/80 text-sm leading-relaxed">
              We support the Autism Society of America. The Autism Society strives to empower individuals with Autism and their families to make informed decisions in the planning and delivery of individualized, evidence-based services and support. Each individual and family has the right to choose the services that best meet their individual needs.
            </p>
          </div>
          <a href="https://autismsociety.org/" target="_blank" rel="noopener" class="shrink-0 inline-block text-brand-cyan font-semibold text-sm hover:underline md:text-right">Visit autismsociety.org →</a>
        </div>

        <!-- Cause 3 -->
        <div class="bg-brand-dark border border-white/10 rounded-2xl p-6 md:p-8 hover:border-brand-cyan/30 transition-all duration-300 flex flex-col md:flex-row md:items-center gap-6" data-animate>
          <div class="w-28 h-28 shrink-0 rounded-2xl overflow-hidden border border-brand-cyan/30">
            <Image src={communitySupport} alt="Local community support in Shelby, NC" class="w-full h-full object-cover" />
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="font-heading text-2xl font-bold text-white mb-2">Local Community Support</h3>
            <p class="text-white/80 text-sm leading-relaxed">
              We actively support local organizations and events in Shelby, NC and the surrounding Western NC area. From sponsoring community events to donating web services to local nonprofits, we invest in the communities that shaped us.
            </p>
          </div>
          <a href="/contact/" class="shrink-0 inline-block text-brand-cyan font-semibold text-sm hover:underline md:text-right">Learn more →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- How to Get Involved -->
  <section class="py-24 px-4 bg-brand-dark">
    <div class="max-w-5xl mx-auto text-center relative z-10">
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">Interested in Partnering With Us?</h2>
      <p class="text-white/80 text-lg mb-8 max-w-2xl mx-auto leading-relaxed">
        Whether you're a nonprofit, community organization, or fellow advocate, we'd love to hear from you. Let's discuss how we can support your mission together.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact/" class="cta-glow-shine inline-block bg-brand-accent text-[#0A0A0A] px-8 py-3 rounded-xl font-bold hover:bg-brand-accent-light">Reach Out to Us</a>
        <a href="tel:+17044738188" class="inline-block border border-white/20 text-white px-8 py-3 rounded-xl font-bold hover:bg-white/10 transition-all">Call/Text: (704) 473-8188</a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-32 px-4 relative overflow-hidden bg-brand-accent/90" data-animate>
    <div class="max-w-4xl mx-auto text-center relative z-10 text-brand-darkest">
      <h2 class="font-heading text-5xl md:text-6xl font-black mb-8 leading-tight">
        Let's Make a Difference <br />Together.
      </h2>
      <p class="text-xl md:text-2xl font-medium mb-10 opacity-90 text-balance">
        Every project we build is an opportunity to do more than just code — it's a chance to support the causes that matter. Ready to build something meaningful?
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact/" class="inline-block bg-[#0A0A0A] text-white px-10 py-4 rounded-xl font-black text-xl hover:scale-105 transition-all duration-300 shadow-2xl">
          Book a Free Chat
        </a>
        <a href="tel:+17044738188" class="inline-block border-2 border-[#0A0A0A] text-[#0A0A0A] px-10 py-4 rounded-xl font-black text-xl hover:bg-[#0A0A0A] hover:text-white transition-all duration-300">
          (704) 473-8188
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
