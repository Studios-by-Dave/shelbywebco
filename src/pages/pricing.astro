---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEOPricingSection from '../components/SEOPricingSection.astro';
import ManagedGrowthSection from '../components/ManagedGrowthSection.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What's included in the price?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every package includes custom design, mobile responsiveness, basic SEO setup, and a contact form. Higher-tier packages add advanced functionality like booking systems, e-commerce, analytics integration, and more. All packages include web hosting setup assistance and a domain consultation."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer payment plans?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! We offer flexible payment plans for most packages. Typically we require 50% upfront to begin the project, with the remaining balance due upon completion. For larger projects, we can arrange monthly installments — just ask during your consultation."
      }
    },
    {
      "@type": "Question",
      "name": "How long does a typical project take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most projects are completed within 2–4 weeks, depending on the scope. A simple 1–2 page site can be ready in as little as 1–2 weeks, while more complex builds (e-commerce, custom portals) typically take 4–6 weeks. We'll give you a clear timeline during the proposal phase."
      }
    },
    {
      "@type": "Question",
      "name": "What if I need more pages than my package includes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No problem! Additional pages beyond the package limit are billed at a flat rate of $75–$150 per page, depending on complexity. We can also help you prioritize which pages to launch with and add more later as your business grows."
      }
    },
    {
      "@type": "Question",
      "name": "Do you handle web hosting and domain setup?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we handle the full setup. We'll help you choose a domain, configure web hosting (or recommend the best provider for your needs), and get everything deployed. Web hosting fees are separate and typically range from $10–$30/month depending on your provider and plan."
      }
    },
    {
      "@type": "Question",
      "name": "Can I upgrade my package later?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely. Your site is built on a scalable foundation, so upgrading is smooth. Whether you need to add e-commerce, a booking system, or more pages down the road, we can handle it. We'll simply quote the additional work based on your current package rate."
      }
    },
    {
      "@type": "Question",
      "name": "What if I'm not satisfied with the design?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Your satisfaction matters. Every package includes 1–3 revision rounds (depending on the tier) where you can request changes. We work iteratively, sharing progress along the way so there are no surprises. For Enterprise clients, we offer unlimited revisions until everything is perfect."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer ongoing maintenance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Our monthly SEO plans are Foundation $297, Growth SEO Engine $497 (most popular), Authority SEO $679, and Scale & Dominate $998-$1,998. All include technical SEO, sitemap/robots.txt/llms.txt, service-page optimization, Core Web Vitals care, and milestone audits. Smaller brochure sites can also use a lighter maintenance snapshot — ask during consultation. See /services/seo/#seo-pricing for full details."
      }
    },
    {
      "@type": "Question",
      "name": "What is a milestone audit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every monthly SEO plan is audited at each milestone, typically every 90 days. We review performance, rankings, technical health, and AI visibility. If no further meaningful work is needed, we tell you and you can pause, reduce scope, or shift to lighter maintenance — no endless retainer."
      }
    },
    {
      "@type": "Question",
      "name": "Do website packages include SEO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Monthly SEO is already built into Growth Engine ($497), Authority Builder ($679), and Scale & Dominate ($998-$1,998) packages — no double-charging. If you already have a site, start on any standalone SEO tier at /services/seo/#seo-pricing."
      }
    }
  ]
};
---

<BaseLayout 
  title="Web Design Pricing"
  description="Transparent web design pricing with clear ranges. From simple brochure sites to enterprise solutions — know what to expect."
>
  <script is:inline set:html={JSON.stringify(faqSchema)} type="application/ld+json"></script>

  <!-- Hero Section -->
  <section class="py-6 lg:py-10 px-4" data-animate>
    <div class="max-w-7xl mx-auto text-center">
      <p class="text-brand-purple text-label uppercase tracking-widest mb-4">✦ Transparent Pricing</p>
      <h1 class="font-heading text-page-title md:text-page-title-lg font-bold text-white mb-6 leading-tight">
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-white via-brand-blue-light to-brand-sky">Shelby Web</span>
        <span class="block text-white">Pricing</span>
      </h1>
      <p class="text-body-lg text-white/80 max-w-3xl mx-auto">
        As Transparent as it Gets — clear price ranges for every project. No hidden fees, no surprises — just honest pricing that scales with your needs.
      </p>
    </div>
  </section>

  <!-- Pricing Section -->
  <section class="pt-12 pb-20 px-4" data-animate>
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-brand-purple text-label uppercase tracking-widest mb-2">✦ Our Packages</p>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-white">Web Package Pricing Tiers</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        
        <!-- Starter Package -->
        <div class="bg-gradient-to-br from-brand-dark via-brand-darkest to-[#050505] border border-white/10 rounded-2xl p-8 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),_0_20px_40px_rgba(0,0,0,0.5)] hover:shadow-[inset_0_1px_1px_rgba(255,255,255,0.15),_0_25px_50px_rgba(0,0,0,0.6),_0_0_30px_rgba(132,204,22,0.15)] transition-all duration-300 relative z-0 flex flex-col">
          <h3 class="font-heading text-card-title font-bold text-white mb-1">Starter Website</h3>
          <p class="text-white/50 text-label uppercase tracking-widest mb-3">Brochure — No Monthly</p>
          <p class="text-white/70 text-body-sm mb-6 italic">Perfect for a clean, professional online presence</p>
          
          <div class="mb-6">
            <div class="flex flex-col items-center justify-center">
              <span class="text-white/40 text-label font-bold uppercase tracking-wider mb-1 line-through">Was $698</span>
              <span class="text-amber-400 text-label font-bold uppercase tracking-wider mb-1 animate-pulse">Now</span>
              <span class="text-[1.75rem] md:text-[2rem] font-black font-nav bg-[linear-gradient(110deg,#f3db70,45%,#fff,55%,#9b7b2a)] bg-[length:200%_auto] bg-clip-text text-transparent drop-shadow-[0_2px_2px_rgba(0,0,0,0.5)] whitespace-nowrap">$598</span>
              <span class="text-white/40 text-label uppercase tracking-widest mt-1">one-time build</span>
            </div>
          </div>

          <ul class="space-y-3 text-body-sm text-white/70 mb-8 flex-1">
            <li>• 1-5 page brochure site</li>
            <li>• Mobile-responsive design</li>
            <li>• Contact form included</li>
            <li>• Basic SEO setup</li>
            <li>• 1 revision round</li>
            <li class="text-brand-cyan/80 font-medium">• Not a full Web Package — no hosting, no monthly SEO included.</li>
          </ul>

          <a href="/contact/" class="block w-full bg-brand-accent text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-accent-light transition-all duration-300 text-center mt-auto">Get Started</a>
        </div>

        <!-- Growth Engine -->
        <div class="bg-gradient-to-br from-[#111111] via-brand-darkest to-brand-dark border border-[#f3db70]/50 rounded-2xl p-8 shadow-[inset_0_2px_2px_rgba(255,255,255,0.15),_0_20px_40px_rgba(0,0,0,0.6)] hover:shadow-[inset_0_2px_2px_rgba(255,255,255,0.2),_0_25px_50px_rgba(0,0,0,0.7),_0_0_40px_rgba(243,219,112,0.25)] transition-all duration-300 relative z-10 scale-100 lg:scale-105 flex flex-col">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#f3db70] text-[#0A0A0A] text-label font-bold px-4 py-1 rounded-full uppercase tracking-wider drop-shadow-md whitespace-nowrap">High Growth Choice</div>
          <h3 class="font-heading text-card-title font-bold text-white mb-1">Growth Engine</h3>
          <p class="text-white/50 text-label uppercase tracking-widest mb-1">Build + Monthly SEO</p>
          <p class="text-white/70 text-body-sm mb-6 italic">Most popular — stronger lead flow with ongoing SEO</p>
          
          <div class="mb-6">
            <div class="flex flex-col items-center justify-center">
              <span class="text-[1.4rem] md:text-[1.6rem] font-black font-nav bg-[linear-gradient(110deg,#f3db70,45%,#fff,55%,#9b7b2a)] bg-[length:200%_auto] bg-clip-text text-transparent drop-shadow-[0_2px_2px_rgba(0,0,0,0.5)] whitespace-nowrap">$798 - $1,498</span>
              <span class="text-white/60 text-label uppercase tracking-widest">one-time build</span>
              <div class="mt-3 w-full bg-brand-cyan/10 border border-brand-cyan/20 rounded-xl py-2 px-3 text-center">
                <span class="text-brand-cyan font-black text-lg">+ $497<span class="text-sm font-bold">/mo</span></span>
                <span class="text-white/70 text-label block">Growth SEO Engine included</span>
              </div>
              <span class="text-white/40 text-label mt-2">Milestone audits — no endless retainer</span>
            </div>
          </div>

          <ul class="space-y-3 text-body-sm text-white/70 mb-8 flex-1">
            <li>• 5-10 page custom site + custom UI/UX</li>
            <li>• Advanced form architecture + analytics</li>
            <li>• Full technical SEO + GEO (sitemap/robots/llms.txt)</li>
            <li>• Local SEO (citations, GBP, map-pack)</li>
            <li>• 2 revision rounds + speed optimization</li>
          </ul>

          <a href="/contact/" class="cta-glow-shine block w-full bg-brand-accent text-[#0A0A0A] px-6 py-3 rounded-xl font-medium hover:bg-brand-accent-light text-center mt-auto">Get Started</a>
        </div>

        <!-- Authority Builder -->
        <div class="bg-gradient-to-br from-brand-dark via-brand-darkest to-[#050505] border border-white/10 rounded-2xl p-8 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),_0_20px_40px_rgba(0,0,0,0.5)] hover:shadow-[inset_0_1px_1px_rgba(255,255,255,0.15),_0_25px_50px_rgba(0,0,0,0.6),_0_0_30px_rgba(132,204,22,0.15)] transition-all duration-300 relative z-0 flex flex-col">
          <h3 class="font-heading text-card-title font-bold text-white mb-1">Authority Builder</h3>
          <p class="text-white/50 text-label uppercase tracking-widest mb-1">Build + Monthly Content SEO</p>
          <p class="text-white/70 text-body-sm mb-6 italic">For brands ready to build topical authority</p>
          
          <div class="mb-6">
            <div class="flex flex-col items-center justify-center">
              <span class="text-[1.5rem] md:text-[1.75rem] font-black font-nav bg-[linear-gradient(110deg,#f3db70,45%,#fff,55%,#9b7b2a)] bg-[length:200%_auto] bg-clip-text text-transparent drop-shadow-[0_2px_2px_rgba(0,0,0,0.5)] whitespace-nowrap">$1,498 - $2,498</span>
              <span class="text-white/60 text-label uppercase tracking-widest">one-time build</span>
              <div class="mt-3 w-full bg-brand-purple/10 border border-brand-purple/20 rounded-xl py-2 px-3 text-center">
                <span class="text-brand-purple font-black text-lg">+ $679<span class="text-sm font-bold">/mo</span></span>
                <span class="text-white/70 text-label block">Authority SEO included</span>
              </div>
              <span class="text-white/40 text-label mt-2">Content systems + topic clustering</span>
            </div>
          </div>

          <ul class="space-y-3 text-body-sm text-white/70 mb-8 flex-1">
            <li>• 10-20 page business engine + blog integration</li>
            <li>• Content strategy + article implementation</li>
            <li>• Expanded competitive research + service-area pages</li>
            <li>• High-performance hosting + CRM integrations</li>
            <li>• Advanced booking/e-commerce + strategy consulting</li>
          </ul>

          <a href="/contact/" class="block w-full bg-brand-accent text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-accent-light transition-all duration-300 text-center mt-auto">Get Started</a>
        </div>

        <!-- Scale & Dominate -->
        <div class="bg-gradient-to-br from-[#151515] via-brand-dark to-brand-darkest border border-white/10 rounded-2xl p-8 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),_0_20px_40px_rgba(0,0,0,0.5)] hover:shadow-[inset_0_1px_1px_rgba(255,255,255,0.15),_0_25px_50px_rgba(0,0,0,0.6),_0_0_30px_rgba(132,204,22,0.15)] transition-all duration-300 relative z-0 flex flex-col">
          <h3 class="font-heading text-card-title font-bold text-white mb-3">Scale & Dominate</h3>
          <p class="text-white/50 text-label uppercase tracking-widest mb-1">Build + Aggressive SEO/GEO</p>
          <p class="text-white/70 text-body-sm mb-6 italic">Full domination for competitive / multi-location</p>
          
          <div class="mb-6">
            <div class="text-center flex flex-col items-center justify-center">
              <span class="text-[1.5rem] md:text-[1.75rem] font-black font-nav bg-[linear-gradient(110deg,#f3db70,45%,#fff,55%,#9b7b2a)] bg-[length:200%_auto] bg-clip-text text-transparent drop-shadow-[0_2px_2px_rgba(0,0,0,0.5)] whitespace-nowrap">$2,498 - $3,998</span>
              <span class="text-white/60 text-label uppercase tracking-widest">one-time build</span>
              <div class="mt-3 w-full bg-white/5 border border-white/10 rounded-xl py-2 px-3 text-center">
                <span class="text-white font-black text-lg">+ $998 – $1,998<span class="text-sm font-bold">/mo</span></span>
                <span class="text-white/70 text-label block">Scale & Dominate SEO included</span>
              </div>
              <span class="text-white/40 text-label mt-2">Or custom enterprise scope available</span>
            </div>
          </div>

          <ul class="space-y-3 text-body-sm text-white/70 mb-8 flex-1">
            <li>• 20+ pages fully custom enterprise solution</li>
            <li>• Advanced GEO/AI visibility + link-building</li>
            <li>• Multi-location / competitive market focus</li>
            <li>• Priority strategy + growth roadmap</li>
            <li>• Membership/vendor portals + API workflows</li>
          </ul>

          <a href="/contact/" class="block w-full border-2 border-brand-purple text-brand-purple px-6 py-3 rounded-lg font-medium hover:bg-brand-purple hover:text-white transition-all duration-300 text-center mt-auto">Book Discovery Call</a>
        </div>

      </div>
    </div>
  </section>

  <SEOPricingSection />
  <ManagedGrowthSection />

  <!-- Payment Terms & Onboarding Section -->
  <section class="py-12 px-4" data-animate>
    <div class="max-w-7xl mx-auto">
      <div class="bg-gradient-to-r from-brand-darkest to-brand-dark border border-brand-cyan/20 rounded-3xl p-8 md:p-12 shadow-2xl relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-brand-cyan/5 rounded-full blur-3xl -mr-32 -mt-32"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-brand-accent/5 rounded-full blur-3xl -ml-32 -mb-32"></div>
        
        <div class="relative z-10 grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-6 leading-tight">
              We EASE Our Clients Onboard
            </h2>
            <div class="space-y-4 text-body-lg text-slate-300">
              <p>
                We believe the start of a partnership should be exciting, not stressful. That's why we remove the friction of difficult financial entry by providing <span class="text-brand-cyan font-semibold">flexible payment plans</span> (if necessary) that work specifically for your business.
              </p>
              <p>
                Our standard process is designed to keep things clear and concise for both sides:
              </p>
              <ul class="space-y-3 mt-4">
                <li class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-brand-accent/20 flex items-center justify-center text-brand-accent font-bold">1</div>
                  <span class="text-white"><span class="font-bold text-brand-accent">50% Down</span> upon project start</span>
                </li>
                <li class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-brand-cyan/20 flex items-center justify-center text-brand-cyan font-bold">2</div>
                  <span class="text-white"><span class="font-bold text-brand-cyan">50% Due</span> upon project completion</span>
                </li>
              </ul>
            </div>
          </div>
          
          <div class="bg-brand-darkest/50 backdrop-blur-sm border border-white/5 rounded-2xl p-8">
            <h3 class="text-body-lg font-bold text-white mb-4">Why we do this:</h3>
            <p class="text-slate-400 mb-6 italic">
              "This 50/50 approach keeps both parties fully invested in the success of the project and usually yields a much smoother, focused project path from start to finish."
            </p>
            <div class="flex items-center gap-4 border-t border-white/10 pt-6">
              <div class="w-12 h-12 bg-brand-accent rounded-full flex items-center justify-center text-brand-darkest font-bold text-xl">✓</div>
              <div>
                <p class="text-white font-bold leading-none">Clean & Concise</p>
                <p class="text-white/90 text-label mt-1 uppercase tracking-tighter font-bold">The Shelby Web Co Way</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What Affects Pricing Section -->
  <section class="py-20 px-4 bg-brand-dark" data-animate>
    <div class="max-w-4xl mx-auto">
      <p class="text-brand-purple text-label uppercase tracking-widest mb-4">✦ What Affects Your Price</p>
      <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-8">
        Understanding the Range
      </h2>
      
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-brand-darkest border border-brand-purple/20 rounded-xl p-6">
          <h3 class="text-brand-accent font-bold mb-2">Lower End of Range</h3>
          <p class="text-white/70 text-body-sm">
            Simple layouts, existing branding/content ready, standard features, no custom integrations, flexible timeline.
          </p>
        </div>
        
        <div class="bg-brand-darkest border border-brand-purple/20 rounded-xl p-6">
          <h3 class="text-brand-purple font-bold mb-2">Higher End of Range</h3>
          <p class="text-white/70 text-body-sm">
            Custom design from scratch, complex functionality, multiple integrations, rush timeline, extensive content creation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI Calculator Section -->
  <section class="py-24 px-4 relative overflow-hidden" data-animate>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-cyan/20 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-brand-cyan/20 to-transparent"></div>
    
    <div class="max-w-4xl mx-auto relative z-10">
      <div class="text-center mb-12">
        <p class="text-brand-glow text-label uppercase tracking-[0.2em] mb-4">✦ Growth Forecasting</p>
        <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-6">ROI Calculator</h2>
        <p class="text-body-lg text-white">
          See the real impact a high-performing website has on your bottom line. 
          <span class="text-brand-cyan font-semibold">Invest in growth, not just code.</span>
        </p>
      </div>

      <div class="bg-brand-dark/50 backdrop-blur-xl border border-white/10 rounded-3xl p-8 md:p-12 shadow-2xl">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <!-- Inputs -->
          <div class="space-y-8">
            <div class="space-y-4">
              <label class="block text-white font-bold text-body-lg mb-2">Average Customer Value (LTV)</label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-brand-sky/60 font-bold">$</span>
                <input 
                  type="number" 
                  id="avgValue" 
                  value="1500" 
                  class="w-full bg-brand-darkest border border-white/10 rounded-xl py-4 pl-10 pr-4 text-white font-bold focus:border-brand-cyan focus:ring-1 focus:ring-brand-cyan outline-none transition-all"
                />
              </div>
              <p class="text-label text-brand-sky/60 italic">Total revenue from one customer over their lifetime.</p>
            </div>

            <div class="space-y-4">
              <label class="block text-white font-bold text-body-lg mb-2">Estimated New Monthly Leads</label>
              <input 
                type="range" 
                id="newLeads" 
                min="1" 
                max="50" 
                value="5" 
                class="w-full accent-brand-cyan"
              />
              <div class="flex justify-between text-white font-mono text-body-sm">
                <span>1 Lead</span>
                <span class="text-white font-bold" id="leadsValue">5 Leads</span>
                <span>50 Leads</span>
              </div>
              <p class="text-label text-brand-sky/60 italic">Additional leads generated by your new marketing foundation.</p>
            </div>

            <div class="space-y-4 pt-4">
              <label class="block text-white font-bold text-body-lg mb-2">Project Investment</label>
              <div class="grid grid-cols-2 gap-4">
                <button 
                  onclick="setInvestment(998)" 
                  class="investment-btn py-3 px-4 rounded-xl border border-white/10 bg-brand-darkest text-white hover:border-brand-cyan transition-all text-label font-bold active-investment"
                  data-value="998"
                >
                  $998 (Standard)
                </button>
                <button 
                  onclick="setInvestment(1998)" 
                  class="investment-btn py-3 px-4 rounded-xl border border-white/10 bg-brand-darkest text-white hover:border-brand-cyan transition-all text-label font-bold"
                  data-value="1998"
                >
                  $1,998+ (Premium)
                </button>
              </div>
            </div>
          </div>

          <!-- Results Card -->
          <div class="bg-gradient-to-br from-brand-darkest to-brand-dark p-8 rounded-2xl border border-brand-cyan/20 flex flex-col items-center justify-center text-center">
            <p class="text-brand-glow text-label font-bold uppercase tracking-widest mb-6">Yearly Projection</p>
            
            <div class="mb-8">
              <span class="text-page-title md:text-page-title-lg font-black text-white" id="totalReturn">$90,000</span>
              <p class="text-brand-cyan text-label font-bold mt-2" id="roiPercentage">8,918% ROI</p>
            </div>

            <div class="w-full h-px bg-white/10 mb-8"></div>

            <div class="space-y-4 w-full text-left">
              <div class="flex justify-between items-center text-label">
                <span class="text-white">Potential New Revenue:</span>
                <span class="text-white font-bold" id="grossRevenue">$90,000</span>
              </div>
              <div class="flex justify-between items-center text-label">
                <span class="text-white">Payback Period:</span>
                <span class="text-brand-accent font-bold" id="paybackPeriod">&lt; 1 Month</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

