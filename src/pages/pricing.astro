      border-radius: 0.5rem;
      appearance: none;
      cursor: pointer;
    }

    input[type='range']::-webkit-slider-thumb {
      width: 1.5rem;
      height: 1.5rem;
      background-color: #22d3ee;
      border-radius: 9999px;
      appearance: none;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
      border: 2px solid #1a1a1a;
