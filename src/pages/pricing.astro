---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Pricing"
  description="Transparent web design pricing with clear ranges. From simple brochure sites to enterprise solutions - know what to expect before we start."
>

  <!-- Hero Section -->
  <section class="py-20 lg:py-32 px-4" data-animate>
    <div class="max-w-7xl mx-auto text-center">
      <p class="text-brand-purple text-sm uppercase tracking-widest mb-4">✦ Transparent Pricing</p>
      <h1 class="font-heading text-6xl md:text-7xl lg:text-8xl font-bold text-white mb-6 leading-tight">
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-white via-brand-blue-light to-brand-sky">Shelby Web</span>
        <span class="block bg-clip-text text-transparent bg-gradient-to-r from-[#f3db70] via-[#fff3bf] to-[#d4af37]">Pricing</span>
      </h1>
      <p class="text-xl text-white/80 max-w-3xl mx-auto">
        Clear price ranges for every project. No hidden fees, no surprises — just honest pricing that scales with your needs.
      </p>
    </div>
  </section>

  <!-- Quote Calculator Section -->
  <section class="py-20 px-4 bg-brand-dark" data-animate>
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-brand-cyan text-sm uppercase tracking-widest mb-3">✦ Quick Estimate</p>
        <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black mb-4 leading-tight">
          <span class="inline-block bg-[linear-gradient(110deg,#ffffff_0%,#ffffff_35%,#84cc16_55%,#ffffff_75%,#ffffff_100%)] bg-[length:220%_100%] bg-clip-text text-transparent animate-[shimmer_3.5s_ease-in-out_infinite] drop-shadow-[0_0_24px_rgba(132,204,22,0.25)]">
            Build Your Estimate
          </span>
        </h2>
        <p class="text-white/70 max-w-2xl mx-auto">Answer a few quick questions and we’ll generate a realistic starting estimate for your project.</p>
        <p class="text-xs sm:text-sm text-yellow-300 max-w-3xl mx-auto mt-3 italic font-semibold">*Estimates generated by the Estimate Calculator tool do not signify ACTUAL estimate value and would then be verified by Shelby Web Company directly. Ask for Dave! 704 4738188</p>
      </div>

      <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-8">
        <div class="bg-brand-darkest/80 border border-brand-cyan/20 rounded-3xl p-8 shadow-2xl">
          <div class="space-y-6">
            <div>
              <label class="block text-sm font-bold uppercase tracking-widest text-brand-cyan/80 mb-2">Project Budget</label>
              <select id="budget" class="w-full rounded-xl border border-white/10 bg-brand-dark px-4 py-3 text-white focus:border-brand-cyan focus:outline-none">
                <option value="starter">Starter / Small Business</option>
                <option value="growth">Growth / Professional</option>
                <option value="scale">Scale / Advanced</option>
              </select>
            </div>

            <div>
              <label class="block text-sm font-bold uppercase tracking-widest text-brand-cyan/80 mb-2">How many pages?</label>
              <input id="pages" type="range" min="1" max="12" value="4" class="w-full accent-brand-cyan" />
              <div class="flex justify-between text-sm text-white/60 mt-2">
                <span>1</span>
                <span id="pageCountLabel" class="text-white font-semibold">4 pages</span>
                <span>12</span>
              </div>
            </div>

            <div>
              <label class="block text-sm font-bold uppercase tracking-widest text-brand-cyan/80 mb-2">Contact forms?</label>
              <select id="forms" class="w-full rounded-xl border border-white/10 bg-brand-dark px-4 py-3 text-white focus:border-brand-cyan focus:outline-none">
                <option value="0">No forms</option>
                <option value="1">1 form</option>
                <option value="2">2 forms</option>
                <option value="3">3+ forms</option>
              </select>
            </div>

            <div class="grid md:grid-cols-2 gap-4">
              <label class="rounded-xl border border-white/10 bg-brand-dark px-4 py-3 text-white flex items-center gap-3">
                <input id="blog" type="checkbox" class="h-4 w-4 rounded border-white/20 bg-brand-dark text-brand-cyan" />
                <span>Need a blog?</span>
              </label>
              <label class="rounded-xl border border-white/10 bg-brand-dark px-4 py-3 text-white flex items-center gap-3">
                <input id="ecommerce" type="checkbox" class="h-4 w-4 rounded border-white/20 bg-brand-dark text-brand-cyan" />
                <span>Need e-commerce?</span>
              </label>
            </div>

            <div>
              <label class="block text-sm font-bold uppercase tracking-widest text-brand-cyan/80 mb-2">Timeline</label>
              <select id="timeline" class="w-full rounded-xl border border-white/10 bg-brand-dark px-4 py-3 text-white focus:border-brand-cyan focus:outline-none">
                <option value="standard">Standard timeline</option>
                <option value="rush">Need it faster</option>
              </select>
            </div>

            <div>
              <label class="block text-sm font-bold uppercase tracking-widest text-brand-cyan/80 mb-2">Design Style</label>
              <select id="design" class="w-full rounded-xl border border-white/10 bg-brand-dark px-4 py-3 text-white focus:border-brand-cyan focus:outline-none">
                <option value="template">Template-based</option>
                <option value="custom">Custom design</option>
              </select>
            </div>
          </div>
        </div>

        <div class="bg-gradient-to-br from-brand-darkest to-brand-dark border border-brand-cyan/20 rounded-3xl p-8 shadow-2xl">
          <p class="text-brand-cyan text-sm uppercase tracking-widest mb-3">Estimated Range</p>
          <div class="text-5xl md:text-6xl font-black text-white mb-4" id="quoteTotal">$0</div>
          <p class="text-brand-accent font-semibold mb-6" id="quoteTier">Starter</p>
          <div class="rounded-2xl border border-white/10 bg-brand-darkest/60 p-5 space-y-3 text-sm text-white/70">
            <div class="flex justify-between"><span>Estimated range</span><span id="quoteRange">$0 - $0</span></div>
            <div class="flex justify-between"><span>Base project</span><span id="quoteBase">$0</span></div>
            <div class="flex justify-between"><span>Pages</span><span id="quotePages">$0</span></div>
            <div class="flex justify-between"><span>Forms</span><span id="quoteForms">$0</span></div>
            <div class="flex justify-between"><span>Blog / Ecommerce</span><span id="quoteAddons">$0</span></div>
          </div>
          <a href="/contact" class="mt-6 inline-flex items-center rounded-xl bg-brand-accent px-6 py-3 font-bold text-brand-darkest transition-all duration-300 hover:bg-brand-accent-light">
            Request a Formal Quote
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section class="py-20 px-4" data-animate>
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        
        <!-- Starter Package -->
        <div class="bg-gradient-to-br from-brand-dark via-brand-darkest to-[#050505] border border-white/10 rounded-2xl p-8 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),_0_20px_40px_rgba(0,0,0,0.5)] hover:shadow-[inset_0_1px_1px_rgba(255,255,255,0.15),_0_25px_50px_rgba(0,0,0,0.6),_0_0_30px_rgba(132,204,22,0.15)] transition-all duration-300 relative z-0">
          <h3 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Starter Website</h3>
          <p class="text-white/70 text-sm md:text-base mb-6 italic">Perfect for a clean, professional online presence</p>
          
          <div class="mb-6">
            <div class="flex flex-col items-center justify-center">
              <span class="text-white/40 text-xs font-bold uppercase tracking-wider mb-1 line-through">Was $698</span>
              <span class="text-red-500 text-sm font-bold uppercase tracking-wider mb-1 animate-pulse">Now</span>
              <span class="text-4xl md:text-5xl font-black font-nav bg-[linear-gradient(110deg,#f3db70,45%,#fff,55%,#9b7b2a)] bg-[length:200%_auto] animate-shine bg-clip-text text-transparent drop-shadow-[0_2px_2px_rgba(0,0,0,0.5)] whitespace-nowrap">$598</span>
            </div>
          </div>

          <ul class="space-y-3 text-sm text-white/70 mb-8">
            <li>• 1-5 page brochure site</li>
            <li>• Mobile-responsive design</li>
            <li>• Contact form included</li>
            <li>• Basic SEO setup</li>
            <li>• 1 revision round</li>
          </ul>

          <a 
            href="/contact" 
            class="block w-full bg-brand-green text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-greenLight transition-all duration-300 text-center"
          >
            Get Started
          </a>
        </div>

        <!-- Business Package -->
        <div class="bg-gradient-to-br from-[#111111] via-brand-darkest to-brand-dark border border-[#f3db70]/50 rounded-2xl p-8 shadow-[inset_0_2px_2px_rgba(255,255,255,0.15),_0_20px_40px_rgba(0,0,0,0.6)] hover:shadow-[inset_0_2px_2px_rgba(255,255,255,0.2),_0_25px_50px_rgba(0,0,0,0.7),_0_0_40px_rgba(243,219,112,0.25)] transition-all duration-300 relative z-10 scale-100 lg:scale-105">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#f3db70] text-[#0A0A0A] text-xs font-bold px-4 py-1 rounded-full uppercase tracking-wider drop-shadow-md whitespace-nowrap">
            High Growth Choice
          </div>
          <h3 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Business Web Package</h3>
          <p class="text-white/70 text-sm md:text-base mb-6 italic">Built for growing businesses that need stronger lead flow</p>
          
          <div class="mb-6">
            <div class="flex flex-col items-center justify-center">
              <span class="text-3xl md:text-4xl font-black font-nav bg-[linear-gradient(110deg,#f3db70,45%,#fff,55%,#9b7b2a)] bg-[length:200%_auto] animate-shine bg-clip-text text-transparent drop-shadow-[0_2px_2px_rgba(0,0,0,0.5)] whitespace-nowrap">$998 - $1,998</span>
            </div>
          </div>

          <ul class="space-y-3 text-sm text-white/70 mb-8">
            <li>• 5-10 Page Custom Site</li>
            <li>• Custom UI/UX Design</li>
            <li>• Advanced Form Architecture</li>
            <li>• Local SEO Optimization</li>
            <li>• 2 Revision Rounds</li>
            <li>• Full Analytics Dashboard</li>
            <li>• Speed Optimization Lead</li>
          </ul>

          <a 
            href="/contact" 
            class="cta-glow-shine block w-full bg-brand-accent text-[#0A0A0A] px-6 py-3 rounded-xl font-medium hover:bg-brand-accent-light text-center"
          >
            Get Started
          </a>
        </div>

        <!-- Scale Package -->
        <div class="bg-gradient-to-br from-brand-dark via-brand-darkest to-[#050505] border border-white/10 rounded-2xl p-8 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),_0_20px_40px_rgba(0,0,0,0.5)] hover:shadow-[inset_0_1px_1px_rgba(255,255,255,0.15),_0_25px_50px_rgba(0,0,0,0.6),_0_0_30px_rgba(132,204,22,0.15)] transition-all duration-300 relative z-0">
          <h3 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Scale Business Package</h3>
          <p class="text-white/70 text-sm md:text-base mb-6 italic">Ideal for multi-service brands and multi-location growth</p>
          
          <div class="mb-6">
            <div class="flex flex-col items-center justify-center">
              <span class="text-3xl md:text-4xl font-black font-nav bg-[linear-gradient(110deg,#f3db70,45%,#fff,55%,#9b7b2a)] bg-[length:200%_auto] animate-shine bg-clip-text text-transparent drop-shadow-[0_2px_2px_rgba(0,0,0,0.5)] whitespace-nowrap">$2,000 - $3,998</span>
            </div>
          </div>

          <ul class="space-y-3 text-sm text-white/70 mb-8">
            <li>• 10-20 page Business Engine</li>
            <li>• Full Blog Integration & SEO Strategy</li>
            <li>• Advanced CRM & App Integrations</li>
            <li>• <strong>High-Performance Hosting</strong></li>
            <li>• Advanced booking or E-commerce</li>
            <li>• Enterprise Scaling Capability</li>
            <li>• 1-on-1 Strategy Consulting</li>
          </ul>

          <a 
            href="/contact" 
            class="block w-full bg-brand-green text-white px-6 py-3 rounded-lg font-medium hover:bg-brand-greenLight transition-all duration-300 text-center"
          >
            Get Started
          </a>
        </div>

        <!-- Enterprise Package -->
        <div class="bg-gradient-to-br from-[#151515] via-brand-dark to-brand-darkest border border-white/10 rounded-2xl p-8 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),_0_20px_40px_rgba(0,0,0,0.5)] hover:shadow-[inset_0_1px_1px_rgba(255,255,255,0.15),_0_25px_50px_rgba(0,0,0,0.6),_0_0_30px_rgba(132,204,22,0.15)] transition-all duration-300 relative z-0">
          <h3 class="font-heading text-3xl md:text-4xl font-bold text-white mb-3">Enterprise Custom</h3>
          <p class="text-white/70 text-sm md:text-base mb-6 italic">Custom-built digital systems for complex operations</p>
          
          <div class="mb-6">
            <div class="text-center min-h-[4rem] flex items-center justify-center">
              <span class="text-2xl md:text-3xl font-black font-nav bg-[linear-gradient(110deg,#f3db70,45%,#fff,55%,#9b7b2a)] bg-[length:200%_auto] animate-shine bg-clip-text text-transparent drop-shadow-[0_2px_2px_rgba(0,0,0,0.5)] whitespace-nowrap">Call For Quote</span>
            </div>
          </div>

          <ul class="space-y-3 text-sm text-white/70 mb-8">
            <li>• 20+ pages fully custom enterprise solution</li>
            <li>• Fully Custom Web Applications</li>
            <li>• Membership & Vendor Portals</li>
            <li>• Advanced CRM & API Workflows</li>
            <li>• High-Performance Data Handling</li>
            <li>• Unlimited Technical Support</li>
            <li>• Dedicated Growth Partner</li>
          </ul>

          <a 
            href="/contact" 
            class="block w-full border-2 border-brand-purple text-brand-purple px-6 py-3 rounded-lg font-medium hover:bg-brand-purple hover:text-white transition-all duration-300 text-center"
          >
            Book Discovery Call
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Payment Terms & Onboarding Section -->
  <section class="py-12 px-4" data-animate>
    <div class="max-w-7xl mx-auto">
      <div class="bg-gradient-to-r from-brand-darkest to-brand-dark border border-brand-cyan/20 rounded-3xl p-8 md:p-12 shadow-2xl relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-brand-cyan/5 rounded-full blur-3xl -mr-32 -mt-32"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-brand-accent/5 rounded-full blur-3xl -ml-32 -mb-32"></div>
        
        <div class="relative z-10 grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-6 leading-tight">
              We EASE Our Clients Onboard
            </h2>
            <div class="space-y-4 text-lg text-slate-300">
              <p>
                We believe the start of a partnership should be exciting, not stressful. That's why we remove the friction of difficult financial entry by providing <span class="text-brand-cyan font-semibold">flexible payment plans</span> (if necessary) that work specifically for your business.
              </p>
              <p>
                Our standard process is designed to keep things clear and concise for both sides:
              </p>
              <ul class="space-y-3 mt-4">
                <li class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-brand-accent/20 flex items-center justify-center text-brand-accent font-bold">1</div>
                  <span class="text-white"><span class="font-bold text-brand-accent">50% Down</span> upon project start</span>
                </li>
                <li class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-brand-cyan/20 flex items-center justify-center text-brand-cyan font-bold">2</div>
                  <span class="text-white"><span class="font-bold text-brand-cyan">50% Due</span> upon project completion</span>
                </li>
              </ul>
            </div>
          </div>
          
          <div class="bg-brand-darkest/50 backdrop-blur-sm border border-white/5 rounded-2xl p-8">
            <h3 class="text-xl font-bold text-white mb-4">Why we do this:</h3>
            <p class="text-slate-400 mb-6 italic">
              "This 50/50 approach keeps both parties fully invested in the success of the project and usually yields a much smoother, focused project path from start to finish."
            </p>
            <div class="flex items-center gap-4 border-t border-white/10 pt-6">
              <div class="w-12 h-12 bg-brand-accent rounded-full flex items-center justify-center text-brand-darkest font-bold text-xl">✓</div>
              <div>
                <p class="text-white font-bold leading-none">Clean & Concise</p>
                <p class="text-brand-sky/60 text-sm mt-1 uppercase tracking-tighter font-bold">The Shelby Web Co Way</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What Affects Pricing Section -->
  <section class="py-20 px-4 bg-brand-dark" data-animate>
    <div class="max-w-4xl mx-auto">
      <p class="text-brand-purple text-sm uppercase tracking-widest mb-4">✦ What Affects Your Price</p>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-8">
        Understanding the Range
      </h2>
      
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-brand-darkest border border-brand-purple/20 rounded-xl p-6">
          <h3 class="text-brand-green font-bold mb-2">Lower End of Range</h3>
          <p class="text-white/70 text-sm">
            Simple layouts, existing branding/content ready, standard features, no custom integrations, flexible timeline.
          </p>
        </div>
        
        <div class="bg-brand-darkest border border-brand-purple/20 rounded-xl p-6">
          <h3 class="text-brand-purple font-bold mb-2">Higher End of Range</h3>
          <p class="text-white/70 text-sm">
            Custom design from scratch, complex functionality, multiple integrations, rush timeline, extensive content creation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI Calculator Section -->
  <section class="py-24 px-4 relative overflow-hidden" data-animate>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-cyan/20 to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-brand-cyan/20 to-transparent"></div>
    
    <div class="max-w-4xl mx-auto relative z-10">
      <div class="text-center mb-12">
        <p class="text-brand-glow text-sm uppercase tracking-[0.2em] mb-4">✦ Growth Forecasting</p>
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">ROI Calculator</h2>
        <p class="text-lg text-brand-sky/70">
          See the real impact a high-performing website has on your bottom line. 
          <span class="text-white font-semibold">Invest in growth, not just code.</span>
        </p>
      </div>

      <div class="bg-brand-dark/50 backdrop-blur-xl border border-white/10 rounded-3xl p-8 md:p-12 shadow-2xl">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <!-- Inputs -->
          <div class="space-y-8">
            <div class="space-y-4">
              <label class="block text-white font-bold text-lg mb-2">Average Customer Value (LTV)</label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-brand-sky/50 font-bold">$</span>
                <input 
                  type="number" 
                  id="avgValue" 
                  value="1500" 
                  class="w-full bg-brand-darkest border border-white/10 rounded-xl py-4 pl-10 pr-4 text-white font-bold focus:border-brand-cyan focus:ring-1 focus:ring-brand-cyan outline-none transition-all"
                />
              </div>
              <p class="text-xs text-brand-sky/50 italic">Total revenue from one customer over their lifetime.</p>
            </div>

            <div class="space-y-4">
              <label class="block text-white font-bold text-lg mb-2">Estimated New Monthly Leads</label>
              <input 
                type="range" 
                id="newLeads" 
                min="1" 
                max="50" 
                value="5" 
                class="w-full accent-brand-cyan"
              />
              <div class="flex justify-between text-brand-sky/70 font-mono text-sm">
                <span>1 Lead</span>
                <span class="text-white font-bold" id="leadsValue">5 Leads</span>
                <span>50 Leads</span>
              </div>
              <p class="text-xs text-brand-sky/50 italic">Additional leads generated by your new marketing foundation.</p>
            </div>

            <div class="space-y-4 pt-4">
              <label class="block text-white font-bold text-lg mb-2">Project Investment</label>
              <div class="grid grid-cols-2 gap-4">
                <button 
                  onclick="setInvestment(998)" 
                  class="investment-btn py-3 px-4 rounded-xl border border-white/10 bg-brand-darkest text-white hover:border-brand-cyan transition-all text-xs font-bold active-investment"
                  data-value="998"
                >
                  $998 (Standard)
                </button>
                <button 
                  onclick="setInvestment(1998)" 
                  class="investment-btn py-3 px-4 rounded-xl border border-white/10 bg-brand-darkest text-white hover:border-brand-cyan transition-all text-xs font-bold"
                  data-value="1998"
                >
                  $1,998+ (Premium)
                </button>
              </div>
            </div>
          </div>

          <!-- Results Card -->
          <div class="bg-gradient-to-br from-brand-darkest to-brand-dark p-8 rounded-2xl border border-brand-cyan/20 flex flex-col items-center justify-center text-center">
            <p class="text-brand-glow text-sm font-bold uppercase tracking-widest mb-6">Yearly Projection</p>
            
            <div class="mb-8">
              <span class="text-5xl md:text-6xl font-black text-white" id="totalReturn">$90,000</span>
              <p class="text-brand-cyan text-sm font-bold mt-2" id="roiPercentage">8,918% ROI</p>
            </div>

            <div class="w-full h-px bg-white/10 mb-8"></div>

            <div class="space-y-4 w-full text-left">
              <div class="flex justify-between items-center text-xs">
                <span class="text-brand-sky/70">Potential New Revenue:</span>
                <span class="text-white font-bold" id="grossRevenue">$90,000</span>
              </div>
              <div class="flex justify-between items-center text-xs">
                <span class="text-brand-sky/70">Payback Period:</span>
                <span class="text-brand-accent font-bold" id="paybackPeriod">&lt; 1 Month</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 px-4 bg-brand-dark" data-animate>
    <div class="max-w-4xl mx-auto">
      <p class="text-brand-purple text-sm uppercase tracking-widest mb-4 text-center">✦ FAQ</p>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-12 text-center">
        Frequently Asked Questions
      </h2>

      <div class="space-y-4" id="pricing-faq">
        <!-- Question 1 -->
