---
import BaseLayout from '../layouts/BaseLayout.astro';
import GrowthPlanPricingSection from '../components/GrowthPlanPricingSection.astro';
import marbleBg from '../../assets/marble-800x530.webp';
import Image from '../components/OptimizedImage.astro';
import pricingCompare from '../../assets/pricing_chart_2.jpg';
import PricingFaqBoard from '../components/PricingFaqBoard.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What's included in the price?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every package includes custom design, mobile responsiveness, basic SEO setup, and a contact form. Higher-tier packages add advanced functionality like booking systems, e-commerce, analytics integration, and more. All packages include web hosting setup assistance and a domain consultation."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer payment plans?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Growth Plans use a launch fee followed by one simple monthly payment — Core is $497 to launch then $297/month, Plus is $798–$998 to launch then $597/month, and Ultra is $998–$1,498 to launch then $797/month. Plans are month-to-month with no minimum term, and you can cancel at any time with 30 days’ written notice."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a discount if I pay upfront?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. If you pay your entire build fee plus your first month of SEO service upfront in a single payment, we apply an instant $50 discount to your total. It's the same plan and the same work — just one payment instead of two."
      }
    },
    {
      "@type": "Question",
      "name": "How long does a typical project take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most projects are completed within 2–4 weeks, depending on the scope. A simple 1–2 page site can be ready in as little as 1–2 weeks, while more complex builds (e-commerce, custom portals) typically take 4–6 weeks. We'll give you a clear timeline during the proposal phase."
      }
    },
    {
      "@type": "Question",
      "name": "What if I need more pages than my package includes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No problem! Additional pages beyond the package limit are billed at a flat rate of $75–$150 per page, depending on complexity. We can also help you prioritize which pages to launch with and add more later as your business grows."
      }
    },
    {
      "@type": "Question",
      "name": "Do you handle web hosting and domain setup?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we handle the full setup. We'll help you choose a domain and get everything deployed. Web hosting, SSL, backups, security monitoring, and software updates are included with every Growth Plan while your plan is active — there are no separate hosting fees."
      }
    },
    {
      "@type": "Question",
      "name": "Can I upgrade my package later?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely. Your site is built on a scalable foundation, so upgrading is smooth. Whether you need to add e-commerce, a booking system, or more pages down the road, we can handle it. We'll simply quote the additional work based on your current package rate."
      }
    },
    {
      "@type": "Question",
      "name": "What if I'm not satisfied with the design?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Your satisfaction matters. Every Growth Plan includes one small edit request per month (up to about 30 minutes of work) plus collaborative revision rounds during the initial build. We work iteratively, sharing progress along the way so there are no surprises. Larger redesigns, new pages, and major feature work are project-priced — just ask during your consultation."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer ongoing maintenance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Every Growth Plan is ongoing by design — that is the whole point. Our plans are Core ($497 launch + $297/month), Plus ($798–$998 launch + $597/month), and Ultra ($998–$1,498 launch + $797/month). All include hosting, security, updates, foundational SEO, and monthly reporting. See /services/seo/#growth-pricing for full details."
      }
    },
    {
      "@type": "Question",
      "name": "What is a milestone audit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every monthly SEO plan is audited at each milestone, typically every 90 days. We review performance, rankings, technical health, and AI visibility. If no further meaningful work is needed, we tell you and you can pause, reduce scope, or shift to lighter maintenance — no endless retainer."
      }
    },
    {
      "@type": "Question",
      "name": "Do website packages include SEO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Foundational on-page and local SEO is included with every plan, so there is no double-charging. If you already have a site and want active local visibility work, our Plus plan at $597/month covers keyword research, content, Google Business Profile optimization, and review generation — see /services/seo/#growth-pricing."
      }
    }
  ]
};
---

<BaseLayout 
  title="Web Design & SEO Pricing in Shelby, NC"
  description="Transparent pricing from Shelby Web Company — websites from $497 to launch, ongoing local SEO from $297/month. No hidden fees, no minimum term."
  bgVariant="blue"
>
  <script is:inline set:html={JSON.stringify(faqSchema)} type="application/ld+json"></script>

  <!-- Hero Section -->
  <section class="py-6 lg:py-10 px-4 relative overflow-hidden" data-animate>
    <!-- Marble backdrop — fills the whole hero grid, then dissolves so the
         moving pricing-tier artwork below blends into the page. -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div
        class="absolute inset-0 bg-cover bg-center"
        style={`background-image: url("${encodeURI(marbleBg.src)}"); -webkit-mask-image: linear-gradient(to bottom, black 0%, black 12%, transparent 70%); mask-image: linear-gradient(to bottom, black 0%, black 12%, transparent 70%);`}
      ></div>
    </div>

    <!-- Decorative pricing-tier backdrop -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <svg class="w-full h-full" viewBox="0 0 1200 440" preserveAspectRatio="xMidYMax slice" focusable="false">
        <defs>
          <linearGradient id="pgh-card" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#1e3a8a" stop-opacity="0.20"/>
            <stop offset="55%" stop-color="#0f2350" stop-opacity="0.12"/>
            <stop offset="100%" stop-color="#081227" stop-opacity="0.04"/>
          </linearGradient>
          <linearGradient id="pgh-card-featured" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#2563eb" stop-opacity="0.26"/>
            <stop offset="55%" stop-color="#123a7a" stop-opacity="0.14"/>
            <stop offset="100%" stop-color="#0a1730" stop-opacity="0.05"/>
          </linearGradient>
          <linearGradient id="pgh-edge" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#38bdf8" stop-opacity="0"/>
            <stop offset="50%" stop-color="#7dd3fc" stop-opacity="0.15"/>
            <stop offset="100%" stop-color="#38bdf8" stop-opacity="0"/>
          </linearGradient>
          <linearGradient id="pgh-bar" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#60a5fa" stop-opacity="0.22"/>
            <stop offset="100%" stop-color="#60a5fa" stop-opacity="0.04"/>
          </linearGradient>
          <radialGradient id="pgh-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.13"/>
            <stop offset="60%" stop-color="#1d4ed8" stop-opacity="0.05"/>
            <stop offset="100%" stop-color="#1d4ed8" stop-opacity="0"/>
          </radialGradient>
          <pattern id="pgh-grid" width="46" height="46" patternUnits="userSpaceOnUse">
            <path d="M46 0H0V46" fill="none" stroke="#60a5fa" stroke-opacity="0.055" stroke-width="1"/>
          </pattern>
        </defs>

        <rect width="1200" height="440" fill="url(#pgh-grid)"/>

        <!-- glows behind the panels -->
        <ellipse cx="600" cy="470" rx="520" ry="270" fill="url(#pgh-glow)"/>

        <!-- tier panels (extend below the frame so cropping reads as "continuing") -->
        <!-- left panel -->
        <g class="pgh-panel pgh-panel-left">
          <rect x="60" y="176" width="320" height="440" rx="20" fill="url(#pgh-card)" stroke="#3b82f6" stroke-opacity="0.15" stroke-width="1.5"/>
          <rect x="60" y="176" width="320" height="3" rx="1.5" fill="url(#pgh-edge)"/>
          <rect x="88" y="204" width="132" height="12" rx="6" fill="#93c5fd" fill-opacity="0.20"/>
          <rect x="88" y="236" width="180" height="30" rx="8" fill="url(#pgh-bar)"/>
          <rect x="88" y="290" width="244" height="9" rx="4.5" fill="#bfdbfe" fill-opacity="0.13"/>
          <rect x="88" y="310" width="222" height="9" rx="4.5" fill="#bfdbfe" fill-opacity="0.10"/>
          <rect x="88" y="330" width="236" height="9" rx="4.5" fill="#bfdbfe" fill-opacity="0.08"/>
        </g>

        <!-- featured (center) panel -->
        <g class="pgh-panel pgh-panel-center">
          <rect x="440" y="140" width="320" height="476" rx="20" fill="url(#pgh-card-featured)" stroke="#60a5fa" stroke-opacity="0.24" stroke-width="1.5"/>
          <rect x="440" y="140" width="320" height="3" rx="1.5" fill="url(#pgh-edge)"/>
          <rect x="468" y="168" width="152" height="12" rx="6" fill="#bfdbfe" fill-opacity="0.13"/>
          <rect x="468" y="200" width="206" height="34" rx="8" fill="url(#pgh-bar)"/>
          <rect x="468" y="258" width="264" height="9" rx="4.5" fill="#dbeafe" fill-opacity="0.08"/>
          <rect x="468" y="278" width="248" height="9" rx="4.5" fill="#dbeafe" fill-opacity="0.07"/>
          <rect x="468" y="298" width="256" height="9" rx="4.5" fill="#dbeafe" fill-opacity="0.10"/>
          <rect x="468" y="318" width="228" height="9" rx="4.5" fill="#dbeafe" fill-opacity="0.08"/>
          <rect x="468" y="338" width="240" height="9" rx="4.5" fill="#dbeafe" fill-opacity="0.07"/>
        </g>

        <!-- right panel -->
        <g class="pgh-panel pgh-panel-right">
          <rect x="820" y="176" width="320" height="440" rx="20" fill="url(#pgh-card)" stroke="#3b82f6" stroke-opacity="0.15" stroke-width="1.5"/>
          <rect x="820" y="176" width="320" height="3" rx="1.5" fill="url(#pgh-edge)"/>
          <rect x="848" y="204" width="146" height="12" rx="6" fill="#93c5fd" fill-opacity="0.20"/>
          <rect x="848" y="236" width="192" height="30" rx="8" fill="url(#pgh-bar)"/>
          <rect x="848" y="290" width="240" height="9" rx="4.5" fill="#bfdbfe" fill-opacity="0.13"/>
          <rect x="848" y="310" width="228" height="9" rx="4.5" fill="#bfdbfe" fill-opacity="0.10"/>
          <rect x="848" y="330" width="244" height="9" rx="4.5" fill="#bfdbfe" fill-opacity="0.08"/>
        </g>
      </svg>

      <style is:inline>
        @keyframes pgh-slide-ltr {
          0%, 100% { transform: translateX(-20px); }
          50% { transform: translateX(20px); }
        }
        @keyframes pgh-slide-rtl {
          0%, 100% { transform: translateX(20px); }
          50% { transform: translateX(-20px); }
        }
        .pgh-panel { will-change: transform; }
        .pgh-panel-left   { animation: pgh-slide-ltr 5s ease-in-out infinite; }
        .pgh-panel-center { animation: pgh-slide-rtl 6.5s ease-in-out infinite; animation-delay: -2s; }
        .pgh-panel-right  { animation: pgh-slide-ltr 5s ease-in-out infinite; animation-delay: -3s; }
        @media (prefers-reduced-motion: reduce) {
          .pgh-panel { animation: none; }
        }
      </style>
    </div>

    <!-- Scrim: tints the marble back toward the page background and fades it
         out toward the bottom, so the texture reads strongest up top and
         dissolves as the page continues down. -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background: linear-gradient(180deg, rgba(8,14,28,0.52) 0%, rgba(8,14,28,0.44) 32%, rgba(8,14,28,0.70) 66%, rgba(8,14,28,0.94) 100%);"></div>

    <!-- centre vignette keeps the headline legible over the artwork -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background: radial-gradient(ellipse 58% 66% at 50% 44%, rgba(8,14,28,0.58) 0%, rgba(8,14,28,0.30) 46%, rgba(8,14,28,0) 100%);"></div>

    <div class="max-w-7xl mx-auto text-center relative z-10">
      <p class="text-brand-accent text-label uppercase tracking-widest mb-4">✦ Transparent Pricing</p>
      <div class="block w-full max-w-3xl mx-auto px-8 py-4 rounded-2xl bg-[#08090f]/45 backdrop-blur-md border border-white/15 mb-4 shadow-[0_18px_45px_rgba(0,0,0,0.28)]">
        <h1 class="font-heading text-page-title md:text-page-title-lg font-bold text-white leading-tight">
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-white via-brand-blue-light to-brand-sky">Shelby Web</span>
          <span class="block text-white">Total Pricing</span>
        </h1>
      </div>
      <p class="text-yellow-400 text-sm md:text-base uppercase tracking-[0.2em] font-semibold mb-4">Total Transparency</p>
      <p class="text-body-lg text-white/80 max-w-3xl mx-auto">
        As Transparent as it Gets — clear price ranges for every project. No hidden fees, no surprises — just honest pricing that scales with your needs. Three local businesses can also have their $497 website build and launch fee waived through the <a href="/promotions/the-golden-ticket/" class="text-[#f4c95d] underline decoration-[#fbbf24]/40 underline-offset-4 hover:text-[#f8d66d]">Golden Ticket giveaway</a>.
      </p>
      <div class="mt-8 max-w-4xl mx-auto">
        <div class="bg-gradient-to-r from-brand-cyan/10 via-white/5 to-brand-cyan/10 border border-brand-cyan/20 rounded-2xl px-6 py-5">
          <p class="text-white text-lg md:text-xl font-medium italic leading-relaxed">“At Shelby Web Company we don’t think you should have to pay <span class="text-yellow-400 font-bold not-italic">thousands and thousands of dollars a month</span> for SEO.”</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Website Rescue Pricing -->
  <section class="py-16 md:py-20 px-4" data-animate aria-labelledby="rescue-pricing-heading">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-brand-accent text-label uppercase tracking-widest mb-4">✦ Website Rescue Pricing</p>
        <h2 id="rescue-pricing-heading" class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-6 leading-tight">
          Not Every Website Needs to Be Replaced.<br class="hidden md:block" />
          <span class="text-brand-accent">Some just need to be fixed the right way.</span>
        </h2>
        <p class="text-body-lg text-white/80 max-w-2xl mx-auto">
          Start free. Go deeper when you're ready. We only sell fixes you actually need.
        </p>
      </div>

      <!-- Ladder: Free audit + Paid audit -->
      <div class="grid md:grid-cols-2 gap-6 mb-10 max-w-4xl mx-auto">
        <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-7 hover:border-brand-accent/40 transition-colors">
          <p class="uppercase tracking-widest text-xs font-semibold text-white/60 mb-2">Step 1 &mdash; Free</p>
          <h3 class="font-heading text-2xl font-bold text-white mb-2">Free SEO Audit</h3>
          <p class="font-heading text-3xl font-bold text-white mb-4">$0</p>
          <ul class="space-y-2 text-white/85 text-sm leading-snug mb-5">
            <li class="flex items-start gap-2"><span class="text-brand-accent mt-0.5" aria-hidden="true">&#10003;</span>Homepage visibility check — is Google finding you?</li>
            <li class="flex items-start gap-2"><span class="text-brand-accent mt-0.5" aria-hidden="true">&#10003;</span>Basic on-page SEO and title/meta review</li>
            <li class="flex items-start gap-2"><span class="text-brand-accent mt-0.5" aria-hidden="true">&#10003;</span>Quick indexing spot-check</li>
            <li class="flex items-start gap-2"><span class="text-brand-accent mt-0.5" aria-hidden="true">&#10003;</span>Obvious local SEO issues</li>
            <li class="flex items-start gap-2"><span class="text-brand-accent mt-0.5" aria-hidden="true">&#10003;</span>2–3 quick recommendations</li>
          </ul>
          <a href="/promotions/free-seo-audit/" class="block text-center rounded-xl bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-6 py-3 font-bold border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),0_4px_14px_rgba(0,0,0,0.4)] hover:-translate-y-[1px] transition-all duration-300 text-base">
            Get My Free Audit →
          </a>
        </div>

        <div class="bg-white/[0.05] border border-brand-accent/40 rounded-2xl p-7 shadow-[0_0_40px_rgba(132,204,22,0.08)] hover:border-brand-accent/60 transition-colors">
          <p class="uppercase tracking-widest text-xs font-semibold text-brand-accent mb-2">Step 2 &mdash; Paid</p>
          <h3 class="font-heading text-2xl font-bold text-white mb-2">The Website Rescue Report</h3>
          <p class="font-heading text-3xl font-bold text-brand-accent mb-1">$197 <span class="text-white/60 text-base font-normal">one-time</span></p>
          <p class="text-brand-accent/90 text-sm font-semibold mb-4">Credited toward fixes if we do the work within 60 days</p>
          <ul class="space-y-2 text-white/85 text-sm leading-snug mb-5">
            <li class="flex items-start gap-2"><span class="text-brand-accent mt-0.5" aria-hidden="true">&#10003;</span>Full indexing review + Google Search Console analysis</li>
            <li class="flex items-start gap-2"><span class="text-brand-accent mt-0.5" aria-hidden="true">&#10003;</span>Crawlability, sitemap, and robots review</li>
            <li class="flex items-start gap-2"><span class="text-brand-accent mt-0.5" aria-hidden="true">&#10003;</span>Deeper technical SEO and code-level concerns</li>
            <li class="flex items-start gap-2"><span class="text-brand-accent mt-0.5" aria-hidden="true">&#10003;</span>Basic vulnerability review and obvious security risks</li>
            <li class="flex items-start gap-2"><span class="text-brand-accent mt-0.5" aria-hidden="true">&#10003;</span>The <span class="text-white font-semibold">Website Rescue Report</span> — scorecards + prioritized fix plan</li>
          </ul>
          <a href="/contact/?service=website-rescue-audit" class="block text-center rounded-xl border border-brand-accent/50 bg-brand-accent/10 text-white px-6 py-3 font-bold hover:bg-brand-accent/20 hover:-translate-y-[1px] transition-all duration-300 text-base">
            Get the Rescue Report →
          </a>
        </div>
      </div>

      <!-- Fix packages -->
      <h3 class="font-heading text-2xl md:text-3xl font-bold text-white text-center mb-2">Fix Packages</h3>
      <p class="text-white/70 text-center text-base mb-8 max-w-2xl mx-auto">Every package is scoped by your audit, so you're only paying for what your site actually needs. Prices start at:</p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
        <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-6 hover:border-brand-accent/40 transition-colors">
          <h4 class="font-heading text-xl font-bold text-white mb-2">Visibility Rescue</h4>
          <p class="font-heading text-2xl font-bold text-brand-accent mb-3">from $349</p>
          <ul class="space-y-1.5 text-white/75 text-sm leading-snug">
            <li>• Indexing &amp; crawlability repairs</li>
            <li>• Sitemap / robots / Search Console</li>
            <li>• Technical SEO cleanup &amp; speed fixes</li>
            <li>• LocalBusiness schema</li>
          </ul>
        </div>

        <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-6 hover:border-brand-accent/40 transition-colors">
          <h4 class="font-heading text-xl font-bold text-white mb-2">Credibility Rescue</h4>
          <p class="font-heading text-2xl font-bold text-brand-accent mb-3">from $299</p>
          <ul class="space-y-1.5 text-white/75 text-sm leading-snug">
            <li>• Rewrite AI-generated copy (up to 5 pages)</li>
            <li>• De-generic styling pass</li>
            <li>• Mobile UX fixes</li>
            <li>• Trust signals: reviews, credentials</li>
          </ul>
        </div>

        <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-6 hover:border-brand-accent/40 transition-colors">
          <h4 class="font-heading text-xl font-bold text-white mb-2">Conversion Rescue</h4>
          <p class="font-heading text-2xl font-bold text-brand-accent mb-3">from $299</p>
          <ul class="space-y-1.5 text-white/75 text-sm leading-snug">
            <li>• CTA strategy + implementation</li>
            <li>• Lead form rebuild</li>
            <li>• Service page structure (up to 3 pages)</li>
            <li>• One local landing page</li>
          </ul>
        </div>

        <div class="bg-white/[0.05] border border-brand-accent/40 rounded-2xl p-6 hover:border-brand-accent/60 transition-colors">
          <h4 class="font-heading text-xl font-bold text-white mb-2">Full Rescue</h4>
          <p class="font-heading text-2xl font-bold text-brand-accent mb-3">from $749</p>
          <ul class="space-y-1.5 text-white/75 text-sm leading-snug">
            <li>• All three rescues combined</li>
            <li>• Found, credible, converting</li>
            <li>• Saves ~$200 vs. individually</li>
          </ul>
        </div>
      </div>

      <div class="text-center">
        <p class="text-white/70 text-base max-w-2xl mx-auto">
          Every rescue starts with a free audit — so you know what's wrong before you spend a dollar. Month-to-month on all ongoing plans, cancel any time.
        </p>
        <a href="/promotions/free-seo-audit/" class="cta-glow-shine mt-6 inline-flex items-center justify-center rounded-full bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-8 py-3.5 font-bold border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),inset_0_-2px_6px_rgba(0,0,0,0.25),0_4px_14px_rgba(0,0,0,0.4),0_2px_8px_rgba(132,204,22,0.35),0_0_20px_rgba(132,204,22,0.25)] hover:-translate-y-[1px] active:translate-y-[1px] transition-all duration-300 text-base">
          Start With a Free Audit
        </a>
      </div>
    </div>
  </section>

  <!-- Divider: build pricing below -->
  <section class="px-4 pb-2" data-animate>
    <div class="max-w-4xl mx-auto text-center">
      <div class="flex items-center gap-4">
        <div class="flex-1 h-px bg-white/10"></div>
        <p class="text-white/60 text-sm uppercase tracking-widest font-semibold whitespace-nowrap">Planning a new website instead?</p>
        <div class="flex-1 h-px bg-white/10"></div>
      </div>
      <p class="text-white/70 text-base mt-4">New build &amp; ongoing SEO pricing below.</p>
    </div>
  </section>

  <GrowthPlanPricingSection standalone eyebrow="✦ Website Build Packages" title="Website Build Packages — With or Without SEO" />

  <!-- Old vs. New Pricing Comparison Graphic -->
  <section class="py-12 px-4" data-animate>
    <div class="max-w-4xl mx-auto">
      <div class="bg-gradient-to-br from-brand-accent/10 via-transparent to-brand-cyan/5 border border-brand-accent/20 rounded-3xl p-2 md:p-4">
        <Image
