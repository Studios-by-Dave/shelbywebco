  </style>

  <script type="module">
    import { calculateQuote } from '../utils/quoteCalculator.js';

    const budgetInput = document.getElementById('budget');
    const pagesInput = document.getElementById('pages');
    const formsInput = document.getElementById('forms');
    const blogInput = document.getElementById('blog');
    const ecommerceInput = document.getElementById('ecommerce');
    const timelineInput = document.getElementById('timeline');
    const designInput = document.getElementById('design');
    const pageCountLabel = document.getElementById('pageCountLabel');
    const quoteTotal = document.getElementById('quoteTotal');
    const quoteRange = document.getElementById('quoteRange');
    const quoteBase = document.getElementById('quoteBase');
    const quotePages = document.getElementById('quotePages');
    const quoteForms = document.getElementById('quoteForms');
    const quoteAddons = document.getElementById('quoteAddons');
    const quoteTier = document.getElementById('quoteTier');

    function formatCurrency(value) {
      return `$${value.toLocaleString()}`;
    }

    function updateCalculator() {
      const quote = calculateQuote({
        budget: budgetInput?.value || 'starter',
        pages: Number(pagesInput?.value || 1),
        forms: Number(formsInput?.value || 0),
        blog: blogInput?.checked || false,
        ecommerce: ecommerceInput?.checked || false,
        timeline: timelineInput?.value || 'standard',
        design: designInput?.value || 'template'
      });

      if (pageCountLabel) {
        pageCountLabel.textContent = `${quote.breakdown.pages ? Math.round(quote.breakdown.pages / 225) + 1 : 1} pages`;
      }

      if (quoteTotal) quoteTotal.textContent = formatCurrency(quote.total);
      if (quoteRange) quoteRange.textContent = `${formatCurrency(quote.rangeLow)} - ${formatCurrency(quote.rangeHigh)}`;
      if (quoteBase) quoteBase.textContent = formatCurrency(quote.breakdown.base);
      if (quotePages) quotePages.textContent = formatCurrency(quote.breakdown.pages);
      if (quoteForms) quoteForms.textContent = formatCurrency(quote.breakdown.forms);
      if (quoteAddons) quoteAddons.textContent = formatCurrency(quote.breakdown.blog + quote.breakdown.ecommerce);
      if (quoteTier) quoteTier.textContent = quote.tier;
    }

    [budgetInput, pagesInput, formsInput, blogInput, ecommerceInput, timelineInput, designInput].forEach((input) => {
      input?.addEventListener('input', updateCalculator);
      input?.addEventListener('change', updateCalculator);
    });

    updateCalculator();

    let currentInvestment = 998;

    window.setInvestment = (value) => {
      currentInvestment = value;
      
      // Update UI buttons
      document.querySelectorAll('.investment-btn').forEach(btn => {
        if (parseInt(btn.getAttribute('data-value')) === value) {
          btn.classList.add('active-investment');
        } else {
          btn.classList.remove('active-investment');
        }
      });
      
      calculateROI();
    };

    function calculateROI() {
      const avgValue = parseFloat(document.getElementById('avgValue').value) || 0;
      const leads = parseInt(document.getElementById('newLeads').value);
      
      // Update label
      document.getElementById('leadsValue').innerText = `${leads} Lead${leads > 1 ? 's' : ''}`;
      
      const yearlyLeads = leads * 12;
      const conversionRate = 0.25; // Conservative estimate: 25% of leads become paying customers
      const customersPerYear = yearlyLeads * conversionRate;
      const grossRevenue = customersPerYear * avgValue;
      const netReturn = grossRevenue - currentInvestment;
      const roi = currentInvestment > 0 ? (netReturn / currentInvestment) * 100 : 0;
      const monthlyRevenue = grossRevenue / 12;
      const monthsToPayback = monthlyRevenue > 0 ? currentInvestment / monthlyRevenue : Infinity;
      
      // Update DOM
      document.getElementById('totalReturn').innerText = `$${grossRevenue.toLocaleString()}`;
      document.getElementById('roiPercentage').innerText = `${Math.max(0, roi).toLocaleString(undefined, { maximumFractionDigits: 0 })}% ROI`;
      document.getElementById('grossRevenue').innerText = `$${grossRevenue.toLocaleString()}`;
      
      const paybackEl = document.getElementById('paybackPeriod');
      if (monthsToPayback < 1) {
        paybackEl.innerText = '< 1 Month';
        paybackEl.className = 'text-brand-accent font-bold';
      } else {
        paybackEl.innerText = `${monthsToPayback.toFixed(1)} Months`;
        paybackEl.className = 'text-white font-bold';
      }
    }

    // Initialize observers
    document.addEventListener('DOMContentLoaded', () => {
      const avgInput = document.getElementById('avgValue');
      const leadsInput = document.getElementById('newLeads');
      
      if (avgInput) avgInput.addEventListener('input', calculateROI);
      if (leadsInput) leadsInput.addEventListener('input', calculateROI);

      // Initial calculation
      calculateROI();
    });
  </script>

</BaseLayout>

<script>
  // FAQ Accordion Toggle
  document.addEventListener('DOMContentLoaded', () => {
    const faqItems = document.querySelectorAll('.faq-item');

    faqItems.forEach(item => {
      const question = item.querySelector('.faq-question') as HTMLElement | null;
      const answer = item.querySelector('.faq-answer') as HTMLElement | null;
      const icon = item.querySelector('.faq-icon') as HTMLElement | null;

      if (!question || !answer || !icon) return;

      question.addEventListener('click', () => {
        const isOpen = item.classList.contains('active');

        // Close all FAQ items
        faqItems.forEach(otherItem => {
          otherItem.classList.remove('active');
          const otherQuestion = otherItem.querySelector('.faq-question') as HTMLElement | null;
          const otherAnswer = otherItem.querySelector('.faq-answer') as HTMLElement | null;
          const otherIcon = otherItem.querySelector('.faq-icon') as HTMLElement | null;
          if (otherQuestion) otherQuestion.setAttribute('aria-expanded', 'false');
          if (otherAnswer) otherAnswer.style.maxHeight = '0';
          if (otherIcon) {
            otherIcon.textContent = '+';
            otherIcon.style.transform = 'rotate(0deg)';
          }
        });

        // If it was closed, open it
        if (!isOpen) {
          item.classList.add('active');
          question.setAttribute('aria-expanded', 'true');
          answer.style.maxHeight = answer.scrollHeight + 'px';
          icon.textContent = '−';
          icon.style.transform = 'rotate(180deg)';
        }
      });
    });
  });
</script>
