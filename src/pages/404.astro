---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  bgVariant="blue"
  title="Page Not Found"
  description="The page you're looking for doesn't exist. Let's get you back on track with our services."
>
  <!-- 404 Hero Section -->
  <section class="py-24 lg:py-32 px-4 flex items-center justify-center min-h-[calc(100vh-8rem)] relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_50%_35%,rgba(59,130,246,0.18),transparent_55%),radial-gradient(circle_at_80%_80%,rgba(132,204,22,0.08),transparent_40%)]"></div>
    <div class="max-w-4xl mx-auto text-center relative z-10 rounded-3xl border border-white/10 bg-white/[0.04] backdrop-blur-md p-8 md:p-12 shadow-2xl">
      <div class="mb-8">
        <h1 class="font-heading text-8xl md:text-9xl font-black bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] bg-clip-text text-transparent mb-4 tracking-tight">
          404
        </h1>
        <p class="text-brand-accent text-sm uppercase tracking-widest mb-4">✦ Oops!</p>
      </div>
      
      <h2 class="font-heading text-5xl md:text-6xl font-bold text-white mb-6 leading-tight">
        Page <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-blue-light to-brand-accent">Not Found</span>
      </h2>
      
      <p class="text-xl text-white mb-10 max-w-2xl mx-auto">
        Looks like this page has vanished into the digital void. Don't worry — let us help you find what you're looking for.
      </p>

      <!-- Navigation Options -->
      <div class="grid md:grid-cols-3 gap-6 mb-12 max-w-2xl mx-auto">
        <a 
          href="/"
          class="group relative p-6 bg-white/[0.04] rounded-2xl border border-white/10 hover:border-brand-accent/40 hover:bg-white/[0.07] transition-all duration-300"
        >
          <div class="text-brand-accent mb-2 text-2xl">🏠</div>
          <h3 class="font-heading text-white font-bold mb-2 group-hover:text-brand-accent transition-colors">Back Home</h3>
          <p class="text-sm text-white/90">Return to the homepage</p>
        </a>

        <a 
          href="/services/web-design/"
          class="group relative p-6 bg-white/[0.04] rounded-2xl border border-white/10 hover:border-brand-accent/40 hover:bg-white/[0.07] transition-all duration-300"
        >
          <div class="text-brand-accent mb-2 text-2xl">✨</div>
          <h3 class="font-heading text-white font-bold mb-2 group-hover:text-brand-accent transition-colors">Our Services</h3>
          <p class="text-sm text-white/90">See what we offer</p>
        </a>

        <a 
          href="/contact/"
          class="group relative p-6 bg-white/[0.04] rounded-2xl border border-white/10 hover:border-brand-accent/40 hover:bg-white/[0.07] transition-all duration-300"
        >
          <div class="text-brand-accent mb-2 text-2xl">💬</div>
          <h3 class="font-heading text-white font-bold mb-2 group-hover:text-brand-accent transition-colors">Get in Touch</h3>
          <p class="text-sm text-white/90">Let's talk about your project</p>
        </a>
      </div>

      <!-- CTA Button -->
      <a 
        href="/contact/"
        class="cta-glow-shine inline-block bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-10 py-4 rounded-xl font-bold border border-white/20 shadow-[0_4px_14px_rgba(0,0,0,0.4),0_2px_8px_rgba(132,204,22,0.35)] hover:-translate-y-[1px] transition-all duration-300 text-lg"
      >
        Start Your Project Today
      </a>

      <!-- Additional Help -->
      <div class="mt-12 pt-8 border-t border-white/10">
        <p class="text-white mb-4">Still need help? Reach out to us:</p>
        <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
          <a 
            href="tel:+17044738188"
            class="text-brand-accent hover:text-white transition-colors font-medium"
          >
            (704) 473-8188
          </a>
          <span class="text-brand-sky/60">•</span>
          <a 
            href="mailto:dave@shelbywebco.com"
            class="text-brand-accent hover:text-white transition-colors font-medium"
          >
            dave@shelbywebco.com
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
