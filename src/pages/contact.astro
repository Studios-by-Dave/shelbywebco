---
import BaseLayout from '../layouts/BaseLayout.astro';
import Image from '../components/OptimizedImage.astro';
import businessCard from '../../assets/about/Sweb_bcard_1.png';
---

<BaseLayout 
  title="Contact Us"
  description="Get in touch with Shelby Web Company. Call us at (704) 473-8188 or email shelbywebco@gmail.com. Free consultations for web design, development, and digital marketing services in Shelby, NC."
>

  <!-- Hero Section -->
  <section class="py-20 lg:py-32 px-4" data-animate>
    <div class="max-w-7xl mx-auto">
      <div class="w-full">
        <div class="w-full max-w-4xl mx-auto space-y-6">
          <div class="text-center mb-8">
            <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ Get In Touch</p>
            <h1 class="font-heading text-6xl md:text-7xl font-bold text-white mb-6 leading-tight">
              Contact Us
            </h1>
          </div>

          <div class="relative group max-w-3xl mx-auto">
            <div class="absolute -inset-1 bg-gradient-to-r from-brand-accent to-brand-cyan rounded-3xl blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
            <div class="relative bg-brand-darkest border border-white/10 rounded-3xl overflow-hidden shadow-2xl">
              <Image
                src={businessCard}
                alt="Shelby Web Co Business Card"
                class="w-full h-auto object-cover transform transition duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-darkest/80 via-transparent to-transparent opacity-60"></div>
            </div>
          </div>

          <p class="text-center text-red-400 text-sm uppercase tracking-widest font-semibold mb-3">Hit the Button!</p>

          <!-- Phone Button -->
          <a 
            href="tel:+17044738188"
            class="cta-glow-shine group block max-w-lg mx-auto bg-brand-accent hover:bg-brand-accent-light p-6 rounded-[30px] transform hover:scale-[1.02]"
          >
            <div class="flex flex-col items-center text-center">
              <div class="flex items-center gap-2 mb-2 text-[#0A0A0A]/80">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span class="font-bold uppercase tracking-widest text-sm">Call or Text Anytime</span>
              </div>
              <span class="font-heading text-3xl md:text-5xl font-black text-[#0A0A0A] mb-3">(704) 473-8188</span>
              <div class="bg-black/10 px-4 py-1 rounded-full">
                <p class="text-[#0A0A0A] text-[10px] md:text-xs font-bold uppercase tracking-tighter">
                  Available 24/7 • If no immediate response 12-24 hr response guaranteed
                </p>
              </div>
            </div>
          </a>

          <!-- Email Button -->
          <a 
            href="mailto:shelbywebco@gmail.com"
            class="cta-glow-shine group block max-w-lg mx-auto bg-brand-accent hover:bg-brand-accent-light p-6 rounded-[30px] transform hover:scale-[1.02]"
          >
            <div class="flex flex-col items-center text-center">
              <div class="flex items-center gap-2 mb-2 text-[#0A0A0A]/80">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <span class="font-bold uppercase tracking-widest text-sm">Send an Email</span>
              </div>
              <span class="font-heading text-2xl md:text-3xl font-black text-[#0A0A0A] mb-3 break-all">shelbywebco@gmail.com</span>
              <div class="bg-black/10 px-4 py-1 rounded-full">
                <p class="text-[#0A0A0A] text-[10px] md:text-xs font-bold uppercase tracking-tighter">
                  If no immediate response 12-24 hr response guaranteed
                </p>
              </div>
            </div>
          </a>

          <div class="relative flex items-center justify-center my-12">
            <div class="absolute inset-x-0 h-px bg-brand-sky/20"></div>
            <span class="relative bg-brand-darkest px-6 text-brand-sky/60 font-bold uppercase tracking-[0.2em] text-sm">Or</span>
          </div>

          <div class="max-w-xl mx-auto w-full space-y-6">
            <div class="bg-brand-darkest border border-brand-sky/20 rounded-2xl p-8 shadow-2xl relative overflow-hidden group">
              <div class="absolute -top-24 -right-24 w-48 h-48 bg-brand-accent/5 rounded-full blur-3xl group-hover:bg-brand-accent/10 transition-colors"></div>
              <h3 class="font-heading text-xl md:text-2xl font-bold text-white mb-6 flex items-center gap-3">
                <span class="w-8 h-px bg-brand-accent"></span>
                Send Us a Message - We'd Love to Hear From You!
              </h3>
              <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-5">
                <input type="hidden" name="access_key" value="6c43f496-301c-46c2-afe8-743b55e17bb6" />
                <div>
                  <label for="name" class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-widest">Full Name</label>
                  <input type="text" name="name" id="name" required placeholder="John Doe" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder:text-gray-400 text-base focus:outline-none focus:border-brand-accent transition-all focus:ring-1 focus:ring-brand-accent/20" />
                </div>

                <div>
                  <label for="email" class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-widest">Email Address</label>
                  <input type="email" name="email" id="email" required placeholder="john@example.com" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder:text-gray-400 text-base focus:outline-none focus:border-brand-accent transition-all focus:ring-1 focus:ring-brand-accent/20" />
                </div>

                <div>
                  <label for="message" class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-widest">Project Details</label>
                  <textarea name="message" id="message" rows="4" required placeholder="Tell us about your vision..." class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder:text-gray-400 text-base focus:outline-none focus:border-brand-accent transition-all focus:ring-1 focus:ring-brand-accent/20 resize-none"></textarea>
                </div>

                <input type="checkbox" name="botcheck" class="hidden" style="display: none;">
                <input type="hidden" name="subject" value="New Contact Form Submission from Shelby Web Co" />
                <div id="form-status" class="min-h-6 text-sm text-brand-sky/70"></div>

                <button type="submit" class="w-full bg-brand-accent hover:bg-brand-accent-light text-brand-darkest font-black py-4 rounded-xl uppercase tracking-[0.2em] text-sm transition-all duration-300 active:scale-95">
                  Send / Launch
                </button>
              </form>
            </div>

            <div class="rounded-3xl border border-brand-cyan/20 bg-brand-darkest/80 p-8">
              <p class="text-brand-sky/80 text-sm uppercase tracking-widest mb-3">Client Reviews</p>
              <div class="space-y-4">
                <div class="rounded-2xl border border-white/10 bg-brand-dark/70 p-5">
                  <div class="flex items-center gap-1 mb-3">
                    <span class="text-yellow-300 text-xl">★</span><span class="text-yellow-300 text-xl">★</span><span class="text-yellow-300 text-xl">★</span><span class="text-yellow-300 text-xl">★</span><span class="text-yellow-300 text-xl">★</span>
                  </div>
                  <p class="text-white text-lg italic mb-3">"The BEST experience!!"</p>
                  <p class="text-brand-cyan/60 uppercase tracking-widest text-xs">Michelle Bryan</p>
                </div>
              </div>
              <p class="text-brand-sky/70 text-sm mt-6">Our team is ready to deliver the same high-touch service for your Shelby business.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');

    if (!form || !status) return;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);

      status.textContent = 'Sending your message...';
      status.className = 'min-h-6 text-sm text-brand-sky/70';

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || 'Unable to send your message right now.');
        }

        status.textContent = result.message;
        status.className = 'min-h-6 text-sm text-brand-accent';
        form.reset();
      } catch (error) {
        const message = error instanceof Error ? error.message : 'Unable to send your message right now.';
        status.textContent = message;
        status.className = 'min-h-6 text-sm text-red-400';
      }
    });
  });
</script>
