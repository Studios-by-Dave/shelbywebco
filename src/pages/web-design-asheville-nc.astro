---
import BaseLayout from '../layouts/BaseLayout.astro';
import Image from '../components/OptimizedImage.astro';
import ashHead from '../../assets/service locations/asheville/Asheville nc_header1.jpg';
import ash2 from '../../assets/service locations/asheville/Asheville nc_2.jpeg';
import ash5 from '../../assets/service locations/asheville/Asheville nc_5.jpg';
import ash6 from '../../assets/service locations/asheville/asheville nc_6.jpeg';
import ash7 from '../../assets/service locations/asheville/Asheville_6.jpeg';

const faqItems = [
  {
    question: 'How much does web design cost in Asheville, NC?',
    answer: 'Asheville-area custom web design runs from $598 for a starter site up to $3,998 for a full-scale build. Most growing businesses land in the $998\u2013$1,998 range (average ~$1,298), with local SEO and lead-focused features built in. Every project is quoted transparently \u2014 no hidden fees, no surprise add-ons.'
  },
  {
    question: 'How long does it take to design and launch a website in Asheville?',
    answer: 'Most Asheville web design projects launch in 2\u20134 weeks. A simple 1\u20132 page site can be ready in 1\u20132 weeks, while complex builds (e-commerce, custom portals) typically take 4\u20136 weeks. We\u2019ll give you a clear timeline during the proposal phase.'
  },
  {
    question: 'Do you offer SEO for existing Asheville websites, or only new builds?',
    answer: 'Both. We can optimize a site we built for you \u2014 or rescue an existing site that\u2019s underperforming in Asheville search results.'
  },
  {
    question: 'What makes Shelby Web Company different from other Asheville web design companies?',
    answer: 'We combine custom design, local SEO, and a long-term partnership approach \u2014 built for mountain businesses that want to own their local market.'
  },
  {
    question: 'Do you serve businesses outside downtown Asheville?',
    answer: 'Yes \u2014 we serve Asheville businesses remotely from our Shelby, NC base, so we work with companies across Buncombe County and all of Western NC, including Hendersonville, Weaverville, Black Mountain, Waynesville, and Brevard.'
  },
  {
    question: 'How quickly will I see results from Asheville local SEO?',
    answer: 'Most clients see meaningful movement in local rankings within 60\u201390 days, with compounding growth ongoing.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqItems.map(item => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer
    }
  }))
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'serviceType': 'Web Design & Local SEO',
  'provider': {
    '@type': 'ProfessionalService',
    'name': 'Shelby Web Company',
    'url': 'https://www.shelbywebco.com',
    'telephone': '(704) 473-8188'
  },
  'areaServed': [
    { '@type': 'City', 'name': 'Asheville' },
    { '@type': 'City', 'name': 'Hendersonville' },
    { '@type': 'City', 'name': 'Black Mountain' },
    { '@type': 'City', 'name': 'Weaverville' },
    { '@type': 'City', 'name': 'Waynesville' },
    { '@type': 'City', 'name': 'Brevard' },
    { '@type': 'AdministrativeArea', 'name': 'Buncombe County' },
    { '@type': 'AdministrativeArea', 'name': 'Western North Carolina' }
  ]
};
---

<BaseLayout 
  title="Asheville Web Design & SEO"
  description="Local web design & SEO in Asheville, NC. Shelby Web Company builds fast, high-converting websites that rank page one locally. Free strategy session."
>

  <script is:inline set:html={JSON.stringify(faqSchema)} type="application/ld+json"></script>
  <script is:inline set:html={JSON.stringify(serviceSchema)} type="application/ld+json"></script>

  <!-- Hero Section -->
  <section class="py-24 lg:py-32 px-4 relative overflow-hidden" data-animate>
    <div class="hero-background-image absolute inset-0 z-0 opacity-40">
      <Image src={ashHead} alt="Asheville, NC Background" class="w-full h-full object-cover" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0A]/65 via-[#0A0A0A]/70 to-[#0A0A0A] z-0"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(0,180,216,0.1),transparent_50%)] z-0"></div>
    
    <div class="max-w-5xl mx-auto text-center relative z-10">
      <div class="inline-block px-4 py-1.5 mb-6 rounded-full border border-brand-glow/30 bg-brand-glow/5 text-brand-glow text-sm font-bold uppercase tracking-[0.2em]">
        ✦ Local Growth for Asheville Businesses
      </div>
      <h1 class="font-heading text-6xl md:text-8xl font-black text-white mb-8 tracking-tight leading-[0.9]">
        Elevating Mountain Brands <br /><span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-cyan to-brand-blue">Across Asheville.</span>
      </h1>
      <p class="text-xl md:text-2xl text-brand-sky/80 mb-10 max-w-3xl mx-auto leading-relaxed">
        From downtown to the Blue Ridge valleys, we specialize in high-performance <span class="text-white font-bold">Asheville web design</span> and local SEO campaigns tailored for <span class="text-white font-bold">local impact</span>.
      </p>
      <div class="flex flex-col sm:flex-row gap-5 justify-center">
        <a 
          href="/contact/"
          class="group relative inline-flex items-center justify-center bg-brand-accent text-[#0A0A0A] px-10 py-4 rounded-xl font-bold text-lg hover:bg-brand-accent-light transition-all duration-300 shadow-[0_0_20px_rgba(132,204,22,0.4)] overflow-hidden"
        >
          <span class="relative z-10">Get Your Free Strategy Session</span>
          <div class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[0%] bg-white/20 transition-transform duration-300"></div>
        </a>
      </div>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="py-24 px-4 bg-brand-darkest border-y border-white/5">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl">
        <p class="text-brand-cyan text-sm uppercase tracking-widest mb-4">✦ Asheville Web Design & Local SEO</p>
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6 leading-tight">
          Asheville Web Design Built for <span class="text-brand-cyan">Local Growth</span>
        </h2>
      </div>
      <div class="grid lg:grid-cols-2 gap-10">
        <div class="space-y-5 text-brand-sky/70 leading-relaxed text-lg">
          <p>
            Your website is your hardest-working salesperson — and in Asheville, it has to compete for attention every single day. Shelby Web Company designs custom websites for Asheville businesses that are fast, mobile-first, and built to convert visitors into paying customers. We pair every site with strategic local SEO so that when someone searches <span class="text-white font-semibold">"web design Asheville"</span> or <span class="text-white font-semibold">"website design Asheville NC,"</span> your business is the one they find.
          </p>
          <p>
            Based in the heart of Western NC and serving Asheville remotely, we understand the mountain market: the tourism traffic, the seasonal ebb and flow, and the customers who expect a personal, trustworthy online experience before they pick up the phone. You get a dedicated North Carolina team — without big-city agency overhead.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <Image src={ash6} alt="Asheville web design projects" class="rounded-2xl shadow-2xl aspect-square object-cover" />
          <Image src={ash5} alt="Asheville local business web design" class="rounded-2xl shadow-2xl aspect-square object-cover mt-8" />
        </div>
      </div>
    </div>
  </section>

  <!-- Problem/Solution Section -->
  <section class="py-24 px-4 bg-brand-darkest border-y border-white/5">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-8 leading-tight">
          Is Your Asheville Presence <span class="text-brand-cyan">Falling Behind?</span>
        </h2>
        <div class="space-y-6">
          <div class="flex gap-4">
            <div class="shrink-0 w-9 h-9 mt-0.5 bg-white rounded-md flex items-center justify-center text-red-600 shadow-[0_4px_12px_rgba(255,255,255,0.25)]">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3.5" d="M6 18L18 6M6 6l12 12"></path></svg>
            </div>
            <p class="text-brand-sky/70"><span class="text-white font-semibold">Spending too much on directory leads?</span> Break free from shared platforms and start generating your own exclusive inquiries.</p>
          </div>
          <div class="flex gap-4">
            <div class="shrink-0 w-9 h-9 mt-0.5 bg-white rounded-md flex items-center justify-center text-red-600 shadow-[0_4px_12px_rgba(255,255,255,0.25)]">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3.5" d="M6 18L18 6M6 6l12 12"></path></svg>
            </div>
            <p class="text-brand-sky/70"><span class="text-white font-semibold">Missing from local map searches?</span> When Asheville customers look for services nearby, your business needs to appear at the absolute top.</p>
          </div>
          <div class="flex gap-4">
            <div class="shrink-0 w-9 h-9 mt-0.5 bg-white rounded-md flex items-center justify-center text-red-600 shadow-[0_4px_12px_rgba(255,255,255,0.25)]">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3.5" d="M6 18L18 6M6 6l12 12"></path></svg>
            </div>
            <p class="text-brand-sky/70"><span class="text-white font-semibold">Outdated digital storefront?</span> A clunky, slow website makes it harder for customers to trust your brand before they even reach out.</p>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <Image src={ash2} alt="Asheville business district" class="rounded-2xl shadow-2xl aspect-square object-cover" />
        <Image src={ash7} alt="Local results in Asheville" class="rounded-2xl shadow-2xl aspect-square object-cover mt-8" />
      </div>
    </div>
  </section>

  <!-- Web Design Services -->
  <section class="py-24 px-4 relative overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-brand-cyan text-sm uppercase tracking-widest mb-4">✦ Web Design Asheville</p>
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">Custom Strategies for <span class="text-brand-cyan">Asheville Businesses</span></h2>
        <p class="text-brand-sky/70 max-w-2xl mx-auto text-lg">
          From brand-new launches to full redesigns, our Asheville web design process is built around one outcome: websites that rank, convert, and keep working.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 mb-16">
        <div class="relative group bg-brand-dark p-8 rounded-2xl border border-white/5 hover:border-brand-cyan/40 transition-colors">
          <div class="absolute top-4 right-4 w-9 h-9 bg-brand-accent rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500 shadow-[0_0_12px_rgba(132,204,22,0.5)]">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5 text-[#0A0A0A]">
              <path class="check-draw" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Modern, High-Converting Website Design in Asheville</h3>
          <p class="text-brand-sky/70 leading-relaxed">We design streamlined, fast-loading websites for Asheville businesses that elevate your brand's perceived value from the first click. Every layout is mobile-responsive and optimized for the way Asheville customers actually browse — often from their phones.</p>
        </div>
        <div class="relative group bg-brand-dark p-8 rounded-2xl border border-white/5 hover:border-brand-cyan/40 transition-colors">
          <div class="absolute top-4 right-4 w-9 h-9 bg-brand-accent rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500 shadow-[0_0_12px_rgba(132,204,22,0.5)]">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5 text-[#0A0A0A]">
              <path class="check-draw" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">SEO-First Foundation</h3>
          <p class="text-brand-sky/70 leading-relaxed">Your site is built on a clean, crawlable technical foundation from day one — fast core web vitals, proper schema, and keyword-mapped pages. That's how "web design Asheville NC" searches convert into ranked pages, not just pretty graphics.</p>
        </div>
        <div class="relative group bg-brand-dark p-8 rounded-2xl border border-white/5 hover:border-brand-cyan/40 transition-colors">
          <div class="absolute top-4 right-4 w-9 h-9 bg-brand-accent rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500 shadow-[0_0_12px_rgba(132,204,22,0.5)]">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5 text-[#0A0A0A]">
              <path class="check-draw" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Local SEO That Puts You on the Map</h3>
          <p class="text-brand-sky/70 leading-relaxed">We align your Google Business Profile, directories, and citations so you win the Asheville map pack for "seo company asheville" and "asheville seo" style searches — the visible, local-intent traffic that actually books appointments.</p>
        </div>
        <div class="relative group bg-brand-dark p-8 rounded-2xl border border-white/5 hover:border-brand-cyan/40 transition-colors">
          <div class="absolute top-4 right-4 w-9 h-9 bg-brand-accent rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500 shadow-[0_0_12px_rgba(132,204,22,0.5)]">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5 text-[#0A0A0A]">
              <path class="check-draw" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Ongoing Partnerships, Not Throwaway Projects</h3>
          <p class="text-brand-sky/70 leading-relaxed">As Asheville's digital landscape evolves, we continually refine your site and campaigns to keep your operations scaling — long-term partners for sustainable, compounding growth.</p>
        </div>
      </div>

      <div class="text-center">
        <a href="/services/web-design/" class="inline-block text-brand-cyan font-bold hover:text-white transition-colors">Explore our full Asheville web design services →</a>
      </div>
    </div>
  </section>

  <!-- SEO Services -->
  <section class="py-24 px-4 bg-brand-darkest border-y border-white/5">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-brand-cyan text-sm uppercase tracking-widest mb-4">✦ Asheville SEO</p>
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">Asheville SEO Services That Rank on <span class="text-brand-blue">Page One</span></h2>
      </div>

      <div class="max-w-3xl mx-auto mb-14">
        <p class="text-brand-sky/70 leading-relaxed text-lg">
          Ranking on page one for "asheville seo" searches means showing up where buyers already are. Shelby Web Company is an Asheville SEO company focused on one result: putting your business in front of local customers at the exact moment they're ready to buy. If you've searched "SEO company Asheville NC" or "asheville SEO company" and found competitors ahead of you, we can fix that.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 mb-16">
        <div class="relative group bg-brand-dark p-8 rounded-2xl border border-white/5 hover:border-brand-blue/40 transition-colors">
          <div class="absolute top-4 right-4 w-9 h-9 bg-brand-accent rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500 shadow-[0_0_12px_rgba(132,204,22,0.5)]">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5 text-[#0A0A0A]">
              <path class="check-draw" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Local SEO & Map Pack Dominance</h3>
          <p class="text-brand-sky/70 leading-relaxed">We optimize your Google Business Profile, local citations, and on-page signals so your business wins the Asheville map pack — the visible, high-intent slot locals actually click.</p>
        </div>
        <div class="relative group bg-brand-dark p-8 rounded-2xl border border-white/5 hover:border-brand-blue/40 transition-colors">
          <div class="absolute top-4 right-4 w-9 h-9 bg-brand-accent rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500 shadow-[0_0_12px_rgba(132,204,22,0.5)]">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5 text-[#0A0A0A]">
              <path class="check-draw" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Content & Keyword Strategy</h3>
          <p class="text-brand-sky/70 leading-relaxed">We map every keyword from "asheville web design" to "seo company asheville nc" onto pages built to rank — then create content that answers exactly what Asheville searchers ask.</p>
        </div>
        <div class="relative group bg-brand-dark p-8 rounded-2xl border border-white/5 hover:border-brand-blue/40 transition-colors">
          <div class="absolute top-4 right-4 w-9 h-9 bg-brand-accent rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500 shadow-[0_0_12px_rgba(132,204,22,0.5)]">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5 text-[#0A0A0A]">
              <path class="check-draw" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Technical SEO & Site Speed</h3>
          <p class="text-brand-sky/70 leading-relaxed">Fast core web vitals, clean schema, crawlable architecture. Your Asheville site loads in a blink and Google can read every page — the foundation every ranking needs.</p>
        </div>
        <div class="relative group bg-brand-dark p-8 rounded-2xl border border-white/5 hover:border-brand-blue/40 transition-colors">
          <div class="absolute top-4 right-4 w-9 h-9 bg-brand-accent rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-500 shadow-[0_0_12px_rgba(132,204,22,0.5)]">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5 text-[#0A0A0A]">
              <path class="check-draw" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Conversion-Focused Optimization</h3>
          <p class="text-brand-sky/70 leading-relaxed">Ranking is only step one. We optimize every page to turn Asheville searchers into calls, form fills, and booked appointments.</p>
        </div>
      </div>

      <div class="text-center">
        <a href="/services/seo/" class="inline-block text-brand-cyan font-bold hover:text-white transition-colors">See all Asheville SEO services →</a>
      </div>
    </div>
  </section>

  <!-- The Local Advantage (Social Proof) -->
  <section class="py-24 px-4 relative overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">Rooted in Western NC.</h2>
        <p class="text-brand-sky/70 max-w-2xl mx-auto text-lg">
          We don't just serve Asheville — we understand it. Based in Shelby, NC and collaborating with Asheville businesses remotely, our Western NC roots mean campaigns that genuinely connect. From downtown's arts district to the Blue Ridge valleys, we know the local market dynamics: what draws in visitors, what keeps locals coming back, and how to position your brand as the trusted choice across Buncombe County.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        <Image src={ash6} alt="Asheville Projects" class="rounded-xl object-cover h-64 w-full shadow-lg" />
        <Image src={ash5} alt="Asheville local commerce" class="rounded-xl object-cover h-64 w-full shadow-lg" />
        <Image src={ashHead} alt="Western NC business growth" class="rounded-xl object-cover h-64 w-full shadow-lg" />
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5">
          <div class="text-brand-accent text-4xl font-black mb-2">100%</div>
          <div class="text-white font-bold text-lg mb-2">Visibility Focus</div>
          <p class="text-brand-sky/60 text-sm">We optimize site infrastructure so local customers find you immediately.</p>
        </div>
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5">
          <div class="text-brand-cyan text-4xl font-black mb-2">Steady</div>
          <div class="text-white font-bold text-lg mb-2">Lead Generation</div>
          <p class="text-brand-sky/60 text-sm">Our modern layouts keep bounce rates low and conversions flowing consistently.</p>
        </div>
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5">
          <div class="text-brand-blue text-4xl font-black mb-2">Local</div>
          <div class="text-white font-bold text-lg mb-2">Search Authority</div>
          <p class="text-brand-sky/60 text-sm">We ensure directories and maps properly align to establish regional trust.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-24 px-4 bg-brand-darkest border-y border-white/5">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-brand-cyan text-sm uppercase tracking-widest mb-4">✦ How We Work</p>
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">Our Asheville Web Design & SEO <span class="text-brand-cyan">Process</span></h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5">
          <div class="text-brand-cyan text-5xl font-black mb-4">1</div>
          <h3 class="text-xl font-bold text-white mb-3">Strategy Session</h3>
          <p class="text-brand-sky/70 text-sm">We map your goals, market, and competition — then build a custom plan around your Asheville customers.</p>
        </div>
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5">
          <div class="text-brand-cyan text-5xl font-black mb-4">2</div>
          <h3 class="text-xl font-bold text-white mb-3">Design & Build</h3>
          <p class="text-brand-sky/70 text-sm">Custom, on-brand, conversion-focused design with SEO baked into the foundation from day one.</p>
        </div>
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5">
          <div class="text-brand-cyan text-5xl font-black mb-4">3</div>
          <h3 class="text-xl font-bold text-white mb-3">Launch & Optimize</h3>
          <p class="text-brand-sky/70 text-sm">Go live with clean technical SEO, fast load times, and everything aligned to start ranking.</p>
        </div>
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5">
          <div class="text-brand-cyan text-5xl font-black mb-4">4</div>
          <h3 class="text-xl font-bold text-white mb-3">Grow</h3>
          <p class="text-brand-sky/70 text-sm">Ongoing local SEO that compounds month over month — keeping you at the top of Asheville search.</p>
