---
import BaseLayout from '../layouts/BaseLayout.astro';
import Image from '../components/OptimizedImage.astro';
import remodelers1 from '../../assets/industry pages/remodelers_1.webp';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'serviceType': 'Websites & SEO for Kitchen and Bath Remodelers and Remodeling Contractors',
  'name': 'Websites & SEO for Home Remodelers and Contractors in Shelby, NC',
  'description': 'Websites and rescue for remodelers in Shelby and Western NC. Core setup $597; Plus $998–$1,498; Ultra $1,798–$2,498. Plans from $297/month.',
  'provider': {
    '@type': 'LocalBusiness',
    'name': 'Shelby Web Company',
    'url': 'https://www.shelbywebco.com',
    'telephone': '(704) 473-8188'
  },
  'areaServed': [
    { '@type': 'City', 'name': 'Shelby, NC' },
    { '@type': 'City', 'name': 'Gastonia, NC' },
    { '@type': 'City', 'name': 'Kings Mountain, NC' },
    { '@type': 'City', 'name': 'Forest City, NC' },
    { '@type': 'City', 'name': 'Boiling Springs, NC' },
    { '@type': 'City', 'name': 'Polkville, NC' }
  ],
  'url': 'https://www.shelbywebco.com/web-design-for-home-remodelers-shelby-nc/'
};

const faqItems = [
  {
    question: 'Why isn’t my remodeling website getting leads?',
    answer: 'Usually it isn’t being found, isn’t showing in the map results, or doesn’t give a homeowner a clear reason to call. The free audit tells you which before you spend anything.'
  },
  {
    question: 'Why am I not showing in the map pack for “kitchen remodeler near me”?',
    answer: 'Often the Google Business Profile is unclaimed, uses the wrong categories, or has too few recent reviews. We check the profile, categories, and location pages as part of the audit.'
  },
  {
    question: 'Do I need separate kitchen and bathroom remodeling pages?',
    answer: 'Yes, if you want to be found for both. One combined page splits the intent. Each service gets its own page, photos, and local targeting.'
  },
  {
    question: 'Should I show prices on my remodeling site?',
    answer: 'A typical project range plus a clear process usually helps. It answers the homeowner’s first question and filters out tire-kickers without committing you to a fixed quote.'
  },
  {
    question: 'Is SEO worth it, or should I just buy leads?',
    answer: 'Paid leads are faster but cost more each time and skew toward price-shoppers. Practitioners commonly estimate SEO takes about 3–6 months, but you own the channel and it keeps working. We don’t guarantee rankings or lead counts.'
  },
  {
    question: 'Who owns my website and Google Business Profile if I leave?',
    answer: 'You do. Your domain, content, and Google profile stay in your name. Files are handed over on request. We’re non-exclusive and month-to-month — cancel any time with 30 days’ written notice.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqItems.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': { '@type': 'Answer', 'text': item.answer }
  }))
};
---

<BaseLayout
  bgVariant="blue"
  title="Websites & SEO for Remodelers and Contractors | Shelby, NC"
  description="Websites and rescue for remodelers in Shelby and Cleveland County. Core setup $597; Plus $998–$1,498; Ultra $1,798–$2,498. Plans from $297/month."
>
  <script is:inline set:html={JSON.stringify(serviceSchema)} type="application/ld+json"></script>
  <script is:inline set:html={JSON.stringify(faqSchema)} type="application/ld+json"></script>

  <!-- Hero Section -->
  <section class="py-10 lg:py-16 px-4 relative overflow-hidden" data-animate>
    <div class="absolute inset-0 bg-gradient-to-b from-brand-dark via-brand-darkest to-brand-darkest z-0"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(0,180,216,0.12),transparent_55%)] z-0"></div>
    <div class="max-w-5xl mx-auto text-center relative z-10">
      <div class="inline-block px-4 py-1.5 mb-6 rounded-full border border-brand-accent/30 bg-brand-accent/20 text-brand-accent text-sm font-bold uppercase tracking-[0.2em] backdrop-blur-sm">
        ✦ Built for Remodelers &amp; Contractors
      </div>
      <h1 class="font-heading text-5xl md:text-7xl font-black text-white mb-6 tracking-tight leading-[0.9]">
        Websites for Remodelers That Get <span class="bg-clip-text text-transparent bg-gradient-to-r from-lime-400 to-lime-600">Found, Trusted</span> and Called.
      </h1>
      <p class="text-2xl md:text-3xl font-bold text-[#f4c95d] mb-3">Core setup: $597. Month-to-month.</p>
      <p class="text-lg md:text-xl text-white/80 mb-8 max-w-3xl mx-auto leading-relaxed">
        Kitchen and bath remodelers and remodeling contractors priced out of $1,500+/month agencies: we fix the site you have or build one that turns <span class="text-white font-bold">before &amp; after</span> into booked jobs across <span class="text-white font-bold">Shelby, Gastonia, Kings Mountain &amp; Forest City</span>. You own your site, your domain, and your Google profile.
      </p>
      <div class="flex flex-col sm:flex-row gap-5 justify-center">
<a
           href="/contact/"
           class="group relative inline-flex items-center justify-center cta-glow-shine bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-10 py-4 rounded-xl font-bold text-lg border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),inset_0_-2px_6px_rgba(0,0,0,0.25),0_4px_14px_rgba(0,0,0,0.4),0_2px_8px_rgba(132,204,22,0.35),0_0_20px_rgba(132,204,22,0.25)] hover:from-[#b5f146] hover:via-brand-accent-light hover:to-[#4d7c0f] hover:-translate-y-[1px] active:translate-y-[1px] active:shadow-[inset_0_2px_4px_rgba(0,0,0,0.3),0_2px_6px_rgba(0,0,0,0.3)] transition-all duration-300 overflow-hidden"
         >
           <span class="relative z-10">Get Your Free Quote</span>
           <div class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[0%] bg-white/20 transition-transform duration-300"></div>
         </a>
        <a
          href="tel:+17044738188"
          class="inline-flex items-center justify-center border border-brand-accent/40 text-brand-accent px-10 py-4 rounded-xl font-bold text-lg hover:bg-brand-accent/10 transition-all duration-300"
        >
          (704) 473-8188
        </a>
      </div>
    </div>
  </section>

  <!-- Recent Work Section -->
  <section class="py-24 px-4 bg-white/[0.04]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-brand-accent text-label uppercase tracking-widest mb-4">✦ Remodeling Work</p>
        <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-4">Sites Built to Book High-End Remodels</h2>
        <p class="text-white/70 max-w-2xl mx-auto">Portfolio galleries and project pages that show the quality of your finish work — and turn "kitchen remodel" searches into booked consultations.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        <a href="/contact/" class="group block bg-white/[0.03] border border-white/10 rounded-2xl overflow-hidden hover:border-brand-blue/40 transition-all duration-300">
          <div class="aspect-video overflow-hidden">
            <Image src={remodelers1} alt="Custom luxury kitchen remodel with wood cabinetry, quartz island, and professional range" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
          </div>
          <div class="p-6">
            <p class="text-brand-accent text-xs font-bold uppercase tracking-widest mb-2">Kitchens &amp; Whole-Home</p>
            <p class="text-white text-sm leading-relaxed">Before/after galleries, finish and material details, and per-project CTIs so high-ticket work gets the attention it needs.</p>
          </div>
        </a>
        <div class="bg-white/[0.03] border border-brand-blue/25 rounded-2xl flex flex-col items-center justify-center text-center p-8">
          <span class="text-brand-accent text-3xl mb-4" aria-hidden="true">✦</span>
          <p class="text-white font-bold text-lg mb-2">Your project here</p>
          <p class="text-white/70 text-sm mb-6">Get a free quote for a remodeling website built to win higher-value projects.</p>
          <a href="/contact/" class="cta-glow-shine inline-block bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-6 py-3 rounded-xl font-bold text-sm border border-white/20 hover:-translate-y-[1px] transition-all duration-300">Get Your Free Quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem / Solution Section -->
  <section class="py-24 px-4 border-y border-white/10">
    <div class="max-w-7xl mx-auto">
      <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-12 leading-tight text-center">
        Why Remodeling Companies Lose Jobs to <span class="text-brand-accent">Slow Websites</span>
      </h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white/[0.04] p-8 rounded-2xl border border-white/10">
          <div class="text-brand-accent text-4xl font-black mb-2">Found</div>
          <div class="text-white font-bold text-lg mb-2">Homeowners Judge Before They Visit</div>
          <p class="text-white/80 text-sm">A weak portfolio or a slow site means the next remodeler in the search results gets the call. We check whether Google can find you and whether your best work is visible.</p>
        </div>
        <div class="bg-white/[0.04] p-8 rounded-2xl border border-white/10">
          <div class="text-brand-accent text-4xl font-black mb-2">Hired</div>
          <div class="text-white font-bold text-lg mb-2">High-Ticket Projects Start With a Call</div>
          <p class="text-white/80 text-sm">A kitchen or bath project is a big decision. Your site has to make it easy to call, and your follow-up has to be fast. Industry sources report many home-service leads aren't answered within an hour.</p>
        </div>
        <div class="bg-white/[0.04] p-8 rounded-2xl border border-white/10">
          <div class="text-brand-blue text-4xl font-black mb-2">Trusted</div>
          <div class="text-white font-bold text-lg mb-2">The Map Pack Matters</div>
          <p class="text-white/80 text-sm">Remodel searches often start in the map results. We tune your Google Business Profile with portfolio photos, correct remodel categories, and steady reviews. We don't promise a rank.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What You Get Section -->
  <section class="py-24 px-4 bg-white/[0.04]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-14">
        <p class="text-brand-accent text-label uppercase tracking-widest mb-4">✦ Built for Home Remodelers</p>
        <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-4">A Remodeling Website That Works for You</h2>
        <p class="text-white/70 max-w-2xl mx-auto">Every remodel site ships with what homeowners judge you on — before/after galleries, estimates, and reviews.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-8">
          <h3 class="text-card-title font-bold text-brand-accent mb-3">Before/After Galleries</h3>
          <p class="text-white/80">Showcase your cleanest transformations in a fast-loading gallery — homeowners decide you're the one before the first walkthrough, with your portfolio doing the talking.</p>
        </div>
        <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-8">
          <h3 class="text-card-title font-bold text-brand-accent mb-3">Project Estimate Requests</h3>
          <p class="text-white/80">Room, budget, and timeline pickers that let homeowners request an estimate without leaving the page. Every form lands straight in your phone before the next call.</p>
        </div>
        <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-8">
          <h3 class="text-card-title font-bold text-brand-accent mb-3">Service Area Pages</h3>
          <p class="text-white/80">Dedicated pages like "Kitchen Remodel Shelby NC" that rank for the exact searches homeowners type before they hire — kitchen, bath, and addition intent.</p>
        </div>
        <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-8">
          <h3 class="text-card-title font-bold text-brand-accent mb-3">Reviews &amp; Map Pack Optimization</h3>
          <p class="text-white/80">Remodel decisions hinge on trust. We wire review requests and Google Business Profile signals together so glowing before-and-after stories land exactly where homeowners search.</p>
        </div>
        <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-8">
          <h3 class="text-card-title font-bold text-brand-accent mb-3">Licensing &amp; Trust Badges</h3>
          <p class="text-white/80">Licensed, insured, and warranty-backed — shown upfront. Homeowners won't hire the remodeler who hides the paperwork.</p>
        </div>
        <div class="bg-white/[0.03] border border-white/10 rounded-2xl p-8">
          <h3 class="text-card-title font-bold text-brand-accent mb-3">Local SEO Built In</h3>
          <p class="text-white/80">Every site ships with <a href="/services/seo/" class="text-brand-accent underline decoration-brand-accent/30">on-page SEO</a> aimed at high-intent remodel searches — kitchen, bath, and whole-home queries across Shelby, Gastonia, and beyond.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas / Proof Section -->
  <section class="py-24 px-4 bg-white/[0.03]">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-6">Trusted by Remodelers Across Western NC</h2>
          <p class="text-white/80 text-lg mb-8">Remodelers across Western NC use our sites to turn portfolio searches into booked consultations — from <a href="/web-design-shelby-nc/" class="text-brand-accent underline decoration-brand-accent/30">Shelby</a> and <a href="/web-design-gastonia-nc/" class="text-brand-accent underline decoration-brand-accent/30">Gastonia</a> to <a href="/web-design-kings-mountain-nc/" class="text-brand-accent underline decoration-brand-accent/30">Kings Mountain</a>, <a href="/web-design-forest-city-nc/" class="text-brand-accent underline decoration-brand-accent/30">Forest City</a>, <a href="/web-design-boiling-springs-nc/" class="text-brand-accent underline decoration-brand-accent/30">Boiling Springs</a>, and <a href="/web-design-polkville-nc/" class="text-brand-accent underline decoration-brand-accent/30">Polkville</a>.</p>
          <a href="/services/case-studies/" class="cta-glow-shine inline-block bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-8 py-4 rounded-xl font-bold border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),inset_0_-2px_6px_rgba(0,0,0,0.25),0_4px_14px_rgba(0,0,0,0.4),0_2px_8px_rgba(132,204,22,0.35),0_0_20px_rgba(132,204,22,0.25)] hover:from-[#b5f146] hover:via-brand-accent-light hover:to-[#4d7c0f] hover:-translate-y-[1px] active:translate-y-[1px] active:shadow-[inset_0_2px_4px_rgba(0,0,0,0.3),0_2px_6px_rgba(0,0,0,0.3)] transition-all duration-300">
            See Our Case Studies
          </a>
        </div>
        <div class="grid gap-4">
          <div class="bg-white/[0.04] p-6 rounded-2xl border border-white/10">
            <div class="text-brand-accent text-3xl font-black mb-1">5.0</div>
            <div class="text-white font-bold mb-1">Google Rating</div>
            <p class="text-white/70 text-sm">Local, direct service from Dave — not an account manager three states away.</p>
          </div>
          <div class="bg-white/[0.04] p-6 rounded-2xl border border-white/10">
            <div class="text-brand-accent text-3xl font-black mb-1">$597</div>
            <div class="text-white font-bold mb-1">Setup, one time</div>
            <p class="text-white/70 text-sm">New site or existing-site rescue. Scope confirmed after the audit.</p>
          </div>
          <div class="bg-white/[0.04] p-6 rounded-2xl border border-white/10">
            <div class="text-brand-blue text-3xl font-black mb-1">90 days</div>
            <div class="text-white font-bold mb-1">Milestone Audit</div>
            <p class="text-white/70 text-sm">We report, then tell you honestly if there's no meaningful work left. No endless retainer.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Remodeler FAQ -->
  <section class="py-20 px-4 border-t border-white/10" data-animate aria-labelledby="remodeler-faq-heading">
    <div class="max-w-4xl mx-auto">
      <p class="text-brand-accent text-label uppercase tracking-widest mb-4 text-center">✦ Common Questions</p>
      <h2 id="remodeler-faq-heading" class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-10 text-center">
        Straight Answers for Remodelers &amp; Contractors
      </h2>
      <div class="space-y-4">
        {faqItems.map((item) => (
          <details class="bg-white/[0.04] border border-white/10 rounded-2xl p-5 group">
            <summary class="cursor-pointer font-semibold text-white text-lg flex items-center justify-between gap-4 list-none marker:hidden">
              {item.question}
              <span class="text-brand-accent text-2xl leading-none transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="text-white/75 text-base leading-relaxed mt-4">{item.answer}</p>
          </details>
        ))}
      </div>
      <p class="text-center text-white/60 text-sm mt-8">
        Want a deeper look at your own site? <a href="/promotions/free-seo-audit/" class="text-brand-accent underline decoration-brand-accent/40 underline-offset-4 hover:text-brand-accent-light">Start with the free SEO audit →</a>
      </p>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-32 px-4 relative overflow-hidden bg-brand-accent/90" data-animate>
    <div class="max-w-4xl mx-auto text-center relative z-10 text-brand-darkest">
      <h2 class="font-heading text-5xl md:text-6xl font-black mb-8 leading-tight">
        Ready for a Remodeling Website <br />That Books the Consult?
      </h2>
      <p class="text-xl md:text-2xl font-medium mb-10 opacity-90 text-balance">
        Sit down for a free strategy call — no pressure, no upsells, just a straight plan for turning portfolio browsers into booked consultations.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/contact/"
          class="inline-block bg-white/[0.03] text-white px-10 py-4 rounded-xl font-black text-xl hover:scale-105 transition-all duration-300 shadow-2xl"
        >
          Book a Free Chat
        </a>
        <a
          href="tel:+17044738188"
          class="inline-block border-2 border-brand-darkest text-brand-darkest px-10 py-4 rounded-xl font-black text-xl hover:bg-white/[0.03] hover:text-white transition-all duration-300"
        >
          (704) 473-8188
        </a>
      </div>
    </div>
  </section>

</BaseLayout>