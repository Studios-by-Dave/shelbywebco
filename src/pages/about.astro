    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-12 relative z-10">
      <div class="md:w-1/2 text-center md:text-left">
        <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ About Us</p>
        <h1 class="font-heading text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight">
          About Us
