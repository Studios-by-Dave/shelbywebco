        <div class="group bg-gradient-to-br from-brand-dark to-brand-darkest border border-white/10 rounded-2xl p-8 hover:border-lime-500/50 hover:shadow-[0_20px_40px_rgba(132,204,22,0.2)] hover:-translate-y-2 transition-all duration-500 relative overflow-hidden">
