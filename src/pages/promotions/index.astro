---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PixieDust from '../../components/PixieDust.jsx';
---

<BaseLayout 
  title="Limited-Time Offers & Promotions"
  description='Check out our current promotions: Free Logo Design with web packages, Free SEO audits, unlimited $100 Referral Bonus program, and a Free Website for 5 select Asheville, NC small service businesses — a fully functioning front-end (up to 5 pages) you own outright. Hosting sold separately.'
>

  <!-- Hero Section -->
  <section class="py-14 lg:py-20 px-4" data-animate>
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ Limited-Time Offers</p>
      <div class="relative inline-block">
        <PixieDust client:load />
        <h1 class="font-heading text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-4 leading-tight">
          Exclusive <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-blue via-brand-cyan to-brand-sky">Promotions</span> for Your Business
        </h1>
      </div>
      <p class="text-xl text-brand-sky/80 mb-8">
        We're offering limited-time promotions to help your business grow. Explore what we have available right now.
      </p>
    </div>
  </section>

  <!-- Promotions Grid -->
  <section class="py-24 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Promo 1: Free Logo Design -->
        <a href="/promotions/free-logo-design/" class="group block bg-gradient-to-br from-brand-dark to-brand-darkest p-8 rounded-2xl border border-brand-blue/20 hover:border-lime-500/50 transition-all duration-300 hover:shadow-[0_0_30px_rgba(34,211,238,0.2)] cursor-pointer">
          <div class="w-14 h-14 bg-gradient-to-br from-lime-200 via-lime-400 to-lime-600 rounded-lg flex items-center justify-center mb-6 text-brand-darkest shadow-lg shadow-lime-500/30">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
          </div>
          <h3 class="text-3xl font-bold text-white group-hover:text-lime-400 transition-colors duration-300 mb-3">Free Logo Design</h3>
          <p class="text-brand-sky/70 mb-6 text-base">
            When you invest in a full web package with us, get a custom logo design completely free.
          </p>
          <div class="bg-brand-darkest/50 border border-brand-blue/20 rounded-lg p-4 mb-6">
            <p class="text-brand-cyan text-base font-bold mb-2">Includes:</p>
            <ul class="text-brand-sky/60 text-sm space-y-1">
              <li>✓ Custom logo concept</li>
              <li>✓ Multiple design options</li>
              <li>✓ Unlimited revisions</li>
              <li>✓ All file formats</li>
            </ul>
          </div>
          <span class="inline-block w-full text-center bg-white/10 backdrop-blur-md border border-white/20 text-brand-cyan-light px-6 py-3 rounded-lg font-bold group-hover:bg-white/20 group-hover:border-white/40 transition-all duration-300">
            Learn More
          </span>
        </a>

        <!-- Promo 2: Free SEO Audit -->
        <a href="/promotions/free-seo-audit/" class="group block bg-gradient-to-br from-brand-dark to-brand-darkest p-8 rounded-2xl border border-brand-blue/20 hover:border-lime-500/50 transition-all duration-300 hover:shadow-[0_0_30px_rgba(34,211,238,0.2)] cursor-pointer">
          <div class="w-14 h-14 bg-gradient-to-br from-lime-200 via-lime-400 to-lime-600 rounded-lg flex items-center justify-center mb-6 text-brand-darkest shadow-lg shadow-lime-500/30">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7"></path></svg>
          </div>
          <h3 class="text-3xl font-bold text-white group-hover:text-lime-400 transition-colors duration-300 mb-3">Free SEO Audit</h3>
          <p class="text-brand-sky/70 mb-6 text-base">
            Selected local businesses get a comprehensive SEO analysis to identify opportunities and fix critical issues.
          </p>
          <div class="bg-brand-darkest/50 border border-brand-blue/20 rounded-lg p-4 mb-6">
            <p class="text-brand-cyan text-base font-bold mb-2">You'll Receive:</p>
            <ul class="text-brand-sky/60 text-sm space-y-1">
              <li>✓ Technical SEO review</li>
              <li>✓ Keyword analysis</li>
              <li>✓ Competitive insights</li>
              <li>✓ Action plan</li>
            </ul>
          </div>
          <span class="inline-block w-full text-center bg-white/10 backdrop-blur-md border border-white/20 text-brand-cyan-light px-6 py-3 rounded-lg font-bold group-hover:bg-white/20 group-hover:border-white/40 transition-all duration-300">
            Learn More
          </span>
        </a>

        <!-- Promo 3: $100 Referral Bonus -->
        <a href="/promotions/referral-bonus/" class="group block bg-gradient-to-br from-brand-dark to-brand-darkest p-8 rounded-2xl border border-brand-blue/20 hover:border-lime-500/50 transition-all duration-300 hover:shadow-[0_0_30px_rgba(34,211,238,0.2)] cursor-pointer">
          <div class="w-14 h-14 bg-gradient-to-br from-lime-200 via-lime-400 to-lime-600 rounded-lg flex items-center justify-center mb-6 text-brand-darkest shadow-lg shadow-lime-500/30">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-3xl font-bold text-white group-hover:text-lime-400 transition-colors duration-300 mb-3">$100 Referral Bonus</h3>
          <p class="text-brand-sky/70 mb-6 text-base">
            Earn unlimited $100 bonuses every time you refer a customer to us. Build passive income by sharing Shelby Web Co.
          </p>
          <div class="bg-brand-darkest/50 border border-brand-blue/20 rounded-lg p-4 mb-6">
            <p class="text-brand-accent text-base font-bold mb-2">Unlimited Earning:</p>
            <ul class="text-brand-sky/60 text-sm space-y-1">
              <li>✓ $100 per qualified referral</li>
              <li>✓ No limit on earnings</li>
              <li>✓ Fast payout process</li>
              <li>✓ Lifetime referral link</li>
            </ul>
          </div>
          <span class="inline-block w-full text-center bg-white/10 backdrop-blur-md border border-white/20 text-brand-cyan-light px-6 py-3 rounded-lg font-bold group-hover:bg-white/20 group-hover:border-white/40 transition-all duration-300">
            Learn More
          </span>
        </a>

        <!-- Promo 4: Free Website for 5 Asheville Businesses -->
        <a href="/promotions/free-website-asheville-nc/" class="group block bg-gradient-to-br from-brand-dark to-brand-darkest p-8 rounded-2xl border border-brand-blue/20 hover:border-lime-500/50 transition-all duration-300 hover:shadow-[0_0_30px_rgba(34,211,238,0.2)] cursor-pointer">
          <div class="w-14 h-14 bg-gradient-to-br from-lime-200 via-lime-400 to-lime-600 rounded-lg flex items-center justify-center mb-6 text-brand-darkest shadow-lg shadow-lime-500/30">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
          </div>
          <h3 class="text-3xl font-bold text-white group-hover:text-lime-400 transition-colors duration-300 mb-3">Free Website for 5 Asheville Businesses</h3>
          <p class="text-brand-sky/70 mb-6 text-base">
            Five select Asheville, NC small service businesses will win a brand-new, fully functioning front-end website (up to 5 pages) — completely free.
          </p>
          <div class="bg-brand-darkest/50 border border-brand-blue/20 rounded-lg p-4 mb-6">
            <p class="text-brand-cyan text-base font-bold mb-2">Limited to 5 Spots:</p>
            <ul class="text-brand-sky/60 text-sm space-y-1">
              <li>✓ Fully functioning front-end, up to 5 pages</li>
              <li>✓ Mobile-responsive build &amp; local SEO setup</li>
              <li>✓ You own the site and the code outright</li>
              <li>✓ Hosting &amp; live launch not included (we'll transition it for you at standard rates)</li>
            </ul>
          </div>
          <span class="inline-block w-full text-center bg-white/10 backdrop-blur-md border border-white/20 text-brand-cyan-light px-6 py-3 rounded-lg font-bold group-hover:bg-white/20 group-hover:border-white/40 transition-all duration-300">
            Claim Your Spot
          </span>
        </a>

      </div>

      <!-- Bottom CTA -->
      <div class="mt-16 text-center">
        <p class="text-brand-sky/70 mb-6">Ready to take advantage of these offers?</p>
        <a 
          href="/contact/"
          class="inline-block bg-brand-accent text-[#0A0A0A] px-8 py-3 rounded-xl font-bold hover:bg-brand-accent-light transition-all"
        >
          Get Started Today
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
