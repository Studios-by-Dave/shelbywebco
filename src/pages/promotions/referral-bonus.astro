---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Promotions" description="Current Shelby Web Company promotions.">
  <meta http-equiv="refresh" content="0; url=/promotions/" />
  <script is:inline>
    window.location.replace('/promotions/');
  </script>

  <section class="px-4 py-20 text-center">
    <div class="mx-auto max-w-2xl rounded-2xl border border-white/10 bg-brand-dark p-8">
      <p class="mb-3 text-sm uppercase tracking-[0.2em] text-brand-accent">Promotion Removed</p>
      <h1 class="font-heading text-4xl font-bold text-white">This referral bonus has been retired.</h1>
      <p class="mt-4 text-white/70">You’re being redirected back to the main promotions page.</p>
      <a href="/promotions/" class="mt-6 inline-block text-brand-cyan underline decoration-brand-cyan/50 underline-offset-4">Return to promotions</a>
    </div>
  </section>
</BaseLayout>
