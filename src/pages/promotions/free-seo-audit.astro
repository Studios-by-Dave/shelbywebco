---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PixieDust from '../../components/PixieDust.jsx';
import Image from '../../components/OptimizedImage.astro';
import FaqSection from '../../components/FaqSection.astro';
import auditFlyer from '../../../assets/Sweb_audit_1.jpg';

const faqItems = [
  {
    question: 'Is this audit truly free with no obligation?',
    answer: 'Yes, completely free. There’s no catch and no obligation to hire us. Our goal is to help businesses understand their SEO health.'
  },
  {
    question: 'How long does it take to receive the audit?',
    answer: 'You’ll receive your snapshot and recommendations within a few business days of your request.'
  },
  {
    question: 'Will I understand the report if I’m not an SEO expert?',
    answer: 'Yes — we write for business owners, not SEO professionals. Everything is in plain English with clear next steps.'
  },
  {
    question: 'What if my website is new or has no traffic yet?',
    answer: 'The audit is still valuable. We’ll identify technical issues and opportunities to optimize before you invest in marketing.'
  },
  {
    question: 'What if the audit finds a bigger problem?',
    answer: 'Then we’ll tell you honestly. Some fixes are simple DIY tasks; deeper issues may be worth a paid Full Website Rescue Audit. We’ll explain the difference so you can decide what’s right for you — no pressure either way.'
  },
  {
    question: 'Do I need to give you access to anything?',
    answer: 'No. We only need your website URL. For a deeper look later, read-only Google Search Console access helps, but it’s never required for the free snapshot.'
  }
];
---

<BaseLayout 
  bgVariant="blue"
  title="Free SEO Audit for Local Businesses"
  description="Get a free SEO audit snapshot for your local business: homepage visibility check, indexing spot-check, title and meta review, and 2-3 quick recommendations. No obligation."
>

  <!-- Hero Section -->
  <section class="py-10 lg:py-16 px-4" data-animate>
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-accent text-sm uppercase tracking-widest mb-4">✦ Free for Local Businesses</p>
      <div class="relative inline-block">
        <PixieDust client:load />
        <h1 class="font-heading text-5xl md:text-7xl font-black text-white mb-6 leading-tight">
          Free <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-blue-light to-brand-accent">SEO Audit</span>
        </h1>
      </div>
      <p class="text-lg md:text-xl text-white mb-4">
        A quick, honest snapshot of your website's health. We'll tell you whether Google can find you, whether your site sends the right signals, and what's most worth fixing first.
      </p>
      <p class="text-base md:text-lg text-white/80 mb-8">
        No obligation. No sales pitch. Just a clear look at where your website stands.
      </p>
<a 
         href="#audit-form"
         class="cta-glow-shine inline-block bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-8 py-3 rounded-xl font-bold border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),inset_0_-2px_6px_rgba(0,0,0,0.25),0_4px_14px_rgba(0,0,0,0.4),0_2px_8px_rgba(132,204,22,0.35),0_0_20px_rgba(132,204,22,0.25)] hover:from-[#b5f146] hover:via-brand-accent-light hover:to-[#4d7c0f] hover:-translate-y-[1px] active:translate-y-[1px] active:shadow-[inset_0_2px_4px_rgba(0,0,0,0.3),0_2px_6px_rgba(0,0,0,0.3)] transition-all duration-300"
       >
          Request Your Free Audit
        </a>
      </div>
      <div class="mt-10 max-w-sm mx-auto">
        <Image
          src={auditFlyer}
          alt="Free SEO Audit Flyer"
          class="w-full h-auto rounded-2xl border border-white/20 shadow-2xl"
          loading="lazy"
        />
      </div>
  </section>

  <!-- What You'll Discover -->
  <section class="py-24 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-6">What Your Free Audit Covers</h2>
        <p class="text-white max-w-2xl mx-auto text-lg">
          A focused, high-level check — not a full consulting engagement. Here's exactly what we look at:
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white/[0.04] p-8 rounded-2xl border border-white/10 hover:border-brand-accent/40 hover:bg-white/[0.07] transition-all">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Homepage Visibility Check</h3>
          <p class="text-white/90">We run a search for your business and check whether your homepage actually shows up on Google.</p>
        </div>

        <div class="bg-white/[0.04] p-8 rounded-2xl border border-white/10 hover:border-brand-accent/40 hover:bg-white/[0.07] transition-all">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Indexing Spot-Check</h3>
          <p class="text-white/90">A quick check of whether your key pages are being indexed, plus whether your sitemap.xml and robots.txt are present and working.</p>
        </div>

        <div class="bg-white/[0.04] p-8 rounded-2xl border border-white/10 hover:border-brand-accent/40 hover:bg-white/[0.07] transition-all">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Title &amp; Meta Review</h3>
          <p class="text-white/90">We review your homepage titles and meta descriptions — the first thing Google and customers see.</p>
        </div>

        <div class="bg-white/[0.04] p-8 rounded-2xl border border-white/10 hover:border-brand-accent/40 hover:bg-white/[0.07] transition-all">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100 4m0-4a2 2 0 110 4m0-4v2m0-6V4m6 6v10m6-2a2 2 0 100 4m0-4a2 2 0 110 4m0-4v2m0-6V4"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">On-Page SEO Basics</h3>
          <p class="text-white/90">A basic look at headings, page structure, and how clearly your homepage explains what you do and where you do it.</p>
        </div>

        <div class="bg-white/[0.04] p-8 rounded-2xl border border-white/10 hover:border-brand-accent/40 hover:bg-white/[0.07] transition-all">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Obvious Local SEO Issues</h3>
          <p class="text-white/90">Common local problems: missing location info, unclaimed or inconsistent Google Business Profile signals, no local pages.</p>
        </div>

        <div class="bg-white/[0.04] p-8 rounded-2xl border border-white/10 hover:border-brand-accent/40 hover:bg-white/[0.07] transition-all">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m7 0a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">2–3 Quick Recommendations</h3>
          <p class="text-white/90">You get 2–3 specific, actionable fixes you can make right away — no jargon, no 40-page report.</p>
        </div>
      </div>

      <p class="mt-10 text-center text-white/75 text-base italic max-w-3xl mx-auto">
        This audit is a high-level diagnostic. If we find deeper issues, we'll tell you — and we offer a paid Full Website Rescue Audit for that. But the snapshot is genuinely free, and it's yours either way.
      </p>
    </div>
  </section>

  <!-- The Process -->
  <section class="py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-16 text-center">How the Audit Works</h2>
      
      <div class="space-y-8">
        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-full bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] text-brand-darkest font-bold">
              1
            </div>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2">Submit Your Request</h3>
            <p class="text-white">Fill out the short form below with your website URL and basic business info. Tell us what's frustrating you most about your website.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-full bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] text-brand-darkest font-bold">
              2
            </div>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2">We Run the Checks</h3>
            <p class="text-white">We run the visibility, indexing, and on-page checks by hand — looking at your site the way Google and a first-time customer would.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-full bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] text-brand-darkest font-bold">
              3
            </div>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2">Get Your Snapshot</h3>
            <p class="text-white">Within a few business days, you'll get a short, plain-English summary of what we found and 2–3 recommended fixes. No 40-page PDF. No jargon.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-full bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] text-brand-darkest font-bold">
              4
            </div>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2">What Happens Next (Your Choice)</h3>
            <p class="text-white">If the audit surfaces bigger problems, we'll tell you what a deeper Full Website Rescue Audit would cover. Whether you fix things yourself, hire someone else, or ask us to help — you're under no obligation.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-16 text-center">Why We Give This Away Free</h2>
      
      <div class="space-y-6">
        <div class="flex gap-4">
          <div class="text-brand-accent text-2xl flex-shrink-0">✓</div>
          <div>
            <h3 class="text-lg font-bold text-white mb-2">See What Your Customers See</h3>
            <p class="text-white">Most owners have never searched for their own business the way a customer would. The audit shows you exactly what turns up — or doesn't.</p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="text-brand-accent text-2xl flex-shrink-0">✓</div>
          <div>
            <h3 class="text-lg font-bold text-white mb-2">Small Fixes, Real Impact</h3>
            <p class="text-white">Some of the most common problems — a missing sitemap, a vague page title, no phone number above the fold — take minutes to fix and directly affect visibility.</p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="text-brand-accent text-2xl flex-shrink-0">✓</div>
          <div>
            <h3 class="text-lg font-bold text-white mb-2">A Straight Answer</h3>
            <p class="text-white">If your site is fine, we'll say so. If it needs work, you'll know exactly where to start. Either way, you're better off than before you asked.</p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="text-brand-accent text-2xl flex-shrink-0">✓</div>
          <div>
            <h3 class="text-lg font-bold text-white mb-2">No Catch, No Pressure</h3>
            <p class="text-white">We do these audits because they lead to paid rescue work for some businesses — and because a website that works is good for everyone in our community. You will never be pressured into anything.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FaqSection items={faqItems} />

  <!-- CTA / Audit Request Form -->
  <section id="audit-form" class="py-24 px-4">
    <div class="max-w-2xl mx-auto rounded-3xl border border-white/10 bg-white/[0.04] p-6 md:p-10">
      <div class="text-center mb-10">
        <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-6">Get Your Free SEO Audit</h2>
        <p class="text-xl text-white mb-4">
          Tell us where to look. We'll take it from there — completely free, no obligation.
        </p>
        <p class="text-white/90 text-sm">
          While you're here, learn how to <a href="/blog/local-seo-essentials-2026/" class="text-brand-accent hover:text-white underline decoration-brand-accent/30">master local SEO</a>, see the service-area strategy that <a href="/services/case-studies/solution-c/" class="text-brand-accent hover:text-white underline decoration-brand-accent/30">multiplied organic reach by 214%</a>, or explore our full <a href="/services/seo/" class="text-brand-accent hover:text-white underline decoration-brand-accent/30">SEO services</a>.
        </p>
      </div>

      <form id="seo-audit-form" action="/api/contact" method="POST" class="space-y-5">
        <input type="hidden" name="subject" value="Free SEO Audit Request — Shelby Web Co" />
        <input type="hidden" name="form_type" value="Free SEO Audit" />
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

        <div>
          <label for="audit-name" class="block text-sm font-medium text-white mb-2">Name *</label>
          <input type="text" name="name" id="audit-name" required placeholder="John Doe" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder:text-gray-400 text-base focus:outline-none focus:border-brand-accent transition-all focus:ring-1 focus:ring-brand-accent/20" />
        </div>

        <div>
          <label for="audit-business" class="block text-sm font-medium text-white mb-2">Business Name *</label>
          <input type="text" name="business_name" id="audit-business" required placeholder="Your Business LLC" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder:text-gray-400 text-base focus:outline-none focus:border-brand-accent transition-all focus:ring-1 focus:ring-brand-accent/20" />
        </div>

        <div>
          <label for="audit-email" class="block text-sm font-medium text-white mb-2">Email *</label>
          <input type="email" name="email" id="audit-email" required placeholder="john@example.com" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder:text-gray-400 text-base focus:outline-none focus:border-brand-accent transition-all focus:ring-1 focus:ring-brand-accent/20" />
        </div>

        <div>
          <label for="audit-website" class="block text-sm font-medium text-white mb-2">Website URL</label>
          <input type="url" name="website" id="audit-website" placeholder="https://yourbusiness.com" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder:text-gray-400 text-base focus:outline-none focus:border-brand-accent transition-all focus:ring-1 focus:ring-brand-accent/20" />
        </div>

        <div>
          <label for="audit-phone" class="block text-sm font-medium text-white mb-2">Phone <span class="text-brand-sky/60">(optional)</span></label>
          <input type="tel" name="phone" id="audit-phone" placeholder="(704) 555-0123" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder:text-gray-400 text-base focus:outline-none focus:border-brand-accent transition-all focus:ring-1 focus:ring-brand-accent/20" />
        </div>

        <div>
          <label for="audit-challenge" class="block text-sm font-medium text-white mb-2">Your biggest SEO challenge</label>
          <select name="challenge" id="audit-challenge" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 text-base focus:outline-none focus:border-brand-accent transition-all focus:ring-1 focus:ring-brand-accent/20">
            <option value="">Select one...</option>
            <option>Not showing up on Google at all</option>
            <option>Ranking below my competitors</option>
            <option>Getting traffic but no leads/calls</option>
            <option>Not sure where to start with SEO</option>
            <option>Something else</option>
          </select>
        </div>

        <div>
          <label for="audit-message" class="block text-sm font-medium text-white mb-2">Anything else? <span class="text-brand-sky/60">(optional)</span></label>
          <textarea name="message" id="audit-message" rows="4" placeholder="Tell us a bit about your business or goals..." class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder:text-gray-400 text-base focus:outline-none focus:border-brand-accent transition-all focus:ring-1 focus:ring-brand-accent/20 resize-none"></textarea>
          <p class="text-white/60 text-xs mt-2">Have Google Search Console access? You can note it here — read-only access helps us verify indexing, but it's never required for the free snapshot.</p>
        </div>

<button type="submit" class="cta-glow-shine w-full inline-block bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-8 py-3 rounded-xl font-bold border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),inset_0_-2px_6px_rgba(0,0,0,0.25),0_4px_14px_rgba(0,0,0,0.4),0_2px_8px_rgba(132,204,22,0.35),0_0_20px_rgba(132,204,22,0.25)] hover:from-[#b5f146] hover:via-brand-accent-light hover:to-[#4d7c0f] hover:-translate-y-[1px] active:translate-y-[1px] active:shadow-[inset_0_2px_4px_rgba(0,0,0,0.3),0_2px_6px_rgba(0,0,0,0.3)] transition-all duration-300 text-lg">
           Request My Free Audit
         </button>

        <div id="audit-form-status" class="min-h-6 text-sm text-white"></div>
      </form>

      <div id="audit-form-success" class="hidden text-center bg-white/[0.04] border border-lime-400/20 rounded-2xl p-10">
        <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.4)] text-brand-darkest mb-6">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
        </div>
        <h3 class="font-heading text-2xl md:text-3xl font-bold text-white mb-4">Thanks! Your Request Is In.</h3>
        <p class="text-white text-lg max-w-md mx-auto">
          We've received your free audit request and will reach out within a few business days with your snapshot and recommendations.
        </p>
      </div>
    </div>
  </section>

  <script>
    const auditForm = document.getElementById('seo-audit-form') as HTMLFormElement | null;
    const auditStatus = document.getElementById('audit-form-status');
    if (auditForm) {
      auditForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(auditForm);
        if (formData.get('botcheck')) return;
        auditStatus.textContent = 'Sending...';
        auditStatus.className = 'min-h-6 text-sm text-white';
        try {
          formData.set('form_type', 'Free SEO Audit');
          const res = await fetch('/api/contact', {
            method: 'POST',
            body: formData
          });
          const data = await res.json();
          if (data.success) {
            auditForm.style.display = 'none';
            const successPanel = document.getElementById('audit-form-success');
            if (successPanel) successPanel.classList.remove('hidden');
          } else {
            auditStatus.textContent = data.message || 'Something went wrong. Please try again.';
            auditStatus.className = 'min-h-6 text-sm text-red-400';
          }
        } catch (err) {
          auditStatus.textContent = 'Network error. Please try again.';
          auditStatus.className = 'min-h-6 text-sm text-red-400';
        }
      });
    }
  </script>

</BaseLayout>
