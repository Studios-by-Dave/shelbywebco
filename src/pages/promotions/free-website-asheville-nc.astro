---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PixieDust from '../../components/PixieDust.jsx';
---

<BaseLayout 
  title="Free Website for 5 Asheville, NC Businesses"
  description="Shelby Web Company is giving away 5 free, fully functioning front-end websites (up to 5 pages) to select small service businesses in Asheville, NC. You own the site and the code — hosting and live launch not included in the promo."
>

  <!-- Hero Section -->
  <section class="py-20 lg:py-32 px-4" data-animate>
    <div class="max-w-4xl mx-auto text-center relative">
      <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ Limited-Time Offer</p>
      <div class="relative inline-block">
        <PixieDust client:load />
        <h1 class="font-heading text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight">
          A Free Website for <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-blue via-brand-cyan to-brand-sky">5 Asheville Businesses.</span>
        </h1>
      </div>
      <div class="flex justify-center mb-8">
        <div class="w-32 h-32 md:w-40 md:h-40 rounded-full bg-gradient-to-br from-brand-accent to-brand-accent-light flex items-center justify-center shadow-[0_0_30px_rgba(132,204,22,0.5)]">
          <span class="text-[#0A0A0A] font-heading font-black text-3xl md:text-4xl text-center leading-tight">Free<br>Site</span>
        </div>
      </div>
      <p class="text-xl text-brand-sky/80 mb-8">
        Five lucky Asheville, NC small service businesses will receive a brand-new, custom-designed website — completely free. We're building it to help five local businesses get found, get booked, and get growing. The tally will be taken roughly 30 days from now — the 5 businesses with the most mentions win.
      </p>
      <a 
        href="#raffle"
        class="inline-block bg-white/10 backdrop-blur-md border border-white/20 text-brand-cyan-light px-8 py-3 rounded-xl font-bold hover:bg-white/20 hover:border-white/40 transition-all"
      >
        Enter the Raffle — 5 Spots
      </a>
    </div>
  </section>

  <!-- What's Included -->
  <section class="py-24 px-4 bg-brand-darkest border-y border-white/5">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">What Each Winner Receives</h2>
        <p class="text-brand-sky/70 max-w-2xl mx-auto text-lg">
          This isn't a stripped-down placeholder. Selected businesses get a full, professional website built to win local customers.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Custom Website Design</h3>
          <p class="text-brand-sky/60">A bespoke design built around your business, your services, and your brand — not a template everyone else uses. Each winner receives a fully functioning front-end website, up to 5 pages, designed and developed to look and run great.</p>
        </div>

        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">You Own the Site & the Code</h3>
          <p class="text-brand-sky/60">Once the design is approved through our revision rounds, the finished website and its complete filebase/code are handed over to you. You own everything outright — the site and the code are 100% yours to keep and use as you see fit.</p>
        </div>

        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Mobile-Responsive Build</h3>
          <p class="text-brand-sky/60">Fast, mobile-first design so you look great on every device — where most Asheville customers search from their phones.</p>
        </div>

        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Local SEO Setup</h3>
          <p class="text-brand-sky/60">We configure your site to be found for the local Asheville searches that matter to your business — right out of the gate.</p>
        </div>

        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Handover & Code Transfer</h3>
          <p class="text-brand-sky/60">We design, develop, and refine your custom front-end through revision rounds. Once you approve the design, we hand over the finished website and its complete code — 100% yours. Please note: actually launching and hosting the live site is <span class="text-white font-semibold">not included</span> in this free promotion.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Eligibility -->
  <section class="py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-16 text-center">Who Should Apply</h2>
      
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5">
          <h3 class="text-xl font-bold text-white mb-3">Small Service Businesses in Asheville & Western NC</h3>
          <p class="text-brand-sky/60 leading-relaxed">
            This offer is for local service businesses — contractors, salons, cleaners, landscapers, home services, healthcare providers, and similar trades operating in or around Asheville, NC.
          </p>
        </div>
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5">
          <h3 class="text-xl font-bold text-white mb-3">5 Lucky Businesses Will Win</h3>
          <p class="text-brand-sky/60 leading-relaxed">
            The tally will be taken roughly 30 days from now. The 5 businesses with the most tally mentions win a free custom website. Spread the word to your network — every mention counts toward your tally.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-24 px-4 bg-brand-dark/50 border-y border-white/5">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-16 text-center">How It Works</h2>
      
      <div class="space-y-8">
        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-full bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] text-brand-darkest font-bold">1</div>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2">Get Mentioned & Build Your Tally</h3>
            <p class="text-brand-sky/70">When people mention your business — by name, tag, or referral — your tally goes up. Spread the word to your network, customers, and community. The more mentions you get, the better your chances.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-full bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] text-brand-darkest font-bold">2</div>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2">Tally Taken in ~30 Days</h3>
            <p class="text-brand-sky/70">Roughly 30 days from now, we'll tally all mentions. The 5 businesses with the most mentions win a free custom website. We'll announce the winners right here and reach out directly.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-full bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] text-brand-darkest font-bold">3</div>
          </div>
          <div>
          <h3 class="text-xl font-bold text-white mb-2">We Build & You Approve</h3>
          <p class="text-brand-sky/70">Our team designs, develops, and refines your custom front-end through revision rounds. Once you approve the design, we hand over the finished website and its complete code — fully ready for you to host and use.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-16 text-center">Frequently Asked Questions</h2>
      
      <div class="space-y-6">
        <div class="bg-brand-darkest p-6 rounded-xl border border-white/5">
          <h3 class="text-lg font-bold text-white mb-3">Is the website really completely free?</h3>
          <p class="text-brand-sky/70">Yes. Selected businesses receive a custom-designed website at no cost. There are no hidden fees and no commitment required.</p>
        </div>

        <div class="bg-brand-darkest p-6 rounded-xl border border-white/5">
          <h3 class="text-lg font-bold text-white mb-3">Who qualifies as a "small service business"?</h3>
          <p class="text-brand-sky/70">Contractors, trades, salons, cleaners, landscapers, home services, healthcare providers, and similar local service businesses operating in or around Asheville, NC.</p>
        </div>

        <div class="bg-brand-darkest p-6 rounded-xl border border-white/5">
          <h3 class="text-lg font-bold text-white mb-3">I'm outside Asheville but in Western NC. Do I qualify?</h3>
          <p class="text-brand-sky/70">We prioritize Asheville, NC businesses for this offer, but we're happy to discuss custom web design for businesses throughout Western NC and beyond.</p>
        </div>

        <div class="bg-brand-darkest p-6 rounded-xl border border-white/5">
          <h3 class="text-lg font-bold text-white mb-3">How are the 5 winners selected?</h3>
          <p class="text-brand-sky/70">The tally will be taken roughly 30 days from now. The 5 businesses with the most tally mentions win the free website. Every mention, tag, or referral from your network counts toward your tally — so spread the word early and often.</p>
        </div>

        <div class="bg-brand-darkest p-6 rounded-xl border border-white/5">
          <h3 class="text-lg font-bold text-white mb-3">How soon is the offer closing?</h3>
          <p class="text-brand-sky/70">The tally will be taken roughly 30 days from now. After that, we'll announce the 5 winners. Get your mentions in before the deadline to maximize your chances.</p>
        </div>

        <div class="bg-brand-darkest p-6 rounded-xl border border-white/5">
          <h3 class="text-lg font-bold text-white mb-3">Are there any ongoing costs after launch?</h3>
          <p class="text-brand-sky/70">Hosting and actually launching the live site are <span class="text-white font-semibold">not included</span> in this free promotion. The website and its code are 100% yours, free. If you'd like, we can happily transition your free site into a fully functioning, hosted web project — standard hosting and care-plan rates would simply apply at that point.</p>
        </div>
      </div>

      <p class="text-brand-sky/40 text-xs mt-8 leading-relaxed text-center">
        *Details: Winners receive a full, functioning front-end website of up to 5 pages, along with its complete code, free of charge. The site is handed over once it is approved through our revision rounds — at that point you own both the site and the code outright. Hosting and live launch are not included in the promotion; however, we're happy to transition any free site into a fully functioning, hosted web project (standard hosting and care-plan rates would then apply).
      </p>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-24 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">Don't Miss Out — Only 5 Spots</h2>
      <p class="text-xl text-brand-sky/80 mb-8">
        If your Asheville-area service business could use a fresh, high-converting website, reach out today to reserve your spot.
      </p>
      <a 
        href="#raffle"
        class="inline-block bg-brand-accent text-[#0A0A0A] px-8 py-3 rounded-xl font-bold hover:bg-brand-accent-light transition-all text-lg"
      >
        Enter the Raffle
      </a>
    </div>
  </section>

  <!-- Raffle Entry Form -->
  <section id="raffle" class="py-24 px-4 bg-brand-darkest border-y border-white/5 scroll-mt-8">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ 5 Winners • Raffle Entry</p>
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-4">Enter the Free Website Raffle</h2>
        <p class="text-brand-sky/70">Asheville & Western NC small service businesses — fill this out to enter. We’ll draw 5 winners. Takes about 60 seconds.</p>
        <p id="raffle-count" class="text-brand-accent text-sm mt-3"></p>
      </div>

      <form id="raffle-form" class="bg-brand-dark p-6 md:p-8 rounded-2xl border border-white/10 space-y-5" novalidate>
        <!-- Honeypot -->
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <div class="grid md:grid-cols-2 gap-5">
          <label class="block">
            <span class="text-white text-sm font-semibold">Business name *</span>
            <input name="businessName" required type="text" placeholder="Acme Landscaping" class="mt-2 w-full rounded-xl bg-white/5 border border-white/10 px-4 py-3 text-white placeholder:text-white/40 focus:border-brand-cyan focus:outline-none" />
          </label>
          <label class="block">
            <span class="text-white text-sm font-semibold">Contact name *</span>
            <input name="contactName" required type="text" placeholder="Jane Doe" class="mt-2 w-full rounded-xl bg-white/5 border border-white/10 px-4 py-3 text-white placeholder:text-white/40 focus:border-brand-cyan focus:outline-none" />
          </label>
        </div>

        <div class="grid md:grid-cols-2 gap-5">
          <label class="block">
            <span class="text-white text-sm font-semibold">Email *</span>
            <input name="email" required type="email" placeholder="you@business.com" class="mt-2 w-full rounded-xl bg-white/5 border border-white/10 px-4 py-3 text-white placeholder:text-white/40 focus:border-brand-cyan focus:outline-none" />
          </label>
          <label class="block">
            <span class="text-white text-sm font-semibold">Phone</span>
            <input name="phone" type="tel" placeholder="(828) 555-1234" class="mt-2 w-full rounded-xl bg-white/5 border border-white/10 px-4 py-3 text-white placeholder:text-white/40 focus:border-brand-cyan focus:outline-none" />
          </label>
        </div>

        <div class="grid md:grid-cols-2 gap-5">
          <label class="block">
            <span class="text-white text-sm font-semibold">Website (if any)</span>
            <input name="website" type="url" placeholder="https://example.com" class="mt-2 w-full rounded-xl bg-white/5 border border-white/10 px-4 py-3 text-white placeholder:text-white/40 focus:border-brand-cyan focus:outline-none" />
          </label>
          <label class="block">
            <span class="text-white text-sm font-semibold">Business type</span>
            <select name="businessType" class="mt-2 w-full rounded-xl bg-white/5 border border-white/10 px-4 py-3 text-white focus:border-brand-cyan focus:outline-none">
              <option value="" class="bg-brand-dark">Select one</option>
              <option value="Contractor / Trades" class="bg-brand-dark">Contractor / Trades</option>
              <option value="Salon / Beauty" class="bg-brand-dark">Salon / Beauty</option>
              <option value="Cleaning" class="bg-brand-dark">Cleaning</option>
              <option value="Landscaping / Lawn" class="bg-brand-dark">Landscaping / Lawn</option>
              <option value="Home Services" class="bg-brand-dark">Home Services</option>
              <option value="Healthcare / Wellness" class="bg-brand-dark">Healthcare / Wellness</option>
              <option value="Restaurant / Hospitality" class="bg-brand-dark">Restaurant / Hospitality</option>
              <option value="Retail" class="bg-brand-dark">Retail</option>
              <option value="Other" class="bg-brand-dark">Other</option>
            </select>
          </label>
        </div>

        <label class="block">
          <span class="text-white text-sm font-semibold">Why should your business be one of the 5? (optional)</span>
          <textarea name="message" rows="3" placeholder="A sentence or two about your business and customers." class="mt-2 w-full rounded-xl bg-white/5 border border-white/10 px-4 py-3 text-white placeholder:text-white/40 focus:border-brand-cyan focus:outline-none"></textarea>
        </label>

        <p class="text-brand-sky/50 text-xs">By entering you agree we may contact you about the raffle. Hosting/live launch not included — see details above. Max 50 entries.</p>

        <button type="submit" id="raffle-submit" class="w-full bg-brand-accent text-[#0A0A0A] px-8 py-4 rounded-xl font-bold text-lg hover:bg-brand-accent-light transition-all disabled:opacity-50 disabled:cursor-not-allowed">
          Enter Raffle
        </button>

        <p id="raffle-status" class="text-sm text-center min-h-[1.5rem]" aria-live="polite"></p>
        <p class="text-brand-sky/40 text-xs text-center">Prefer to talk first? <a href="/contact/" class="text-brand-cyan hover:underline">Contact us</a> instead.</p>
      </form>
    </div>

    <script is:inline>
      (function() {
        const form = document.getElementById('raffle-form');
        const statusEl = document.getElementById('raffle-status');
        const submitBtn = document.getElementById('raffle-submit');
        const countEl = document.getElementById('raffle-count');

        async function refreshCount() {
          try {
            const r = await fetch('/api/raffle', { headers: { 'Accept': 'application/json' } });
            if (r.ok) {
              const j = await r.json();
              if (typeof j.count === 'number' && countEl) countEl.textContent = j.count + ' / 50 entries so far — ' + Math.max(0, 50 - j.count) + ' spots left in the raffle pool.';
            }
          } catch {}
        }
        refreshCount();

        if (form) form.addEventListener('submit', async function(e) {
          e.preventDefault();
          if (statusEl) { statusEl.textContent = ''; statusEl.className = 'text-sm text-center min-h-[1.5rem]'; }
          if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Submitting…'; }
          const fd = new FormData(form);
          const payload = Object.fromEntries(fd.entries());
          try {
            const r = await fetch('/api/raffle', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify(payload),
            });
            const j = await r.json();
            if (r.ok && j.success) {
              if (statusEl) { statusEl.textContent = j.message || "You're entered — good luck!"; statusEl.className = 'text-sm text-center min-h-[1.5rem] text-lime-400'; }
              form.reset();
              refreshCount();
            } else {
              if (statusEl) { statusEl.textContent = j.message || 'Something went wrong. Please try again.'; statusEl.className = 'text-sm text-center min-h-[1.5rem] text-red-400'; }
            }
          } catch {
            if (statusEl) { statusEl.textContent = 'Network error — please try again.'; statusEl.className = 'text-sm text-center min-h-[1.5rem] text-red-400'; }
          } finally {
            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Enter Raffle'; }
          }
        });
      })();
    </script>
  </section>

</BaseLayout>