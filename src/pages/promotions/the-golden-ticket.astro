---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PixieDust from '../../components/PixieDust.jsx';
---

<BaseLayout
  title="The Golden Ticket — Free Website for 3 Local Businesses"
  description="Shelby Web Co is choosing 3 local businesses for the Class of 2026. We waive the full $497 build & launch fee on a brand-new website. Applications close December 15, 2026."
>

  <!-- Hero Section -->
  <section class="py-10 lg:py-16 px-4" data-animate>
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ The Golden Ticket — Class of 2026</p>
      <div class="relative inline-block">
        <PixieDust client:load />
        <h1 class="font-heading text-5xl md:text-7xl font-bold text-white mb-6 leading-tight">
          The <span class="bg-clip-text text-transparent" style="background-image: linear-gradient(110deg, #fef08a 0%, #fbbf24 20%, #fff7d6 38%, #f59e0b 55%, #fde68a 72%, #b45309 88%, #fbbf24 100%); -webkit-background-clip: text; background-clip: text; text-shadow: 0 0 24px rgba(251,191,36,0.35);">Golden Ticket</span>
        </h1>
      </div>
      <p class="text-lg md:text-xl text-white mb-6">
        We're choosing <span class="text-brand-cyan font-semibold">3 local businesses</span> and building them a brand-new website —
        we cover the full <span class="text-brand-cyan font-semibold">$497 build and launch fee</span>, the same build work we previously
        priced at <span class="text-brand-cyan font-semibold">$1,000–$1,200 per website</span>.
      </p>
      <p class="text-white/90 mb-8 font-semibold">
        Applications close December 15, 2026 at 11:59 PM ET — only 3 spots for the Class of 2026.
      </p>
      <a
        href="#apply-form"
        class="cta-glow-shine inline-block bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-8 py-3 rounded-xl font-bold border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),inset_0_-2px_6px_rgba(0,0,0,0.25),0_4px_14px_rgba(0,0,0,0.4),0_2px_8px_rgba(132,204,22,0.35),0_0_20px_rgba(132,204,22,0.25)] hover:from-[#b5f146] hover:via-brand-accent-light hover:to-[#4d7c0f] hover:-translate-y-[1px] active:translate-y-[1px] active:shadow-[inset_0_2px_4px_rgba(0,0,0,0.3),0_2px_6px_rgba(0,0,0,0.3)] transition-all duration-300"
      >
        Apply for Your Golden Ticket
      </a>
    </div>
  </section>

  <!-- What Winners Receive -->
  <section class="py-24 px-4 bg-brand-darkest border-y border-white/5" data-animate>
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">What the 3 Winners Receive</h2>
        <p class="text-white max-w-2xl mx-auto text-lg">
          Every winner gets our Core growth plan with the launch fee fully covered by us — a direct giveback to the
          community that built this company.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-gradient-to-br from-lime-400/10 to-transparent p-8 rounded-2xl border border-lime-500/30">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8V6m0 12v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-white mb-3">$497 Build &amp; Launch Fee — Waived</h3>
          <p class="text-white/90 mb-4">
            We cover the entire $497 build and launch fee. That's the phase of the project where the real work happens —
            design, build, content setup, and launch — equivalent to our previous standard web pricing of
            <span class="text-brand-cyan font-semibold">$1,000–$1,200 per build</span>.
          </p>
          <p class="text-lime-400 font-bold text-xl">Value: $497 waived, $1,000–$1,200 of build work covered</p>
        </div>

        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-white mb-3">Everything in Our Core Plan</h3>
          <ul class="text-white/90 space-y-2">
            <li>✓ 4–5 page mobile-first website</li>
            <li>✓ Hosting, SSL, backups &amp; security</li>
            <li>✓ Contact forms &amp; lead notifications</li>
            <li>✓ Google Analytics &amp; Search Console</li>
            <li>✓ Foundational on-page &amp; local SEO</li>
            <li>✓ One small monthly edit request</li>
            <li>✓ Monthly performance snapshot</li>
            <li>✓ Quarterly growth review</li>
          </ul>
        </div>
      </div>

      <div class="mt-8 bg-brand-dark p-8 rounded-2xl border border-white/5">
        <h3 class="text-xl font-bold text-white mb-3">The Honest Details</h3>
        <p class="text-white/90">
          Winners continue on the Core plan at <span class="text-brand-cyan font-semibold">$297/month</span> for a standard
          12-month term — the same plan any Core client signs. Hosting, maintenance, edits, and growth reviews are included
          in that rate. What we're giving away is the <span class="text-brand-cyan font-semibold">$497 build and launch fee</span>:
          the design, construction, and launch of your new site, which we previously charged at $1,000–$1,200 per build.
          No surprise charges, no upsells, no fine print.
        </p>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-24 px-4" data-animate>
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-16 text-center">How the Golden Ticket Works</h2>

      <div class="space-y-8">
        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-full bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] text-brand-darkest font-bold">
              1
            </div>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2">Tell Your Story</h3>
            <p class="text-white">Fill out the short application below. No pitch decks, no jargon — just tell us what you do, who you serve, and why a modern website would change your next 12 months.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-full bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] text-brand-darkest font-bold">
              2
            </div>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2">We Review Every Application</h3>
            <p class="text-white">A human reviews every submission. We're looking for local businesses with real stories, real customers, and a clear reason a better website matters right now.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-full bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] text-brand-darkest font-bold">
              3
            </div>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2">3 Winners Announced — Class of 2026</h3>
            <p class="text-white">We choose exactly 3 businesses as a one-time cohort. This isn't a rolling giveaway — the Class of 2026 closes when applications close on December 15, 2026.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-full bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] text-brand-darkest font-bold">
              4
            </div>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2">We Build &amp; Launch</h3>
            <p class="text-white">Winners kick off with a friendly pre-discovery call, then we design, build, and launch — weeks, not months. Your $497 build and launch fee is fully covered by us.</p>
          </div>
        </div>

        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-full bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] text-brand-darkest font-bold">
              5
            </div>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2">We Measure the Results</h3>
            <p class="text-white">At 30, 60, and 90 days we track the numbers together — traffic, calls, form fills, and rankings — so your story comes with proof, not promises.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Ask in Return -->
  <section class="py-24 px-4 bg-brand-dark/50 border-y border-white/5" data-animate>
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-14">
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">What We Ask in Return</h2>
        <p class="text-white text-lg">
          This program costs us real money — we cover the $497 build and launch fee, equivalent to our previous standard
          web pricing of <span class="text-brand-cyan font-semibold">$1,000–$1,200 per build</span>. It only works for a small
          local shop like ours if it produces real proof and real relationships. Four simple asks:
        </p>
      </div>

      <div class="space-y-6">
        <div class="flex gap-4">
          <div class="text-brand-cyan text-2xl flex-shrink-0">✓</div>
          <div>
            <h3 class="text-lg font-bold text-white mb-2">An Honest Testimonial</h3>
            <p class="text-white">After launch, tell the truth about working with us — the good and the nitpicks. We'll use it as a case study alongside your 30/60/90-day results.</p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="text-brand-cyan text-2xl flex-shrink-0">✓</div>
          <div>
            <h3 class="text-lg font-bold text-white mb-2">A Google Review</h3>
            <p class="text-white">Once your site is live and you're happy with it, leave us a review on Google. Reviews are the lifeblood of local businesses — including ours.</p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="text-brand-cyan text-2xl flex-shrink-0">✓</div>
          <div>
            <h3 class="text-lg font-bold text-white mb-2">Permission to Feature You — 6 Months</h3>
            <p class="text-white">We'd love to show off your site and results in our portfolio, social posts, and marketing for 6 months. You approve everything before it goes out.</p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="text-brand-cyan text-2xl flex-shrink-0">✓</div>
          <div>
            <h3 class="text-lg font-bold text-white mb-2">One Warm Intro</h3>
            <p class="text-white">If you know one other business owner who deserves a better website, pass along their name. That's it — one introduction.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Case Study Engine -->
  <section class="py-24 px-4" data-animate>
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">The 30 / 60 / 90-Day Case Study</h2>
        <p class="text-white max-w-2xl mx-auto text-lg">
          Every Golden Ticket site becomes a living case study. We track what matters from day one so your giveback fuels the
          next business's chance.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5 text-center">
          <p class="text-brand-cyan font-bold text-sm uppercase tracking-widest mb-3">Day 30</p>
          <h3 class="text-2xl font-bold text-white mb-3">Foundation Live</h3>
          <p class="text-white/90">Site launched, Analytics and Search Console running, contact forms delivering leads, foundational local SEO in place.</p>
        </div>
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5 text-center">
          <p class="text-brand-cyan font-bold text-sm uppercase tracking-widest mb-3">Day 60</p>
          <h3 class="text-2xl font-bold text-white mb-3">First Signals</h3>
          <p class="text-white/90">First organic impressions, calls, and form fills rolling in. We tune pages and content around what's actually working.</p>
        </div>
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5 text-center">
          <p class="text-brand-cyan font-bold text-sm uppercase tracking-widest mb-3">Day 90</p>
          <h3 class="text-2xl font-bold text-white mb-3">Proof on Paper</h3>
          <p class="text-white/90">A clean results snapshot — traffic, leads, and rankings — that becomes your case study and our receipts for the program.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 px-4 bg-brand-darkest border-y border-white/5" data-animate>
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-16 text-center">Frequently Asked Questions</h2>

      <div class="space-y-6">
        <div class="bg-brand-dark p-6 rounded-xl border border-white/5">
          <h3 class="text-lg font-bold text-white mb-3">Is it really free?</h3>
          <p class="text-white">Yes — we cover the full $497 build and launch fee, the same build work we previously priced at $1,000–$1,200 per website. Winners continue on the Core plan at $297/month for a standard 12-month term (hosting, maintenance, edits, and growth reviews included). No upfront project invoice, no surprise charges.</p>
        </div>

        <div class="bg-brand-dark p-6 rounded-xl border border-white/5">
          <h3 class="text-lg font-bold text-white mb-3">Who can apply?</h3>
          <p class="text-white">Local businesses in the areas we serve — whether you're a solo operator or a small team. You don't need a website today; old, outdated, or nonexistent all qualify. You do need to be open for business and ready to launch within the program window.</p>
        </div>

        <div class="bg-brand-dark p-6 rounded-xl border border-white/5">
          <h3 class="text-lg font-bold text-white mb-3">How are the 3 winners chosen?</h3>
          <p class="text-white">By story and need. We're looking for businesses where a modern website would genuinely change the next 12 months — and where the partnership makes sense both ways. Every application is read by a human.</p>
        </div>

        <div class="bg-brand-dark p-6 rounded-xl border border-white/5">
          <h3 class="text-lg font-bold text-white mb-3">What's the deadline?</h3>
          <p class="text-white">December 15, 2026 at 11:59 PM ET. The Golden Ticket is a one-time cohort of exactly 3 businesses — once applications close, this page closes with it.</p>
        </div>

        <div class="bg-brand-dark p-6 rounded-xl border border-white/5">
          <h3 class="text-lg font-bold text-white mb-3">I already have a website. Can I still apply?</h3>
          <p class="text-white">Absolutely. If your current site is dated, slow, or invisible on Google, that's exactly the situation this program exists for. Tell us about it in the application.</p>
        </div>

        <div class="bg-brand-dark p-6 rounded-xl border border-white/5">
          <h3 class="text-lg font-bold text-white mb-3">What's the catch?</h3>
          <p class="text-white">No catch — just the four asks: an honest testimonial, a Google review, permission to feature your results in our marketing for 6 months (with your approval), and one warm intro to another business owner. We can afford the $497 waiver because those results help us win the next round of real clients.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Application Form -->
  <section id="apply-form" class="py-24 px-4 bg-brand-dark/50 border-y border-white/5" data-animate>
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ Applications Close December 15, 2026</p>
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">Apply for the Golden Ticket</h2>
        <p class="text-xl text-white mb-4">
          Tell your story — that's the whole application. 3 spots for the Class of 2026.
        </p>
        <p class="text-white/90 text-sm">
          Curious how the program fits with our standard plans? See full <a href="/pricing/" class="text-brand-cyan hover:text-white underline decoration-brand-cyan/30">pricing</a>
          or read how we <a href="/about/how-we-work/" class="text-brand-cyan hover:text-white underline decoration-brand-cyan/30">work with clients</a>.
        </p>
      </div>

      <form id="golden-ticket-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-5">
        <input type="hidden" name="access_key" value="6c43f496-301c-46c2-afe8-743b55e17bb6" />
        <input type="hidden" name="subject" value="The Golden Ticket Application — Shelby Web Co" />
        <input type="hidden" name="form_type" value="The Golden Ticket" />
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

        <div>
          <label for="gt-name" class="block text-sm font-medium text-white mb-2">Name *</label>
          <input type="text" name="name" id="gt-name" required placeholder="John Doe" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder:text-gray-400 text-base focus:outline-none focus:border-brand-accent transition-all focus:ring-1 focus:ring-brand-accent/20" />
        </div>

        <div>
          <label for="gt-email" class="block text-sm font-medium text-white mb-2">Email *</label>
          <input type="email" name="email" id="gt-email" required placeholder="john@example.com" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder:text-gray-400 text-base focus:outline-none focus:border-brand-accent transition-all focus:ring-1 focus:ring-brand-accent/20" />
        </div>

        <div>
          <label for="gt-phone" class="block text-sm font-medium text-white mb-2">Phone <span class="text-brand-sky/60">(optional)</span></label>
          <input type="tel" name="phone" id="gt-phone" placeholder="(704) 555-0123" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder:text-gray-400 text-base focus:outline-none focus:border-brand-accent transition-all focus:ring-1 focus:ring-brand-accent/20" />
        </div>

        <div>
          <label for="gt-business" class="block text-sm font-medium text-white mb-2">Business Name *</label>
          <input type="text" name="business" id="gt-business" required placeholder="Your Business LLC" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder:text-gray-400 text-base focus:outline-none focus:border-brand-accent transition-all focus:ring-1 focus:ring-brand-accent/20" />
        </div>

        <div>
          <label for="gt-industry" class="block text-sm font-medium text-white mb-2">Industry</label>
          <select name="industry" id="gt-industry" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 text-base focus:outline-none focus:border-brand-accent transition-all focus:ring-1 focus:ring-brand-accent/20">
            <option value="">Select one...</option>
            <option>Home services &amp; trades</option>
            <option>Construction &amp; remodeling</option>
            <option>Restaurant &amp; food</option>
            <option>Retail &amp; boutique</option>
            <option>Health, wellness &amp; beauty</option>
            <option>Professional services</option>
            <option>Nonprofit &amp; community</option>
            <option>Other</option>
          </select>
        </div>

        <div>
          <label for="gt-website" class="block text-sm font-medium text-white mb-2">Current Website <span class="text-brand-sky/60">(optional)</span></label>
          <input type="url" name="website" id="gt-website" placeholder="https://yourbusiness.com" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder:text-gray-400 text-base focus:outline-none focus:border-brand-accent transition-all focus:ring-1 focus:ring-brand-accent/20" />
        </div>

        <div>
          <label for="gt-story" class="block text-sm font-medium text-white mb-2">Why does your business deserve a digital refresh? *</label>
          <textarea name="story" id="gt-story" rows="6" required placeholder="Tell us what you do, who you serve, and why a modern website would change your next 12 months..." class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder:text-gray-400 text-base focus:outline-none focus:border-brand-accent transition-all focus:ring-1 focus:ring-brand-accent/20 resize-none"></textarea>
        </div>

        <div>
          <label for="gt-budget" class="block text-sm font-medium text-white mb-2">Current Monthly Marketing Budget</label>
          <select name="budget" id="gt-budget" class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 text-base focus:outline-none focus:border-brand-accent transition-all focus:ring-1 focus:ring-brand-accent/20">
            <option value="">Select one...</option>
            <option>Not currently spending</option>
            <option>Under $250 / month</option>
            <option>$250 – $500 / month</option>
            <option>$500 – $1,000 / month</option>
            <option>$1,000+ / month</option>
          </select>
        </div>

        <button type="submit" class="cta-glow-shine w-full inline-block bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-8 py-3 rounded-xl font-bold border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),inset_0_-2px_6px_rgba(0,0,0,0.25),0_4px_14px_rgba(0,0,0,0.4),0_2px_8px_rgba(132,204,22,0.35),0_0_20px_rgba(132,204,22,0.25)] hover:from-[#b5f146] hover:via-brand-accent-light hover:to-[#4d7c0f] hover:-translate-y-[1px] active:translate-y-[1px] active:shadow-[inset_0_2px_4px_rgba(0,0,0,0.3),0_2px_6px_rgba(0,0,0,0.3)] transition-all duration-300 text-lg">
          Submit My Application
        </button>

        <div id="golden-ticket-form-status" class="min-h-6 text-sm text-white"></div>
      </form>

      <div id="golden-ticket-form-success" class="hidden text-center bg-brand-darkest border border-lime-400/20 rounded-2xl p-10">
        <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.4)] text-brand-darkest mb-6">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
        </div>
        <h3 class="font-heading text-2xl md:text-3xl font-bold text-white mb-4">Application Received!</h3>
        <p class="text-white text-lg max-w-md mx-auto">
          Your story is in. We read every application personally — if you're one of the 3 winners for the Class of 2026,
          we'll reach out directly.
        </p>
      </div>
    </div>
  </section>

  <script>
    const goldenTicketForm = document.getElementById('golden-ticket-form') as HTMLFormElement | null;
    const goldenTicketStatus = document.getElementById('golden-ticket-form-status');
    if (goldenTicketForm) {
      goldenTicketForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(goldenTicketForm);
        if (formData.get('botcheck')) return;
        if (goldenTicketStatus) goldenTicketStatus.textContent = 'Sending...';
        if (goldenTicketStatus) goldenTicketStatus.className = 'min-h-6 text-sm text-white';
        try {
          const object = Object.fromEntries(formData);
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
            body: JSON.stringify(object)
          });
          const data = await res.json();
          if (data.success) {
            goldenTicketForm.style.display = 'none';
            const successPanel = document.getElementById('golden-ticket-form-success');
            if (successPanel) successPanel.classList.remove('hidden');
          } else {
            if (goldenTicketStatus) goldenTicketStatus.textContent = data.message || 'Something went wrong. Please try again.';
            if (goldenTicketStatus) goldenTicketStatus.className = 'min-h-6 text-sm text-red-400';
          }
        } catch (err) {
          if (goldenTicketStatus) goldenTicketStatus.textContent = 'Network error. Please try again.';
          if (goldenTicketStatus) goldenTicketStatus.className = 'min-h-6 text-sm text-red-400';
        }
      });
    }
  </script>

</BaseLayout>
