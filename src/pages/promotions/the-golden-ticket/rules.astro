---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JsonLd from '../../../components/JsonLd.astro';
import { breadcrumbSchema, SITE_URL } from '../../../lib/schema';

const pageUrl = `${SITE_URL}promotions/the-golden-ticket/rules/`;
---

<!-- [TODO: LEGAL REVIEW REQUIRED] Have counsel review before publishing/promoting. -->
<BaseLayout
  title="The Golden Ticket — Official Rules"
  description="Official rules for The Golden Ticket free website build program from Shelby Web Company. Eligibility, selection, timeline, and terms."
>
  <JsonLd data={[breadcrumbSchema([{ name: 'Golden Ticket Official Rules', url: pageUrl }])]} />

  <article class="pt-16 pb-24 px-4">
    <div class="max-w-3xl mx-auto">
      <p class="text-brand-glow text-xs font-bold uppercase tracking-widest mb-3">The Golden Ticket</p>
      <h1 class="font-heading text-3xl md:text-5xl font-black text-white mb-4 tracking-tight">Official Rules</h1>
      <p class="text-white/60 text-sm mb-10">Effective for the Class of 2026 cohort. Applications close December 15, 2026 at 11:59 PM ET.</p>

      <div class="prose prose-invert prose-lg max-w-none space-y-6">
        <section>
          <h2 class="font-heading text-2xl font-bold text-white mt-8 mb-3">1. Sponsor</h2>
          <p class="text-white/75">Shelby Web Company ("Sponsor"), Shelby, North Carolina. Contact: dave@shelbywebco.com · (704) 473-8188.</p>
        </section>

        <section>
          <h2 class="font-heading text-2xl font-bold text-white mt-8 mb-3">2. Program period</h2>
          <p class="text-white/75">Applications open until December 15, 2026, 11:59 PM ET. The program is a one-time cohort of exactly five (5) recipients ("Class of 2026").</p>
        </section>

        <section>
          <h2 class="font-heading text-2xl font-bold text-white mt-8 mb-3">3. Eligibility</h2>
          <ul class="list-disc pl-5 text-white/75 space-y-1">
            <li>Local businesses in the Sponsor's service areas (Cleveland County, Gaston County, and Western North Carolina communities served).</li>
            <li>Sole proprietors and small teams; must be open for business.</li>
            <li>Must be able to complete a discovery call and launch within the program window.</li>
            <li>One application per business. Employees and contractors of Sponsor are not eligible.</li>
          </ul>
        </section>

        <section>
          <h2 class="font-heading text-2xl font-bold text-white mt-8 mb-3">4. Selection</h2>
          <p class="text-white/75">Recipients are <b class="text-white">judged, not drawn at random</b>. Sponsor will evaluate applications based on story, need, fit, and how much a modern website would change the recipient's next twelve (12) months. Every application is reviewed by a human. Sponsor's decisions are final. No purchase necessary; purchase does not improve chances.</p>
        </section>

        <section>
          <h2 class="font-heading text-2xl font-bold text-white mt-8 mb-3">5. What recipients receive</h2>
          <ul class="list-disc pl-5 text-white/75 space-y-1">
            <li>Design, build, and launch of a custom 4–5 page website — the $497 Core launch fee waived (approx. $1,200 of work).</li>
            <li>Continuation on the Core plan at $297/month for a twelve (12) month initial term (hosting, security, backups, edits, foundational SEO).</li>
            <li>Standard Core plan inclusions as published at <a href="/pricing/" class="text-brand-cyan hover:text-white underline decoration-brand-cyan/30">shelbywebco.com/pricing</a>.</li>
          </ul>
          <p class="text-white/75 mt-3">Recipients are responsible for the monthly plan fee. No other costs apply unless separately agreed in writing (e.g., added pages or e-commerce).</p>
        </section>

        <section>
          <h2 class="font-heading text-2xl font-bold text-white mt-8 mb-3">6. What Sponsor asks in return</h2>
          <ul class="list-disc pl-5 text-white/75 space-y-1">
            <li>An honest testimonial.</li>
            <li>A Google review after launch, if genuinely satisfied.</li>
            <li>Permission to feature the recipient's business for six (6) months — recipient approves all uses first.</li>
            <li>One warm introduction to another business owner who may need a website.</li>
          </ul>
        </section>

        <section>
          <h2 class="font-heading text-2xl font-bold text-white mt-8 mb-3">7. Publicity</h2>
          <p class="text-white/75">Recipient names and case studies may be published on the Sponsor's website and social channels after mutual approval. Recipients may decline feature use at any time without affecting their participation.</p>
        </section>

        <section>
          <h2 class="font-heading text-2xl font-bold text-white mt-8 mb-3">8. General terms</h2>
          <p class="text-white/75">Sponsor reserves the right to disqualify fraudulent, incomplete, or ineligible applications. The program is void where prohibited. These rules are governed by the laws of the State of North Carolina. By applying, participants agree to these rules.</p>
          <p class="text-white/75">Not affiliated with, endorsed by, or sponsored by Google, Meta, or any sweepstakes clearinghouse.</p>
        </section>

        <section>
          <h2 class="font-heading text-2xl font-bold text-white mt-8 mb-3">9. Winner notice</h2>
          <p class="text-white/75">Recipients will be contacted directly using the email or phone provided in the application. The Class of 2026 results will be published on the <a href="/promotions/the-golden-ticket/" class="text-brand-cyan hover:text-white underline decoration-brand-cyan/30">Golden Ticket page</a> after selection.</p>
        </section>
      </div>

      <p class="mt-12">
        <a href="/promotions/the-golden-ticket/" class="text-white/80 hover:text-white">← Back to The Golden Ticket</a>
      </p>
    </div>
  </article>
</BaseLayout>
