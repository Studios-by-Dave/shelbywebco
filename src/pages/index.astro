---
import BaseLayout from '../layouts/BaseLayout.astro';
import Image from '../components/OptimizedImage.astro';
import ProjectPopup from '../components/ProjectPopup.jsx';
import heroImage from '../../assets/Sweb_hero1.jpg';
import googleStars from '../../assets/badge icons/google 5 stars.png';
import comptiaBadge from '../../assets/badge icons/CompTIA_A__Digital_Badge.jpg';

import mascotOne from '../../assets/mascot_1.jpg';
import newBadges25 from '../../assets/badge icons/NewBadges25.png';

import chatgptLogo from '../../assets/logo banner/chatgpt-logo-chat-gpt-icon-on-black-background-free-vector.jpg';
import claudeLogo from '../../assets/logo banner/claude-Ekx6wd5U.png';
import comptiaTool from '../../assets/logo banner/comptia-Cm7O9_X6.png';
import devinLogo from '../../assets/logo banner/devin-logo-1.png';
import githubLogo from '../../assets/logo banner/github-logo-png_seeklogo-304612.png';
import grokLogo from '../../assets/logo banner/grok-ai-icon.webp';
import linuxLogo from '../../assets/logo banner/linux-operating-systems-logo-whatsapp-logo.jpg';
import ollamaLogo from '../../assets/logo banner/ollama-logo1.png';
import opencodeLogo from '../../assets/logo banner/opencode-BrfWWnj4.png';
import vscodeLogo from '../../assets/logo banner/vscode--vbwWAnL.jpeg';
import hsCross from '../../assets/logo banner/hscross.webp';
import FaqSection from '../components/FaqSection.astro';

const faqItems = [
  {
    question: 'Do I have to purchase SEO with my website?',
    answer: 'No. You can purchase the website build for $497 without an ongoing SEO subscription. Without SEO, the $149/month Website Care Plan covers hosting, backups, edits, and updates, month-to-month with no minimum term. We recommend pairing your website with local SEO to continue working on your search visibility after launch.'
  },
  {
    question: 'How long should I give SEO?',
    answer: 'We strongly recommend six to twelve months of consistent work to give improvements time to develop and provide a meaningful period for evaluating progress. Plans are month-to-month, and six to twelve months is what we recommend for evaluating progress. Results and timing vary based on your website, competition, and market.'
  },
  {
    question: 'Do I have to keep paying for SEO?',
    answer: 'SEO plans are month-to-month, so there is no minimum term. You can cancel any time with 30 days’ written notice, and future SEO work and billing stop. Canceling SEO does not cancel your website.'
  },
  {
    question: 'What happens to previous SEO work if I cancel?',
    answer: 'Canceling ends the ongoing service; it does not mean we reverse completed website improvements. Future updates, monitoring, and optimization included in your SEO plan stop when the service ends.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqItems.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer
    }
  }))
};
import marbleBg from '../../assets/marble-800x530.webp';
import pricingCompare from '../../assets/pricing_chart_2.jpg';
---

<BaseLayout 
  title="Shelby Web Company | Web Design & SEO in Shelby, NC"
  description="Custom websites from $497 and local SEO at $297/month. Month-to-month, cancel anytime. Web design and SEO in Shelby, NC. Call (704) 473-8188."
  bgVariant="blue"
>

  <!-- Promo Ticker/Marquee Bar -->
  <div class="bg-[#0e1c4e]/90 backdrop-blur border-b border-white/10 overflow-hidden relative z-20 py-2 flex">
    <div class="absolute inset-0 bg-gradient-to-b from-white/5 to-transparent pointer-events-none"></div>
    <div class="flex whitespace-nowrap animate-promo-ticker relative z-10 w-max shrink-0" aria-hidden="true">
      <div class="flex items-center space-x-12 px-6">
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <span class="text-brand-accent">Free Logo Design</span> with any Growth Plan!</span>
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <span class="text-brand-accent">$100 Unlimited Referral Bonus!</span></span>
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <span class="text-brand-accent">Free SEO Audit</span> for Local Businesses!</span>
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <a href="/promotions/free-logo-design/" class="text-brand-accent hover:underline">Free Logo Design</a> with any Growth Plan!</span>
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <a href="/promotions/referral-bonus/" class="text-brand-accent hover:underline">$100 Unlimited Referral Bonus</a>!</span>
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <a href="/promotions/free-seo-audit/" class="text-brand-accent hover:underline">Free SEO Audit</a> for Local Businesses!</span>
      </div>
    </div>
    <div class="flex whitespace-nowrap animate-promo-ticker relative z-10 w-max shrink-0" aria-hidden="true">
      <div class="flex items-center space-x-12 px-6">
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <span class="text-brand-accent">Free Logo Design</span> with any Growth Plan!</span>
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <span class="text-brand-accent">$100 Unlimited Referral Bonus!</span></span>
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <span class="text-brand-accent">Free SEO Audit</span> for Local Businesses!</span>
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <a href="/promotions/free-logo-design/" class="text-brand-accent hover:underline">Free Logo Design</a> with any Growth Plan!</span>
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <a href="/promotions/referral-bonus/" class="text-brand-accent hover:underline">$100 Unlimited Referral Bonus</a>!</span>
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <a href="/promotions/free-seo-audit/" class="text-brand-accent hover:underline">Free SEO Audit</a> for Local Businesses!</span>
      </div>
    </div>
  </div>

  <div id="golden-ticket-easter-egg" class="golden-ticket-easter-egg" aria-hidden="true"></div>

  <style>
    @keyframes promo-ticker {
      0% { transform: translateX(0%); }
      100% { transform: translateX(-100%); }
    }
    .animate-promo-ticker {
      animation: promo-ticker 75s linear infinite;
    }
  </style>

  <!-- Hero Section -->
  <section class="pt-14 pb-16 px-4 sm:px-6 lg:pt-20 lg:pb-20 overflow-hidden" data-animate>
    <div class="max-w-5xl mx-auto flex flex-col items-center text-center relative">
      <span class="handshake-anchor absolute top-0 right-2 lg:hidden" aria-hidden="true"></span>
      <div class="inline-flex items-center space-x-2 rounded-full py-1.5 px-4 mb-6 bg-white/10 border border-white/20 backdrop-blur">
        <span class="flex h-2 w-2 rounded-full bg-brand-accent animate-pulse shadow-[0_0_8px_rgba(132,204,22,0.8)]"></span>
        <span class="text-white font-bold text-sm tracking-wide">SHELBY, NC WEB DESIGN & LOCAL SEO</span>
      </div>
      <h1 class="font-heading text-[clamp(3rem,7vw,5rem)] font-black mb-5 leading-[1.02] tracking-tight text-white max-w-4xl">
        Websites. <span class="text-brand-accent">Local SEO.</span> Custom Tools.
      </h1>
      <p class="text-lg md:text-xl text-[#f4c95d] mb-2 max-w-2xl leading-relaxed font-semibold" style="text-shadow: 0 0 12px rgba(244, 201, 93, 0.25);">
        “Technology That Fills The Gaps.”
      </p>
      <p class="text-base sm:text-lg text-white/70 mb-8 max-w-2xl leading-relaxed italic">
        We build solutions. From professional websites and better search visibility to custom-built tools that solve operational challenges, we help local businesses work smarter and grow.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-8">
        <a
          href="/contact/"
          class="cta-glow-shine rounded-full bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-8 py-4 font-bold border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),inset_0_-2px_6px_rgba(0,0,0,0.25),0_4px_14px_rgba(0,0,0,0.4),0_2px_8px_rgba(132,204,22,0.35),0_0_20px_rgba(132,204,22,0.25)] hover:-translate-y-[1px] transition-all duration-300 text-base sm:text-lg text-center"
        >
          Start a Project
        </a>
        <a
          href="/promotions/"
          class="rounded-full border border-white/30 bg-white/5 px-8 py-4 text-center text-base sm:text-lg font-semibold text-white transition-all duration-300 hover:bg-white/10 hover:border-white/50"
        >
          View Promotions
        </a>
      </div>
      <a
        href="tel:+17044738188"
        class="inline-flex flex-col items-center group rounded-2xl bg-white/5 border border-white/15 backdrop-blur px-8 py-5 hover:border-brand-accent/50 transition-all duration-300 mb-4"
      >
        <p class="text-white/70 text-xs font-semibold tracking-[0.2em] mb-1">CALL OR TEXT 24/7</p>
        <p class="text-brand-accent text-3xl sm:text-4xl font-heading font-bold group-hover:text-brand-accent-light transition-colors leading-none tracking-tight" style="text-shadow: 0 0 12px rgba(132,204,22,0.6), 0 0 24px rgba(132,204,22,0.3);">(704) 473-8188</p>
        <p class="text-white/60 text-xs font-medium mt-2">Just click and call! We're here <span class="text-white font-semibold">24/7</span> &bull; <span class="text-white/80">dave@shelbywebco.com</span></p>
      </a>

      <div class="rounded-3xl p-1 my-8 bg-gradient-to-br from-white/20 to-white/5 w-full max-w-[46rem] relative mx-auto">
        <Image 
          src={heroImage} 
          alt="Professional web design and local SEO services in Shelby, NC - Shelby Web Company" 
          class="rounded-[22px] w-full h-auto"
          width={800}
          height={600}
          loading="eager"
        />
        <div class="handshake-anchor absolute pointer-events-none" style="left:48%;top:78%;" aria-hidden="true"></div>
      </div>

      <p class="italic text-white/85 text-base sm:text-lg leading-relaxed max-w-2xl mb-6">
        $497 to build and deploy + $297/month for continued buildout and SEO. Standalone build: $149/month Website Care Plan. Month-to-month, cancel any time.
      </p>
      <p class="text-white/80 text-sm flex items-center gap-1.5 mb-10">
        <span class="text-brand-accent leading-none">★★★★★</span>
        5.0 on Google
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-6 sm:gap-10 mb-10">
        <p class="italic text-white/85 text-base sm:text-lg">• Custom websites that convert</p>
        <p class="italic text-white/85 text-base sm:text-lg">• Local SEO for Shelby &amp; Cleveland County</p>
        <p class="italic text-white/85 text-base sm:text-lg">• Custom Business Machines</p>
      </div>

      <div class="flex flex-wrap gap-2 mb-10 justify-center">
        <a href="/services/web-design/" class="inline-flex items-center min-h-[44px] text-white/85 border border-white/20 bg-white/5 rounded-full px-4 py-1.5 text-sm font-semibold hover:bg-white/10 hover:border-white/40 transition-all duration-300">Web Design</a>
        <a href="/services/seo/" class="inline-flex items-center min-h-[44px] text-white/85 border border-white/20 bg-white/5 rounded-full px-4 py-1.5 text-sm font-semibold hover:bg-white/10 hover:border-white/40 transition-all duration-300">SEO</a>
        <a href="/services/branding/" class="inline-flex items-center min-h-[44px] text-white/85 border border-white/20 bg-white/5 rounded-full px-4 py-1.5 text-sm font-semibold hover:bg-white/10 hover:border-white/40 transition-all duration-300">Branding</a>
        <a href="/services/custom-software-saas/" class="inline-flex items-center min-h-[44px] text-white/85 border border-white/20 bg-white/5 rounded-full px-4 py-1.5 text-sm font-semibold hover:bg-white/10 hover:border-white/40 transition-all duration-300">Custom Software</a>
      </div>

      <div class="flex flex-row items-center justify-center gap-5">
        <Image 
          src={googleStars} 
          alt="5 Star Google Reviews" 
          class="h-24 sm:h-28 md:h-32 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity"
        />
        <Image 
          src={comptiaBadge} 
          alt="CompTIA A+ Certified" 
          class="h-20 sm:h-24 md:h-28 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity rounded-lg"
        />
      </div>
    </div>
  </section>

<!-- Services Section -->
  <section class="py-10 md:py-14 px-4 relative z-20" data-animate>
    <div class="max-w-7xl mx-auto">
      <div class="rounded-3xl p-1 mb-10 bg-gradient-to-br from-white/20 to-white/5 relative overflow-hidden">
        <div class="relative w-full rounded-[22px] overflow-hidden bg-cover bg-center py-10 md:py-14 px-4 md:px-8" style={`background-image: url("${encodeURI(marbleBg.src)}")`}>
          <div class="absolute inset-0 bg-[#08090f]/55"></div>
          <h2 class="relative font-heading font-black text-white text-center tracking-tight leading-[1.05] text-[clamp(2.2rem,5.5vw,4rem)]">
            Web Design &bull; <span class="text-brand-accent">SEO</span> &bull; Branding<br class="hidden sm:block" /> <span class="sm:hidden">&bull; </span><span class="text-brand-accent">AI Visibility</span> &bull; Custom Software
          </h2>
          <p class="relative text-body-lg text-white/90 max-w-3xl leading-relaxed text-center mt-6 mx-auto">
            We help local businesses grow with custom websites and SEO built around your goals. At Shelby Web Company, everything we do is focused on getting you found, trusted, and hired.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Web Design Card -->
        <a href="/services/web-design/" class="group block bg-white/[0.04] border border-white/10 rounded-2xl p-6 hover:border-brand-accent/60 hover:bg-white/[0.07] hover:-translate-y-2 transition-all duration-300 cursor-pointer">
          <div class="relative z-10">
            <div class="w-14 h-14 bg-brand-accent/15 border border-brand-accent/40 shadow-[0_0_15px_rgba(132,204,22,0.25)] rounded-xl flex items-center justify-center mb-4">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7 text-brand-accent"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <h3 class="font-heading text-2xl font-bold text-white mb-3">Web Design</h3>
            <ul class="list-disc pl-4 space-y-1.5 text-base leading-snug text-white/75 mb-4">
              <li>Custom sites that turn visitors into customers</li>
              <li>Built for local service businesses</li>
              <li>Mobile-first and lightning-fast</li>
              <li>Lead forms + local SEO included</li>
            </ul>
            <span class="text-brand-accent group-hover:text-brand-accent-light text-base font-semibold transition-colors">
              Learn About Web Design →
            </span>
          </div>
        </a>

        <!-- Branding Card -->
        <a href="/services/branding/" class="group block bg-white/[0.04] border border-white/10 rounded-2xl p-6 hover:border-brand-accent/60 hover:bg-white/[0.07] hover:-translate-y-2 transition-all duration-300 cursor-pointer">
          <div class="relative z-10">
            <div class="w-14 h-14 bg-brand-accent/15 border border-brand-accent/40 shadow-[0_0_15px_rgba(132,204,22,0.25)] rounded-xl flex items-center justify-center mb-4">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7 text-brand-accent"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
            </div>
            <h3 class="font-heading text-2xl font-bold text-white mb-3">Logo Design & Branding</h3>
            <ul class="list-disc pl-4 space-y-1.5 text-base leading-snug text-white/75 mb-4">
              <li>Branding that stands out</li>
              <li>Builds trust with customers</li>
              <li>Custom logo + full brand identity</li>
              <li>Business cards and social assets</li>
            </ul>
            <span class="text-brand-accent group-hover:text-brand-accent-light text-base font-semibold transition-colors">
              Learn About Branding →
            </span>
          </div>
        </a>

        <!-- SEO Card -->
        <a href="/services/seo/" class="group block bg-white/[0.04] border border-white/10 rounded-2xl p-6 hover:border-brand-accent/60 hover:bg-white/[0.07] hover:-translate-y-2 transition-all duration-300 cursor-pointer">
          <div class="relative z-10">
            <div class="w-14 h-14 bg-brand-accent/15 border border-brand-accent/40 shadow-[0_0_15px_rgba(132,204,22,0.25)] rounded-xl flex items-center justify-center mb-4">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7 text-brand-accent"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <h3 class="font-heading text-2xl font-bold text-white mb-3">SEO Services</h3>
            <ul class="list-disc pl-4 space-y-1.5 text-base leading-snug text-white/75 mb-4">
              <li>More visibility, more customers</li>
              <li>Technical + on-page optimization</li>
              <li>Local search strategy</li>
              <li>Google Business Profile setup</li>
            </ul>
            <span class="text-brand-accent group-hover:text-brand-accent-light text-base font-semibold transition-colors">
              Learn About SEO Services →
            </span>
          </div>
        </a>

        <!-- Custom Software & SaaS Card -->
        <a href="/services/custom-software-saas/" class="group block bg-white/[0.04] border border-white/10 rounded-2xl p-6 hover:border-brand-accent/60 hover:bg-white/[0.07] hover:-translate-y-2 transition-all duration-300 cursor-pointer">
          <div class="relative z-10">
            <div class="w-14 h-14 bg-brand-accent/15 border border-brand-accent/40 shadow-[0_0_15px_rgba(132,204,22,0.25)] rounded-xl flex items-center justify-center mb-4">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7 text-brand-accent"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
            </div>
            <h3 class="font-heading text-2xl font-bold text-white mb-3">Custom Software & SaaS (Business Machines)</h3>
            <ul class="list-disc pl-4 space-y-1.5 text-base leading-snug text-white/75 mb-4">
              <li>Software built around your workflow</li>
              <li>Automate the busywork</li>
              <li>SaaS apps and API integrations</li>
              <li>Tools that give you an edge</li>
            </ul>
            <span class="text-brand-accent group-hover:text-brand-accent-light text-base font-semibold transition-colors">
              Learn About Custom Software →
            </span>
          </div>
        </a>
      </div>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-5">
        <a href="/services/" class="inline-flex items-center text-white/90 hover:text-white font-semibold text-body-lg transition-colors underline decoration-brand-accent decoration-2 underline-offset-4">
          View All Services →
        </a>
        <a href="/contact/" class="cta-glow-shine inline-flex items-center justify-center whitespace-nowrap rounded-full bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-8 py-3.5 font-bold border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),inset_0_-2px_6px_rgba(0,0,0,0.25),0_4px_14px_rgba(0,0,0,0.4),0_2px_8px_rgba(132,204,22,0.35),0_0_20px_rgba(132,204,22,0.25)] hover:-translate-y-[1px] active:translate-y-[1px] transition-all duration-300 text-base">
          Get Your Free Quote
        </a>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16 px-4 border-t border-white/10" data-animate>
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="font-heading text-section-heading-md lg:text-5xl font-bold text-white mb-4">
          3 Simple Steps. No Red Tape. <span class="text-brand-accent">Just Process.</span>
        </h2>
        <p class="text-white/75 text-body-lg max-w-2xl mx-auto">
          Every project starts with a conversation, gets shaped by research, and is built with a clear plan.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 mb-10">
        <!-- Step 1 -->
        <div class="relative bg-white/[0.04] border border-white/10 rounded-2xl p-7 hover:border-brand-accent/40 transition-colors">
          <div class="w-14 h-14 rounded-full bg-brand-accent border border-brand-accent shadow-[0_0_18px_rgba(132,204,22,0.4)] flex items-center justify-center text-[#08090f] text-2xl font-black mb-5">1</div>
          <h3 class="font-heading text-2xl font-bold text-white mb-3">The Friendly Pre-Discovery</h3>
          <p class="text-white/75 text-lg leading-relaxed">A casual conversation about your business — no jargon, no pressure. We learn what makes you unique and what you need online.</p>
        </div>

        <!-- Step 2 -->
        <div class="relative bg-white/[0.04] border border-white/10 rounded-2xl p-7 hover:border-brand-accent/40 transition-colors">
          <div class="w-14 h-14 rounded-full bg-brand-accent border border-brand-accent shadow-[0_0_18px_rgba(132,204,22,0.4)] flex items-center justify-center text-[#08090f] text-2xl font-black mb-5">2</div>
          <h3 class="font-heading text-2xl font-bold text-white mb-3">The Strategy Map</h3>
          <p class="text-white/75 text-lg leading-relaxed">Research becomes a plan. We map out SEO, content, and structure tailored to your keywords, geography, and customers.</p>
        </div>

        <!-- Step 3 -->
        <div class="relative bg-white/[0.04] border border-white/10 rounded-2xl p-7 hover:border-brand-accent/40 transition-colors">
          <div class="w-14 h-14 rounded-full bg-brand-accent border border-brand-accent shadow-[0_0_18px_rgba(132,204,22,0.4)] flex items-center justify-center text-[#08090f] text-2xl font-black mb-5">3</div>
          <h3 class="font-heading text-2xl font-bold text-white mb-3">The Build</h3>
          <p class="text-white/75 text-lg leading-relaxed">Design, copy, and build follow the strategy. Review rounds keep you in control. Launch with SEO foundations in place.</p>
        </div>
      </div>

      <!-- Payment Terms Trust Bar -->
      <div class="bg-white/[0.05] border border-brand-accent/30 rounded-2xl p-6 flex flex-col sm:flex-row items-center justify-between gap-4 mb-10">
        <div>
          <p class="text-white font-semibold text-lg">Simple Payment Terms</p>
          <p class="text-white/75 text-base">$497 for your website build, then one simple monthly SEO plan — month-to-month, cancel at any time with 30 days’ notice.</p>
        </div>
        <a href="/pricing/" class="text-brand-accent hover:text-brand-accent-light font-semibold text-base whitespace-nowrap transition-colors">See transparent pricing →</a>
