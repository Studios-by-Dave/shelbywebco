---
import BaseLayout from '../layouts/BaseLayout.astro';
import Image from '../components/OptimizedImage.astro';
import ProjectPopup from '../components/ProjectPopup.jsx';
import heroImage from '../../assets/Sweb_hero1.jpg';
import googleStars from '../../assets/badge icons/google 5 stars.png';
import comptiaBadge from '../../assets/badge icons/CompTIA_A__Digital_Badge.jpg';

import mascotOne from '../../assets/mascot_1.jpg';

import GoogleReview from '../components/GoogleReview.astro';
import FaqSection from '../components/FaqSection.astro';

const faqItems = [
  {
    question: 'How do I know if my website has a problem?',
    answer: 'Start with our free SEO audit. It checks whether your homepage is visible on Google, reviews your titles and meta descriptions, spot-checks indexing, and flags obvious local SEO issues — with 2–3 quick recommendations you can act on right away. It’s a diagnostic, not consulting, and it’s free for local businesses.'
  },
  {
    question: 'Can AI-built websites be fixed, or do I need a new one?',
    answer: 'It depends on the foundation. Many AI-generated sites have fixable problems — missing indexing setup, generic copy, weak structure. We diagnose first, then tell you honestly whether a rescue or a rebuild is the better investment.'
  },
  {
    question: 'My website isn’t showing up on Google at all. What does that usually mean?',
    answer: 'Usually one of three things: the site isn’t being indexed, basic technical SEO is missing, or the content doesn’t match what local customers actually search for. The free audit identifies which of these applies to you.'
  },
  {
    question: 'Do you offer ongoing support after the fixes?',
    answer: 'Yes. Website care and ongoing local SEO plans are month-to-month with no minimum term. You can cancel any time with 30 days’ written notice, and future work and billing stop. Canceling service does not reverse completed improvements to your website.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqItems.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer
    }
  }))
};
import marbleBg from '../../assets/marble-800x530.webp';
---

<BaseLayout 
  title="Website Rescue, SEO Fixes & New Website Builds | Shelby Web Co."
  description="Website rescue, SEO fixes, and strategic website builds from $497. Month-to-month, cancel anytime. Web design and SEO in Shelby, NC. Call (704) 473-8188."
  bgVariant="blue"
>

  <!-- Promo Ticker/Marquee Bar -->
  <div class="bg-[#0e1c4e]/90 backdrop-blur border-b border-white/10 overflow-hidden relative z-20 py-2 flex">
    <div class="absolute inset-0 bg-gradient-to-b from-white/5 to-transparent pointer-events-none"></div>
    <div class="flex whitespace-nowrap animate-promo-ticker relative z-10 w-max shrink-0" aria-hidden="true">
      <div class="flex items-center space-x-12 px-6">
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <span class="text-brand-accent">Free Logo Design</span> with any Growth Plan!</span>
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <span class="text-brand-accent">Free SEO Audit</span> for Local Businesses!</span>
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <a href="/promotions/free-logo-design/" class="text-brand-accent hover:underline">Free Logo Design</a> with any Growth Plan!</span>
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <a href="/promotions/free-seo-audit/" class="text-brand-accent hover:underline">Free SEO Audit</a> for Local Businesses!</span>
      </div>
    </div>
    <div class="flex whitespace-nowrap animate-promo-ticker relative z-10 w-max shrink-0" aria-hidden="true">
      <div class="flex items-center space-x-12 px-6">
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <span class="text-brand-accent">Free Logo Design</span> with any Growth Plan!</span>
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <span class="text-brand-accent">Free SEO Audit</span> for Local Businesses!</span>
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <a href="/promotions/free-logo-design/" class="text-brand-accent hover:underline">Free Logo Design</a> with any Growth Plan!</span>
        <span class="text-white text-xl font-heading drop-shadow-sm">✦ <a href="/promotions/free-seo-audit/" class="text-brand-accent hover:underline">Free SEO Audit</a> for Local Businesses!</span>
      </div>
    </div>
  </div>

  <div id="golden-ticket-easter-egg" class="golden-ticket-easter-egg" aria-hidden="true"></div>

  <style>
    @keyframes promo-ticker {
      0% { transform: translateX(0%); }
      100% { transform: translateX(-100%); }
    }
    .animate-promo-ticker {
      animation: promo-ticker 75s linear infinite;
    }
  </style>

  <!-- Hero Section -->
  <section class="pt-14 pb-16 px-4 sm:px-6 lg:pt-20 lg:pb-20 overflow-hidden" data-animate>
    <div class="max-w-5xl mx-auto flex flex-col items-center text-center relative">
      <span class="handshake-anchor absolute top-0 right-2 lg:hidden" aria-hidden="true"></span>
      <div class="inline-flex items-center space-x-2 rounded-full py-1.5 px-4 mb-6 bg-white/10 border border-white/20 backdrop-blur">
        <span class="flex h-2 w-2 rounded-full bg-brand-accent animate-pulse shadow-[0_0_8px_rgba(132,204,22,0.8)]"></span>
        <span class="text-white font-bold text-sm tracking-wide">SHELBY, NC — WEBSITE RESCUE & LOCAL SEO</span>
      </div>
      <h1 class="font-heading text-[clamp(2.5rem,5.5vw,4.25rem)] font-black mb-5 leading-[1.05] tracking-tight text-white max-w-4xl">
        <span class="text-brand-accent">Website Rescue,</span> SEO Fixes, and Strategic Website Builds
      </h1>
      <p class="text-lg md:text-xl text-[#f4c95d] mb-2 max-w-2xl leading-relaxed font-semibold" style="text-shadow: 0 0 12px rgba(244, 201, 93, 0.25);">
        “Technology That Fills The Gaps.”
      </p>
      <p class="text-base sm:text-lg text-white/70 mb-3 max-w-2xl leading-relaxed">
        We also repair underperforming websites, clean up AI-generated issues, and build new sites when a fresh start makes sense.
      </p>
      <p class="text-base sm:text-lg text-white/85 mb-8 max-w-2xl leading-relaxed italic">
        If your website looks generic, isn’t indexing, or isn’t bringing in business — <span class="text-brand-accent font-semibold not-italic">we can help.</span>
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-8">
        <a
          href="/promotions/free-seo-audit/"
          class="cta-glow-shine rounded-full bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-8 py-4 font-bold border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),inset_0_-2px_6px_rgba(0,0,0,0.25),0_4px_14px_rgba(0,0,0,0.4),0_2px_8px_rgba(132,204,22,0.35),0_0_20px_rgba(132,204,22,0.25)] hover:-translate-y-[1px] transition-all duration-300 text-base sm:text-lg text-center"
        >
          Get My Free Audit
        </a>
        <a
          href="/services/"
          class="rounded-full border border-white/30 bg-white/5 px-8 py-4 text-center text-base sm:text-lg font-semibold text-white transition-all duration-300 hover:bg-white/10 hover:border-white/50"
        >
          Explore Services
        </a>
      </div>
      <a
        href="tel:+17044738188"
        class="inline-flex flex-col items-center group rounded-2xl bg-white/5 border border-white/15 backdrop-blur px-8 py-5 hover:border-brand-accent/50 transition-all duration-300 mb-4"
      >
        <p class="text-white/70 text-xs font-semibold tracking-[0.2em] mb-1">CALL OR TEXT 24/7</p>
        <p class="text-brand-accent text-3xl sm:text-4xl font-heading font-bold group-hover:text-brand-accent-light transition-colors leading-none tracking-tight" style="text-shadow: 0 0 12px rgba(132,204,22,0.6), 0 0 24px rgba(132,204,22,0.3);">(704) 473-8188</p>
        <p class="text-white/60 text-xs font-medium mt-2">Just click and call! We're here <span class="text-white font-semibold">24/7</span> &bull; <span class="text-white/80">dave@shelbywebco.com</span></p>
      </a>

      <div class="rounded-3xl p-1 my-8 bg-gradient-to-br from-white/20 to-white/5 w-full max-w-[46rem] relative mx-auto">
        <Image 
          src={heroImage} 
          alt="Professional web design and local SEO services in Shelby, NC - Shelby Web Company" 
          class="rounded-[22px] w-full h-auto"
          width={800}
          height={600}
          loading="eager"
        />
        <div class="handshake-anchor absolute pointer-events-none" style="left:48%;top:78%;" aria-hidden="true"></div>
      </div>

      <p class="text-white/80 text-sm flex items-center gap-1.5 mb-4">
        <span class="text-brand-accent leading-none">★★★★★</span>
        5.0 on Google
      </p>
      <GoogleReview
        quote="Very professional. And very knowledgeable about what can and can't be done. Highly recommend David."
        name="Roger P."
        class="mb-10"
      />

      <div class="flex flex-col sm:flex-row items-center justify-center gap-6 sm:gap-10 mb-10">
        <p class="italic text-white/85 text-base sm:text-lg">• Websites repaired, rescued, and rebuilt — only when a rebuild is truly needed</p>
        <p class="italic text-white/85 text-base sm:text-lg">• Local SEO for Shelby &amp; Cleveland County</p>
        <p class="italic text-white/85 text-base sm:text-lg">• Free SEO audit so you know exactly what's wrong</p>
      </div>

      <div class="flex flex-wrap gap-2 mb-10 justify-center">
        <a href="/services/web-design/" class="inline-flex items-center min-h-[44px] text-white/85 border border-white/20 bg-white/5 rounded-full px-4 py-1.5 text-sm font-semibold hover:bg-white/10 hover:border-white/40 transition-all duration-300">Web Design</a>
        <a href="/services/seo/" class="inline-flex items-center min-h-[44px] text-white/85 border border-white/20 bg-white/5 rounded-full px-4 py-1.5 text-sm font-semibold hover:bg-white/10 hover:border-white/40 transition-all duration-300">SEO</a>
        <a href="/services/branding/" class="inline-flex items-center min-h-[44px] text-white/85 border border-white/20 bg-white/5 rounded-full px-4 py-1.5 text-sm font-semibold hover:bg-white/10 hover:border-white/40 transition-all duration-300">Branding</a>
        <a href="/services/custom-software-saas/" class="inline-flex items-center min-h-[44px] text-white/85 border border-white/20 bg-white/5 rounded-full px-4 py-1.5 text-sm font-semibold hover:bg-white/10 hover:border-white/40 transition-all duration-300">Custom Software</a>
      </div>

      <div class="flex flex-row items-center justify-center gap-5">
        <Image 
          src={googleStars} 
          alt="5 Star Google Reviews" 
          class="h-24 sm:h-28 md:h-32 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity"
        />
        <Image 
          src={comptiaBadge} 
          alt="CompTIA A+ Certified" 
          class="h-20 sm:h-24 md:h-28 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity rounded-lg"
        />
      </div>
    </div>
  </section>

  <!-- Problem Section: Your website may need rescue if... -->
  <section class="py-14 md:py-18 px-4 border-t border-white/10" data-animate aria-labelledby="rescue-if-heading">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <p class="uppercase tracking-widest mb-3 font-semibold italic text-brand-accent text-sm">THE WARNING SIGNS</p>
        <h2 id="rescue-if-heading" class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-4">
          Your Website May Need Rescue If...
        </h2>
        <p class="text-white/75 text-body-lg max-w-2xl mx-auto leading-relaxed">
          Most website problems are invisible to the owner. You don't see them — your customers (and Google) do. Check any that sound familiar:
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-5 md:gap-6">
        <!-- Symptom 1 -->
        <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-6 hover:border-brand-accent/40 transition-colors">
          <h3 class="font-heading text-xl font-bold text-white mb-2">Your site isn't showing up on Google.</h3>
          <p class="text-white/75 text-base leading-relaxed mb-3">You can search your business name and still can't find it — or only the homepage appears, never your services.</p>
          <p class="text-brand-accent/90 text-sm font-semibold italic">Likely cause: indexing problems, technical SEO, or no sitemap.</p>
        </div>

        <!-- Symptom 2 -->
        <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-6 hover:border-brand-accent/40 transition-colors">
          <h3 class="font-heading text-xl font-bold text-white mb-2">You're not getting calls, forms, or leads from it.</h3>
          <p class="text-white/75 text-base leading-relaxed mb-3">The site looks fine to you, but the phone stays quiet and nobody fills out the form.</p>
          <p class="text-brand-accent/90 text-sm font-semibold italic">Likely cause: weak calls-to-action, no trust signals, confusing page flow.</p>
        </div>

        <!-- Symptom 3 -->
        <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-6 hover:border-brand-accent/40 transition-colors">
          <h3 class="font-heading text-xl font-bold text-white mb-2">It looks "AI-built" or generic.</h3>
          <p class="text-white/75 text-base leading-relaxed mb-3">Cookie-cutter layout, robotic copy, stock everything. Customers notice — and so does Google.</p>
          <p class="text-brand-accent/90 text-sm font-semibold italic">Likely cause: AI-generated pages published without review or strategy.</p>
        </div>

        <!-- Symptom 4 -->
        <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-6 hover:border-brand-accent/40 transition-colors">
          <h3 class="font-heading text-xl font-bold text-white mb-2">It hasn't been touched in months (or years).</h3>
          <p class="text-white/75 text-base leading-relaxed mb-3">Broken links, outdated info, slow load times, features that stopped working.</p>
          <p class="text-brand-accent/90 text-sm font-semibold italic">Likely cause: no ongoing care or monitoring.</p>
        </div>

        <!-- Symptom 5 -->
        <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-6 hover:border-brand-accent/40 transition-colors">
          <h3 class="font-heading text-xl font-bold text-white mb-2">You built it yourself, with a tool, or with AI — and it never really launched.</h3>
          <p class="text-white/75 text-base leading-relaxed mb-3">It went live, but never got indexed, never ranked, and never produced business.</p>
          <p class="text-brand-accent/90 text-sm font-semibold italic">Likely cause: no SEO foundation at launch.</p>
        </div>

        <!-- Symptom 6 -->
        <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-6 hover:border-brand-accent/40 transition-colors">
          <h3 class="font-heading text-xl font-bold text-white mb-2">It fails on a phone.</h3>
          <p class="text-white/75 text-base leading-relaxed mb-3">Half your customers are on mobile. If buttons are tiny, text is cramped, or pages crawl, they leave.</p>
          <p class="text-brand-accent/90 text-sm font-semibold italic">Likely cause: template or AI layout never tested on real devices.</p>
        </div>
      </div>

      <div class="mt-10 text-center">
        <p class="text-white/85 text-lg mb-5">Sound familiar? <span class="text-brand-accent font-semibold">You don't need a new website — you need a rescue.</span></p>
        <a
          href="/promotions/free-seo-audit/"
          class="cta-glow-shine inline-flex items-center justify-center whitespace-nowrap rounded-full bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-8 py-3.5 font-bold border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),inset_0_-2px_6px_rgba(0,0,0,0.25),0_4px_14px_rgba(0,0,0,0.4),0_2px_8px_rgba(132,204,22,0.35),0_0_20px_rgba(132,204,22,0.25)] hover:-translate-y-[1px] active:translate-y-[1px] transition-all duration-300 text-base"
        >
          Get My Free SEO Audit →
        </a>
      </div>
    </div>
  </section>

<!-- Services Section -->
  <section class="py-10 md:py-14 px-4 relative z-20" data-animate>
    <div class="max-w-7xl mx-auto">
      <div class="rounded-3xl p-1 mb-10 bg-gradient-to-br from-white/20 to-white/5 relative overflow-hidden">
        <div class="relative w-full rounded-[22px] overflow-hidden bg-cover bg-center py-10 md:py-14 px-4 md:px-8" style={`background-image: url("${encodeURI(marbleBg.src)}")`}>
          <div class="absolute inset-0 bg-[#08090f]/55"></div>
          <h2 class="relative font-heading font-black text-white text-center tracking-tight leading-[1.05] text-[clamp(2.4rem,5.75vw,4.3rem)]">
            Website <span class="text-brand-blue">Rescue</span> Services
          </h2>
          <p class="relative text-body-lg text-white/90 max-w-3xl leading-relaxed text-center mt-6 mx-auto">
            Four ways we make your website work — visibility, credibility, conversion, and a clean rebuild when it's time.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Google Visibility Fixes Card -->
        <a href="/services/seo/" class="group block bg-white/[0.04] border border-white/10 rounded-2xl p-6 hover:border-brand-accent/60 hover:bg-white/[0.07] hover:-translate-y-2 transition-all duration-300 cursor-pointer">
          <div class="relative z-10">
            <div class="w-14 h-14 bg-brand-accent/15 border border-brand-accent/40 shadow-[0_0_15px_rgba(132,204,22,0.25)] rounded-xl flex items-center justify-center mb-4">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7 text-brand-accent"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <h3 class="font-heading text-2xl font-bold text-white mb-3">Google Visibility Fixes</h3>
            <ul class="list-disc pl-4 space-y-1.5 text-base leading-snug text-white/75 mb-4">
              <li>Indexing and crawlability repairs (sitemap, robots, Search Console)</li>
              <li>Technical SEO cleanup and page speed fixes</li>
              <li>Schema markup so Google understands your pages</li>
              <li>Local SEO foundation: Google Business Profile, local pages, citations</li>
            </ul>
            <span class="text-brand-accent group-hover:text-brand-accent-light text-base font-semibold transition-colors">
              Learn About Visibility Fixes →
            </span>
          </div>
        </a>

        <!-- AI Cleanup & Credibility Fixes Card -->
        <a href="/services/ai-cleanup/" class="group block bg-white/[0.04] border border-white/10 rounded-2xl p-6 hover:border-brand-accent/60 hover:bg-white/[0.07] hover:-translate-y-2 transition-all duration-300 cursor-pointer">
          <div class="relative z-10">
            <div class="w-14 h-14 bg-brand-accent/15 border border-brand-accent/40 shadow-[0_0_15px_rgba(132,204,22,0.25)] rounded-xl flex items-center justify-center mb-4">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7 text-brand-accent"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
            </div>
            <h3 class="font-heading text-2xl font-bold text-white mb-3">AI Cleanup &amp; Credibility Fixes</h3>
            <ul class="list-disc pl-4 space-y-1.5 text-base leading-snug text-white/75 mb-4">
              <li>Remove generic "AI-built" styling and layouts</li>
              <li>Rewrite robotic, AI-generated copy into real human copy</li>
              <li>Fix mobile UX problems that make sites feel cheap</li>
              <li>Make the site look custom, current, and trustworthy</li>
            </ul>
            <span class="text-brand-accent group-hover:text-brand-accent-light text-base font-semibold transition-colors">
              Learn About Credibility Fixes →
            </span>
          </div>
        </a>

        <!-- Conversion Fixes Card -->
        <a href="/services/conversion/" class="group block bg-white/[0.04] border border-white/10 rounded-2xl p-6 hover:border-brand-accent/60 hover:bg-white/[0.07] hover:-translate-y-2 transition-all duration-300 cursor-pointer">
          <div class="relative z-10">
            <div class="w-14 h-14 bg-brand-accent/15 border border-brand-accent/40 shadow-[0_0_15px_rgba(132,204,22,0.25)] rounded-xl flex items-center justify-center mb-4">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7 text-brand-accent"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
            </div>
            <h3 class="font-heading text-2xl font-bold text-white mb-3">Conversion Fixes</h3>
            <ul class="list-disc pl-4 space-y-1.5 text-base leading-snug text-white/75 mb-4">
              <li>Clearer calls-to-action and lead forms people actually fill out</li>
              <li>Service pages structured around what customers search for</li>
              <li>Trust signals: reviews, credentials, real photos, guarantees</li>
              <li>Phone and contact optimization + local landing pages</li>
            </ul>
            <span class="text-brand-accent group-hover:text-brand-accent-light text-base font-semibold transition-colors">
              Learn About Conversion Fixes →
            </span>
          </div>
        </a>

        <!-- Full Rebuilds & New Builds Card -->
        <a href="/services/web-design/" class="group block bg-white/[0.04] border border-white/10 rounded-2xl p-6 hover:border-brand-accent/60 hover:bg-white/[0.07] hover:-translate-y-2 transition-all duration-300 cursor-pointer">
          <div class="relative z-10">
            <div class="w-14 h-14 bg-brand-accent/15 border border-brand-accent/40 shadow-[0_0_15px_rgba(132,204,22,0.25)] rounded-xl flex items-center justify-center mb-4">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7 text-brand-accent"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l9-9 9 9M5 10v10h14V10M9 20v-6h6v6"></path></svg>
            </div>
            <h3 class="font-heading text-2xl font-bold text-white mb-3">Full Rebuilds &amp; New Builds</h3>
            <ul class="list-disc pl-4 space-y-1.5 text-base leading-snug text-white/75 mb-4">
              <li>Strategic rebuilds when repair isn't the right answer</li>
              <li>New builds with SEO foundations from day one</li>
              <li>Design and copy that fits your actual business, not a template</li>
              <li>Built to be found: indexing, speed, and local SEO included</li>
            </ul>
            <span class="text-brand-accent group-hover:text-brand-accent-light text-base font-semibold transition-colors">
              Learn About Rebuilds →
            </span>
          </div>
        </a>
