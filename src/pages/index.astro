  <script>
    (() => {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const tray = document.getElementById('golden-ticket-easter-egg');
      if (!tray) return;

      const makeTicket = () => {
        const ticket = document.createElement('a');
        ticket.className = 'golden-ticket-float';
        ticket.href = '/promotions/the-golden-ticket/';
        ticket.setAttribute('aria-label', 'Visit the Golden Ticket promotion');

        const label = document.createElement('span');
        label.textContent = 'Golden Ticket';

        const rim = document.createElement('div');
        rim.className = 'ticket-rim';

        ticket.appendChild(label);
        ticket.appendChild(rim);
        return ticket;
      };

      const findHandshakeAnchors = () => {
        const anchors = Array.from(document.querySelectorAll<HTMLElement>('.handshake-anchor'));
        const visible = anchors.filter((el) => {
          const rect = el.getBoundingClientRect();
          const style = window.getComputedStyle(el);
          return rect.width >= 0 && rect.height >= 0 && style.display !== 'none' && style.visibility !== 'hidden' && el.getClientRects().length > 0;
        });
        if (visible.length) return visible;
        return anchors.filter((el) => el.offsetParent !== null);
      };

      const findHandshakeAnchor = () => findHandshakeAnchors()[0] || null;

      const isMobileView = () => window.matchMedia('(max-width: 768px)').matches;

      const startAmbientFloat = () => {
        if (prefersReducedMotion) return;

        const ticketCount = 1;
        for (let i = 0; i < ticketCount; i += 1) {
          const ticket = makeTicket();

          const duration = isMobileView()
            ? (9 + Math.random() * 5).toFixed(2)
            : (14 + Math.random() * 10).toFixed(2);
          const delay = isMobileView()
            ? (0.4 + i * 3 + Math.random() * 2).toFixed(2)
            : (1 + Math.random() * 8).toFixed(2);
          const randomizeFlightPath = () => {
            const driftY = (Math.random() * 180 - 90).toFixed(0);
            const startY = (12 + Math.random() * 68).toFixed(2);

            ticket.style.top = `${startY}%`;
            ticket.style.setProperty('--drift-y', `${driftY}px`);
          };

          ticket.style.left = '-100px';
          ticket.style.animationDuration = `${duration}s`;
          ticket.style.animationDelay = `${delay}s`;
          randomizeFlightPath();
          ticket.addEventListener('animationiteration', randomizeFlightPath);

          tray.appendChild(ticket);
        }
      };

      const placeParkedTicket = () => {
        for (const anchor of findHandshakeAnchors()) {
          if (anchor.querySelector('.ticket-parked')) continue;
          const ticket = makeTicket();
          ticket.classList.add('ticket-parked');
          ticket.style.left = '-32px';
          ticket.style.top = '-17px';
          anchor.appendChild(ticket);
        }
      };

      const shakeScreen = () => {
        document.body.classList.add('gt-nose-shake');
        window.setTimeout(() => document.body.classList.remove('gt-nose-shake'), 260);
      };

      const removeParkedTickets = () => {
        document.querySelectorAll('.ticket-parked').forEach((el) => el.remove());
      };

      const playIntro = async () => {
        removeParkedTickets();

        const t1 = makeTicket();
        t1.classList.add('gt-intro');
        t1.setAttribute('aria-hidden', 'true');
        t1.removeAttribute('href');
        t1.tabIndex = -1;
        t1.style.left = '0px';
        t1.style.top = '30vh';
        tray.appendChild(t1);

        const t1Anim = t1.animate(
          [
            { transform: 'translate3d(-140px, 0, 0) rotate(-14deg) scale(0.8)', opacity: 0 },
            { transform: 'translate3d(28vw, 0, 0) rotate(-4deg) scale(2.2)', opacity: 1, offset: 0.35 },
            { transform: 'translate3d(50vw, -8px, 0) rotate(2deg) scale(3.6)', opacity: 1, offset: 0.5 },
            { transform: 'translate3d(72vw, 30px, 0) rotate(10deg) scale(1.8)', opacity: 0.95, offset: 0.75 },
            { transform: 'translate3d(115vw, 90px, 0) rotate(20deg) scale(0.8)', opacity: 0 },
          ],
          { duration: 2600, easing: 'cubic-bezier(0.3, 0, 0.6, 1)', fill: 'forwards' }
        );
        window.setTimeout(shakeScreen, 1300);

        await t1Anim.finished.catch(() => {});
        t1.remove();

        const parkInHandshake = (async () => {
          const t2 = makeTicket();
          t2.classList.add('gt-intro');
          t2.style.left = '0px';
          t2.style.top = '38vh';
          tray.appendChild(t2);

          await t2.animate(
            [
              { transform: 'translate3d(-120px, 0, 0) rotate(-12deg) scale(0.9)', opacity: 0 },
              { transform: 'translate3d(10vw, 10px, 0) rotate(-6deg) scale(1)', opacity: 1, offset: 0.15 },
              { transform: 'translate3d(52vw, -20px, 0) rotate(8deg) scale(1)', opacity: 1, offset: 0.7 },
              { transform: 'translate3d(58vw, -10px, 0) rotate(10deg) scale(1)', opacity: 1 },
            ],
            { duration: 1600, easing: 'cubic-bezier(0.25, 0.6, 0.4, 1)', fill: 'forwards' }
          ).finished.catch(() => {});

          const anchor = findHandshakeAnchor();
          if (!anchor) {
            t2.remove();
            placeParkedTicket();
            return;
          }

          const rect = anchor.getBoundingClientRect();
          const tx = rect.left - 32;
          const ty = rect.top - 17;

          await t2.animate(
            [
              { transform: 'translate3d(58vw, -10px, 0) rotate(10deg) scale(1)' },
              { transform: `translate3d(${tx}px, ${ty}px, 0) rotate(-8deg) scale(0.62)` },
            ],
            { duration: 1200, easing: 'cubic-bezier(0.2, 0.8, 0.3, 1)', fill: 'forwards' }
          ).finished.catch(() => {});

          await t2.animate(
            [
              { transform: `translate3d(${tx}px, ${ty}px, 0) rotate(-8deg) scale(0.62)` },
              { transform: `translate3d(${tx}px, ${ty - 10}px, 0) rotate(-6deg) scale(0.66)`, offset: 0.4 },
              { transform: `translate3d(${tx}px, ${ty}px, 0) rotate(-7deg) scale(0.64)` },
            ],
            { duration: 420, easing: 'ease-out', fill: 'forwards' }
          ).finished.catch(() => {});

          t2.getAnimations().forEach((a) => a.cancel());
          t2.classList.remove('gt-intro');
          t2.classList.add('ticket-parked');
          t2.style.left = '-32px';
          t2.style.top = '-17px';
          anchor.appendChild(t2);
        })();

        const flyOnThrough = (async () => {
          const t3 = makeTicket();
          t3.classList.add('gt-intro');
          t3.setAttribute('aria-hidden', 'true');
          t3.removeAttribute('href');
          t3.tabIndex = -1;
          t3.style.left = '0px';
          t3.style.top = '52vh';
          tray.appendChild(t3);

          await t3.animate(
            [
              { transform: 'translate3d(-130px, 0, 0) rotate(-13deg) scale(0.85)', opacity: 0 },
              { transform: 'translate3d(30vw, -34px, 0) rotate(-3deg) scale(1.15)', opacity: 1, offset: 0.4 },
              { transform: 'translate3d(72vw, 24px, 0) rotate(10deg) scale(1)', opacity: 1, offset: 0.78 },
              { transform: 'translate3d(120vw, 96px, 0) rotate(24deg) scale(0.8)', opacity: 0 },
            ],
            { duration: 3000, easing: 'cubic-bezier(0.3, 0, 0.6, 1)', fill: 'forwards' }
          ).finished.catch(() => {});

          t3.remove();
        })();

        await Promise.all([parkInHandshake, flyOnThrough]);
      };

      if (prefersReducedMotion) {
        placeParkedTicket();
      } else {
        const REPLAY_INTERVAL_MS = 90_000;
        let introRunning = false;
        let ambientStarted = false;

        const runIntro = async () => {
          if (introRunning) return;
          introRunning = true;
          try {
            await playIntro();
          } catch {
            placeParkedTicket();
          } finally {
            introRunning = false;
            if (!ambientStarted) {
              ambientStarted = true;
              startAmbientFloat();
            }
          }
        };

        runIntro();
        window.setInterval(runIntro, REPLAY_INTERVAL_MS);
      }
    })();
  </script>

