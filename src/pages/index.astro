---
import BaseLayout from '../layouts/BaseLayout.astro';
import Image from '../components/OptimizedImage.astro';
import ProjectPopup from '../components/ProjectPopup.jsx';
import heroImage from '../../assets/Sweb_hero1.jpg';
import googleStars from '../../assets/badge icons/google 5 stars.png';
import comptiaBadge from '../../assets/badge icons/CompTIA_A__Digital_Badge.jpg';

import mascotOne from '../../assets/mascot_1.jpg';
import heroHumanInside from '../../assets/about/hero-human-inside.webp';
import newBadges25 from '../../assets/badge icons/NewBadges25.png';

import chatgptLogo from '../../assets/logo banner/chatgpt-logo-chat-gpt-icon-on-black-background-free-vector.jpg';
import claudeLogo from '../../assets/logo banner/claude-Ekx6wd5U.png';
import comptiaTool from '../../assets/logo banner/comptia-Cm7O9_X6.png';
import devinLogo from '../../assets/logo banner/devin-logo-1.png';
import githubLogo from '../../assets/logo banner/github-logo-png_seeklogo-304612.png';
import grokLogo from '../../assets/logo banner/grok-ai-icon.webp';
import linuxLogo from '../../assets/logo banner/linux-operating-systems-logo-whatsapp-logo.jpg';
import ollamaLogo from '../../assets/logo banner/ollama-logo1.png';
import opencodeLogo from '../../assets/logo banner/opencode-BrfWWnj4.png';
import vscodeLogo from '../../assets/logo banner/vscode--vbwWAnL.jpeg';
import hsCross from '../../assets/logo banner/hscross.webp';
import FaqSection from '../components/FaqSection.astro';

const faqItems = [
  {
    question: 'Do I have to purchase SEO with my website?',
    answer: 'No. You can purchase the website build for $497 without an ongoing SEO subscription. Without SEO, the $149/month Website Care Plan covers hosting, backups, edits, and updates, on the same system all of our clients use.'
  },
  {
    question: 'How long should I give SEO?',
    answer: 'We strongly recommend six to twelve months of consistent work to give improvements time to develop and provide a meaningful period for evaluating progress. Plans carry a six-month minimum term.'
  },
  {
    question: 'Do I have to keep paying for SEO?',
    answer: 'SEO plans have a six-month minimum term. After that you can cancel any time with 30 days’ written notice, and future SEO work and billing stop. If you cancel before six months, a $299 cancellation fee applies.'
  },
  {
    question: 'What happens to previous SEO work if I cancel?',
    answer: 'Canceling ends the ongoing service; it does not mean we reverse completed website improvements. Future updates, monitoring, and optimization included in your SEO plan stop when the service ends.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqItems.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer
    }
  }))
};
import marbleBg from '../../assets/marble-800x530.webp';
---

<BaseLayout 
  title="Shelby Web Company | Web Design & SEO in Shelby, NC"
  description="Custom websites from $497 and local SEO at $297/month. Six-month minimum term, then cancel anytime. Web design and SEO in Shelby, NC. Call (704) 473-8188."
  bgVariant="charcoal"
>

  <!-- Promo Ticker/Marquee Bar -->
  <div class="bg-gradient-to-r from-gray-200 via-gray-300 to-gray-200 border-b border-gray-400 shadow-[0_4px_6px_-1px_rgba(0,0,0,0.1),0_2px_4px_-1px_rgba(0,0,0,0.06),inset_0_1px_0_rgba(255,255,255,0.25)] relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-white/30 to-transparent pointer-events-none"></div>
    <div class="flex whitespace-nowrap animate-promo-ticker relative z-10 w-max shrink-0" aria-hidden="true">
      <div class="flex items-center space-x-12 px-6">
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ Free Logo Design with any Growth Plan!</span>
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ Free SEO Audit for Local Businesses!</span>
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ <a href="/promotions/free-logo-design/" class="hover:underline">Free Logo Design</a> with any Growth Plan!</span>
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ <a href="/promotions/free-seo-audit/" class="hover:underline">Free SEO Audit</a> for Local Businesses!</span>
      </div>
    </div>
    <div class="flex whitespace-nowrap animate-promo-ticker relative z-10 w-max shrink-0" aria-hidden="true">
      <div class="flex items-center space-x-12 px-6">
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ Free Logo Design with any Growth Plan!</span>
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ Free SEO Audit for Local Businesses!</span>
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ <a href="/promotions/free-logo-design/" class="hover:underline">Free Logo Design</a> with any Growth Plan!</span>
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ <a href="/promotions/free-seo-audit/" class="hover:underline">Free SEO Audit</a> for Local Businesses!</span>
      </div>
    </div>
  </div>

  <div id="golden-ticket-easter-egg" class="golden-ticket-easter-egg" aria-hidden="true"></div>

  <style>
    @keyframes promo-ticker {
      0% { transform: translateX(0%); }
      100% { transform: translateX(-100%); }
    }
    .animate-promo-ticker {
      animation: promo-ticker 75s linear infinite;
    }
  </style>

  <!-- Hero Section -->
  <section class="pt-8 pb-16 px-3 sm:px-4 lg:pt-10 lg:pb-16 overflow-hidden" data-animate>
    <div class="max-w-7xl mx-auto">
      <div class="grid gap-8 items-center lg:grid-cols-2 lg:gap-12">
        <div class="flex min-w-0 w-full flex-col items-center lg:items-start text-center lg:text-left relative">
          <span class="handshake-anchor absolute lg:hidden" style="top:0;right:6px;" aria-hidden="true"></span>
          <div class="inline-flex items-center space-x-2 bg-gradient-to-br from-gray-700 via-gray-400 to-gray-800 border border-gray-400/50 rounded-full py-1.5 px-4 mb-4 shadow-[0_0_15px_rgba(255,255,255,0.1)]">
            <span class="flex h-2 w-2 rounded-full bg-brand-accent animate-pulse shadow-[0_0_8px_rgba(132,204,22,0.8)]"></span>
            <span class="text-white font-bold text-sm tracking-wide drop-shadow-md">SHELBY, NC WEB DESIGN & LOCAL SEO</span>
          </div>
          <h1 class="font-heading text-[clamp(3.2rem,8vw,5.4rem)] font-black text-white mb-3 leading-[0.95] max-w-full break-words tracking-tight">
            <span class="text-white">Quality </span><span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-blue-dark to-brand-blue">Custom</span><span class="text-white"> Websites</span>
          </h1>
          <p class="font-heading text-2xl sm:text-3xl md:text-[2.3rem] font-bold mb-4" style="color: #fcd34d;">
            Web design &amp; local SEO — <span style="-webkit-text-fill-color: #000; -webkit-text-stroke: 2px #fcd34d; text-stroke: 2px #fcd34d; paint-order: stroke fill; font-weight: 900; font-size: inherit;">Built to grow</span> your business.
          </p>
          <p class="text-base sm:text-lg md:text-xl text-white/80 mb-4 max-w-xl leading-relaxed">
            Launching your website is just the beginning. Pair your custom website with ongoing local SEO for $297/month to keep improving your site and building your visibility over time.
          </p>
          <div class="mb-6">
            <a href="/pricing/" class="inline-flex items-center gap-2 border border-white/25 rounded-xl px-5 py-3 hover:bg-white/10 hover:border-white/50 transition-all duration-300 group">
              <span class="text-white/90 font-semibold text-base sm:text-lg">See pricing details</span>
              <span class="text-brand-accent font-semibold text-base sm:text-lg group-hover:text-brand-accent-light transition-colors">→</span>
            </a>
          </div>
          <div class="flex flex-wrap gap-2 mb-6">
            <a href="/services/web-design/" class="inline-flex items-center min-h-[44px] text-white/80 border border-white/30 rounded-lg px-3 py-1.5 text-sm font-semibold hover:bg-white/10 hover:border-white/50 transition-colors">Web Design</a>
            <a href="/services/seo/" class="inline-flex items-center min-h-[44px] text-white/80 border border-white/30 rounded-lg px-3 py-1.5 text-sm font-semibold hover:bg-white/10 hover:border-white/50 transition-colors">SEO</a>
            <a href="/services/branding/" class="inline-flex items-center min-h-[44px] text-white/80 border border-white/30 rounded-lg px-3 py-1.5 text-sm font-semibold hover:bg-white/10 hover:border-white/50 transition-colors">Branding</a>
            <a href="/services/custom-software-saas/" class="inline-flex items-center min-h-[44px] text-white/80 border border-white/30 rounded-lg px-3 py-1.5 text-sm font-semibold hover:bg-white/10 hover:border-white/50 transition-colors">Business Machines</a>
          </div>

          <div class="lg:hidden mb-6">
            <a href="tel:+17044738188" class="bg-brand-dark/95 backdrop-blur-md border border-brand-blue/30 rounded-2xl px-6 py-4 flex flex-col items-center justify-center hover:border-brand-cyan/50 transition-all duration-300">
              <div class="flex items-center space-x-2 mb-1">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.51 5.51l1.13-2.257a1 1 0 011.21-.502l4.493 1.498A1 1 0 0121 15.72V19a2 2 0 01-2 2h-1C10.82 21 3 13.18 3 5V5z" /></svg>
                <p class="text-white text-xs font-semibold tracking-[0.2em]">CALL OR TEXT <span style="-webkit-text-stroke: 0.5px red; text-stroke: 0.5px red;">24/7</span></p>
              </div>
              <p class="text-brand-accent text-3xl font-heading font-bold drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] leading-none tracking-tight" style="-webkit-text-stroke: 0.8px #84cc16; text-stroke: 0.8px #84cc16;">(704) 473-8188</p>
              <p class="text-white/70 text-xs font-medium mt-1">Just click and call!</p>
            </a>
            <a href="mailto:dave@shelbywebco.com" class="mt-3 mx-auto w-fit inline-flex items-center gap-2 bg-brand-dark/95 backdrop-blur-md border border-brand-blue/30 rounded-xl px-4 py-2.5 text-sm font-semibold text-white/85 hover:border-brand-cyan/50 transition-all duration-300">
              <svg class="w-4 h-4 text-brand-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              dave@shelbywebco.com
            </a>
          </div>

          <div class="rounded-2xl p-1 mb-6 sm:mb-8 bg-gradient-to-br from-brand-blue/20 to-brand-cyan/20 lg:hidden relative">
            <Image src={heroImage} alt="Professional web design and local SEO services in Shelby, NC - Shelby Web Company" class="rounded-[13px] w-full h-auto" width={800} height={600} loading="eager" />
            <div class="handshake-anchor absolute pointer-events-none" style="left:48%;top:78%;" aria-hidden="true"></div>
          </div>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-4 sm:mb-5">
            <a href="/contact/?service=website-seo" class="cta-glow-shine rounded-xl bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-6 py-3 font-bold border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.35)]">
              Explore Website + SEO
            </a>
            <a href="/contact/?service=website" class="rounded-xl border border-white/60 bg-transparent px-6 py-3 text-center text-base font-medium text-white/90 transition-all duration-300 hover:bg-white/10 hover:border-white/80">
              Get Started With a Website
            </a>
          </div>
          <p class="italic text-white/80 text-sm sm:text-base leading-relaxed max-w-xl mb-6 sm:mb-8">
            $497 to build and deploy + $297/month for continued buildout and SEO. Standalone build: $149/month Website Care Plan. Six-month minimum term, then cancel any time.
          </p>
          <p class="text-white/70 text-sm flex items-center gap-1.5 mb-6 sm:mb-8">
            <span class="text-brand-accent leading-none">★★★★★</span>
            5.0 on Google
          </p>

          <div class="space-y-3 mb-8">
            <p class="italic text-white/80 text-base sm:text-lg">• Custom websites that convert</p>
            <p class="italic text-white/80 text-base sm:text-lg">• Local SEO for Shelby &amp; Cleveland County</p>
            <p class="italic text-white/80 text-base sm:text-lg">• Custom Business Machines</p>
          </div>

          <div class="flex flex-row items-center justify-center sm:justify-start gap-3 sm:gap-5 mb-6 sm:mb-8">
            <Image src={googleStars} alt="5 Star Google Reviews" class="h-24 sm:h-28 md:h-32 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity" />
            <Image src={comptiaBadge} alt="CompTIA A+ Certified" class="h-20 sm:h-24 md:h-28 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity rounded-lg" />
          </div>
        </div>

        <div class="relative mt-2 lg:mt-0 lg:self-start flex flex-col items-center lg:items-end gap-6">
          <div class="hidden lg:block">
            <a href="tel:+17044738188" class="bg-brand-dark/95 backdrop-blur-md border border-brand-blue/30 rounded-2xl px-6 py-4 sm:px-7 sm:py-4 flex flex-col items-center justify-center hover:border-brand-cyan/50 transition-all duration-300">
              <div class="flex items-center space-x-2 mb-2">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.51 5.51l1.13-2.257a1 1 0 011.21-.502l4.493 1.498A1 1 0 0121 15.72V19a2 2 0 01-2 2h-1C10.82 21 3 13.18 3 5V5z" /></svg>
                <p class="text-white text-sm font-semibold tracking-widest">CALL US TEXT US</p>
              </div>
              <p class="text-brand-accent text-3xl sm:text-3xl lg:text-4xl font-heading font-bold group-hover:text-brand-accent-light transition-colors leading-none tracking-tight py-1" style="-webkit-text-stroke: 0.8px #84cc16; text-stroke: 0.8px #84cc16;">(704) 473-8188</p>
              <p class="text-white/70 text-xs font-medium mt-1">Just click and call!</p>
              <p class="text-white/60 text-sm">We're here <span style="-webkit-text-stroke: 0.5px red; text-stroke: 0.5px red;">24/7</span></p>
            </a>
            <a href="mailto:dave@shelbywebco.com" class="mt-3 w-full sm:w-fit mx-auto inline-flex items-center justify-center gap-2 bg-brand-dark/95 backdrop-blur-md border border-brand-blue/30 rounded-xl px-4 py-2.5 text-sm font-semibold text-white/85 hover:border-brand-cyan/50 transition-all duration-300">
              <svg class="w-4 h-4 text-brand-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              dave@shelbywebco.com
            </a>
          </div>

          <div class="hidden lg:block w-full relative">
            <Image src={heroImage} alt="Professional web design and local SEO services in Shelby, NC - Shelby Web Company" class="rounded-[13px] w-[110%] ml-auto h-auto" width={800} height={600} loading="eager" />
            <div class="handshake-anchor absolute pointer-events-none" style="left:48%;top:78%;" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-8 md:py-12 px-4 mt-0 relative z-20" data-animate>
    <div class="max-w-7xl mx-auto">
      <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-brand-darkest/80 px-6 py-10 md:py-14 mb-8 flex flex-col items-center text-center">
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
          <div class="absolute inset-0 opacity-[0.12]" style="background-image: linear-gradient(rgba(255,255,255,0.6) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.6) 1px, transparent 1px); background-size: 28px 28px;"></div>
          <div class="absolute -top-24 left-1/4 w-[60%] h-[120%] bg-brand-blue/15 blur-[120px] rounded-full"></div>
          <div class="absolute -bottom-24 right-1/4 w-[50%] h-[100%] bg-brand-cyan/10 blur-[120px] rounded-full"></div>
        </div>
        <div class="relative text-body-base uppercase tracking-widest mb-4" style="color: #fcd34d;">✦ What We Do</div>
        <div class="relative w-full rounded-3xl overflow-hidden bg-cover bg-center py-8 md:py-10 px-4 md:px-8" style={`background-image: url("${encodeURI(marbleBg.src)}")`}>
          <div class="absolute inset-0 bg-gradient-to-b from-black/45 via-black/25 to-black/65"></div>
          <h2 class="relative font-heading font-black text-white text-center tracking-tight leading-[1.05] text-[clamp(2.4rem,6vw,4.2rem)]">
            <span class="bg-clip-text text-transparent bg-gradient-to-r from-gray-700 to-gray-900">Web Design</span> &bull; <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-blue-light to-brand-cyan">SEO</span>
          </h2>
          <p class="relative text-body-lg text-white/85 max-w-3xl leading-relaxed text-center mt-6 mx-auto">
            We help local businesses grow with custom websites and SEO built around your goals. At Shelby Web Company, everything we do is focused on getting you found, trusted, and hired.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline set:html={JSON.stringify(faqSchema)} type="application/ld+json"></script>
  <ProjectPopup client:load />
</BaseLayout>
