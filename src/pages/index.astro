---
import BaseLayout from '../layouts/BaseLayout.astro';
import Image from '../components/OptimizedImage.astro';
import ProjectPopup from '../components/ProjectPopup.jsx';
import heroImage from '../../assets/Sweb_hero1.jpg';
import googleStars from '../../assets/badge icons/google 5 stars.png';
import comptiaBadge from '../../assets/badge icons/CompTIA_A__Digital_Badge.jpg';

import mascotOne from '../../assets/mascot_1.jpg';
import heroHumanInside from '../../assets/about/hero-human-inside.webp';
import newBadges25 from '../../assets/badge icons/NewBadges25.png';

import chatgptLogo from '../../assets/logo banner/chatgpt-logo-chat-gpt-icon-on-black-background-free-vector.jpg';
import claudeLogo from '../../assets/logo banner/claude-Ekx6wd5U.png';
import comptiaTool from '../../assets/logo banner/comptia-Cm7O9_X6.png';
import devinLogo from '../../assets/logo banner/devin-logo-1.png';
import githubLogo from '../../assets/logo banner/github-logo-png_seeklogo-304612.png';
import grokLogo from '../../assets/logo banner/grok-ai-icon.webp';
import linuxLogo from '../../assets/logo banner/linux-operating-systems-logo-whatsapp-logo.jpg';
import ollamaLogo from '../../assets/logo banner/ollama-logo1.png';
import opencodeLogo from '../../assets/logo banner/opencode-BrfWWnj4.png';
import vscodeLogo from '../../assets/logo banner/vscode--vbwWAnL.jpeg';
import hsCross from '../../assets/logo banner/hscross.webp';
---

<BaseLayout 
  title="Web Design Shelby NC"
  description="Web design, SEO, branding & custom software - all in one place. Your neighbors in web design. Call (704) 473-8188 for consultation."
  bgVariant="charcoal"
>

  <!-- Promo Ticker/Marquee Bar -->
  <div class="bg-gradient-to-r from-gray-200 via-gray-300 to-gray-200 border-b border-gray-400 shadow-[0_4px_6px_-1px_rgba(0,0,0,0.1),0_2px_4px_-1px_rgba(0,0,0,0.06),inset_0_1px_0_rgba(255,255,255,0.5)] overflow-hidden relative z-20 py-2 flex">
    <div class="absolute inset-0 bg-gradient-to-b from-white/30 to-transparent pointer-events-none"></div>
    <div class="flex whitespace-nowrap animate-promo-ticker relative z-10 w-max shrink-0" aria-hidden="true">
      <div class="flex items-center space-x-12 px-6">
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ Free Logo Design with any Growth Plan!</span>
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ $100 Unlimited Referral Bonus!</span>
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ Free SEO Audit for Local Businesses!</span>
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ Free Logo Design with any Growth Plan!</span>
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ $100 Unlimited Referral Bonus!</span>
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ Free SEO Audit for Local Businesses!</span>
      </div>
    </div>
    <div class="flex whitespace-nowrap animate-promo-ticker relative z-10 w-max shrink-0" aria-hidden="true">
      <div class="flex items-center space-x-12 px-6">
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ Free Logo Design with any Growth Plan!</span>
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ $100 Unlimited Referral Bonus!</span>
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ Free SEO Audit for Local Businesses!</span>
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ Free Logo Design with any Growth Plan!</span>
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ $100 Unlimited Referral Bonus!</span>
        <span class="text-gray-900 text-xl font-heading drop-shadow-sm">✦ Free SEO Audit for Local Businesses!</span>
      </div>
    </div>
  </div>

  <style>
    @keyframes promo-ticker {
      0% { transform: translateX(0%); }
      100% { transform: translateX(-100%); }
    }
    .animate-promo-ticker {
      animation: promo-ticker 75s linear infinite;
    }
  </style>

  <!-- Hero Section -->
  <section class="pt-8 pb-16 px-3 sm:px-4 lg:pt-10 lg:pb-16 overflow-hidden" data-animate>
    <div class="max-w-7xl mx-auto">
      <div class="grid gap-8 items-center lg:grid-cols-2 lg:gap-12">
        <div class="flex min-w-0 w-full flex-col items-center lg:items-start text-center lg:text-left">
          <div class="inline-flex items-center space-x-2 bg-gradient-to-br from-gray-700 via-gray-400 to-gray-800 border border-gray-400/50 rounded-full py-1.5 px-4 mb-4 shadow-[0_0_15px_rgba(255,255,255,0.1)]">
            <span class="flex h-2 w-2 rounded-full bg-brand-accent animate-pulse shadow-[0_0_8px_rgba(132,204,22,0.8)]"></span>
            <span class="text-white font-bold text-sm tracking-wide drop-shadow-md">Shelby Web Design for Local Businesses</span>
          </div>
          <h1 class="font-heading text-[3.1rem] sm:text-[4.45rem] md:text-[5.7rem] lg:text-[5.1rem] xl:text-[5.55rem] font-black text-white mb-2 leading-[0.9] max-w-full break-words tracking-tight">
            Custom Websites. Local SEO. <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-blue to-brand-cyan">Business Machines.</span><span class="text-brand-accent drop-shadow-[0_0_8px_rgba(132,204,22,0.5)] inline-block text-[2.2rem] sm:text-[2.8rem] md:text-[3.1rem] lg:text-[3.2rem] xl:text-[3.4rem]"> Built for Local Business.</span>
          </h1>
          <p class="text-base sm:text-lg md:text-xl text-white/80 mb-4 max-w-xl leading-relaxed">
            Local Web Design Backed by 20+ Years of I.T. Experience.
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            <a href="/services/web-design/" class="text-white/80 border border-white/30 rounded-lg px-3 py-1.5 text-sm font-semibold hover:bg-white/10 hover:border-white/50 transition-all duration-300">Web Design</a>
            <a href="/services/seo/" class="text-white/80 border border-white/30 rounded-lg px-3 py-1.5 text-sm font-semibold hover:bg-white/10 hover:border-white/50 transition-all duration-300">SEO</a>
            <a href="/services/branding/" class="text-white/80 border border-white/30 rounded-lg px-3 py-1.5 text-sm font-semibold hover:bg-white/10 hover:border-white/50 transition-all duration-300">Branding</a>
            <a href="/services/custom-software-saas/" class="text-white/80 border border-white/30 rounded-lg px-3 py-1.5 text-sm font-semibold hover:bg-white/10 hover:border-white/50 transition-all duration-300">Custom Software</a>
          </div>

          <div class="lg:hidden mb-6">
            <a 
              href="tel:+17044738188" 
              class="bg-brand-dark/95 backdrop-blur-md border border-brand-blue/30 rounded-2xl px-6 py-4 flex flex-col items-center justify-center hover:border-brand-cyan/50 transition-all duration-300 group shadow-lg w-fit mx-auto animate-flash-lime"
            >
              <div class="flex items-center space-x-2 mb-1">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <p class="text-white text-[10px] font-semibold tracking-[0.2em]">CALL OR TEXT <span style="-webkit-text-stroke: 0.5px red; text-stroke: 0.5px red;">24/7</span></p>
              </div>
              <p class="text-brand-accent text-3xl font-heading font-bold drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] leading-none tracking-tight" style="-webkit-text-stroke: 0.8px #84cc16; text-stroke: 0.8px #84cc16;">(704) 473-8188</p>
              <p class="text-white/70 text-[11px] font-medium mt-1">Just click and call!</p>
            </a>
          </div>

          <div class="rounded-2xl p-1 mb-6 sm:mb-8 bg-gradient-to-br from-brand-blue/20 to-brand-cyan/20 lg:hidden">
            <Image 
              src={heroImage} 
              alt="Professional web design and local SEO services in Shelby, NC - Shelby Web Company" 
              class="rounded-[13px] w-full h-auto"
              width={800}
              height={600}
              loading="eager"
            />
          </div>

<div class="flex flex-row gap-3 mb-4 sm:mb-6">
             <a 
               href="/contact/"
               class="cta-glow-shine whitespace-nowrap rounded-xl bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-6 py-3 font-bold border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),inset_0_-2px_6px_rgba(0,0,0,0.25),0_4px_14px_rgba(0,0,0,0.4),0_2px_8px_rgba(132,204,22,0.35),0_0_20px_rgba(132,204,22,0.25)] hover:from-[#b5f146] hover:via-brand-accent-light hover:to-[#4d7c0f] hover:-translate-y-[1px] active:translate-y-[1px] active:shadow-[inset_0_2px_4px_rgba(0,0,0,0.3),0_2px_6px_rgba(0,0,0,0.3)] transition-all duration-300 text-base"
              >
               Start a Project
             </a>
              <a 
                href="/services/portfolio/"
               class="whitespace-nowrap rounded-xl border border-white bg-[#1c1c1c] px-6 py-3 text-center text-base font-medium text-white transition-all duration-300 hover:bg-gray-900"
             >
               See Our Work
             </a>
           </div>
          <p class="text-white/70 text-sm flex items-center gap-1.5 mb-6 sm:mb-8">
            <span class="text-brand-accent leading-none">★★★★★</span>
            5.0 on Google
          </p>

          <div class="space-y-3 mb-8">
            <p class="text-white/80 text-base sm:text-lg">• Custom websites that convert</p>
            <p class="text-white/80 text-base sm:text-lg">• SEO optimization</p>
            <p class="text-white/80 text-base sm:text-lg">• Custom Business Machines</p>
          </div>

          <div class="flex flex-row items-center justify-center sm:justify-start gap-3 sm:gap-5 mb-6 sm:mb-8">
            <Image 
              src={googleStars} 
              alt="5 Star Google Reviews" 
              class="h-28 sm:h-36 md:h-44 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity"
            />
            <Image 
              src={comptiaBadge} 
              alt="CompTIA A+ Certified" 
              class="h-24 sm:h-32 md:h-40 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity rounded-lg"
            />
          </div>

          <a href="/pricing/" class="inline-flex items-center gap-2 bg-gradient-to-r from-brand-blue/20 to-brand-cyan/20 border border-brand-blue/30 rounded-xl px-5 py-3 mb-6 sm:mb-8 hover:from-brand-blue/30 hover:to-brand-cyan/30 transition-all duration-300 group">
            <span class="text-white font-semibold text-base sm:text-lg italic">Professional websites from $497 to launch, SEO from $297/mo.</span>
            <span class="text-brand-accent font-semibold text-base sm:text-lg group-hover:text-brand-accent-light transition-colors italic">See transparent pricing →</span>
          </a>

        </div>

        <div class="relative mt-2 lg:mt-0 lg:self-start flex flex-col items-center lg:items-end gap-6">
          <div class="hidden lg:block">
            <a 
              href="tel:+17044738188" 
              class="bg-brand-dark/95 backdrop-blur-md border border-brand-blue/30 rounded-2xl px-6 py-4 sm:px-8 sm:py-5 flex flex-col items-center justify-center hover:border-brand-cyan/50 transition-all duration-300 group shadow-2xl relative z-10 mr-0 self-center lg:self-end transform scale-90 sm:scale-100 lg:scale-105 origin-center w-full sm:w-fit max-w-sm sm:max-w-none mt-4 lg:mt-0 order-first lg:order-none mx-auto sm:mx-0"
            >
              <div class="flex items-center space-x-2 mb-2">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <p class="text-white text-sm font-semibold tracking-widest">CALL US TEXT US</p>
              </div>
                <p class="text-brand-accent text-3xl sm:text-4xl lg:text-5xl font-heading font-bold group-hover:text-brand-accent-light transition-colors leading-none tracking-tight py-2" style="-webkit-text-stroke: 0.8px #84cc16; text-stroke: 0.8px #84cc16; text-shadow: 0 0 12px rgba(132,204,22,0.7), 0 0 24px rgba(132,204,22,0.4);">(704) 473-8188</p>
              <p class="text-white/70 text-[11px] font-medium mt-1">Just click and call!</p>
              <p class="text-white/60 text-sm">We're here <span style="-webkit-text-stroke: 0.5px red; text-stroke: 0.5px red;">24/7</span></p>
            </a>
          </div>

<div class="hidden lg:block w-full">
             <Image 
               src={heroImage} 
               alt="Professional web design and local SEO services in Shelby, NC - Shelby Web Company" 
               class="rounded-[13px] w-[110%] ml-auto h-auto"
               width={800}
               height={600}
               loading="eager"
             />
           </div>
        </div>
      </div>
    </div>
  </section>

<!-- Services Section -->
   <section class="py-8 md:py-12 px-4 -mt-16 md:-mt-20 relative z-20" data-animate>
     <div class="max-w-7xl mx-auto">
       <div class="mb-8 flex flex-col items-center">
         <div class="inline-block px-6 py-3 rounded-2xl bg-brand-darkest/95 backdrop-blur-md border border-brand-blue/30 mb-4">
         <h2 class="font-heading text-[3.3rem] md:text-[4.2rem] font-black text-white mb-0 text-center tracking-tight leading-[0.9]">
            Web Design &bull; <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-blue to-brand-cyan">SEO / GEO</span> &bull; <span class="text-white">Branding</span> &bull; Custom Software
         </h2>
          </div>
         <p class="text-body-lg text-white/80 max-w-3xl leading-relaxed text-center">
           We're your local specialized web development and marketing toolkit. We build growth engines—designed around your business, optimized for the results that matter most. At Shelby Web Company, our focus is <span class="text-brand-cyan">YOU</span>!
          </p>
        </div>



      <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Web Design Card -->
        <a href="/services/web-design/" class="group block bg-gradient-to-br from-brand-dark to-brand-darkest border border-white/10 rounded-2xl p-6 hover:border-lime-400/60 hover:shadow-[0_25px_50px_rgba(132,204,22,0.22),0_12px_24px_rgba(0,0,0,0.5)] hover:-translate-y-3 hover:scale-[1.03] hover:z-10 transition-all duration-300 ease-out will-change-transform relative overflow-hidden cursor-pointer">
          <div class="absolute -top-24 -right-24 w-48 h-48 bg-lime-500/5 blur-[80px] group-hover:bg-lime-500/20 transition-all duration-500"></div>
          <div class="relative z-10">
            <div class="w-20 h-20 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-xl flex items-center justify-center mb-4">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-10 h-10 text-brand-darkest"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <h3 class="font-heading text-[1.9rem] font-bold text-white mb-3">Web Design</h3>
            <p class="text-[1.07rem] text-white/70 mb-4">Custom, responsive websites that convert visitors into customers. Optimized for local businesses and service businesses.</p>
            <ul class="space-y-2 text-[1.07rem] text-white/70 mb-4">
              <li>• Mobile-First Design</li>
              <li>• Lightning Fast Loading</li>
              <li>• Lead Generation Forms</li>
              <li>• Local SEO Built-In</li>
            </ul>
            <span class="text-brand-cyan hover:text-brand-cyanLight text-[1.07rem] font-medium transition-colors">
              Learn About Web Design →
            </span>
          </div>
        </a>

        <!-- Branding Card -->
        <a href="/services/branding/" class="group block bg-gradient-to-br from-brand-dark to-brand-darkest border border-white/10 rounded-2xl p-6 hover:border-lime-400/60 hover:shadow-[0_25px_50px_rgba(132,204,22,0.22),0_12px_24px_rgba(0,0,0,0.5)] hover:-translate-y-3 hover:scale-[1.03] hover:z-10 transition-all duration-300 ease-out will-change-transform relative overflow-hidden cursor-pointer">
          <div class="absolute -top-24 -right-24 w-48 h-48 bg-lime-500/5 blur-[80px] group-hover:bg-lime-500/20 transition-all duration-500"></div>
          <div class="relative z-10">
            <div class="w-20 h-20 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-xl flex items-center justify-center mb-4">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-10 h-10 text-brand-darkest"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
            </div>
            <h3 class="font-heading text-[1.9rem] font-bold text-white mb-3">Logo Design & Branding</h3>
            <p class="text-[1.07rem] text-white/70 mb-4">Professional branding packages that make your business stand out from competitors and build trust with customers.</p>
            <ul class="space-y-2 text-[1.07rem] text-white/70 mb-4">
              <li>• Custom Logo Design</li>
              <li>• Brand Identity Package</li>
              <li>• Business Card Design</li>
              <li>• Social Media Assets</li>
            </ul>
            <span class="text-brand-cyan hover:text-brand-cyanLight text-[1.07rem] font-medium transition-colors">
              Learn About Branding →
            </span>
          </div>
        </a>

        <!-- SEO Card -->
        <a href="/services/seo/" class="group block bg-gradient-to-br from-brand-dark to-brand-darkest border border-white/10 rounded-2xl p-6 hover:border-lime-400/60 hover:shadow-[0_25px_50px_rgba(132,204,22,0.22),0_12px_24px_rgba(0,0,0,0.5)] hover:-translate-y-3 hover:scale-[1.03] hover:z-10 transition-all duration-300 ease-out will-change-transform relative overflow-hidden cursor-pointer">
          <div class="absolute -top-24 -right-24 w-48 h-48 bg-lime-500/5 blur-[80px] group-hover:bg-lime-500/20 transition-all duration-500"></div>
          <div class="relative z-10">
            <div class="w-20 h-20 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-xl flex items-center justify-center mb-4">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-10 h-10 text-brand-darkest"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <h3 class="font-heading text-[1.9rem] font-bold text-white mb-3">SEO Services</h3>
            <p class="text-[1.07rem] text-white/70 mb-4">Complete search engine optimization to help your business dominate search results and attract more customers.</p>
            <ul class="space-y-2 text-[1.07rem] text-white/70 mb-4">
              <li>• Technical SEO</li>
              <li>• On-Page Optimization</li>
              <li>• Local Search Dominance</li>
              <li>• Google Business Profile</li>
            </ul>
            <span class="text-brand-cyan hover:text-brand-cyanLight text-[1.07rem] font-medium transition-colors">
              Learn About SEO Services →
            </span>
          </div>
        </a>

        <!-- Custom Software & SaaS Card -->
        <a href="/services/custom-software-saas/" class="group block bg-gradient-to-br from-brand-dark to-brand-darkest border border-white/10 rounded-2xl p-6 hover:border-lime-400/60 hover:shadow-[0_25px_50px_rgba(132,204,22,0.22),0_12px_24px_rgba(0,0,0,0.5)] hover:-translate-y-3 hover:scale-[1.03] hover:z-10 transition-all duration-300 ease-out will-change-transform relative overflow-hidden cursor-pointer">
          <div class="absolute -top-24 -right-24 w-48 h-48 bg-lime-500/5 blur-[80px] group-hover:bg-lime-500/20 transition-all duration-500"></div>
          <div class="relative z-10">
            <div class="w-20 h-20 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-xl flex items-center justify-center mb-4">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-10 h-10 text-brand-darkest"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
