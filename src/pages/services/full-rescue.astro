---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PixieDust from '../../components/PixieDust.jsx';
import FaqSection from '../../components/FaqSection.astro';

const faqItems = [
  {
    question: "What exactly is included in a Full Rescue?",
    answer: "All three rescue paths: Visibility (indexing, technical SEO, local SEO foundation), Credibility (AI copy rewritten, styling de-generic'd, mobile UX, trust signals), and Conversion (calls-to-action, lead forms, service page structure, local landing page). One team, one scope, one price."
  },
  {
    question: "How much does a Full Rescue cost?",
    answer: "From $749, scoped by your audit. The three paths bought separately would be $897 — bundling them saves about $150. You get a fixed price before any work starts; no hourly billing and no surprise invoices."
  },
  {
    question: "Do I need the $197 Rescue Report first?",
    answer: "It's optional but recommended. If you buy the report and have us do the fix work within 60 days, the full $197 comes off your fix invoice — so it either tells you exactly what's wrong or it pays for itself."
  },
  {
    question: "When do I need a rebuild instead of a rescue?",
    answer: "When the foundation itself is the problem — a site built on a template platform you can't edit, a codebase that's unmaintainable, or a design that's so far from your business it can't be repurposed. We'll show you exactly why before you spend a dollar."
  },
  {
    question: "What if my site only needs one or two things fixed?",
    answer: "Then don't buy the bundle. Visibility, Credibility, and Conversion each start at $299 on their own, and the free audit tells you which one you actually need. Full Rescue exists for the sites that need all three."
  },
  {
    question: "How long does it take?",
    answer: "Most full rescues run two to four weeks from the fixed scope. If your site genuinely needs a rebuild instead, we'll quote that separately with a clear timeline before you commit."
  }
];

const pillars = [
  {
    key: 'visibility',
    name: 'Found',
    title: 'Visibility Rescue',
    price: 'from $299',
    tint: 'text-brand-accent',
    dot: 'bg-brand-accent',
    border: 'border-brand-accent/40',
    bg: 'bg-brand-accent/5',
    href: '/services/seo/',
    items: [
      'Indexing & crawlability repairs',
      'Technical SEO cleanup & page speed',
      'Local SEO foundation & citations',
    ],
  },
  {
    key: 'credibility',
    name: 'Trusted',
    title: 'Credibility Rescue',
    price: 'from $299',
    tint: 'text-[#22d3ee]',
    dot: 'bg-[#22d3ee]',
    border: 'border-[#22d3ee]/40',
    bg: 'bg-[#22d3ee]/5',
    href: '/services/ai-cleanup/',
    items: [
      'AI-generated copy rewritten',
      'De-generic styling & mobile UX',
      'Trust signals, reviews & credentials',
    ],
  },
  {
    key: 'conversion',
    name: 'Hired',
    title: 'Conversion Rescue',
    price: 'from $299',
    tint: 'text-[#f4c95d]',
    dot: 'bg-[#f4c95d]',
    border: 'border-[#f4c95d]/40',
    bg: 'bg-[#f4c95d]/5',
    href: '/services/conversion/',
    items: [
      'Calls-to-action & lead form rebuild',
      'Service pages built around real searches',
      'Local landing page & contact optimization',
    ],
  },
];
---

<BaseLayout
  bgVariant="blue"
  title="Full Rescue — Fix Everything That’s Broken | Shelby Web Co"
  description="Not found, not trusted, not hired? The Full Rescue fixes all three at once — visibility, credibility, and conversion — from $749. Scoped by your audit, credited report, no lock-in."
>
  <!-- Hero -->
  <section class="py-10 lg:py-16 px-4" data-animate>
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-blue-light text-sm uppercase tracking-widest mb-4">✦ Full Rescue · From $749</p>
      <div class="relative inline-block">
        <PixieDust client:load />
        <h1 class="font-heading text-4xl md:text-6xl font-black text-white mb-6 leading-tight">
          Most Websites Have <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-blue-light via-brand-cyan to-brand-accent">Three Problems, Not One.</span>
        </h1>
      </div>
      <p class="text-lg md:text-xl text-white max-w-3xl mx-auto mb-6">
        Not found. Not trusted. Not hired. Fixing one leaves the other two — and the customer still doesn't call you.
      </p>
      <p class="text-base md:text-lg text-white/80 max-w-3xl mx-auto mb-8">
        The Full Rescue fixes all three together, in the order that matters — for less than buying them separately.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/promotions/free-seo-audit/"
          class="cta-glow-shine inline-block bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-8 py-3 rounded-xl font-bold border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),inset_0_-2px_6px_rgba(0,0,0,0.25),0_4px_14px_rgba(0,0,0,0.4),0_2px_8px_rgba(132,204,22,0.35),0_0_20px_rgba(132,204,22,0.25)] hover:from-[#b5f146] hover:via-brand-accent-light hover:to-[#4d7c0f] hover:-translate-y-[1px] active:translate-y-[1px] transition-all duration-300"
        >
          Start With the Free Audit
        </a>
        <a
          href="/contact/?service=full-rescue"
          class="inline-block px-8 py-3 rounded-xl font-bold text-white border border-white/20 bg-white/[0.04] hover:bg-white/[0.08] hover:-translate-y-[1px] transition-all duration-300"
        >
          Ask About the Full Rescue
        </a>
      </div>
    </div>
  </section>

  <!-- Signs You Need the Full Rescue -->
  <section class="py-16 px-4">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-10 text-center">Your Site May Need the Full Rescue If...</h2>
      <div class="space-y-4">
        <div class="bg-white/[0.04] rounded-2xl border border-white/10 p-5 md:p-6 hover:border-brand-accent/40 hover:bg-white/[0.07] transition-all">
          <p class="text-white/90"><span class="text-brand-accent font-bold">✦</span> You're not ranking for anything you'd actually want to be found for.</p>
        </div>
        <div class="bg-white/[0.04] rounded-2xl border border-white/10 p-5 md:p-6 hover:border-brand-accent/40 hover:bg-white/[0.07] transition-all">
          <p class="text-white/90"><span class="text-brand-accent font-bold">✦</span> Your site looks like every other site in your industry — and customers notice.</p>
        </div>
        <div class="bg-white/[0.04] rounded-2xl border border-white/10 p-5 md:p-6 hover:border-brand-accent/40 hover:bg-white/[0.07] transition-all">
          <p class="text-white/90"><span class="text-brand-accent font-bold">✦</span> You get traffic, but no calls. Visitors leave without doing anything.</p>
        </div>
        <div class="bg-white/[0.04] rounded-2xl border border-white/10 p-5 md:p-6 hover:border-brand-accent/40 hover:bg-white/[0.07] transition-all">
          <p class="text-white/90"><span class="text-brand-accent font-bold">✦</span> You honestly don't know what's broken — nobody's looked at it in a year or more.</p>
        </div>
        <div class="bg-white/[0.04] rounded-2xl border border-white/10 p-5 md:p-6 hover:border-brand-accent/40 hover:bg-white/[0.07] transition-all">
          <p class="text-white/90"><span class="text-brand-accent font-bold">✦</span> You've been told you need a new website — and you don't want to spend thousands to find out.</p>
        </div>
        <div class="bg-white/[0.04] rounded-2xl border border-white/10 p-5 md:p-6 hover:border-brand-accent/40 hover:bg-white/[0.07] transition-all">
          <p class="text-white/90"><span class="text-brand-accent font-bold">✦</span> Someone built it with AI or a template, and it never really launched.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- The three pillars -->
  <section class="py-16 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-brand-blue-light text-sm uppercase tracking-widest mb-4">✦ What's Included</p>
        <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-4">All Three, Done Together</h2>
        <p class="text-white max-w-2xl mx-auto">Scoped by your audit — you only pay for what your site actually needs.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {pillars.map((p) => (
          <a href={p.href} class={`block ${p.bg} border ${p.border} rounded-2xl p-6 hover:-translate-y-1 transition-all duration-300`}>
            <div class="flex items-center gap-2 mb-3">
              <span class={`w-2.5 h-2.5 rounded-full ${p.dot}`}></span>
              <span class={`text-xs uppercase tracking-widest font-bold ${p.tint}`}>{p.name}</span>
            </div>
            <h3 class="font-heading text-2xl font-bold text-white mb-1">{p.title}</h3>
            <p class={`font-heading text-lg font-bold ${p.tint} mb-4`}>{p.price}</p>
            <ul class="space-y-2 text-white/80 text-base leading-snug">
              {p.items.map((item) => <li>• {item}</li>)}
            </ul>
            <span class={`inline-block mt-5 text-sm font-semibold ${p.tint}`}>Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Savings visual -->
  <section class="py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-brand-blue-light text-sm uppercase tracking-widest mb-4">✦ The Math</p>
        <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-4">One Bundle, Less Than Three</h2>
      </div>

      <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-6 md:p-10">
        <div class="grid grid-cols-3 gap-3 md:gap-5 items-stretch">
          <div class="text-center bg-white/[0.04] border border-white/10 rounded-2xl p-4 md:p-6">
            <p class="font-heading text-xl md:text-3xl font-black text-white">$299</p>
            <p class="text-white/60 text-xs md:text-sm mt-2">Visibility</p>
          </div>
          <div class="text-center bg-white/[0.04] border border-white/10 rounded-2xl p-4 md:p-6">
            <p class="font-heading text-xl md:text-3xl font-black text-white">$299</p>
            <p class="text-white/60 text-xs md:text-sm mt-2">Credibility</p>
          </div>
          <div class="text-center bg-white/[0.04] border border-white/10 rounded-2xl p-4 md:p-6">
            <p class="font-heading text-xl md:text-3xl font-black text-white">$299</p>
            <p class="text-white/60 text-xs md:text-sm mt-2">Conversion</p>
          </div>
        </div>

        <div class="flex items-center gap-4 my-5">
          <div class="flex-1 h-px bg-white/15"></div>
          <span class="font-heading text-lg md:text-2xl font-black text-white/70">=</span>
          <div class="flex-1 h-px bg-white/15"></div>
        </div>

        <div class="rounded-2xl border border-brand-blue-light/50 bg-gradient-to-r from-brand-blue-light/15 via-brand-blue-light/5 to-transparent p-6 md:p-8 text-center">
          <p class="text-brand-blue-light text-xs uppercase tracking-widest font-bold mb-2">Full Rescue — everything included</p>
          <p class="font-heading text-4xl md:text-6xl font-black text-white">$749</p>
          <p class="text-brand-accent font-bold text-base md:text-lg mt-3">You save about $150</p>
        </div>

        <p class="text-white/60 text-sm text-center mt-6">
          And one team handles all of it — no juggling three vendors, no three invoices.
        </p>
      </div>
    </div>
  </section>

  <!-- Rescue it or rebuild it -->
  <section class="py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-brand-blue-light text-sm uppercase tracking-widest mb-4">✦ Rescue It or Rebuild It</p>
        <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-4">We'll Tell You Which One You Need</h2>
        <p class="text-white max-w-2xl mx-auto">Repair isn't always the answer. If a rebuild really is the right call, we'll show you exactly why before you spend a dollar.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white/[0.04] border border-brand-blue-light/40 rounded-2xl p-6 md:p-8">
          <p class="text-brand-blue-light text-xs uppercase tracking-widest font-bold mb-2">When the foundation is sound</p>
          <h3 class="font-heading text-2xl md:text-3xl font-black text-white mb-2">Rescue It</h3>
          <p class="font-heading text-3xl font-black text-brand-blue-light mb-5">from $749</p>
          <ul class="space-y-2.5 text-white/85 text-base leading-snug mb-6">
            <li>• Your content, branding, and pages stay</li>
            <li>• Nothing to relearn — same site, working properly</li>
            <li>• Weeks, not months</li>
            <li>• All three rescue paths, one scope</li>
          </ul>
          <a href="/promotions/free-seo-audit/" class="inline-block bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-6 py-3 rounded-xl font-bold border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),0_4px_14px_rgba(0,0,0,0.4)] hover:-translate-y-[1px] transition-all duration-300">
            Start With the Free Audit
          </a>
        </div>

        <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-6 md:p-8">
          <p class="text-white/50 text-xs uppercase tracking-widest font-bold mb-2">When the foundation isn't</p>
          <h3 class="font-heading text-2xl md:text-3xl font-black text-white mb-2">Rebuild It</h3>
          <p class="font-heading text-3xl font-black text-white mb-5">$497 + $297<span class="text-white/60 text-base font-normal">/mo</span></p>
          <ul class="space-y-2.5 text-white/85 text-base leading-snug mb-6">
            <li>• A brand-new site built around your business</li>
            <li>• SEO foundations from day one</li>
            <li>• Ongoing local SEO and hosting included</li>
            <li>• Month-to-month, cancel any time</li>
          </ul>
          <a href="/services/web-design/" class="inline-block border border-white/30 bg-white/[0.04] px-6 py-3 rounded-xl font-bold text-white hover:bg-white/[0.08] hover:border-white/50 transition-all duration-300">
            See Website Build Packages
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-16 px-4">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-12 text-center">How It Works</h2>
      <div class="space-y-8">
        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-full bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] text-brand-darkest font-bold">1</div>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2">Free Audit First</h3>
            <p class="text-white">We look at your site the way Google and your customers do — and show you which of the three problems you actually have. Free, no obligation.</p>
          </div>
        </div>
        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-full bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] text-brand-darkest font-bold">2</div>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2">Fixed Scope, Fixed Price</h3>
            <p class="text-white">You get a prioritized plan with a firm price starting at $749 — every page, every fix, ranked by what moves the needle first. No hourly billing.</p>
          </div>
        </div>
        <div class="flex gap-6">
          <div class="flex-shrink-0">
            <div class="flex items-center justify-center h-12 w-12 rounded-full bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] text-brand-darkest font-bold">3</div>
          </div>
          <div>
            <h3 class="text-xl font-bold text-white mb-2">Fixed, Then Measured</h3>
            <p class="text-white">We work through the plan in order. After, it should be obvious what changed: more calls, more forms, more bookings — found, trusted, and hired.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <FaqSection items={faqItems} />

  <!-- CTA -->
  <section class="py-16 px-4">
    <div class="max-w-3xl mx-auto rounded-3xl border border-white/10 bg-white/[0.04] p-6 md:p-10 text-center">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-white mb-4">How Many Problems Does Your Site Have?</h2>
      <p class="text-lg text-white/90 mb-8 max-w-xl mx-auto">
        Start with the free audit. It's an honest snapshot of your website's health — free for local businesses, no obligation.
      </p>
      <a
        href="/promotions/free-seo-audit/"
        class="cta-glow-shine inline-block bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-8 py-3 rounded-xl font-bold border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),inset_0_-2px_6px_rgba(0,0,0,0.25),0_4px_14px_rgba(0,0,0,0.4),0_2px_8px_rgba(132,204,22,0.35),0_0_20px_rgba(132,204,22,0.25)] hover:from-[#b5f146] hover:via-brand-accent-light hover:to-[#4d7c0f] hover:-translate-y-[1px] active:translate-y-[1px] transition-all duration-300"
      >
        Request Your Free Audit
      </a>
      <p class="text-white/70 text-sm mt-6">
        Want the full every-page diagnosis first? See the <a href="/services/website-rescue-report/" class="text-brand-accent hover:text-white underline decoration-brand-accent/30">Website Rescue Report</a> or <a href="/pricing/" class="text-brand-accent hover:text-white underline decoration-brand-accent/30">all pricing</a>.
      </p>
    </div>
  </section>

</BaseLayout>
