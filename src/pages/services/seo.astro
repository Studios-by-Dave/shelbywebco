---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PixieDust from '../../components/PixieDust.jsx';
import Image from '../../components/OptimizedImage.astro';
import stratImg from '../../../assets/Sweb_STRAT_1.png';
import sisConsole1 from '../../../assets/seo service page/sis_console_1.png';
import sisConsole2 from '../../../assets/seo service page/sis_console_2.png';
import sisConsole3 from '../../../assets/seo service page/sis_console_3.png';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Complete SEO Services",
  "description": "Comprehensive SEO services for Shelby, NC businesses. Technical optimization, local search, and more leads.",
  "url": "https://www.shelbywebco.com/services/seo/",
  "provider": { "@type": "LocalBusiness", "name": "Shelby Web Company", "url": "https://www.shelbywebco.com", "telephone": "(704) 473-8188" },
  "areaServed": ["Shelby, NC", "Kings Mountain, NC", "Gastonia, NC", "Forest City, NC", "Boiling Springs, NC", "Polkville, NC", "Asheville, NC"]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How long does it take to see SEO results?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most local businesses start seeing measurable improvements in search rankings and organic traffic within 3-6 months. Technical SEO fixes (like the SEO Upgrade) can show results within weeks, while content and authority building compounds over time."
      }
    },
    {
      "@type": "Question",
      "name": "What's included in your SEO services?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our SEO services include on-page optimization, local SEO (Google Business Profile), technical SEO audits, content strategy, image/video SEO, off-page link building, and full analytics reporting. We also offer our proprietary STRAT Console for ongoing rank tracking and competitor monitoring."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer free SEO audits?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We offer a free SEO audit for Shelby-area businesses. It covers your site's crawlability, on-page optimization, local search presence, and competitor positioning. Request yours at shelbywebco.com/promotions/free-seo-audit/."
      }
    },
    {
      "@type": "Question",
      "name": "What is STRAT?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "STRAT is Shelby Web Company's Search Tracking, Research & Action Tool — a proprietary SEO web app being developed to centralize keyword research, competitor analysis, search visibility data, and website optimization opportunities. It is currently in the finalization process and will be available to all Shelby Web clients."
      }
    },
    {
      "@type": "Question",
      "name": "Do you work with businesses outside Shelby?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely. While Shelby is home base, we serve businesses across Cleveland County, Gaston County, Rutherford County, and the greater Western NC region including Gastonia, Kings Mountain, Forest City, Boiling Springs, Polkville, and Asheville."
      }
    }
  ]
};
---

<BaseLayout 
  title="Complete SEO Services"
  description="Comprehensive SEO services for Shelby, NC businesses. Technical optimization, local search, and more leads."
>
  <script is:inline set:html={JSON.stringify(serviceSchema)} type="application/ld+json"></script>
  <script is:inline set:html={JSON.stringify(faqSchema)} type="application/ld+json"></script>

  <!-- Hero Section: What Is SEO? -->
  <section class="py-16 lg:py-20 px-4 relative overflow-hidden bg-brand-darkest" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-black/35 via-brand-darkest/45 to-black/35 pointer-events-none"></div>
    <div class="absolute inset-0 bg-noise opacity-[0.03] pointer-events-none"></div>
    <div class="absolute inset-0 bg-dot-pattern opacity-20 pointer-events-none"></div>
    <div class="max-w-5xl mx-auto relative z-10">
      <div class="text-center mb-12">
        <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ Search Engine Optimization</p>
        <div class="relative inline-block">
          <PixieDust client:load />
          <h1 class="font-heading text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight">
            So What Is <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-blue via-brand-blue-light to-brand-sky">SEO</span>?
          </h1>
        </div>
        <p class="text-xl text-white mb-8 max-w-3xl mx-auto">
          Search Engine Optimization is the practice of configuring every layer of your website so that Google, Bing, and other search engines can find it, understand it, trust it, and rank it above your competitors when potential customers search for what you offer.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a 
            href="/contact/"
            class="cta-glow-shine inline-block bg-brand-accent text-[#0A0A0A] px-8 py-3 rounded-xl font-medium hover:bg-brand-accent-light"
          >
            Start Ranking Higher
          </a>
          <a 
            href="/promotions/free-seo-audit/"
            class="inline-block border border-white/20 text-white px-8 py-3 rounded-xl font-medium hover:bg-white/10 transition-all duration-300"
          >
            Free SEO Audit →
          </a>
        </div>
      </div>

      <!-- The SEO Variables -->
      <div class="bg-brand-dark/80 border border-white/5 rounded-3xl p-8 md:p-12 mb-12">
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6 text-center">The Variables Behind Every Ranking</h2>
        <p class="text-white text-center mb-10 max-w-3xl mx-auto">
          SEO isn't one thing — it's dozens of interconnected systems working together. Missing any single layer can hold your entire site back. Here's what goes into a proper SEO strategy:
        </p>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 bg-brand-accent/20 rounded-lg flex items-center justify-center shrink-0 mt-1">
              <span class="text-brand-accent font-bold text-sm">01</span>
            </div>
            <div>
              <h4 class="text-brand-cyan font-bold mb-1">Page Indexing & Crawlability</h4>
              <p class="text-white/80 text-sm">Google must be able to discover, crawl, and index every important page on your site. If pages aren't indexed, they don't exist in search results — no matter how good your content is.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 bg-brand-accent/20 rounded-lg flex items-center justify-center shrink-0 mt-1">
              <span class="text-brand-accent font-bold text-sm">02</span>
            </div>
            <div>
              <h4 class="text-brand-cyan font-bold mb-1">Canonicalization</h4>
              <p class="text-white/80 text-sm">When multiple URLs serve the same or similar content, canonical tags tell Google which version is the authoritative one — preventing duplicate content issues that split your ranking power.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 bg-brand-accent/20 rounded-lg flex items-center justify-center shrink-0 mt-1">
              <span class="text-brand-accent font-bold text-sm">03</span>
            </div>
            <div>
              <h4 class="text-brand-cyan font-bold mb-1">XML Sitemap Implementation</h4>
              <p class="text-white/80 text-sm">A properly structured sitemap acts as a roadmap for search engines — listing every page, its update frequency, and relative importance so crawlers prioritize what matters most.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 bg-brand-accent/20 rounded-lg flex items-center justify-center shrink-0 mt-1">
              <span class="text-brand-accent font-bold text-sm">04</span>
            </div>
            <div>
              <h4 class="text-brand-cyan font-bold mb-1">Robots.txt Configuration</h4>
              <p class="text-white/80 text-sm">This file tells crawlers which pages to access and which to skip. A misconfigured robots.txt can block your entire site from Google or expose pages you want hidden.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 bg-brand-accent/20 rounded-lg flex items-center justify-center shrink-0 mt-1">
              <span class="text-brand-accent font-bold text-sm">05</span>
            </div>
            <div>
              <h4 class="text-brand-cyan font-bold mb-1">LLMs.txt — AI Visibility</h4>
              <p class="text-white/80 text-sm">The new frontier. LLMs.txt is an emerging standard that helps AI models like ChatGPT, Claude, and Perplexity understand and surface your content — optional today, critical tomorrow.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 bg-brand-accent/20 rounded-lg flex items-center justify-center shrink-0 mt-1">
              <span class="text-brand-accent font-bold text-sm">06</span>
            </div>
            <div>
              <h4 class="text-brand-cyan font-bold mb-1">Redirect Management</h4>
              <p class="text-white/80 text-sm">Broken links and missing pages kill ranking signals. Proper 301 redirects preserve link equity when URLs change, pages move, or domains are consolidated — without losing authority.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 bg-brand-accent/20 rounded-lg flex items-center justify-center shrink-0 mt-1">
              <span class="text-brand-accent font-bold text-sm">07</span>
            </div>
            <div>
              <h4 class="text-brand-cyan font-bold mb-1">On-Page Optimization</h4>
              <p class="text-white/80 text-sm">Title tags, meta descriptions, header hierarchy, internal linking, keyword placement, content quality, and structured data — every element on every page sends signals to search engines.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 bg-brand-accent/20 rounded-lg flex items-center justify-center shrink-0 mt-1">
              <span class="text-brand-accent font-bold text-sm">08</span>
            </div>
            <div>
              <h4 class="text-brand-cyan font-bold mb-1">Technical Performance</h4>
              <p class="text-white/80 text-sm">Core Web Vitals, mobile responsiveness, page speed, HTTPS security, and JavaScript rendering — Google rewards sites that load fast and work flawlessly on every device.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 bg-brand-accent/20 rounded-lg flex items-center justify-center shrink-0 mt-1">
              <span class="text-brand-accent font-bold text-sm">09</span>
            </div>
            <div>
              <h4 class="text-brand-cyan font-bold mb-1">Local SEO & Google Business</h4>
              <p class="text-white/80 text-sm">For service-area businesses, local SEO is everything — Google Business Profile optimization, NAP consistency, local citations, review management, and map pack positioning.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-8 h-8 bg-brand-accent/20 rounded-lg flex items-center justify-center shrink-0 mt-1">
              <span class="text-brand-accent font-bold text-sm">10</span>
            </div>
            <div>
              <h4 class="text-brand-cyan font-bold mb-1">Content Strategy & Authority</h4>
              <p class="text-white/80 text-sm">Keyword research, topic clustering, content freshness, E-E-A-T signals (Experience, Expertise, Authority, Trust), and link building — the long game that separates top rankings from page two.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- The Reality Check -->
      <div class="bg-gradient-to-r from-brand-blue/10 to-brand-cyan/10 border border-brand-blue/20 rounded-2xl p-8 md:p-10 text-center">
        <h3 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">It's a Lot. Even With AI.</h3>
        <p class="text-white max-w-3xl mx-auto text-lg leading-relaxed">
          To be clear — we're not here to bash AI. We love AI. It's a game-changer for research, content, and speed. It's definitely all in how you use it. But even with AI tools accelerating the work, SEO still requires a capable human to properly audit, configure, monitor, and adapt all of these variables together. AI can assist — but it can't replace the judgment needed to decide <em class="text-white">which</em> fixes matter most for <em class="text-white">your</em> specific site, <em class="text-white">your</em> market, and <em class="text-white">your</em> customers. That's where we come in.
        </p>
      </div>
    </div>
  </section>

  <!-- Approach Section -->
  <section class="py-24 px-4 bg-brand-darkest border-y border-white/5">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ Our Approach</p>
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">Complete SEO Strategy</h2>
        <p class="text-white max-w-2xl mx-auto text-lg">
          Our comprehensive approach covers all aspects of SEO to ensure maximum visibility and results.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5 hover:border-lime-500/50 transition-all duration-300">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h7l5 5v11a2 2 0 01-2 2z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">On-Page SEO</h3>
          <p class="text-white/90 text-lg">Strategic content optimization, keyword targeting, meta data refinement, internal linking architecture, and clean URL structure — every element tuned for maximum crawlability and ranking potential.</p>
        </div>
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5 hover:border-lime-500/50 transition-all duration-300">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21s7-4.35 7-11a7 7 0 10-14 0c0 6.65 7 11 7 11z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10a2 2 0 100-4 2 2 0 000 4z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Local SEO</h3>
          <p class="text-white/90 text-lg"><span class="text-brand-cyan font-semibold">Google Business Profile</span> optimization, local citation building, review management, and location-based strategies that put your business on the map — literally — for nearby customers.</p>
        </div>
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5 hover:border-lime-500/50 transition-all duration-300">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l-3 3 3 3m8-6l3 3-3 3M14 5l-4 14"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Technical SEO</h3>
          <p class="text-white/90 text-lg">Site speed optimization, mobile-first compliance, crawlability audits, indexation control, accessibility standards, and structured data markup — the technical foundation Google rewards.</p>
        </div>
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5 hover:border-lime-500/50 transition-all duration-300">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.6-4.6a2 2 0 012.8 0L14 14l1.6-1.6a2 2 0 012.8 0L20 16m-9-7h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Image & Video SEO</h3>
          <p class="text-white/90 text-lg">Image compression, alt tag strategy, video transcription, and multimedia schema — so visual content ranks in Google Images and video carousels, not just standard search.</p>
        </div>
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5 hover:border-lime-500/50 transition-all duration-300">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Off-Page SEO</h3>
          <p class="text-white/90 text-lg">Strategic link building, guest posting, social signal amplification, and domain authority growth — the external credibility signals that push your site above competitors.</p>
        </div>
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5 hover:border-lime-500/50 transition-all duration-300">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">SEO Analytics</h3>
          <p class="text-white/90 text-lg">Real-time performance tracking, keyword rank monitoring, competitor benchmarking, and detailed reporting through our proprietary <span class="text-brand-cyan font-semibold">STRAT Console</span> — so you always know what's working.</p>
        </div>
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5 hover:border-lime-500/50 transition-all duration-300">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Google Business Profile</h3>
          <p class="text-white/90 text-lg">Complete profile setup, review monitoring, local Maps ranking, and ongoing post integration — get found by customers in your area exactly when they're searching.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- STRAT Console Showcase -->
  <section class="py-24 px-4 bg-brand-darkest relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-brand-blue/5 via-transparent to-brand-cyan/5 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="text-center mb-16">
        <div class="inline-block bg-brand-cyan/10 border border-brand-cyan/30 text-brand-cyan text-xs font-bold px-4 py-1 rounded-full uppercase tracking-wider mb-6">
          Proprietary Tooling
        </div>
        <h2 class="font-heading text-4xl md:text-5xl lg:text-6xl font-black text-brand-cyan mb-3">
          Introducing STRAT
        </h2>
        <p class="text-brand-cyan font-bold tracking-wide mb-4">A New Proprietary SEO Tool by Shelby Web Company — Coming Soon!</p>
        <p class="text-white max-w-3xl mx-auto text-lg">
          Search Tracking, Research &amp; Action Tool — STRAT is designed to bring essential SEO research and strategy into one streamlined system, helping us identify opportunities, uncover problems, and develop practical solutions for the websites we manage.
        </p>
      </div>

      <!-- STRAT hero image -->
      <div class="mb-16 max-w-2xl mx-auto">
        <div class="rounded-2xl overflow-hidden border border-white/10 shadow-[0_20px_60px_rgba(0,0,0,0.5)]">
          <Image 
            src={stratImg} 
            alt="STRAT Console - Search Tracking, Research & Action Tool" 
            class="w-full h-auto"
            width={800}
            height={437}
            loading="lazy"
          />
        </div>
      </div>

      <!-- STRAT story -->
      <div class="max-w-3xl mx-auto space-y-14 mb-16">
        <div>
          <h3 class="text-2xl font-bold text-brand-cyan mb-4">Smarter SEO Research</h3>
          <p class="text-white mb-6">
            STRAT brings together the research needed to build a more informed SEO strategy. The system is being designed to help analyze important search and competitive data, including:
          </p>
          <ul class="grid sm:grid-cols-2 gap-3">
            <li class="flex gap-2 text-white"><span class="text-brand-cyan">✦</span>Keyword opportunities related to your products and services.</li>
            <li class="flex gap-2 text-white"><span class="text-brand-cyan">✦</span>Competitor rankings, content, and search visibility.</li>
            <li class="flex gap-2 text-white"><span class="text-brand-cyan">✦</span>Search-result trends and areas where your website can improve.</li>
            <li class="flex gap-2 text-white"><span class="text-brand-cyan">✦</span>Technical and on-page SEO opportunities.</li>
            <li class="flex gap-2 text-white"><span class="text-brand-cyan">✦</span>Gaps in your existing content and website structure.</li>
            <li class="flex gap-2 text-white"><span class="text-brand-cyan">✦</span>Local search opportunities for businesses serving specific communities.</li>
            <li class="flex gap-2 text-white"><span class="text-brand-cyan">✦</span>Potential improvements that can strengthen visibility and generate more qualified traffic.</li>
          </ul>
          <p class="text-white mt-6">
            Instead of relying on guesswork, STRAT helps turn SEO data into a clearer action plan.
          </p>
        </div>

        <div>
          <h3 class="text-2xl font-bold text-brand-cyan mb-4">From Data to Action</h3>
          <p class="text-white">
            Many SEO tools provide information, but the information is not always easy to interpret. STRAT is being built around a more practical question:
          </p>
          <p class="text-xl font-bold text-brand-cyan my-4">What should we do next?</p>
          <p class="text-white">
            The system helps connect SEO findings with recommended actions. Whether the opportunity involves creating a new service page, improving an existing title tag, targeting a more specific keyword, strengthening internal links, addressing a technical issue, or creating content around an underserved topic, STRAT is intended to help guide the next step.
          </p>
          <p class="text-white mt-4">
            This allows SEO work to remain focused on meaningful improvements rather than disconnected metrics.
          </p>
        </div>

        <div>
          <h3 class="text-2xl font-bold text-brand-cyan mb-4">Built for Website Growth</h3>
          <p class="text-white mb-6">
            STRAT is being developed as part of Shelby Web Company's broader SEO process. It supports the work involved in improving technical performance, content quality, search visibility, and lead-generation potential. The system can help inform decisions across areas such as:
          </p>
          <ul class="grid sm:grid-cols-2 gap-3">
