        <img id="strat-lightbox-img" src="" alt="" class="relative z-10 max-w-[95vw] max-h-[90vh] w-auto h-auto rounded-xl shadow-2xl border border-white/10" />
        <button type="button" id="strat-lightbox-x" class="absolute top-4 right-4 z-20 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white flex items-center justify-center" aria-label="Close">✕</button>
