---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Image from '../../components/OptimizedImage.astro';
import swebscreen from '../../../assets/portfolio/Sweb_portfolio_screenshot_3.webp';
import fsExpedited from '../../../assets/portfolio/fs-expeditedllc_screenshot_1.webp';
import padgsteenGuitars from '../../../assets/portfolio/padgsteenguitars.webp';
import shadesOfGray from '../../../assets/portfolio/shades-of-gray.webp';
import leeConstruction from '../../../assets/portfolio/lee-construction.webp';
import odysseyRenovations from '../../../assets/portfolio/odyssey-renovations.webp';
import bigFuturisticPictureBox from '../../../assets/portfolio/big-futuristic-picture-box.webp';
import audioNotesAi from '../../../assets/portfolio/audio-notes-ai.webp';
import musicalLock from '../../../assets/portfolio/musical-lock.webp';
import mikesGutHealer from '../../../assets/portfolio/mikes-gut-healer.webp';
import theLivingWord from '../../../assets/portfolio/the-living-word.webp';
import rifeGenerator from '../../../assets/portfolio/rife-generator.webp';
import gAnalyzer from '../../../assets/portfolio/5g-analyzer.webp';
---

<BaseLayout 
  title="Web Design Portfolio | Shelby Web Company"
  description="View our portfolio of web design, branding, and digital marketing projects for local businesses in Shelby, NC."
>

  <!-- Hero Section -->
  <section class="py-10 lg:py-12 px-4 relative overflow-hidden bg-brand-darkest" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-black/35 via-brand-darkest/45 to-black/35 pointer-events-none"></div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ Portfolio</p>
      <h1 class="font-heading text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-4 leading-tight">
        Our Work
      </h1>
      <p class="text-xl text-brand-sky/80 mb-8">
        Websites, branding, and digital solutions for local businesses.
      </p>
    </div>
  </section>

  <!-- Portfolio Grid -->
  <section class="py-16 px-4 bg-brand-darkest" data-animate>
    <div class="max-w-7xl mx-auto">
      
      <!-- Websites Section -->
      <div class="mb-16">
        <div class="mb-10">
          <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ Websites</p>
          <h2 class="font-heading text-4xl font-bold text-white">Websites</h2>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          <!-- Lee Construction -->
          <div class="group cursor-pointer">
            <div class="relative rounded-xl overflow-hidden bg-brand-dark border border-white/10 hover:border-brand-accent/50 transition-all duration-500">
              <div class="aspect-video relative overflow-hidden">
                <Image src={leeConstruction} alt="Lee Construction" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              </div>
            </div>
            <div class="mt-2 px-1">
              <h3 class="font-heading text-sm font-bold text-white">Lee Construction</h3>
              <p class="text-brand-sky/60 text-xs">Shelby, NC</p>
            </div>
          </div>

          <!-- Shades of Gray Painters -->
          <div class="group cursor-pointer">
            <div class="relative rounded-xl overflow-hidden bg-brand-dark border border-white/10 hover:border-brand-accent/50 transition-all duration-500">
              <div class="aspect-video relative overflow-hidden">
                <Image src={shadesOfGray} alt="Shades of Gray Painters" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              </div>
            </div>
            <div class="mt-2 px-1">
              <h3 class="font-heading text-sm font-bold text-white">Shades of Gray Painters</h3>
              <p class="text-brand-sky/60 text-xs">Shelby, NC</p>
            </div>
          </div>

          <!-- Padgsteen Guitars -->
          <div class="group cursor-pointer">
            <div class="relative rounded-xl overflow-hidden bg-brand-dark border border-white/10 hover:border-brand-accent/50 transition-all duration-500">
              <div class="aspect-video relative overflow-hidden">
                <Image src={padgsteenGuitars} alt="Padgsteen Guitars" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              </div>
            </div>
            <div class="mt-2 px-1">
              <h3 class="font-heading text-sm font-bold text-white">Padgsteen Guitars</h3>
              <p class="text-brand-sky/60 text-xs">Appalachia</p>
            </div>
          </div>

          <!-- F&S Expedited -->
          <div class="group cursor-pointer">
            <div class="relative rounded-xl overflow-hidden bg-brand-dark border border-white/10 hover:border-brand-accent/50 transition-all duration-500">
              <div class="aspect-video relative overflow-hidden">
                <Image src={fsExpedited} alt="F&S Expedited LLC" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              </div>
            </div>
            <div class="mt-2 px-1">
              <h3 class="font-heading text-sm font-bold text-white">F&S Expedited LLC</h3>
              <p class="text-brand-sky/60 text-xs">Shelby, NC</p>
            </div>
          </div>

          <!-- Odyssey Renovations -->
          <div class="group cursor-pointer">
            <div class="relative rounded-xl overflow-hidden bg-brand-dark border border-white/10 hover:border-brand-accent/50 transition-all duration-500">
              <div class="aspect-video relative overflow-hidden">
                <Image src={odysseyRenovations} alt="Odyssey Custom Renovations" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              </div>
            </div>
            <div class="mt-2 px-1">
              <h3 class="font-heading text-sm font-bold text-white">Odyssey Custom Renovations</h3>
              <p class="text-brand-sky/60 text-xs">Cleveland County</p>
            </div>
          </div>

          <!-- Shelby Web Company -->
          <div class="group cursor-pointer">
            <div class="relative rounded-xl overflow-hidden bg-brand-dark border border-brand-accent/30 hover:border-brand-accent/50 transition-all duration-500">
              <div class="aspect-video relative overflow-hidden">
                <Image src={swebscreen} alt="Shelby Web Company" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              </div>
            </div>
            <div class="mt-2 px-1">
              <h3 class="font-heading text-sm font-bold text-white">Shelby Web Company</h3>
              <p class="text-brand-sky/60 text-xs">Our Site</p>
            </div>
          </div>

        </div>
      </div>

      <!-- Web Applications Section -->
      <div>
        <div class="mb-10">
          <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ Web Applications</p>
          <h2 class="font-heading text-4xl font-bold text-white">Web Applications</h2>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          <!-- Big Futuristic Picture Box -->
          <div class="group cursor-pointer">
            <div class="relative rounded-xl overflow-hidden bg-brand-dark border border-white/10 hover:border-brand-purple/50 transition-all duration-500">
              <div class="aspect-video relative overflow-hidden">
                <Image src={bigFuturisticPictureBox} alt="Big Futuristic Picture Box" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              </div>
            </div>
            <div class="mt-2 px-1">
              <h3 class="font-heading text-sm font-bold text-white">Big Futuristic Picture Box</h3>
              <p class="text-brand-sky/60 text-xs">AI Image Generator</p>
            </div>
          </div>

          <!-- Audio Notes AI -->
          <div class="group cursor-pointer">
            <div class="relative rounded-xl overflow-hidden bg-brand-dark border border-white/10 hover:border-brand-purple/50 transition-all duration-500">
              <div class="aspect-video relative overflow-hidden">
                <Image src={audioNotesAi} alt="Audio Notes AI" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              </div>
            </div>
            <div class="mt-2 px-1">
              <h3 class="font-heading text-sm font-bold text-white">Audio Notes AI</h3>
              <p class="text-brand-sky/60 text-xs">Audio Transcriber</p>
            </div>
          </div>

          <!-- Musical Lock -->
          <div class="group cursor-pointer">
            <div class="relative rounded-xl overflow-hidden bg-brand-dark border border-white/10 hover:border-brand-purple/50 transition-all duration-500">
              <div class="aspect-video relative overflow-hidden">
                <Image src={musicalLock} alt="Musical Lock" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              </div>
            </div>
            <div class="mt-2 px-1">
              <h3 class="font-heading text-sm font-bold text-white">Musical Lock</h3>
              <p class="text-brand-sky/60 text-xs">Auth System</p>
            </div>
          </div>

          <!-- Mikes Gut Healer -->
          <div class="group cursor-pointer">
            <div class="relative rounded-xl overflow-hidden bg-brand-dark border border-white/10 hover:border-brand-purple/50 transition-all duration-500">
              <div class="aspect-video relative overflow-hidden">
                <Image src={mikesGutHealer} alt="Mikes Gut Healer 5000" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              </div>
            </div>
            <div class="mt-2 px-1">
              <h3 class="font-heading text-sm font-bold text-white">Mikes Gut Healer 5000</h3>
              <p class="text-brand-sky/60 text-xs">Health Resource</p>
            </div>
          </div>

          <!-- The Living Word -->
          <div class="group cursor-pointer">
            <div class="relative rounded-xl overflow-hidden bg-brand-dark border border-white/10 hover:border-brand-purple/50 transition-all duration-500">
              <div class="aspect-video relative overflow-hidden">
                <Image src={theLivingWord} alt="The Living Word" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              </div>
            </div>
            <div class="mt-2 px-1">
              <h3 class="font-heading text-sm font-bold text-white">The Living Word</h3>
              <p class="text-brand-sky/60 text-xs">Spiritual Guide</p>
            </div>
          </div>

          <!-- RIFE Generator -->
          <div class="group cursor-pointer">
            <div class="relative rounded-xl overflow-hidden bg-brand-dark border border-white/10 hover:border-brand-purple/50 transition-all duration-500">
              <div class="aspect-video relative overflow-hidden">
                <Image src={rifeGenerator} alt="RIFE Frequency Generator" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              </div>
            </div>
            <div class="mt-2 px-1">
              <h3 class="font-heading text-sm font-bold text-white">RIFE Frequency Generator</h3>
              <p class="text-brand-sky/60 text-xs">Frequency Tool</p>
            </div>
          </div>

          <!-- 5G Analyzer -->
          <div class="group cursor-pointer">
            <div class="relative rounded-xl overflow-hidden bg-brand-dark border border-white/10 hover:border-brand-purple/50 transition-all duration-500">
              <div class="aspect-video relative overflow-hidden">
                <Image src={gAnalyzer} alt="5G Spectrum Analyzer" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              </div>
            </div>
            <div class="mt-2 px-1">
              <h3 class="font-heading text-sm font-bold text-white">5G Spectrum Analyzer</h3>
              <p class="text-brand-sky/60 text-xs">RF Spectrum</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 px-4 relative overflow-hidden" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-brand-darkest via-brand-dark to-brand-darkest"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-brand-sky/10 to-brand-cyan/10"></div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-6">
        Want Your Project Featured?
      </h2>
      <p class="text-lg text-brand-sky/80 mb-8">
        Let's create something amazing together. Get in touch today to discuss your project.
      </p>
      <a 
        href="/contact/"
        class="cta-glow-shine inline-block bg-brand-accent text-[#0A0A0A] px-8 py-3 rounded-xl font-medium hover:bg-brand-accent-light"
      >
        Get Started Today
      </a>
    </div>
  </section>

</BaseLayout>
