---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PixieDust from '../../components/PixieDust.jsx';
---

<BaseLayout 
  title="Web Design, SEO & Digital Services"
  description="Professional web design, SEO, branding, and custom software development for local businesses in Shelby, NC and surrounding areas."
>

  <!-- Hero Section -->
  <section class="py-14 lg:py-20 px-4" data-animate>
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-silver-shimmer text-label uppercase tracking-widest mb-4">✦ Our Services</p>
      <div class="relative inline-block">
        <PixieDust client:load />
        <h1 class="font-heading text-[3.2rem] sm:text-[4.5rem] md:text-[5.8rem] lg:text-[7rem] font-black text-white mb-4 leading-[0.9] tracking-tight">
          Shelby Web Company 2026 <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-blue to-brand-cyan">Complete Set of Services</span>
        </h1>
      </div>
      <p class="text-body-lg md:text-xl text-white/80 mb-8 max-w-3xl mx-auto leading-relaxed">
        From high-converting websites to search engine dominance — we build the digital foundation your business deserves. Hand-coded for performance, wired for <a href="/services/seo/" class="text-brand-cyan hover:underline decoration-brand-cyan/30">SEO / GEO</a> from day one.
      </p>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-24 px-4" aria-labelledby="services-grid-heading">
    <div class="max-w-7xl mx-auto">
      <h2 id="services-grid-heading" class="sr-only">Our core services</h2>
      <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Web Design Card -->
          <a href="/services/web-design/" class="group block bg-gradient-to-br from-brand-dark to-brand-darkest border border-white/10 rounded-2xl p-6 hover:border-lime-400/60 hover:shadow-[0_25px_50px_rgba(132,204,22,0.22),0_12px_24px_rgba(0,0,0,0.5)] hover:-translate-y-3 hover:scale-[1.03] hover:z-10 transition-all duration-300 ease-out will-change-transform relative overflow-hidden cursor-pointer">
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-lime-500/5 blur-[80px] group-hover:bg-lime-500/20 transition-all duration-500"></div>
            <div class="relative z-10">
              <div class="w-20 h-20 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-xl flex items-center justify-center mb-4">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-10 h-10 text-brand-darkest"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <h3 class="font-heading text-[1.9rem] font-bold text-white mb-3">Web Design</h3>
              <p class="text-[1.07rem] text-white/70 mb-4">Custom, responsive websites that convert visitors into customers. Optimized for local businesses and service businesses.</p>
              <ul class="space-y-2 text-[1.07rem] text-white/70 mb-4">
                <li>• Mobile-First Design</li>
                <li>• Lightning Fast Loading</li>
                <li>• Lead Generation Forms</li>
                <li>• Local SEO Built-In</li>
              </ul>
              <span class="text-brand-cyan hover:text-brand-cyanLight text-[1.07rem] font-medium transition-colors">
                Learn About Web Design →
              </span>
            </div>
          </a>

          <!-- Branding Card -->
          <a href="/services/branding/" class="group block bg-gradient-to-br from-brand-dark to-brand-darkest border border-white/10 rounded-2xl p-6 hover:border-lime-400/60 hover:shadow-[0_25px_50px_rgba(132,204,22,0.22),0_12px_24px_rgba(0,0,0,0.5)] hover:-translate-y-3 hover:scale-[1.03] hover:z-10 transition-all duration-300 ease-out will-change-transform relative overflow-hidden cursor-pointer">
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-lime-500/5 blur-[80px] group-hover:bg-lime-500/20 transition-all duration-500"></div>
            <div class="relative z-10">
              <div class="w-20 h-20 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-xl flex items-center justify-center mb-4">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-10 h-10 text-brand-darkest"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
              </div>
              <h3 class="font-heading text-[1.9rem] font-bold text-white mb-3">Logo Design & Branding</h3>
              <p class="text-[1.07rem] text-white/70 mb-4">Professional branding packages that make your business stand out from competitors and build trust with customers.</p>
              <ul class="space-y-2 text-[1.07rem] text-white/70 mb-4">
                <li>• Custom Logo Design</li>
                <li>• Brand Identity Package</li>
                <li>• Business Card Design</li>
                <li>• Social Media Assets</li>
              </ul>
              <span class="text-brand-cyan hover:text-brand-cyanLight text-[1.07rem] font-medium transition-colors">
                Learn About Branding →
              </span>
            </div>
          </a>

          <!-- SEO Card -->
          <a href="/services/seo/" class="group block bg-gradient-to-br from-brand-dark to-brand-darkest border border-white/10 rounded-2xl p-6 hover:border-lime-400/60 hover:shadow-[0_25px_50px_rgba(132,204,22,0.22),0_12px_24px_rgba(0,0,0,0.5)] hover:-translate-y-3 hover:scale-[1.03] hover:z-10 transition-all duration-300 ease-out will-change-transform relative overflow-hidden cursor-pointer">
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-lime-500/5 blur-[80px] group-hover:bg-lime-500/20 transition-all duration-500"></div>
            <div class="relative z-10">
              <div class="w-20 h-20 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-xl flex items-center justify-center mb-4">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-10 h-10 text-brand-darkest"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              </div>
              <h3 class="font-heading text-[1.9rem] font-bold text-white mb-3">SEO Services</h3>
              <p class="text-[1.07rem] text-white/70 mb-4">Complete search engine optimization to help your business dominate search results and attract more customers.</p>
              <ul class="space-y-2 text-[1.07rem] text-white/70 mb-4">
                <li>• Technical SEO</li>
                <li>• On-Page Optimization</li>
                <li>• Local Search Dominance</li>
                <li>• Google Business Profile</li>
              </ul>
              <span class="text-brand-cyan hover:text-brand-cyanLight text-[1.07rem] font-medium transition-colors">
                Learn About SEO Services →
              </span>
            </div>
          </a>

          <!-- Custom Software & SaaS Card -->
          <a href="/services/custom-software-saas/" class="group block bg-gradient-to-br from-brand-dark to-brand-darkest border border-white/10 rounded-2xl p-6 hover:border-lime-400/60 hover:shadow-[0_25px_50px_rgba(132,204,22,0.22),0_12px_24px_rgba(0,0,0,0.5)] hover:-translate-y-3 hover:scale-[1.03] hover:z-10 transition-all duration-300 ease-out will-change-transform relative overflow-hidden cursor-pointer">
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-lime-500/5 blur-[80px] group-hover:bg-lime-500/20 transition-all duration-500"></div>
            <div class="relative z-10">
              <div class="w-20 h-20 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-xl flex items-center justify-center mb-4">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-10 h-10 text-brand-darkest"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
              </div>
              <h3 class="font-heading text-[1.9rem] font-bold text-white mb-3">Custom Software & SaaS (Business Machines)</h3>
              <p class="text-[1.07rem] text-white/70 mb-4">Custom-built software and business machines engineered to automate, streamline, and give your business a powerful edge.</p>
              <ul class="space-y-2 text-[1.07rem] text-white/70 mb-4">
                <li>• Custom Business Machines</li>
                <li>• SaaS Applications</li>
                <li>• API Integrations</li>
                <li>• Business Automation</li>
              </ul>
              <span class="text-brand-cyan hover:text-brand-cyanLight text-[1.07rem] font-medium transition-colors">
                Learn About Custom Software →
              </span>
            </div>
          </a>
        </div>
    </div>
  </section>

    <!-- Industries We Serve -->
   <section id="industries" class="py-20 px-4 bg-brand-dark border-y border-white/5" aria-labelledby="industries-heading">
     <div class="max-w-7xl mx-auto">
       <div class="text-center mb-12">
         <p class="text-brand-glow text-label uppercase tracking-widest mb-4">✦ We Build for These Trades</p>
          <h2 id="industries-heading" class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-4">Industries We Serve</h2>
         <p class="text-white/70 max-w-2xl mx-auto">Dedicated websites for local service businesses. Every site is a lead-generating engine built for your industry.</p>
       </div>
       <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
         <a href="/web-design-for-home-remodelers-shelby-nc/" class="group bg-brand-darkest border border-white/10 rounded-xl p-5 hover:border-brand-cyan/50 hover:-translate-y-1 transition-all duration-300">
           <p class="text-white font-semibold group-hover:text-brand-cyan">Home Remodelers</p>
           <p class="text-white/50 text-sm">Before/after &amp; booking</p>
         </a>
         <a href="/web-design-for-construction-shelby-nc/" class="group bg-brand-darkest border border-white/10 rounded-xl p-5 hover:border-brand-cyan/50 hover:-translate-y-1 transition-all duration-300">
           <p class="text-white font-semibold group-hover:text-brand-cyan">Construction Trades</p>
           <p class="text-white/50 text-sm">Galleries &amp; estimates</p>
         </a>
         <a href="/web-design-for-roofers-shelby-nc/" class="group bg-brand-darkest border border-white/10 rounded-xl p-5 hover:border-brand-cyan/50 hover:-translate-y-1 transition-all duration-300">
           <p class="text-white font-semibold group-hover:text-brand-cyan">Roofers</p>
           <p class="text-white/50 text-sm">Storm-season leads</p>
         </a>
         <a href="/web-design-for-landscapers-shelby-nc/" class="group bg-brand-darkest border border-white/10 rounded-xl p-5 hover:border-brand-cyan/50 hover:-translate-y-1 transition-all duration-300">
           <p class="text-white font-semibold group-hover:text-brand-cyan">Landscapers</p>
           <p class="text-white/50 text-sm">Seasonal promos</p>
         </a>
         <a href="/web-design-for-tree-specialists-shelby-nc/" class="group bg-brand-darkest border border-white/10 rounded-xl p-5 hover:border-brand-cyan/50 hover:-translate-y-1 transition-all duration-300">
           <p class="text-white font-semibold group-hover:text-brand-cyan">Tree Specialists</p>
           <p class="text-white/50 text-sm">Emergency dispatch</p>
         </a>
       </div>
     </div>
   </section>

   <!-- CTA Section -->
  <section class="py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-6">Not Sure What You Need?</h2>
      <p class="text-body-lg text-white mb-8">
        We'll tell you honestly what your business needs — and what it doesn't. No pressure, no upsells.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact/" class="inline-block bg-brand-accent text-brand-darkest px-8 py-4 rounded-xl font-bold hover:bg-brand-accent-light transition-all duration-300 transform hover:scale-105 shadow-[0_0_20px_rgba(132,204,22,0.3)] cta-glow-shine">
          Book a Free Strategy Call
        </a>
        <a href="/promotions/free-seo-audit/" class="inline-block border border-brand-cyan/30 text-brand-cyan px-8 py-4 rounded-xl font-bold hover:bg-brand-cyan/10 transition-all duration-300">
          Get a Free SEO Audit
        </a>
      </div>
      <p class="mt-6 text-sm text-white/75">
        Three local businesses can have the $497 website build and launch fee waived. <a href="/promotions/the-golden-ticket/" class="font-semibold text-[#f4c95d] underline decoration-[#fbbf24]/40 underline-offset-4 hover:text-[#f8d66d]">Read the offer details and apply.</a>
      </p>
    </div>
  </section>

</BaseLayout>
