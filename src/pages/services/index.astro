---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PixieDust from '../../components/PixieDust.jsx';
---

<BaseLayout
  title="Web Design, SEO, Branding & Software Services in Shelby, NC"
  description="Explore web design, SEO/GEO, branding, and custom software services for local businesses in Shelby, NC and across Western North Carolina."
>
  <!-- Hero Section -->
  <section class="relative isolate overflow-hidden bg-brand-darkest px-4 py-14 md:py-20" data-animate>
    <div class="absolute inset-0 -z-10 bg-mesh-gradient"></div>
    <div class="absolute inset-0 -z-10 bg-noise opacity-[0.03]"></div>
    <div class="absolute inset-0 -z-10 bg-dot-pattern opacity-20"></div>
    <div class="mx-auto max-w-5xl text-center">
      <p class="mb-4 text-base font-semibold uppercase tracking-[0.2em] text-brand-cyan sm:text-lg">
        Shelby Web Company Full Service List
      </p>
      <div class="relative inline-block">
        <PixieDust client:load />
        <h1 class="mb-6 font-heading text-5xl font-bold leading-tight text-white sm:text-6xl md:text-7xl lg:text-8xl">
          Shelby Web Company <span class="bg-gradient-to-r from-brand-blue via-brand-blue-light to-brand-cyan bg-clip-text text-transparent">2026 All Services</span>
        </h1>
      </div>
      <p class="mx-auto mb-8 max-w-3xl text-lg leading-relaxed text-white/80 md:text-xl">
        Explore the services that help local businesses look their best, get found, and work smarter—from custom websites and SEO/GEO to branding and business software.
      </p>
      <div class="flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href="#services"
          class="inline-flex min-h-12 items-center justify-center rounded-xl border border-white/20 bg-white/10 px-6 py-3 font-bold text-white transition-colors hover:bg-white/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-brand-darkest"
        >
          Explore Our Services
        </a>
        <a
          href="/contact/"
          class="cta-glow-shine inline-flex min-h-12 items-center justify-center rounded-xl bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] px-6 py-3 font-bold text-black transition-all duration-300 hover:-translate-y-0.5 hover:from-[#b5f146] hover:via-brand-accent-light hover:to-[#4d7c0f] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-brand-darkest"
        >
          Book a Free Strategy Call
        </a>
      </div>
      <div class="mt-10 flex flex-wrap justify-center gap-2 text-sm font-medium text-white/70">
        <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">Web Design</span>
        <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">SEO / GEO</span>
        <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">Branding</span>
        <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2">Custom Software</span>
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section id="services" class="scroll-mt-24 border-y border-white/5 bg-brand-darkest px-4 py-16 md:py-20" aria-labelledby="services-heading">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto mb-10 max-w-3xl text-center md:mb-12">
        <p class="mb-3 text-label uppercase tracking-widest text-brand-glow">✦ Find the Right Fit</p>
        <h2 id="services-heading" class="mb-4 font-heading text-section-heading font-bold text-white md:text-section-heading-md">
          Services built around your goals
        </h2>
        <p class="text-white/70">
          Start with what your business needs now. Each service can stand on its own or work alongside the others as you grow.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
        <!-- Web Design and Development -->
        <a
          href="/services/web-design/"
          aria-label="Explore Web Design and Development"
          class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-br from-brand-dark to-brand-darkest p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand-cyan/50 hover:shadow-[0_18px_40px_rgba(0,0,0,0.3)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-brand-darkest md:p-7"
        >
          <div class="absolute -right-16 -top-16 h-40 w-40 rounded-full bg-brand-blue/10 blur-3xl transition-colors group-hover:bg-brand-cyan/15"></div>
          <div class="relative flex h-full flex-col">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-lime-200 via-lime-400 to-lime-600 text-brand-darkest shadow-lg shadow-lime-500/20">
              <svg aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <p class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-brand-cyan">Websites that work</p>
            <h3 class="mb-3 font-heading text-2xl font-bold text-white transition-colors group-hover:text-brand-cyan-light">Web Design &amp; Development</h3>
            <p class="mb-5 leading-relaxed text-white/70">
              Custom, mobile-first websites designed around your business—fast, easy to use, and built to turn visits into real inquiries.
            </p>
            <ul class="mb-7 space-y-2 text-sm text-white/80">
              <li><span class="mr-2 text-brand-accent" aria-hidden="true">✓</span>Responsive, mobile-first design</li>
              <li><span class="mr-2 text-brand-accent" aria-hidden="true">✓</span>Performance-focused development</li>
              <li><span class="mr-2 text-brand-accent" aria-hidden="true">✓</span>Lead capture and SEO-ready structure</li>
            </ul>
            <span class="mt-auto inline-flex items-center gap-2 font-bold text-brand-cyan transition-transform group-hover:translate-x-1">
              Explore web design <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>

        <!-- SEO / GEO -->
        <a
          href="/services/seo/"
          aria-label="Explore SEO and GEO"
          class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-br from-brand-dark to-brand-darkest p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand-cyan/50 hover:shadow-[0_18px_40px_rgba(0,0,0,0.3)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-brand-darkest md:p-7"
        >
          <div class="absolute -right-16 -top-16 h-40 w-40 rounded-full bg-brand-blue/10 blur-3xl transition-colors group-hover:bg-brand-cyan/15"></div>
          <div class="relative flex h-full flex-col">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-lime-200 via-lime-400 to-lime-600 text-brand-darkest shadow-lg shadow-lime-500/20">
              <svg aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <p class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-brand-cyan">Be easier to find</p>
            <h3 class="mb-3 font-heading text-2xl font-bold text-white transition-colors group-hover:text-brand-cyan-light">SEO / GEO</h3>
            <p class="mb-5 leading-relaxed text-white/70">
              Help the right customers find and understand your business in local search—and build visibility as people increasingly use AI tools to discover services.
            </p>
            <ul class="mb-7 space-y-2 text-sm text-white/80">
              <li><span class="mr-2 text-brand-accent" aria-hidden="true">✓</span>Technical and on-page SEO</li>
              <li><span class="mr-2 text-brand-accent" aria-hidden="true">✓</span>Local search and Google Business Profile</li>
              <li><span class="mr-2 text-brand-accent" aria-hidden="true">✓</span>Generative Engine Optimization</li>
            </ul>
            <span class="mt-auto inline-flex items-center gap-2 font-bold text-brand-cyan transition-transform group-hover:translate-x-1">
              Explore SEO / GEO <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>

        <!-- Branding -->
        <a
          href="/services/branding/"
          aria-label="Explore Logo Design and Branding"
          class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-br from-brand-dark to-brand-darkest p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand-cyan/50 hover:shadow-[0_18px_40px_rgba(0,0,0,0.3)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-brand-darkest md:p-7"
        >
          <div class="absolute -right-16 -top-16 h-40 w-40 rounded-full bg-brand-blue/10 blur-3xl transition-colors group-hover:bg-brand-cyan/15"></div>
          <div class="relative flex h-full flex-col">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-lime-200 via-lime-400 to-lime-600 text-brand-darkest shadow-lg shadow-lime-500/20">
              <svg aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
            </div>
            <p class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-brand-cyan">Look like you mean business</p>
            <h3 class="mb-3 font-heading text-2xl font-bold text-white transition-colors group-hover:text-brand-cyan-light">Logo Design &amp; Branding</h3>
            <p class="mb-5 leading-relaxed text-white/70">
              Create a memorable, consistent identity that helps customers recognize and trust your business wherever they meet your brand.
            </p>
            <ul class="mb-7 space-y-2 text-sm text-white/80">
              <li><span class="mr-2 text-brand-accent" aria-hidden="true">✓</span>Custom logo design</li>
              <li><span class="mr-2 text-brand-accent" aria-hidden="true">✓</span>Brand identity packages</li>
              <li><span class="mr-2 text-brand-accent" aria-hidden="true">✓</span>Business cards and social assets</li>
            </ul>
            <span class="mt-auto inline-flex items-center gap-2 font-bold text-brand-cyan transition-transform group-hover:translate-x-1">
              Explore branding <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>

        <!-- Custom Software -->
        <a
          href="/services/custom-software-saas/"
          aria-label="Explore Custom Software and Business Machines"
          class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-br from-brand-dark to-brand-darkest p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand-cyan/50 hover:shadow-[0_18px_40px_rgba(0,0,0,0.3)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-brand-darkest md:p-7"
        >
          <div class="absolute -right-16 -top-16 h-40 w-40 rounded-full bg-brand-blue/10 blur-3xl transition-colors group-hover:bg-brand-cyan/15"></div>
          <div class="relative flex h-full flex-col">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-lime-200 via-lime-400 to-lime-600 text-brand-darkest shadow-lg shadow-lime-500/20">
              <svg aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
            </div>
            <p class="mb-2 text-xs font-semibold uppercase tracking-[0.16em] text-brand-cyan">Make work flow better</p>
            <h3 class="mb-3 font-heading text-2xl font-bold text-white transition-colors group-hover:text-brand-cyan-light">Custom Software &amp; SaaS</h3>
            <p class="mb-5 leading-relaxed text-white/70">
              Bring disconnected tools and workflows together in a custom business machine, shaped around the way your company operates.
            </p>
            <ul class="mb-7 space-y-2 text-sm text-white/80">
              <li><span class="mr-2 text-brand-accent" aria-hidden="true">✓</span>Custom dashboards and web apps</li>
              <li><span class="mr-2 text-brand-accent" aria-hidden="true">✓</span>Portals and SaaS platforms</li>
              <li><span class="mr-2 text-brand-accent" aria-hidden="true">✓</span>Workflow automation and integrations</li>
            </ul>
            <span class="mt-auto inline-flex items-center gap-2 font-bold text-brand-cyan transition-transform group-hover:translate-x-1">
              Explore custom software <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>

        <!-- Audio Branding -->
        <a
          href="/services/audio-branding/"
          aria-label="Explore upcoming Audio Branding and Sound Identity services"
          class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-br from-brand-dark to-brand-darkest p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand-cyan/50 hover:shadow-[0_18px_40px_rgba(0,0,0,0.3)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan focus-visible:ring-offset-2 focus-visible:ring-offset-brand-darkest md:p-7"
        >
          <div class="absolute -right-16 -top-16 h-40 w-40 rounded-full bg-brand-blue/10 blur-3xl transition-colors group-hover:bg-brand-cyan/15"></div>
          <div class="relative flex h-full flex-col">
            <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-lime-200 via-lime-400 to-lime-600 text-brand-darkest shadow-lg shadow-lime-500/20">
              <svg aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="h-6 w-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z"></path></svg>
            </div>
            <div class="mb-2 flex flex-wrap items-center gap-2">
              <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-cyan">Sound identity</p>
              <span class="rounded-full border border-brand-accent/30 bg-brand-accent/10 px-2.5 py-1 text-[0.65rem] font-bold uppercase tracking-wider text-brand-accent">Coming soon</span>
            </div>
            <h3 class="mb-3 font-heading text-2xl font-bold text-white transition-colors group-hover:text-brand-cyan-light">Audio Branding</h3>
            <p class="mb-5 leading-relaxed text-white/70">
              Give your business a recognizable sound with a sonic logo, custom music, and audio identity for the places your brand shows up.
            </p>
            <ul class="mb-7 space-y-2 text-sm text-white/80">
              <li><span class="mr-2 text-brand-accent" aria-hidden="true">✓</span>Sonic logos and brand anthems</li>
              <li><span class="mr-2 text-brand-accent" aria-hidden="true">✓</span>Podcast and video intros</li>
              <li><span class="mr-2 text-brand-accent" aria-hidden="true">✓</span>On-hold messaging and audio guides</li>
            </ul>
            <span class="mt-auto inline-flex items-center gap-2 font-bold text-brand-cyan transition-transform group-hover:translate-x-1">
              See what's coming <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Work and Results -->
  <section class="px-4 py-16 md:py-20" aria-labelledby="work-heading">
    <div class="mx-auto max-w-7xl">
      <div class="mb-8 flex flex-col gap-3 md:mb-10 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="mb-3 text-label uppercase tracking-widest text-brand-glow">✦ Take a Closer Look</p>
          <h2 id="work-heading" class="font-heading text-section-heading font-bold text-white md:text-section-heading-md">See the work in action</h2>
        </div>
        <p class="max-w-xl text-white/70">Browse finished projects and real-world examples of the digital tools we build.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href="/services/portfolio/" class="group flex items-center justify-between gap-4 rounded-2xl border border-white/10 bg-brand-dark p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand-cyan/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan">
          <div>
            <h3 class="mb-2 font-heading text-xl font-bold text-white transition-colors group-hover:text-brand-cyan">Portfolio</h3>
            <p class="text-sm leading-relaxed text-white/65">Explore websites, custom applications, and digital projects.</p>
          </div>
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 text-xl text-brand-cyan transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
        <a href="/services/case-studies/" class="group flex items-center justify-between gap-4 rounded-2xl border border-white/10 bg-brand-dark p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand-cyan/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan">
          <div>
            <h3 class="mb-2 font-heading text-xl font-bold text-white transition-colors group-hover:text-brand-cyan">Case Studies</h3>
            <p class="text-sm leading-relaxed text-white/65">See selected projects and the problems they were built to solve.</p>
          </div>
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 text-xl text-brand-cyan transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Industries We Serve -->
  <section id="industries" class="scroll-mt-24 border-y border-white/5 bg-brand-dark px-4 py-16 md:py-20" aria-labelledby="industries-heading">
    <div class="mx-auto max-w-7xl">
      <div class="mb-8 text-center md:mb-10">
        <p class="mb-3 text-label uppercase tracking-widest text-brand-glow">✦ Built for Local Businesses</p>
        <h2 id="industries-heading" class="mb-4 font-heading text-section-heading font-bold text-white md:text-section-heading-md">Industries we serve</h2>
        <p class="mx-auto max-w-2xl text-white/70">Focused websites and digital tools for the local service businesses that keep our communities moving.</p>
      </div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        <a href="/web-design-for-home-remodelers-shelby-nc/" class="group rounded-xl border border-white/10 bg-brand-darkest p-5 transition-all duration-300 hover:-translate-y-1 hover:border-brand-cyan/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan">
          <p class="font-semibold text-white group-hover:text-brand-cyan">Home Remodelers</p>
          <p class="mt-1 text-sm text-white/55">Before-and-after galleries and booking</p>
        </a>
        <a href="/web-design-for-construction-shelby-nc/" class="group rounded-xl border border-white/10 bg-brand-darkest p-5 transition-all duration-300 hover:-translate-y-1 hover:border-brand-cyan/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan">
          <p class="font-semibold text-white group-hover:text-brand-cyan">Construction Trades</p>
          <p class="mt-1 text-sm text-white/55">Project galleries and estimates</p>
        </a>
        <a href="/web-design-for-roofers-shelby-nc/" class="group rounded-xl border border-white/10 bg-brand-darkest p-5 transition-all duration-300 hover:-translate-y-1 hover:border-brand-cyan/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan">
          <p class="font-semibold text-white group-hover:text-brand-cyan">Roofers</p>
          <p class="mt-1 text-sm text-white/55">Service-area visibility and inquiries</p>
        </a>
        <a href="/web-design-for-landscapers-shelby-nc/" class="group rounded-xl border border-white/10 bg-brand-darkest p-5 transition-all duration-300 hover:-translate-y-1 hover:border-brand-cyan/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan">
          <p class="font-semibold text-white group-hover:text-brand-cyan">Landscapers</p>
          <p class="mt-1 text-sm text-white/55">Seasonal services and project showcases</p>
        </a>
        <a href="/web-design-for-tree-specialists-shelby-nc/" class="group rounded-xl border border-white/10 bg-brand-darkest p-5 transition-all duration-300 hover:-translate-y-1 hover:border-brand-cyan/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan">
          <p class="font-semibold text-white group-hover:text-brand-cyan">Tree Specialists</p>
          <p class="mt-1 text-sm text-white/55">Service details and urgent inquiries</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="px-4 py-16 md:py-20" aria-labelledby="areas-heading">
    <div class="mx-auto max-w-7xl">
      <div class="mb-8 text-center md:mb-10">
        <p class="mb-3 text-label uppercase tracking-widest text-brand-glow">✦ Where We Work</p>
        <h2 id="areas-heading" class="mb-4 font-heading text-section-heading font-bold text-white md:text-section-heading-md">Serving Shelby and Western North Carolina</h2>
        <p class="mx-auto max-w-2xl text-white/70">Based in Shelby, we help businesses across nearby communities build a stronger online presence.</p>
      </div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        <a href="/web-design-shelby-nc/" class="group rounded-xl border border-white/10 bg-brand-darkest p-5 transition-all duration-300 hover:-translate-y-1 hover:border-brand-cyan/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan">
          <p class="font-semibold text-white group-hover:text-brand-cyan">Shelby, NC</p>
          <p class="mt-1 text-sm text-white/55">Home base · Cleveland County</p>
        </a>
        <a href="/web-design-gastonia-nc/" class="group rounded-xl border border-white/10 bg-brand-darkest p-5 transition-all duration-300 hover:-translate-y-1 hover:border-brand-cyan/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan">
          <p class="font-semibold text-white group-hover:text-brand-cyan">Gastonia, NC</p>
          <p class="mt-1 text-sm text-white/55">Gaston County</p>
        </a>
