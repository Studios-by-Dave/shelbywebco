---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PixieDust from '../../components/PixieDust.jsx';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'What is a custom SaaS platform?',
      'acceptedAnswer': { '@type': 'Answer', 'text': 'A Software-as-a-Service (SaaS) platform is a web-based application your business runs on a subscription model.' }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Custom Software & SaaS Platform Development",
  "description": "Custom web applications, portals, and subscription platforms built around your business.",
  "url": "https://www.shelbywebco.com/services/custom-software-saas/",
  "provider": { "@type": "LocalBusiness", "name": "Shelby Web Company", "url": "https://www.shelbywebco.com", "telephone": "(704) 473-8188" }
};
---

<BaseLayout 
  title="Custom Software & SaaS — Your Business Machine"
  description="Watch us scan your business, identify what's broken, and assemble it into a custom dashboard machine. Built around your exact needs."
>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <script is:inline set:html={JSON.stringify(serviceSchema)} type="application/ld+json"></script>

  <!-- Diagnostic Scan Animation Section -->
  <section id="diagnostic-scan" class="scan-section" data-animate>
    <div class="scan-sticky-container">
      <div class="relative w-full max-w-[1400px] mx-auto aspect-[16/10]" id="scanContainer">
        
        <!-- Stage 1: Chaos Field -->
        <div class="chaos-field" id="chaosField">
          <div class="chaos-item" data-pain="leads" data-module="lead-tracker" data-service="/services/web-design/">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg></div>
          <div class="chaos-item" data-pain="revenue" data-module="revenue-radar" data-service="/services/seo/">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg></div>
          <div class="chaos-item" data-pain="workflow" data-module="workflow-engine" data-service="/services/custom-software-saas/">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg></div>
          <div class="chaos-item" data-pain="alerts" data-module="alert-center" data-service="/services/case-studies/">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg></div>
          <div class="chaos-item" data-pain="forecast" data-module="forecast-hub" data-service="/services/portfolio/">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div>
          <div class="chaos-item" data-pain="profit" data-module="profit-lens" data-service="/services/branding/">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg></div>
        </div>

        <!-- Stage 2: Scanner -->
        <div class="scanner-beam" id="scannerBeam"></div>
        <div class="scan-line" id="scanLine"></div>
        <div class="scan-reticle" id="scanReticle"></div>

        <!-- Stage 3: The Machine -->
        <div class="machine-frame" id="machineFrame">
          <div class="machine-header">
            <span class="machine-title">BUSINESS OS</span>
            <span class="machine-status">OPTIMIZED</span>
          </div>
          <div class="machine-grid">
            <div class="module-slot" id="lead-tracker" data-service="/services/web-design/">
              <div class="module-content"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg></div>
              <div class="module-label">Lead Tracker</div>
            </div>
            <div class="module-slot" id="revenue-radar" data-service="/services/seo/">
              <div class="module-content"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg></div>
              <div class="module-label">Revenue Radar</div>
            </div>
            <div class="module-slot" id="workflow-engine" data-service="/services/custom-software-saas/">
              <div class="module-content"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg></div>
              <div class="module-label">Workflow Engine</div>
            </div>
            <div class="module-slot" id="alert-center" data-service="/services/case-studies/">
              <div class="module-content"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg></div>
              <div class="module-label">Alert Center</div>
            </div>
            <div class="module-slot" id="forecast-hub" data-service="/services/portfolio/">
              <div class="module-content"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div>
              <div class="module-label">Forecast Hub</div>
            </div>
            <div class="module-slot" id="profit-lens" data-service="/services/branding/">
              <div class="module-content"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg></div>
              <div class="module-label">Profit Lens</div>
            </div>
          </div>
        </div>

        <!-- Stage 4: Connection Lines -->
        <svg class="connection-layer" id="connectionLayer" width="100%" height="100%">
          <defs>
            <linearGradient id="connGrad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" style="stop-color:#00d4ff;stop-opacity:0.3"/>
              <stop offset="100%" style="stop-color:#2ed573;stop-opacity:0.3"/>
            </linearGradient>
          </defs>
          <path class="conn-line" d="" stroke="url(#connGrad)" stroke-width="2" fill="none" stroke-dasharray="8 4"/>
          <circle class="conn-pulse" r="3" fill="#00d4ff" opacity="0"/>
        </svg>

        <!-- Stage 5: Service Labels -->
        <div class="service-labels" id="serviceLabels">
          <div class="service-label" data-for="lead-tracker" data-service="/services/web-design/" style="--label-x: 15%; --label-y: 25%;">
            <span class="label-text">Lead Tracker</span>
            <span class="label-service">/services/web-design/</span>
          </div>
          <div class="service-label" data-for="revenue-radar" data-service="/services/seo/" style="--label-x: 50%; --label-y: 15%;">
            <span class="label-text">Revenue Radar</span>
            <span class="label-service">/services/seo/</span>
          </div>
          <div class="service-label" data-for="workflow-engine" data-service="/services/custom-software-saas/" style="--label-x: 80%; --label-y: 35%;">
            <span class="label-text">Workflow Engine</span>
            <span class="label-service">/services/custom-software-saas/</span>
          </div>
          <div class="service-label" data-for="alert-center" data-service="/services/case-studies/" style="--label-x: 30%; --label-y: 65%;">
            <span class="label-text">Alert Center</span>
            <span class="label-service">/services/case-studies/</span>
          </div>
          <div class="service-label" data-for="forecast-hub" data-service="/services/portfolio/" style="--label-x: 65%; --label-y: 60%;">
            <span class="label-text">Forecast Hub</span>
            <span class="label-service">/services/portfolio/</span>
          </div>
          <div class="service-label" data-for="profit-lens" data-service="/services/branding/" style="--label-x: 85%; --label-y: 75%;">
            <span class="label-text">Profit Lens</span>
            <span class="label-service">/services/branding/</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section (kept) -->
  <section class="py-20 px-4" data-animate>
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ FAQs</p>
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-4">Custom Software &amp; SaaS — Questions Answered</h2>
      </div>
      <div class="space-y-4">
        <details class="group bg-brand-dark rounded-2xl border border-white/10 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-5 list-none font-bold text-white text-lg hover:text-brand-cyan transition-colors">
            What is a custom SaaS platform?
            <span class="shrink-0 w-6 h-6 text-brand-accent transition-transform duration-300 group-open:rotate-45"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg></span>
          </summary>
          <div class="px-6 pb-6 text-white text-lg leading-relaxed">A Software-as-a-Service (SaaS) platform is a web-based application your business runs on a subscription model. A custom build means it is designed and coded specifically around your workflows, your clients, and your goals.</div>
        </details>
        <details class="group bg-brand-dark rounded-2xl border border-white/10 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-5 list-none font-bold text-white text-lg hover:text-brand-cyan transition-colors">
            Why get custom software instead of off-the-shelf SaaS?
            <span class="shrink-0 w-6 h-6 text-brand-accent transition-transform duration-300 group-open:rotate-45"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg></span>
          </summary>
          <div class="px-6 pb-6 text-white text-lg leading-relaxed">Off-the-shelf tools force your business to change how it works. Custom software adapts to you: unique processes, branding, integrations, and data handling are built in from day one.</div>
        </details>
        <details class="group bg-brand-dark rounded-2xl border border-white/10 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-5 list-none font-bold text-white text-lg hover:text-brand-cyan transition-colors">
            How much does custom software cost?
            <span class="shrink-0 w-6 h-6 text-brand-accent transition-transform duration-300 group-open:rotate-45"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg></span>
          </summary>
          <div class="px-6 pb-6 text-white text-lg leading-relaxed">Every custom build is scoped individually. Smaller tools run in the mid four to low five figures, while full SaaS platforms range from the low five figures up. Every project is quoted transparently.</div>
        </details>
        <details class="group bg-brand-dark rounded-2xl border border-white/10 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-5 list-none font-bold text-white text-lg hover:text-brand-cyan transition-colors">
            How long does it take?
            <span class="shrink-0 w-6 h-6 text-brand-accent transition-transform duration-300 group-open:rotate-45"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg></span>
          </summary>
          <div class="px-6 pb-6 text-white text-lg leading-relaxed">MVP builds usually land in 4-8 weeks, while full-scale platforms take 3-6 months. We work in phases so you see progress early, then iterate.</div>
        </details>
      </div>
    </div>
  </section>

  <!-- Service Area Mentions -->
  <section class="py-12 px-4 border-t border-white/5 bg-brand-darkest/50">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 text-sm text-white/90">
        <span class="text-brand-glow/60 uppercase tracking-widest font-bold">Serving Our Community:</span>
        <a href="/web-design-shelby-nc/" class="hover:text-brand-cyan transition-colors">Shelby Custom Software</a>
        <a href="/web-design-gastonia-nc/" class="hover:text-brand-cyan transition-colors">Gastonia SaaS</a>
        <a href="/web-design-asheville-nc/" class="hover:text-brand-cyan transition-colors">Asheville Web Apps</a>
        <a href="/web-design-forest-city-nc/" class="hover:text-brand-cyan transition-colors">Forest City Software</a>
      </div>
    </div>
  </section>

  <!-- Animation Script -->
  <script>
    import { createTimeline, stagger } from 'animejs';
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Check URL parameter for focus module
      const urlParams = new URLSearchParams(window.location.search);
      const focusModule = urlParams.get('focus');

      const section = document.querySelector('#diagnostic-scan');
      if (!section) throw new Error('#diagnostic-scan not found');

      function getScrollProgress() {
        const rect = section.getBoundingClientRect();
        const scrollable = rect.height - window.innerHeight;
        if (scrollable <= 0) return 0;
        return Math.min(Math.max(-rect.top / scrollable, 0), 1);
      }

      // Build master timeline
      const masterTl = createTimeline({ autoplay: false, easing: 'easeOutExpo' });

      // Act 1: Chaos Reveal (0-15%)
      masterTl.add('.chaos-item', { opacity: [0, 0.8], scale: [0.5, 1], delay: stagger(80), duration: 800, rotate: stagger([5, -5, 3, -3, 4, -4], { direction: 'alternate' }) });

      // Act 2: The Scan (15-40%)
      masterTl.add('#scanLine', { opacity: [0, 1], duration: 400 }, '-=200')
        .add('#scanLine', { translateY: ['-100%', '100%'], duration: 2500, easing: 'linear' }, '-=200')
        .add('.chaos-item', { filter: ['grayscale(1) brightness(0.5)', 'grayscale(0) brightness(1.3)'], stroke: ['transparent', '#ff4757'], delay: stagger(150), duration: 600 }, '-=2000');

      // Act 3: Extraction & Transformation (40-70%)
      masterTl.add('.chaos-item', { opacity: [0.8, 0], scale: 0.2, rotate: 0, delay: stagger(100), duration: 1000, easing: 'easeInExpo' })
        .add('#machineFrame', { opacity: [0, 1], scale: [0.85, 1], duration: 1000, borderColor: ['transparent', '#2a3548'] }, '-=800')
        .add('.module-slot', { opacity: [0, 1], translateY: [40, 0], delay: stagger(120), duration: 800 }, '-=600');

      // Act 4: System Online (70-100%)
      masterTl.add('.module-content', { opacity: [0, 1], duration: 600 })
        .add('.machine-status', { opacity: [0, 1], duration: 400 }, '-=400')
        .add('.service-label', { opacity: [0, 1], translateY: [20, 0], delay: stagger(80), duration: 600 }, '-=400');

      // Scroll binding
      function updateScroll() {
        const progress = getScrollProgress();
        masterTl.seek(masterTl.duration * progress);
      }

      window.addEventListener('scroll', updateScroll, { passive: true });

      // URL parameter focus
      if (focusModule) {
        const targetModule = document.querySelector(`#${focusModule}`);
        if (targetModule) {
          setTimeout(() => {
            (targetModule as HTMLElement).style.borderColor = '#ffd700';
            (targetModule as HTMLElement).style.boxShadow = '0 0 40px rgba(255, 215, 0, 0.3)';
            const label = document.querySelector(`[data-for="${focusModule}"]`);
            if (label) (label as HTMLElement).style.opacity = '1';
          }, 1500);
        }
      }

      // Module click navigation
      document.querySelectorAll('.module-slot, .service-label').forEach((el) => {
        el.addEventListener('click', () => {
          const url = (el as HTMLElement).dataset.service;
          if (url) {
            (el as HTMLElement).style.transform = 'scale(0.95)';
            setTimeout(() => { window.location.href = url; }, 200);
          }
        });
      });
    } else {
      // Reduced motion: show final state
      document.querySelectorAll('.chaos-item').forEach((el) => { (el as HTMLElement).style.display = 'none'; });
      document.querySelectorAll('.machine-frame, .module-slot, .module-content, .service-label, #machineFrame').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }
  </script>

</BaseLayout>
