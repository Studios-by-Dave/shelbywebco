---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PixieDust from '../../components/PixieDust.jsx';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'What is a custom SaaS platform?',
      'acceptedAnswer': { '@type': 'Answer', 'text': 'A Software-as-a-Service (SaaS) platform is a web-based application your business runs on a subscription model.' }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Custom Software & SaaS Platform Development",
  "description": "Custom web applications, portals, and subscription platforms built around your business.",
  "url": "https://www.shelbywebco.com/services/custom-software-saas/",
  "provider": { "@type": "LocalBusiness", "name": "Shelby Web Company", "url": "https://www.shelbywebco.com", "telephone": "(704) 473-8188" }
};
---

<BaseLayout 
  title="Custom Software & SaaS — Your Business Machine"
  description="Watch us scan your business, identify what's broken, and assemble it into a custom dashboard machine. Built around your exact needs."
>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <script is:inline set:html={JSON.stringify(serviceSchema)} type="application/ld+json"></script>

  <!-- Hero Section -->
  <section class="py-10 lg:py-14 px-4 relative overflow-hidden bg-brand-darkest" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-black/40 via-brand-darkest/50 to-black/40 pointer-events-none"></div>
    <div class="absolute inset-0 bg-noise opacity-[0.03] pointer-events-none"></div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ Custom Software &amp; SaaS</p>
      <div class="relative inline-block">
        <PixieDust client:load />
        <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4 leading-tight">
          Your Business Machine
        </h1>
      </div>
      <p class="text-lg md:text-xl text-white/90 mb-8 max-w-2xl mx-auto">
        Watch us scan your business, identify what's broken, and assemble it into a custom dashboard built around your exact needs. Six modules. One system. Total clarity.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-8">
        <a 
          href="/contact/"
          class="cta-glow-shine inline-block bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-8 py-3 rounded-xl font-medium border border-white/20 shadow-[inset_0_1px_0_rgba(255,255,255,0.65),inset_0_-2px_6px_rgba(0,0,0,0.25),0_4px_14px_rgba(0,0,0,0.4),0_2px_8px_rgba(132,204,22,0.35),0_0_20px_rgba(132,204,22,0.25)] hover:from-[#b5f146] hover:via-brand-accent-light hover:to-[#4d7c0f] hover:-translate-y-[1px] active:translate-y-[1px] active:shadow-[inset_0_2px_4px_rgba(0,0,0,0.3),0_2px_6px_rgba(0,0,0,0.3)] transition-all duration-300"
        >
          Get Your Free Quote
        </a>
        <a 
          href="#diagnostic-scan"
          class="inline-block text-white text-xl md:text-2xl font-bold hover:text-brand-cyan transition-colors"
        >
          See How It Works ↓
        </a>
      </div>
      <div class="mt-8 flex flex-wrap justify-center items-center gap-6 text-sm text-white/70">
        <span class="flex items-center gap-2"><span class="text-brand-cyan">✓</span> Custom-built for your business</span>
        <span class="flex items-center gap-2"><span class="text-brand-cyan">✓</span> 6 core modules</span>
        <span class="flex items-center gap-2"><span class="text-brand-cyan">✓</span> Scalable SaaS architecture</span>
        <span class="flex items-center gap-2"><span class="text-brand-cyan">✓</span> MVP in 4-8 weeks</span>
      </div>
    </div>
  </section>

  <!-- Diagnostic Scan Animation Section -->
  <section id="diagnostic-scan" class="scan-section" data-animate>
    <div class="scan-sticky-container">
      <div class="relative w-full max-w-[1400px] mx-auto aspect-[16/10]" id="scanContainer">
        
        <!-- Stage 1: Chaos Field -->
        <div class="chaos-field" id="chaosField">
          <div class="chaos-item" data-pain="leads" data-module="lead-tracker" data-service="/services/web-design/">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg></div>
          <div class="chaos-item" data-pain="revenue" data-module="revenue-radar" data-service="/services/seo/">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg></div>
          <div class="chaos-item" data-pain="workflow" data-module="workflow-engine" data-service="/services/custom-software-saas/">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg></div>
          <div class="chaos-item" data-pain="alerts" data-module="alert-center" data-service="/services/case-studies/">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg></div>
          <div class="chaos-item" data-pain="forecast" data-module="forecast-hub" data-service="/services/portfolio/">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div>
          <div class="chaos-item" data-pain="profit" data-module="profit-lens" data-service="/services/branding/">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg></div>
        </div>

        <!-- Stage 2: Scanner -->
        <div class="scanner-beam" id="scannerBeam"></div>
        <div class="scan-line" id="scanLine"></div>
        <div class="scan-reticle" id="scanReticle"></div>

        <!-- Stage 3: The Machine -->
        <div class="machine-frame" id="machineFrame">
          <div class="machine-header">
            <span class="machine-title">BUSINESS OS</span>
            <span class="machine-status">OPTIMIZED</span>
          </div>
          <div class="machine-grid">
            <div class="module-slot" id="lead-tracker" data-service="/services/web-design/">
              <div class="module-content"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg></div>
              <div class="module-label">Lead Tracker</div>
            </div>
            <div class="module-slot" id="revenue-radar" data-service="/services/seo/">
              <div class="module-content"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg></div>
              <div class="module-label">Revenue Radar</div>
            </div>
            <div class="module-slot" id="workflow-engine" data-service="/services/custom-software-saas/">
              <div class="module-content"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg></div>
              <div class="module-label">Workflow Engine</div>
            </div>
            <div class="module-slot" id="alert-center" data-service="/services/case-studies/">
              <div class="module-content"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg></div>
              <div class="module-label">Alert Center</div>
            </div>
            <div class="module-slot" id="forecast-hub" data-service="/services/portfolio/">
              <div class="module-content"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div>
              <div class="module-label">Forecast Hub</div>
            </div>
            <div class="module-slot" id="profit-lens" data-service="/services/branding/">
              <div class="module-content"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg></div>
              <div class="module-label">Profit Lens</div>
            </div>
          </div>
        </div>

        <!-- Stage 4: Connection Lines -->
        <svg class="connection-layer" id="connectionLayer" width="100%" height="100%">
          <defs>
            <linearGradient id="connGrad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" style="stop-color:#00d4ff;stop-opacity:0.3"/>
              <stop offset="100%" style="stop-color:#2ed573;stop-opacity:0.3"/>
            </linearGradient>
          </defs>
          <path class="conn-line" d="" stroke="url(#connGrad)" stroke-width="2" fill="none" stroke-dasharray="8 4"/>
          <circle class="conn-pulse" r="3" fill="#00d4ff" opacity="0"/>
        </svg>

        <!-- Stage 5: Service Labels -->
        <div class="service-labels" id="serviceLabels">
          <div class="service-label" data-for="lead-tracker" data-service="/services/web-design/" style="--label-x: 15%; --label-y: 25%;">
            <span class="label-text">Lead Tracker</span>
            <span class="label-service">/services/web-design/</span>
          </div>
          <div class="service-label" data-for="revenue-radar" data-service="/services/seo/" style="--label-x: 50%; --label-y: 15%;">
            <span class="label-text">Revenue Radar</span>
            <span class="label-service">/services/seo/</span>
          </div>
          <div class="service-label" data-for="workflow-engine" data-service="/services/custom-software-saas/" style="--label-x: 80%; --label-y: 35%;">
            <span class="label-text">Workflow Engine</span>
            <span class="label-service">/services/custom-software-saas/</span>
          </div>
          <div class="service-label" data-for="alert-center" data-service="/services/case-studies/" style="--label-x: 30%; --label-y: 65%;">
            <span class="label-text">Alert Center</span>
            <span class="label-service">/services/case-studies/</span>
          </div>
          <div class="service-label" data-for="forecast-hub" data-service="/services/portfolio/" style="--label-x: 65%; --label-y: 60%;">
            <span class="label-text">Forecast Hub</span>
            <span class="label-service">/services/portfolio/</span>
          </div>
          <div class="service-label" data-for="profit-lens" data-service="/services/branding/" style="--label-x: 85%; --label-y: 75%;">
            <span class="label-text">Profit Lens</span>
            <span class="label-service">/services/branding/</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Overview -->
  <section class="py-20 px-4 bg-brand-darkest border-y border-white/5" data-animate>
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ How It Works</p>
        <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4">From Chaos to Clarity</h2>
        <p class="text-lg text-white/80 max-w-3xl mx-auto">Every business has disconnected tools and hidden gaps. Our Diagnostic Scan identifies exactly what's broken, then builds your machine module by module.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8 mb-16">
        <!-- Step 1 -->
        <div class="bg-brand-dark rounded-2xl border border-white/10 p-8 text-center hover:border-brand-cyan/30 transition-all duration-300">
          <div class="w-16 h-16 rounded-full bg-brand-cyan/10 flex items-center justify-center mx-auto mb-6">
            <span class="font-heading text-2xl font-bold text-brand-cyan">1</span>
          </div>
          <h3 class="font-heading text-xl font-bold text-white mb-3">Scan & Diagnose</h3>
          <p class="text-white/70 text-sm leading-relaxed">We analyze your current tech stack, workflows, and revenue gaps. Every business has blind spots — our scan finds them before they cost you.</p>
        </div>
        <!-- Step 2 -->
        <div class="bg-brand-dark rounded-2xl border border-white/10 p-8 text-center hover:border-brand-cyan/30 transition-all duration-300">
          <div class="w-16 h-16 rounded-full bg-brand-cyan/10 flex items-center justify-center mx-auto mb-6">
            <span class="font-heading text-2xl font-bold text-brand-cyan">2</span>
          </div>
          <h3 class="font-heading text-xl font-bold text-white mb-3">Build Your Machine</h3>
          <p class="text-white/70 text-sm leading-relaxed">Six modules are assembled into a unified dashboard. Each module targets a specific business function — leads, revenue, workflow, alerts, forecasting, profit.</p>
        </div>
        <!-- Step 3 -->
        <div class="bg-brand-dark rounded-2xl border border-white/10 p-8 text-center hover:border-brand-cyan/30 transition-all duration-300">
          <div class="w-16 h-16 rounded-full bg-brand-cyan/10 flex items-center justify-center mx-auto mb-6">
            <span class="font-heading text-2xl font-bold text-brand-cyan">3</span>
          </div>
          <h3 class="font-heading text-xl font-bold text-white mb-3">Launch & Optimize</h3>
          <p class="text-white/70 text-sm leading-relaxed">Your MVP ships in 4-8 weeks. We iterate based on real data, scale what works, and refine what doesn't. Your machine runs 24/7.</p>
        </div>
      </div>

      <!-- What We Build -->
      <div class="text-center mb-12">
        <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ The Six Modules</p>
        <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4">One System, Six Engines</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="group bg-brand-dark rounded-2xl border border-white/10 p-6 hover:border-brand-cyan/40 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-red-500/10 flex items-center justify-center mb-4 group-hover:bg-red-500/20 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ff4757" stroke-width="2"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-white mb-2">Lead Tracker</h3>
          <p class="text-white/60 text-sm">Capture, organize, and nurture every lead so nothing falls through the cracks.</p>
          <a href="/services/web-design/" class="text-brand-cyan text-sm font-bold mt-3 inline-block hover:underline">View →</a>
        </div>
        <div class="group bg-brand-dark rounded-2xl border border-white/10 p-6 hover:border-brand-cyan/40 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-green-500/10 flex items-center justify-center mb-4 group-hover:bg-green-500/20 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2ed573" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-white mb-2">Revenue Radar</h3>
          <p class="text-white/60 text-sm">Track income streams, forecast revenue, and identify growth opportunities.</p>
          <a href="/services/seo/" class="text-brand-cyan text-sm font-bold mt-3 inline-block hover:underline">View →</a>
        </div>
        <div class="group bg-brand-dark rounded-2xl border border-white/10 p-6 hover:border-brand-cyan/40 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-blue-500/10 flex items-center justify-center mb-4 group-hover:bg-blue-500/20 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5b9cf5" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-white mb-2">Workflow Engine</h3>
          <p class="text-white/60 text-sm">Automate repetitive tasks and build custom processes that run themselves.</p>
          <a href="/services/custom-software-saas/" class="text-brand-cyan text-sm font-bold mt-3 inline-block hover:underline">View →</a>
        </div>
        <div class="group bg-brand-dark rounded-2xl border border-white/10 p-6 hover:border-brand-cyan/40 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-orange-500/10 flex items-center justify-center mb-4 group-hover:bg-orange-500/20 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffa502" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-white mb-2">Alert Center</h3>
          <p class="text-white/60 text-sm">Real-time notifications for issues, opportunities, and key milestones.</p>
          <a href="/services/case-studies/" class="text-brand-cyan text-sm font-bold mt-3 inline-block hover:underline">View →</a>
        </div>
        <div class="group bg-brand-dark rounded-2xl border border-white/10 p-6 hover:border-brand-cyan/40 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-purple-500/10 flex items-center justify-center mb-4 group-hover:bg-purple-500/20 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-white mb-2">Forecast Hub</h3>
          <p class="text-white/60 text-sm">Predict trends, plan budgets, and make data-driven decisions with confidence.</p>
          <a href="/services/portfolio/" class="text-brand-cyan text-sm font-bold mt-3 inline-block hover:underline">View →</a>
        </div>
        <div class="group bg-brand-dark rounded-2xl border border-white/10 p-6 hover:border-brand-cyan/40 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-yellow-500/10 flex items-center justify-center mb-4 group-hover:bg-yellow-500/20 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffd700" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-white mb-2">Profit Lens</h3>
          <p class="text-white/60 text-sm">See what's actually profitable, cut waste, and maximize margins.</p>
          <a href="/services/branding/" class="text-brand-cyan text-sm font-bold mt-3 inline-block hover:underline">View →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing / CTA Section -->
  <section class="py-24 px-4 bg-brand-darkest/50" data-animate>
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ Investment Options</p>
      <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4">Built to Scale With You</h2>
      <p class="text-lg text-white/80 mb-12 max-w-2xl mx-auto">MVP in 4-8 weeks. Full platform in 3-6 months. Every project quoted transparently — no hidden fees, no surprises.</p>
      <div class="grid md:grid-cols-2 gap-6 mb-12">
        <div class="bg-brand-dark rounded-2xl border border-white/10 p-8 hover:border-brand-cyan/30 transition-all duration-300">
          <h3 class="font-heading text-xl font-bold text-white mb-2">MVP Build</h3>
          <p class="text-brand-cyan text-2xl font-bold mb-1">Starting at $1,498</p>
          <p class="text-white/60 text-sm mb-4">Working prototype with core modules</p>
          <ul class="text-left text-white/70 text-sm space-y-2 mb-6">
            <li class="flex items-start gap-2"><span class="text-brand-cyan">✓</span> 2 core modules</li>
            <li class="flex items-start gap-2"><span class="text-brand-cyan">✓</span> Custom dashboard</li>
            <li class="flex items-start gap-2"><span class="text-brand-cyan">✓</span> 4-8 week delivery</li>
            <li class="flex items-start gap-2"><span class="text-brand-cyan">✓</span> Basic integrations</li>
          </ul>
          <a href="/contact/" class="cta-glow-shine inline-block bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-6 py-3 rounded-xl font-medium border border-white/20 text-sm">Get Your Free Quote</a>
        </div>
        <div class="bg-brand-dark rounded-2xl border border-white/10 p-8 hover:border-brand-cyan/30 transition-all duration-300">
          <h3 class="font-heading text-xl font-bold text-white mb-2">Full Platform</h3>
          <p class="text-brand-cyan text-2xl font-bold mb-1">Starting at $2,498</p>
          <p class="text-white/60 text-sm mb-4">Complete SaaS with all six modules</p>
          <ul class="text-left text-white/70 text-sm space-y-2 mb-6">
            <li class="flex items-start gap-2"><span class="text-brand-cyan">✓</span> All 6 modules</li>
            <li class="flex items-start gap-2"><span class="text-brand-cyan">✓</span> Full dashboard</li>
            <li class="flex items-start gap-2"><span class="text-brand-cyan">✓</span> 3-6 month delivery</li>
            <li class="flex items-start gap-2"><span class="text-brand-cyan">✓</span> Advanced integrations</li>
            <li class="flex items-start gap-2"><span class="text-brand-cyan">✓</span> Analytics & reporting</li>
          </ul>
          <a href="/contact/" class="cta-glow-shine inline-block bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-6 py-3 rounded-xl font-medium border border-white/20 text-sm">Schedule Free Consultation</a>
