---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PixieDust from '../../components/PixieDust.jsx';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'What is a custom SaaS platform?',
      'acceptedAnswer': { '@type': 'Answer', 'text': 'A Software-as-a-Service (SaaS) platform is a web-based application your business runs on a subscription model.' }
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Custom Software & SaaS Platform Development",
  "description": "Custom web applications, portals, and subscription platforms built around your business.",
  "url": "https://www.shelbywebco.com/services/custom-software-saas/",
  "provider": { "@type": "LocalBusiness", "name": "Shelby Web Company", "url": "https://www.shelbywebco.com", "telephone": "(704) 473-8188" }
};
---

<BaseLayout 
  title="Custom Software & SaaS — Your Business Machine"
  description="Watch us scan your business, identify what's broken, and assemble it into a custom dashboard machine. Built around your exact needs."
>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  <script is:inline set:html={JSON.stringify(serviceSchema)} type="application/ld+json"></script>

  <!-- Hero Section -->
  <section class="py-8 lg:py-10 px-4 relative overflow-hidden" data-animate style="background: linear-gradient(135deg, #3f6212 0%, #4d7c0f 30%, #65a30d 60%, #84cc16 85%, #a3e635 100%);">
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 600px 400px at 85% 5%, rgba(255,255,255,0.55) 0%, rgba(255,255,255,0.2) 35%, transparent 70%);"></div>
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(circle at 88% 8%, rgba(255,255,255,0.7) 0%, transparent 30%);"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] pointer-events-none" style="background: radial-gradient(ellipse 300px 200px at 0% 100%, rgba(255,255,255,0.25) 0%, rgba(255,255,255,0.08) 40%, transparent 70%);"></div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <p class="text-black/70 text-sm uppercase tracking-widest mb-4 font-bold" style="-webkit-text-stroke: 0.5px rgba(255,255,255,0.6);">✦ Custom Software &amp; SaaS</p>
      <div class="relative inline-block">
        <PixieDust client:load />
        <h1 class="font-heading text-5xl md:text-6xl lg:text-7xl font-bold text-black mb-4 leading-tight" style="-webkit-text-stroke: 1px rgba(255,255,255,0.8); text-stroke: 1px rgba(255,255,255,0.8);">
          Your Business Machine
        </h1>
      </div>
      <p class="text-xl md:text-2xl text-black/80 mb-8 max-w-2xl mx-auto font-medium" style="-webkit-text-stroke: 0.5px rgba(255,255,255,0.5);">
        Watch us scan your business, identify what's broken, and assemble it into a custom dashboard built around your exact needs. Six modules. One system. Total clarity.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-8">
        <a
          href="/contact/"
          class="inline-block bg-black text-white px-8 py-3 rounded-xl font-bold border border-black/20 shadow-[0_4px_14px_rgba(0,0,0,0.4),0_0_20px_rgba(0,0,0,0.2)] hover:-translate-y-[1px] active:translate-y-[1px] transition-all duration-300"
        >
          Get Your Free Quote
        </a>
      </div>
      <div class="mt-8 flex flex-wrap justify-center items-center gap-6 text-sm text-black/70 font-medium">
        <span class="flex items-center gap-2"><span class="text-black font-bold">✓</span> Custom-built for your business</span>
        <span class="flex items-center gap-2"><span class="text-black font-bold">✓</span> 6 core modules</span>
        <span class="flex items-center gap-2"><span class="text-black font-bold">✓</span> Scalable SaaS architecture</span>
        <span class="flex items-center gap-2"><span class="text-black font-bold">✓</span> MVP in 4-8 weeks</span>
      </div>
    </div>
  </section>

  <!-- Service Overview -->
  <section class="py-20 px-4 bg-brand-darkest border-y border-white/5" data-animate>
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ How It Works</p>
        <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4">From Chaos to Clarity</h2>
        <p class="text-lg text-white/80 max-w-3xl mx-auto">Every business has disconnected tools and hidden gaps. Our Diagnostic Scan identifies exactly what's broken, then builds your machine module by module.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8 mb-16">
        <!-- Step 1 -->
        <div class="bg-brand-dark rounded-2xl border border-white/10 p-8 text-center hover:border-brand-cyan/30 transition-all duration-300">
          <div class="w-16 h-16 rounded-full bg-brand-cyan/10 flex items-center justify-center mx-auto mb-6">
            <span class="font-heading text-2xl font-bold text-brand-cyan">1</span>
          </div>
          <h3 class="font-heading text-xl font-bold text-white mb-3">Scan & Diagnose</h3>
          <p class="text-white/70 text-sm leading-relaxed">We analyze your current tech stack, workflows, and revenue gaps. Every business has blind spots — our scan finds them before they cost you.</p>
        </div>
        <!-- Step 2 -->
        <div class="bg-brand-dark rounded-2xl border border-white/10 p-8 text-center hover:border-brand-cyan/30 transition-all duration-300">
          <div class="w-16 h-16 rounded-full bg-brand-cyan/10 flex items-center justify-center mx-auto mb-6">
            <span class="font-heading text-2xl font-bold text-brand-cyan">2</span>
          </div>
          <h3 class="font-heading text-xl font-bold text-white mb-3">Build Your Machine</h3>
          <p class="text-white/70 text-sm leading-relaxed">Six modules are assembled into a unified dashboard. Each module targets a specific business function — leads, revenue, workflow, alerts, forecasting, profit.</p>
        </div>
        <!-- Step 3 -->
        <div class="bg-brand-dark rounded-2xl border border-white/10 p-8 text-center hover:border-brand-cyan/30 transition-all duration-300">
          <div class="w-16 h-16 rounded-full bg-brand-cyan/10 flex items-center justify-center mx-auto mb-6">
            <span class="font-heading text-2xl font-bold text-brand-cyan">3</span>
          </div>
          <h3 class="font-heading text-xl font-bold text-white mb-3">Launch & Optimize</h3>
          <p class="text-white/70 text-sm leading-relaxed">Your MVP ships in 4-8 weeks. We iterate based on real data, scale what works, and refine what doesn't. Your machine runs 24/7.</p>
        </div>
      </div>

      <!-- What We Build -->
      <div class="text-center mb-12">
        <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ The Six Modules</p>
        <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-4">One System, Six Engines</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="group bg-brand-dark rounded-2xl border border-white/10 p-6 hover:border-brand-cyan/40 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-red-500/10 flex items-center justify-center mb-4 group-hover:bg-red-500/20 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ff4757" stroke-width="2"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-white mb-2">Lead Tracker</h3>
          <p class="text-white/60 text-sm">Capture, organize, and nurture every lead so nothing falls through the cracks.</p>
          <a href="/services/web-design/" class="text-brand-cyan text-sm font-bold mt-3 inline-block hover:underline">View →</a>
        </div>
        <div class="group bg-brand-dark rounded-2xl border border-white/10 p-6 hover:border-brand-cyan/40 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-green-500/10 flex items-center justify-center mb-4 group-hover:bg-green-500/20 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2ed573" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-white mb-2">Revenue Radar</h3>
          <p class="text-white/60 text-sm">Track income streams, forecast revenue, and identify growth opportunities.</p>
          <a href="/services/seo/" class="text-brand-cyan text-sm font-bold mt-3 inline-block hover:underline">View →</a>
        </div>
        <div class="group bg-brand-dark rounded-2xl border border-white/10 p-6 hover:border-brand-cyan/40 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-blue-500/10 flex items-center justify-center mb-4 group-hover:bg-blue-500/20 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5b9cf5" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-white mb-2">Workflow Engine</h3>
          <p class="text-white/60 text-sm">Automate repetitive tasks and build custom processes that run themselves.</p>
          <a href="/services/custom-software-saas/" class="text-brand-cyan text-sm font-bold mt-3 inline-block hover:underline">View →</a>
        </div>
        <div class="group bg-brand-dark rounded-2xl border border-white/10 p-6 hover:border-brand-cyan/40 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-orange-500/10 flex items-center justify-center mb-4 group-hover:bg-orange-500/20 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffa502" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-white mb-2">Alert Center</h3>
          <p class="text-white/60 text-sm">Real-time notifications for issues, opportunities, and key milestones.</p>
          <a href="/services/case-studies/" class="text-brand-cyan text-sm font-bold mt-3 inline-block hover:underline">View →</a>
        </div>
        <div class="group bg-brand-dark rounded-2xl border border-white/10 p-6 hover:border-brand-cyan/40 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-purple-500/10 flex items-center justify-center mb-4 group-hover:bg-purple-500/20 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-white mb-2">Forecast Hub</h3>
          <p class="text-white/60 text-sm">Predict trends, plan budgets, and make data-driven decisions with confidence.</p>
          <a href="/services/portfolio/" class="text-brand-cyan text-sm font-bold mt-3 inline-block hover:underline">View →</a>
        </div>
        <div class="group bg-brand-dark rounded-2xl border border-white/10 p-6 hover:border-brand-cyan/40 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-yellow-500/10 flex items-center justify-center mb-4 group-hover:bg-yellow-500/20 transition-colors">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffd700" stroke-width="2"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
          </div>
          <h3 class="font-heading text-lg font-bold text-white mb-2">Profit Lens</h3>
          <p class="text-white/60 text-sm">See what's actually profitable, cut waste, and maximize margins.</p>
          <a href="/services/branding/" class="text-brand-cyan text-sm font-bold mt-3 inline-block hover:underline">View →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Custom Beats Prepackaged -->
  <section class="py-20 px-4 bg-brand-dark border-y border-white/5" data-animate>
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ Why Custom Wins</p>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-white mb-4">Built Around You, Not the Other Way Around</h2>
      <p class="text-white/70 text-lg mb-10 max-w-2xl mx-auto">Prepackaged tools force your business to bend to their workflow — plus per-seat fees forever. Custom software fits how you already work, connects your existing tools, and you own it outright.</p>
      <div class="grid md:grid-cols-3 gap-6 text-left">
        <div class="bg-brand-darkest rounded-2xl border border-white/10 p-6">
          <h3 class="font-heading text-lg font-bold text-white mb-2">Fits your process</h3>
          <p class="text-white/60 text-sm leading-relaxed">No workarounds or spreadsheet side-hacks. Every screen matches the way your team actually operates.</p>
        </div>
        <div class="bg-brand-darkest rounded-2xl border border-white/10 p-6">
          <h3 class="font-heading text-lg font-bold text-white mb-2">No per-seat tax</h3>
          <p class="text-white/60 text-sm leading-relaxed">Stop paying monthly per-user fees that grow with your team. One build, yours to keep and scale.</p>
        </div>
        <div class="bg-brand-darkest rounded-2xl border border-white/10 p-6">
          <h3 class="font-heading text-lg font-bold text-white mb-2">Grows with you</h3>
          <p class="text-white/60 text-sm leading-relaxed">Add modules and integrations as you grow instead of ripping out a tool you outgrew in a year.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section (kept) -->
  <section class="py-20 px-4" data-animate>
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ FAQs</p>
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-4">Custom Software &amp; SaaS — Questions Answered</h2>
      </div>
      <div class="space-y-4">
        <details class="group bg-brand-dark rounded-2xl border border-white/10 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-5 list-none font-bold text-white text-lg hover:text-brand-cyan transition-colors">
            What is a custom SaaS platform?
            <span class="shrink-0 w-6 h-6 text-brand-accent transition-transform duration-300 group-open:rotate-45"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg></span>
          </summary>
          <div class="px-6 pb-6 text-white text-lg leading-relaxed">A Software-as-a-Service (SaaS) platform is a web-based application your business runs on a subscription model. A custom build means it is designed and coded specifically around your workflows, your clients, and your goals.</div>
        </details>
        <details class="group bg-brand-dark rounded-2xl border border-white/10 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-5 list-none font-bold text-white text-lg hover:text-brand-cyan transition-colors">
            Why get custom software instead of off-the-shelf SaaS?
            <span class="shrink-0 w-6 h-6 text-brand-accent transition-transform duration-300 group-open:rotate-45"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg></span>
          </summary>
          <div class="px-6 pb-6 text-white text-lg leading-relaxed">Off-the-shelf tools force your business to change how it works. Custom software adapts to you: unique processes, branding, integrations, and data handling are built in from day one.</div>
        </details>
        <details class="group bg-brand-dark rounded-2xl border border-white/10 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-5 list-none font-bold text-white text-lg hover:text-brand-cyan transition-colors">
            How much does custom software cost?
            <span class="shrink-0 w-6 h-6 text-brand-accent transition-transform duration-300 group-open:rotate-45"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg></span>
          </summary>
          <div class="px-6 pb-6 text-white text-lg leading-relaxed">Every custom build is scoped individually. Smaller tools run in the mid four to low five figures, while full SaaS platforms range from the low five figures up. Every project is quoted transparently.</div>
        </details>
        <details class="group bg-brand-dark rounded-2xl border border-white/10 overflow-hidden">
          <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-5 list-none font-bold text-white text-lg hover:text-brand-cyan transition-colors">
            How long does it take?
            <span class="shrink-0 w-6 h-6 text-brand-accent transition-transform duration-300 group-open:rotate-45"><svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg></span>
          </summary>
          <div class="px-6 pb-6 text-white text-lg leading-relaxed">MVP builds usually land in 4-8 weeks, while full-scale platforms take 3-6 months. We work in phases so you see progress early, then iterate.</div>
        </details>
      </div>
    </div>
  </section>

  <!-- Service Area Mentions -->
  <section class="py-12 px-4 border-t border-white/5 bg-brand-darkest/50">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 text-sm text-white/90">
        <span class="text-brand-glow/60 uppercase tracking-widest font-bold">Serving Our Community:</span>
        <a href="/web-design-shelby-nc/" class="hover:text-brand-cyan transition-colors">Shelby Custom Software</a>
        <a href="/web-design-gastonia-nc/" class="hover:text-brand-cyan transition-colors">Gastonia SaaS</a>
        <a href="/web-design-asheville-nc/" class="hover:text-brand-cyan transition-colors">Asheville Web Apps</a>
        <a href="/web-design-forest-city-nc/" class="hover:text-brand-cyan transition-colors">Forest City Software</a>
      </div>
    </div>
  </section>


</BaseLayout>