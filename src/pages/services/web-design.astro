---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PixieDust from '../../components/PixieDust.jsx';
import Image from '../../components/OptimizedImage.astro';
import BuildPricingSection from '../../components/BuildPricingSection.astro';
import SEOPricingSection from '../../components/SEOPricingSection.astro';
import ManagedGrowthSection from '../../components/ManagedGrowthSection.astro';

import comptiaBadge from '../../../assets/badge icons/CompTIA_A__Digital_Badge.jpg';
import projectBadge from '../../../assets/badge icons/badge_2.jpeg';
import sbdChart from '../../../assets/sbd ide chart1.png';
import webFlyer from '../../../assets/Sweb_flyer_new.jpg';

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Professional Web Design Services",
  "description": "High-performance, conversion-focused web design services. We build fast, mobile-responsive websites with built-in SEO to help your business grow.",
  "url": "https://www.shelbywebco.com/services/web-design/",
  "provider": { "@type": "LocalBusiness", "name": "Shelby Web Company", "url": "https://www.shelbywebco.com", "telephone": "(704) 473-8188" },
  "areaServed": ["Shelby, NC", "Kings Mountain, NC", "Gastonia, NC", "Forest City, NC", "Boiling Springs, NC", "Polkville, NC", "Asheville, NC"]
};
---

<BaseLayout 
  title="Custom Web Design Services in Shelby, NC"
  description="High-performance, conversion-focused web design services. We build fast, mobile-responsive websites with built-in SEO to help your business grow."
  bgVariant="charcoal"
>
  <script is:inline set:html={JSON.stringify(serviceSchema)} type="application/ld+json"></script>

  <!-- Hero Section -->
  <section class="py-10 lg:py-12 px-4 relative overflow-hidden bg-brand-darkest" data-animate>
    <div class="absolute inset-0 bg-gradient-to-br from-black/35 via-brand-darkest/45 to-black/35 pointer-events-none"></div>
    <div class="absolute inset-0 bg-noise opacity-[0.03] pointer-events-none"></div>
    <div class="absolute inset-0 bg-dot-pattern opacity-20 pointer-events-none"></div>
    <div class="absolute inset-0 bg-grid-pattern opacity-40 pointer-events-none"></div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <p class="text-brand-glow text-sm uppercase tracking-widest mb-4">✦ Web Design & Development</p>
      <div class="relative inline-block">
        <PixieDust client:load />
        <h1 class="font-heading text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-4 leading-tight">
          Professional <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-blue via-brand-blue-light to-brand-sky">Web Design</span> with You in Mind
        </h1>
      </div>
      <p class="text-xl text-white mb-8">
        We build responsive, high-performance websites that turn visitors into customers. Optimized for your specific business needs and built for long-term growth.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a 
          href="/contact/"
          class="cta-glow-shine inline-block bg-brand-accent text-[#0A0A0A] px-8 py-3 rounded-xl font-medium hover:bg-brand-accent-light"
        >
          Get Your Free Quote
        </a>
        <a 
          href="tel:+17044738188"
          class="text-white text-xl md:text-2xl font-bold hover:text-brand-accent transition-colors"
        >
          (704) 473-8188
        </a>
      </div>
      
      <div class="mt-12 flex justify-center items-center gap-8">
        <Image 
          src={comptiaBadge} 
          alt="CompTIA A+ Digital Badge" 
          class="h-24 md:h-28 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity"
        />
        <Image 
          src={projectBadge} 
          alt="Quality Project Badge" 
          class="h-24 md:h-28 w-auto object-contain opacity-90 hover:opacity-100 transition-opacity"
        />
      </div>
    </div>
  </section>

  <!-- Key Features Section -->
  <section class="py-24 px-4 bg-brand-darkest border-y border-white/5">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">Built for Performance, Designed for Growth</h2>
        <p class="text-white max-w-2xl mx-auto text-lg">
          We combine modern web design, technical SEO fundamentals, and conversion strategy so your site performs for both users and search engines.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5 hover:border-lime-500/50 transition-all duration-300">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest text-brand-darkest shadow-sm ">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-white mb-3 font-heading">Lightning Fast Performance</h3>
          <p class="text-white/90 text-base md:text-lg">Speed is a ranking factor. Our sites are optimized for core web vitals and rapid load times on all devices.</p>
        </div>
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5 hover:border-lime-500/50 transition-all duration-300">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest text-brand-darkest shadow-sm ">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-white mb-3 font-heading">Mobile-First Response</h3>
          <p class="text-white/90 text-base md:text-lg">With over 60% of traffic coming from mobile, we ensure your site looks and works perfectly on every screen size.</p>
        </div>
        <div class="bg-brand-dark p-8 rounded-2xl border border-white/5 hover:border-lime-500/50 transition-all duration-300">
          <div class="w-12 h-12 bg-gradient-to-br from-lime-400 to-lime-600 shadow-[0_0_15px_rgba(132,204,22,0.3)] rounded-lg flex items-center justify-center mb-6 text-brand-darkest text-brand-darkest shadow-sm ">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold text-white mb-3 font-heading">SEO Built-In</h3>
          <p class="text-white/90 text-base md:text-lg">We don't treat SEO as an afterthought. Clean code and proper structure are baked into every site we build.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Indexing Section -->
  <section class="py-24 px-4 bg-[#f8f9fc] text-slate-900 relative overflow-hidden" style="background-image: linear-gradient(rgba(148,163,184,0.18) 1px, transparent 1px); background-size: 100% 1.75rem;">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-10 md:gap-16 items-center">
        <div class="w-full break-words">
          <p class="text-brand-glow text-sm uppercase tracking-widest mb-4 [text-shadow:0.5px_0.5px_0_#1e3a8a,-0.5px_-0.5px_0_#1e3a8a,0.5px_-0.5px_0_#1e3a8a,-0.5px_0.5px_0_#1e3a8a]">✦ Technical Architecture</p>
          <h2 class="font-heading text-4xl md:text-5xl font-bold text-slate-900 mb-8 leading-tight">
            Beautiful Design is Only Half the Battle. <span class="text-brand-cyan drop-shadow-[0_0_1px_rgba(30,58,138,1)] [text-shadow:1px_1px_0_#1e3a8a,-1px_-1px_0_#1e3a8a,1px_-1px_0_#1e3a8a,-1px_1px_0_#1e3a8a]">Performance is Everything.</span>
          </h2>
          <div class="space-y-6 text-slate-700 text-lg">
            <p>
              A stunning website means nothing if it's slow, bloated, or falls apart on a phone. Great design earns the click, but performance keeps the customer — and in a fast-scrolling world, every second of delay quietly costs you business.
            </p>
            <p>
              At Shelby Web Co, we build on cutting-edge frameworks like <span class="text-slate-900 font-semibold">Astro, Next.js, and React</span>, using industry-standard build tools like <span class="text-slate-900 font-semibold">Vite</span> to ship lean, high-performance code. The result is a website that loads in a blink, ranks on mobile, and runs smoothly for every visitor — no unnecessary content blocks, no laggy interactions.
            </p>
            <p>
              This rigorous, quality-first approach also means your site is <span class="text-slate-900">clean, crawlable, and delivered as fast, standards-compliant HTML</span> — a reliable foundation that looks sharp today and stays ahead as your business grows.
            </p>
          </div>
          
          <div class="mt-10 flex flex-col sm:flex-row gap-4">
            <div class="flex items-center gap-3 bg-white shadow-sm border border-slate-200 px-6 py-4 rounded-2xl">
              <div class="w-10 h-10 bg-brand-blue/10 rounded-full flex items-center justify-center text-brand-blue">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
              </div>
              <div>
                <p class="text-slate-900 font-bold">Blazing Fast Loads</p>
                <p class="text-slate-500 text-sm">Lean code, quick on mobile</p>
              </div>
            </div>
            <div class="flex items-center gap-3 bg-white shadow-sm border border-slate-200 px-6 py-4 rounded-2xl">
              <div class="w-10 h-10 bg-brand-blue/10 rounded-full flex items-center justify-center text-brand-blue">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <div>
                <p class="text-slate-900 font-bold">Quality-First Code</p>
                <p class="text-slate-500 text-sm">Clean, standards-compliant build</p>
              </div>
            </div>
          </div>
        </div>

        <div class="relative min-w-0">
          <div class="absolute -inset-4 bg-brand-blue/10 blur-3xl rounded-full"></div>
          <div class="relative bg-white p-8 rounded-3xl border border-slate-200 shadow-2xl overflow-hidden">
            <div class="flex items-center gap-2 mb-6 border-b border-slate-200 pb-4">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
              <p class="text-slate-500 text-xs ml-2 font-mono truncate">build.perf-report.log</p>
            </div>
            <div class="space-y-4 font-mono text-sm text-slate-700">
              <div class="flex gap-4 min-w-0">
                <span class="text-slate-400">01</span>
                <span class="text-slate-700 shrink-0">Assets</span>
                <span class="text-slate-900 break-all">compiled & optimized (Vite)</span>
              </div>
              <div class="flex gap-4">
                <span class="text-brand-cyan">Success:</span>
                <span class="text-slate-600">First paint under 1 second.</span>
              </div>
              <div class="flex gap-4">
                <span class="text-brand-cyan">Success:</span>
                <span class="text-slate-600">Mobile & desktop scores 90+.</span>
              </div>
              <div class="flex gap-4 min-w-0">
                <span class="text-slate-400">04</span>
                <span class="text-slate-700 shrink-0">Result</span>
                <span class="text-slate-900">Fast page. Happy customers.</span>
              </div>
              <div class="mt-8 pt-4 border-t border-slate-200 flex items-center flex-wrap gap-x-4 gap-y-2">
                <div class="px-3 py-1 bg-brand-blue/10 text-brand-blue text-[10px] font-bold rounded uppercase">Performance-First Build</div>
                <div class="text-xs text-slate-500 italic">Shelby Web Co Build Pipeline v2.4</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <BuildPricingSection />

  <SEOPricingSection />
  <ManagedGrowthSection />

  <!-- Web Design Flyer -->
  <section class="py-12 px-4" data-animate>
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-8">
        <p class="text-silver-shimmer text-sm uppercase tracking-widest mb-3">✦ What We Offer</p>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-white">Our Web Design Services at a Glance</h2>
      </div>
      <div class="rounded-2xl overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.4)] border border-white/10">
        <Image src={webFlyer} alt="Shelby Web Company — Web Design Services Flyer" class="w-full h-auto" />
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <!-- Service Area Mentions for SEO -->
  <section class="py-12 px-4 border-t border-white/5 bg-brand-darkest/50">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 text-sm text-white/90">
        <span class="text-brand-glow/60 uppercase tracking-widest font-bold">Serving Our Community:</span>
        <a href="/web-design-shelby-nc/" class="hover:text-brand-cyan transition-colors">Shelby Web Design</a>
        <a href="/web-design-gastonia-nc/" class="hover:text-brand-cyan transition-colors">Gastonia SEO</a>
        <a href="/web-design-asheville-nc/" class="hover:text-brand-cyan transition-colors">Asheville Web Dev</a>
        <a href="/web-design-forest-city-nc/" class="hover:text-brand-cyan transition-colors">Forest City Marketing</a>
        <a href="/web-design-polkville-nc/" class="hover:text-brand-cyan transition-colors">Polkville Web Design</a>
        <a href="/web-design-boiling-springs-nc/" class="hover:text-brand-cyan transition-colors">Boiling Springs Design</a>
        <a href="/web-design-kings-mountain-nc/" class="hover:text-brand-cyan transition-colors">Kings Mountain Web Design</a>
      </div>
    </div>
  </section>

  <!-- Review Section -->
  <section class="py-20 px-4" data-animate>
    <div class="max-w-4xl mx-auto">
      <div class="rounded-3xl border border-brand-cyan/20 bg-brand-darkest/80 p-10">
        <div class="flex items-center gap-1 mb-4">
          <span class="text-yellow-300 text-3xl font-black drop-shadow-[0_0_18px_rgba(252,211,77,0.75)]">★</span>
          <span class="text-yellow-300 text-3xl font-black drop-shadow-[0_0_18px_rgba(252,211,77,0.75)]">★</span>
          <span class="text-yellow-300 text-3xl font-black drop-shadow-[0_0_18px_rgba(252,211,77,0.75)]">★</span>
          <span class="text-yellow-300 text-3xl font-black drop-shadow-[0_0_18px_rgba(252,211,77,0.75)]">★</span>
          <span class="text-yellow-300 text-3xl font-black drop-shadow-[0_0_18px_rgba(252,211,77,0.75)]">★</span>
        </div>
        <p class="text-white text-xl italic mb-4">"Great customer service!"</p>
        <p class="font-bold text-white text-lg">William Stephans</p>
        <p class="text-brand-cyan/60 text-sm uppercase tracking-widest mt-2">Local Guide</p>
      </div>
    </div>
  </section>

  <section class="py-24 px-4 bg-brand-dark border-y border-white/5">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-brand-glow text-label uppercase tracking-widest mb-4">✦ Built for Local Trades</p>
        <h2 class="font-heading text-section-heading md:text-section-heading-md font-bold text-white mb-4">Websites Built for Service Businesses</h2>
        <p class="text-white/70 max-w-2xl mx-auto">Every site we build is a lead-generating engine — not a digital business card. Here's who we build for.</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        <a href="/web-design-for-roofers-shelby-nc/" class="group bg-brand-darkest border border-white/10 rounded-xl p-5 hover:border-brand-cyan/50 hover:-translate-y-1 transition-all duration-300">
          <p class="text-white font-semibold group-hover:text-brand-cyan">Roofing &amp; Exterior</p>
          <p class="text-white/50 text-sm">Lead-gen systems that convert</p>
        </a>
        <a href="/web-design-for-landscapers-shelby-nc/" class="group bg-brand-darkest border border-white/10 rounded-xl p-5 hover:border-brand-cyan/50 hover:-translate-y-1 transition-all duration-300">
          <p class="text-white font-semibold group-hover:text-brand-cyan">Landscaping</p>
          <p class="text-white/50 text-sm">Seasonal promos &amp; portfolios</p>
        </a>
        <a href="/services/case-studies/" class="group bg-brand-darkest border border-white/10 rounded-xl p-5 hover:border-brand-cyan/50 hover:-translate-y-1 transition-all duration-300">
          <p class="text-white font-semibold group-hover:text-brand-cyan">Solar Installers</p>
          <p class="text-white/50 text-sm">ROI calculators &amp; education</p>
        </a>
        <a href="/web-design-for-construction-shelby-nc/" class="group bg-brand-darkest border border-white/10 rounded-xl p-5 hover:border-brand-cyan/50 hover:-translate-y-1 transition-all duration-300">
          <p class="text-white font-semibold group-hover:text-brand-cyan">Concrete &amp; Construction Trades</p>
          <p class="text-white/50 text-sm">Galleries &amp; estimate requests</p>
        </a>
        <a href="/services/case-studies/" class="group bg-brand-darkest border border-white/10 rounded-xl p-5 hover:border-brand-cyan/50 hover:-translate-y-1 transition-all duration-300">
          <p class="text-white font-semibold group-hover:text-brand-cyan">Plumbers</p>
          <p class="text-white/50 text-sm">Emergency dispatch systems</p>
        </a>
        <a href="/web-design-for-tree-specialists-shelby-nc/" class="group bg-brand-darkest border border-white/10 rounded-xl p-5 hover:border-brand-cyan/50 hover:-translate-y-1 transition-all duration-300">
          <p class="text-white font-semibold group-hover:text-brand-cyan">Tree Services</p>
          <p class="text-white/50 text-sm">Emergency &amp; seasonal care</p>
        </a>
        <a href="/services/case-studies/" class="group bg-brand-darkest border border-white/10 rounded-xl p-5 hover:border-brand-cyan/50 hover:-translate-y-1 transition-all duration-300">
          <p class="text-white font-semibold group-hover:text-brand-cyan">Expedited Trucking</p>
          <p class="text-white/50 text-sm">Tracking &amp; logistics platforms</p>
        </a>
        <a href="/web-design-for-home-remodelers-shelby-nc/" class="group bg-brand-darkest border border-white/10 rounded-xl p-5 hover:border-brand-cyan/50 hover:-translate-y-1 transition-all duration-300">
          <p class="text-white font-semibold group-hover:text-brand-cyan">Home Remodelers</p>
          <p class="text-white/50 text-sm">Before/after &amp; booking</p>
        </a>
      </div>
    </div>
  </section>

  <!-- SBD Chart (large, centered) -->
  <section class="py-12 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="mt-12 mb-12 flex justify-center">
        <Image src={sbdChart} alt="SBD IDE Chart — large" class="w-full max-w-4xl object-contain rounded-lg shadow-lg" />
      </div>
    </div>
  </section>

  <section class="py-24 px-4 relative overflow-hidden bg-brand-dark" data-animate>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <h2 class="font-heading text-4xl md:text-5xl font-bold text-white mb-6">Ready to Build Your Online Engine?</h2>
      <p class="text-lg text-white mb-10">Let's create a website that drives real business growth. No generic templates—just high-performance results.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/contact/"
          class="inline-block bg-brand-accent text-[#0A0A0A] px-10 py-4 rounded-xl font-black text-xl hover:bg-brand-accent-light shadow-[0_0_20px_rgba(132,204,22,0.4)] transition-all duration-300"
        >
          Get Started Today
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
