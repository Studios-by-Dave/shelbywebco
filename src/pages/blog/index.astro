            <p class="text-brand-cyan text-xs uppercase tracking-widest font-bold mb-1">1</p>
            <p class="text-white text-lg font-bold group-hover:text-brand-cyan transition-colors">Shelby Web Official</p>
          </a>
          <a href="#community-spotlight" class="group rounded-xl border border-orange-500/30 bg-brand-dark px-5 py-4 hover:border-orange-400 transition-colors">
