---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Image from '../../components/OptimizedImage.astro';
import blogImage2 from '../../../assets/blog_image2.jpeg';
import blogImage4 from '../../../assets/blog_image4.jpg';
import blogImage5 from '../../../assets/blog_image5.jpeg';
import blogImage6 from '../../../assets/blog_image6.jpeg';
---

<BaseLayout 
  title="Blog"
  description="Stay up to date with the latest web design, SEO, and digital marketing tips for local businesses in Shelby, NC and surrounding areas."
>
  <section class="py-24 lg:py-40 px-4 relative bg-[#0A0A0A] overflow-hidden" data-animate>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(0,180,216,0.1),transparent_50%)]"></div>
    <div class="max-w-5xl mx-auto text-center relative z-10">
      <div class="inline-block px-4 py-1.5 mb-6 rounded-full border border-brand-glow/30 bg-brand-glow/5 text-brand-glow text-sm font-bold uppercase tracking-[0.2em]">
        ✦ The Shelby Web Co Blog
      </div>
      <h1 class="font-heading text-6xl md:text-8xl font-black text-white mb-8 tracking-tight leading-[0.9]">
        Insights & <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-cyan to-brand-blue">Growth Tips.</span>
      </h1>
      <p class="text-xl md:text-2xl text-brand-sky/80 mb-10 max-w-3xl mx-auto leading-relaxed">
        Helping Shelby businesses dominate the digital landscape, one article at a time.
      </p>
    </div>
  </section>

  <section class="py-24 px-4 bg-brand-darkest border-y border-white/5">
    <div class="max-w-7xl mx-auto">
      <div class="mb-12 rounded-2xl border border-brand-blue/20 bg-brand-dark/50 p-6 md:p-8">
        <p class="text-brand-sky/70 uppercase tracking-widest text-xs font-bold mb-4">Choose a Section</p>
