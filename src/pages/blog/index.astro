            <p class="text-white text-lg font-bold group-hover:text-orange-300 transition-colors">Community Spotlight</p>
          </a>
        </div>
      </div>

      <div id="shelby-web-official" class="mb-16 scroll-mt-28">
        <div class="mb-8">
          <p class="text-brand-cyan text-xs font-bold uppercase tracking-widest mb-2">Section 1</p>
          <h2 class="font-heading text-3xl md:text-4xl font-bold text-white">Shelby Web Official</h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">

