---
import BaseLayout from '../../layouts/BaseLayout.astro';

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "Shelby Web Company 2026 New Pricing Structure",
  "description": "A professional website for $297/month instead of a $3,000-$8,000 upfront bill. See how Shelby Web Company's new pricing works, what's included, and which plan fits your business.",
  "author": { "@type": "Organization", "name": "Shelby Web Company", "url": "https://www.shelbywebco.com" },
  "publisher": { "@type": "Organization", "name": "Shelby Web Company", "logo": { "@type": "ImageObject", "url": "https://www.shelbywebco.com/og-image.jpg" } },
  "mainEntityOfPage": "https://www.shelbywebco.com/blog/why-monthly-website-plans-shelby-nc/"
};
---

<BaseLayout 
  title="Shelby Web Company 2026 New Pricing Structure"
  description="Shelby Web Company's 2026 pricing structure: three growth plans with modest launch fees and simple monthly pricing. See what's included at each tier."
>
  <script is:inline set:html={JSON.stringify(blogPostingSchema)} type="application/ld+json"></script>
  <article class="pt-24 pb-16 px-4">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <header class="mb-10 text-center">
        <div class="inline-flex items-center gap-3 mb-6 px-4 py-1.5 rounded-full border border-brand-cyan/20 bg-brand-cyan/5">
          <span class="text-brand-cyan text-xs font-bold uppercase tracking-widest">Vol #2 Article #19</span>
          <span class="w-1 h-1 rounded-full bg-brand-cyan/30"></span>
          <span class="text-white/90 text-xs font-medium uppercase tracking-widest">September 2026</span>
        </div>
        <h1 class="font-heading text-5xl md:text-7xl font-black text-white mb-8 tracking-tight leading-[1.1]">
          Shelby Web Company <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-cyan to-brand-blue">2026 New Pricing Structure</span>
        </h1>
        <p class="text-xl md:text-2xl text-white leading-relaxed max-w-3xl mx-auto">
          A professional website for $297/month instead of a $3,000–$8,000 upfront bill. Here's how the 2026 pricing structure works, what's included at each tier, and which plan fits your Shelby business.
        </p>
      </header>

      <!-- 2026 Pricing Tiers -->
      <div class="mb-16" data-animate>
        <p class="text-brand-glow text-sm uppercase tracking-widest mb-4 text-center">✦ 2026 Growth Plans</p>
        <div class="grid md:grid-cols-3 gap-6">
          <!-- Core -->
          <div class="bg-gradient-to-br from-brand-dark via-brand-darkest to-[#050505] border border-white/10 rounded-2xl p-6 text-center relative">
            <h3 class="font-heading text-3xl font-black text-white mb-1">Core</h3>
            <p class="text-[#f3db70] text-[10px] uppercase tracking-widest mb-3">12 months initial term</p>
            <p class="text-white/70 text-xs mb-4 italic">A professionally managed website — without a $3,000 to $8,000 upfront bill.</p>
            <div class="bg-brand-cyan/10 border border-brand-cyan/20 rounded-xl py-2 px-3 mb-3">
              <span class="text-brand-cyan font-black text-2xl">$297<span class="text-sm font-bold">/mo</span></span>
            </div>
            <p class="text-white/50 text-xs mb-4">Launch fee: $497</p>
            <ul class="text-left text-sm text-white/70 space-y-2">
              <li>• 4–5 page mobile-first website</li>
              <li>• Hosting, SSL, backups &amp; security</li>
              <li>• Foundational on-page &amp; local SEO</li>
            </ul>
          </div>

          <!-- Plus -->
          <div class="bg-gradient-to-br from-brand-dark via-brand-darkest to-[#050505] border border-[#f3db70]/50 rounded-2xl p-6 text-center relative">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#f3db70] text-[#1c1c1c] text-[10px] font-bold px-3 py-0.5 rounded-full uppercase tracking-wider whitespace-nowrap">Most Popular</div>
            <h3 class="font-heading text-3xl font-black text-white mb-1">Plus</h3>
            <p class="text-[#f3db70] text-[10px] uppercase tracking-widest mb-3">6–12 months initial term</p>
            <p class="text-white/70 text-xs mb-4 italic">Active local SEO, content, and reporting for real visibility growth.</p>
            <div class="bg-brand-cyan/10 border border-brand-cyan/20 rounded-xl py-2 px-3 mb-3">
              <span class="text-brand-cyan font-black text-2xl">$597<span class="text-sm font-bold">/mo</span></span>
            </div>
            <p class="text-white/50 text-xs mb-4">Launch fee: $798 – $998</p>
            <ul class="text-left text-sm text-white/70 space-y-2">
              <li>• Everything in Core</li>
              <li>• Keyword &amp; competitor research</li>
              <li>• Google Business Profile optimization</li>
              <li>• Review-generation system</li>
            </ul>
          </div>

          <!-- Ultra -->
          <div class="bg-gradient-to-br from-brand-dark via-brand-darkest to-[#050505] border border-white/10 rounded-2xl p-6 text-center relative">
            <h3 class="font-heading text-3xl font-black text-white mb-1">Ultra</h3>
            <p class="text-[#f3db70] text-[10px] uppercase tracking-widest mb-3">12 months initial term</p>
            <p class="text-white/70 text-xs mb-4 italic">SEO plus conversion optimization, lead tracking, and priority support.</p>
            <div class="bg-brand-cyan/10 border border-brand-cyan/20 rounded-xl py-2 px-3 mb-3">
              <span class="text-brand-cyan font-black text-2xl">$797<span class="text-sm font-bold">/mo</span></span>
            </div>
            <p class="text-white/50 text-xs mb-4">Launch fee: $998 – $1,498</p>
            <ul class="text-left text-sm text-white/70 space-y-2">
              <li>• Everything in Plus</li>
              <li>• Conversion-rate optimization</li>
              <li>• Lead tracking &amp; attribution</li>
              <li>• Priority support &amp; strategy</li>
            </ul>
          </div>
        </div>
        <p class="text-white/50 text-xs text-center mt-4">Plans continue month-to-month after the initial term. <a href="/pricing/" class="text-brand-cyan hover:underline">View full pricing details →</a></p>
      </div>

      <!-- Content -->
      <div class="prose prose-invert prose-2xl max-w-none">
        <p class="text-lg text-white mb-12">
          Web development is changing. And we're right in the middle of it. Agencies everywhere are adapting their pricing models, and for good reason. The shift from big upfront costs to manageable monthly plans is a win-win for both sides.
        </p>

        <h2 class="text-3xl font-bold text-white mt-16 mb-8 flex items-center gap-4">
          <span class="text-brand-accent">The Problem with the Old Model</span>
        </h2>
        
        <p class="text-white mb-8">
          The traditional website model was built around one big project. You paid a large invoice upfront—sometimes $3,000, sometimes $8,000 or more. The site would launch, and then everybody moved on.
        </p>

        <p class="text-white mb-8">
          Here's the problem: nobody was really responsible for whether it kept working, kept ranking, or kept bringing in customers. A website isn't like a poster you print once. It's closer to a storefront. It needs upkeep, security updates, content refreshes, and attention to keep earning its place in Google search results.
        </p>

        <p class="text-white mb-8">
          We also didn't think a local business in Shelby, Gastonia, or Kings Mountain should have to pay thousands of dollars a month just to get noticed in its own town. Plenty of agencies price that way. We decided to do something different.
        </p>

        <h2 class="text-3xl font-bold text-white mt-16 mb-8 flex items-center gap-4">
          <span class="text-brand-accent">The New Approach: Growth Plans, Not Projects</span>
        </h2>

        <p class="text-white mb-8">
          Instead of a large upfront project bill, we now offer growth plans—professionally managed websites that we build, host, maintain, and grow for you at a predictable monthly price. No surprises. No "what happens after launch?" questions.
        </p>

        <h2 class="text-3xl font-bold text-white mt-16 mb-8 flex items-center gap-4">
          <span class="text-brand-accent">Here's How the Three Plans Work</span>
        </h2>

        <div class="space-y-8 mb-16">
          <div class="bg-brand-dark/50 p-8 rounded-2xl border border-white/5 hover:border-brand-blue/20 transition-all">
            <h3 class="text-2xl font-bold text-white mb-4">Core: $297/month</h3>
            <p class="text-white/90 text-sm mb-4 font-medium">Launch fee from $497. 12-month initial term.</p>
            <p class="text-white/90 text-sm leading-relaxed mb-4">
              This is the starting point for small local businesses that want to look professional online without a big invoice.
            </p>
            <ul class="text-white/90 text-sm space-y-2 list-none">
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>4–5 page, mobile-first website</span></li>
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>Hosting, SSL, backups, and security</span></li>
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>Contact forms with lead notifications</span></li>
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>Google Analytics and Search Console setup</span></li>
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>Foundational on-page and local SEO</span></li>
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>One small monthly edit request</span></li>
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>Monthly performance snapshot and quarterly growth review</span></li>
            </ul>
          </div>

          <div class="bg-brand-dark/50 p-8 rounded-2xl border border-brand-cyan/20 hover:border-brand-cyan/40 transition-all">
            <div class="flex items-center gap-2 mb-4">
              <h3 class="text-2xl font-bold text-white">Plus: $597/month</h3>
              <span class="text-brand-cyan text-xs font-bold uppercase tracking-widest bg-brand-cyan/10 px-3 py-1 rounded-full">Most Popular</span>
            </div>
            <p class="text-white/90 text-sm mb-4 font-medium">Launch fee $798–$998+. 6–12 month initial term.</p>
            <p class="text-white/90 text-sm leading-relaxed mb-4">
              This plan is for businesses ready to be found locally. It includes everything in Core, plus active work to move you up in local search.
            </p>
            <ul class="text-white/90 text-sm space-y-2 list-none">
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>Everything in Core</span></li>
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>Keyword and competitor research</span></li>
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>Search Console analysis and fixes</span></li>
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>New service and location content</span></li>
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>Google Business Profile optimization</span></li>
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>Review-generation system</span></li>
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>Local citation cleanup and buildout</span></li>
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>Conversion-rate improvements</span></li>
            </ul>
          </div>

          <div class="bg-brand-dark/50 p-8 rounded-2xl border border-white/5 hover:border-brand-blue/20 transition-all">
            <h3 class="text-2xl font-bold text-white mb-4">Ultra: $797/month</h3>
            <p class="text-white/90 text-sm mb-4 font-medium">Launch fee $998–$1,498+. 12-month initial term.</p>
            <p class="text-white/90 text-sm leading-relaxed mb-4">
              This is the full system. It includes everything in Plus, plus the tools that turn visitors into customers.
            </p>
            <ul class="text-white/90 text-sm space-y-2 list-none">
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>Everything in Plus</span></li>
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>Conversion-rate optimization and A/B testing</span></li>
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>Lead tracking and attribution</span></li>
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>Follow-up workflows and automation</span></li>
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>Advanced analytics and reporting</span></li>
              <li class="flex gap-2"><span class="text-brand-cyan">•</span> <span>Priority support and dedicated growth manager</span></li>
            </ul>
          </div>
        </div>

        <h2 class="text-3xl font-bold text-white mt-16 mb-8 flex items-center gap-4">
          <span class="text-brand-accent">Add-ons When You're Ready to Grow Faster</span>
        </h2>

        <p class="text-white mb-8">
          Any plan can be expanded with optional extras depending on your goals:
        </p>

        <div class="space-y-4 mb-16">
          <div class="bg-brand-dark/50 p-6 rounded-xl border border-white/5">
            <h4 class="text-white font-bold mb-2">AI Lead Capture / Chatbot: $199–$249/mo</h4>
            <p class="text-white/90 text-sm">Captures leads, answers questions, and books appointments 24/7—around the clock without you lifting a finger.</p>
          </div>

          <div class="bg-brand-dark/50 p-6 rounded-xl border border-white/5">
            <h4 class="text-white font-bold mb-2">Review Growth System: $149–$299/mo</h4>
            <p class="text-white/90 text-sm">Automated review requests, reputation monitoring, and response management to build trust online.</p>
          </div>

          <div class="bg-brand-dark/50 p-6 rounded-xl border border-white/5">
            <h4 class="text-white font-bold mb-2">Missed-Call Text-Back: $149–$299/mo</h4>
            <p class="text-white/90 text-sm">An instant text when you miss a call, plus follow-up sequences. For service businesses, this alone can be worth its weight in gold—a missed call often goes straight to your competitor.</p>
          </div>
        </div>

        <h2 class="text-3xl font-bold text-white mt-16 mb-8 flex items-center gap-4">
          <span class="text-brand-accent">The Honest Fine Print</span>
        </h2>

        <p class="text-white mb-8">
          We believe in being upfront from the start. Here's how the terms work:
        </p>

        <div class="bg-brand-blue/5 border-l-4 border-brand-blue p-8 my-12 rounded-r-2xl">
          <p class="text-white mb-4">
            <strong>Initial term:</strong> Each plan has an initial term of 6 to 12 months, depending on the plan. That gives us time to build the site and do the work that actually moves the needle.
          </p>
          <p class="text-white mb-4">
            <strong>After the term:</strong> Once your initial term is up, your plan continues month to month, and you can cancel with 30 days' written notice.
          </p>
          <p class="text-white mb-4">
            <strong>Site ownership:</strong> Your domain and content are always yours. Website files and design are handed off to you upon completion of your initial term, or available for buyout if you cancel early. We'd rather tell you that now than have you find out later.
          </p>
          <p class="text-white mb-0">
            <strong>Launch fees:</strong> Launch fees vary within the ranges shown, and where you land depends on things like your branding and content, the features you need, and your timeline. A simple layout with content ready to go lands on the lower end. A fully custom design with complex functionality lands higher.
          </p>
        </div>

        <h2 class="text-3xl font-bold text-white mt-16 mb-8 flex items-center gap-4">
          <span class="text-brand-accent">Why This Model Works Better</span>
        </h2>

        <div class="space-y-6 mb-16">
          <div class="flex gap-4">
            <div class="shrink-0 w-8 h-8 rounded-full bg-brand-cyan/10 border border-brand-cyan/20 flex items-center justify-center text-brand-cyan font-bold">1</div>
            <div>
              <strong class="text-white block mb-2">Predictable costs. No surprises.</strong>
              <p class="text-white/90 text-sm">You know exactly what you're paying each month, and what's included. No hidden charges, no "oh, we need another $2k to add that feature."</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="shrink-0 w-8 h-8 rounded-full bg-brand-cyan/10 border border-brand-cyan/20 flex items-center justify-center text-brand-cyan font-bold">2</div>
            <div>
              <strong class="text-white block mb-2">Your site stays alive and fresh.</strong>
              <p class="text-white/90 text-sm">Instead of launching and disappearing, we're actively maintaining, updating, and optimizing your site every single month. That's how sites keep ranking and converting.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="shrink-0 w-8 h-8 rounded-full bg-brand-cyan/10 border border-brand-cyan/20 flex items-center justify-center text-brand-cyan font-bold">3</div>
            <div>
              <strong class="text-white block mb-2">You're not locked into a bad deal.</strong>
              <p class="text-white/90 text-sm">After the initial term, you can adjust your plan, add services, or cancel with 30 days' notice. We have to keep earning your business every month—which means we stay focused on results.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="shrink-0 w-8 h-8 rounded-full bg-brand-cyan/10 border border-brand-cyan/20 flex items-center justify-center text-brand-cyan font-bold">4</div>
            <div>
              <strong class="text-white block mb-2">Better value, faster results.</strong>
              <p class="text-white/90 text-sm">The old model left your site stagnant after launch. This one keeps building on what you've got, improving SEO, conversion rates, and lead capture month after month.</p>
            </div>
          </div>
        </div>

        <h2 class="text-3xl font-bold text-white mt-16 mb-8 flex items-center gap-4">
          <span class="text-brand-accent">Who Is This a Good Fit For?</span>
        </h2>

        <p class="text-white mb-8">
          Monthly plans work best if you:
        </p>

        <ul class="space-y-4 text-white/90 text-sm mb-16 list-none">
          <li class="flex gap-2"><span class="text-brand-cyan">✓</span> <span>Want a professional website without a large upfront invoice</span></li>
          <li class="flex gap-2"><span class="text-brand-cyan">✓</span> <span>Would rather have one team handle hosting, updates, and growth than juggle three vendors</span></li>
          <li class="flex gap-2"><span class="text-brand-cyan">✓</span> <span>Understand that a website works best when it's actively maintained</span></li>
          <li class="flex gap-2"><span class="text-brand-cyan">✓</span> <span>Are a local business in Shelby County that depends on being found in your community</span></li>
        </ul>

        <p class="text-white">
          If you'd prefer a one-time build and plan to manage everything yourself, that's cool too—just let us know. We're happy to talk through what makes sense for your business.
        </p>

        <h2 class="text-3xl font-bold text-white mt-16 mb-8 flex items-center gap-4">
          <span class="text-brand-accent">Not Sure Which Plan Fits?</span>
        </h2>

        <p class="text-white mb-12">
          That's normal, and it's what the conversation is for. Tell us about your business, your goals, your budget, and we'll point you to the right plan—no pressure, no jargon. We've worked with everything from tree services and roofing companies to home remodelers and landscapers throughout Shelby, Gastonia, Kings Mountain, and the surrounding area.
        </p>

        <!-- CTA Section -->
        <div class="bg-gradient-to-br from-brand-blue to-brand-dark p-12 rounded-[2rem] text-center relative overflow-hidden">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(132,204,22,0.1),transparent_70%)]"></div>
          <h2 class="text-3xl md:text-5xl font-black text-white mb-6 relative z-10">Ready to Learn More?</h2>
          <p class="text-xl text-white/80 mb-10 relative z-10 max-w-2xl mx-auto">
            Schedule a free consultation to see which plan fits your business, or get a free SEO audit to understand where your site stands today.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center relative z-10">
            <a href="/contact/" class="cta-glow-shine inline-block bg-gradient-to-b from-[#a3e635] via-brand-accent to-[#65a30d] text-black px-10 py-4 rounded-xl font-bold text-lg border border-white/20 shadow-lg hover:shadow-xl transition-all">
              Free Consultation
            </a>
            <a href="tel:7044738188" class="bg-white/10 backdrop-blur-md text-white border border-white/20 px-10 py-4 rounded-xl font-bold text-lg hover:bg-white/20 transition-all flex items-center justify-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              (704) 473-8188
            </a>
          </div>
        </div>
      </div>

      <!-- Footer navigation -->
      <div class="mt-8 mb-16 p-6 bg-brand-dark/50 border border-white/5 rounded-2xl text-white/90 text-sm">
        <strong class="text-white">Next read:</strong> <a href="/blog/website-cost-shelby-nc-2026/" class="text-brand-cyan hover:underline">What does a website actually cost in 2026?</a> We break down the real numbers and what to expect.
      </div>
      
      <footer class="mt-24 pt-12 border-t border-white/5 flex flex-wrap gap-8 items-center justify-between">
        <a href="/blog/" class="text-white/90 hover:text-white transition-colors flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Back to Blog
        </a>
        <div class="flex gap-6">
          <a href="/" class="text-white/90 hover:text-white transition-colors">Home</a>
          <a href="/pricing/" class="text-white/90 hover:text-white transition-colors">Pricing</a>
          <a href="/contact/" class="text-white/90 hover:text-white transition-colors">Contact</a>
