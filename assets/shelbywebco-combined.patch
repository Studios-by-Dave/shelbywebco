diff --git a/src/styles/global.css b/src/styles/global.css
index 31bcee9..ab89e8a 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -846,3 +846,26 @@
     grid-template-rows: repeat(3, 1fr);
   }
 }
+
+/* ── Glossy charcoal plan cards (opt-in via <GrowthPlanPricingSection glossy />) ──
+   Overrides the translucent glass shell. Reflections are background layers
+   (not pseudo-elements) so the card never needs overflow:hidden, which would
+   clip the "Most Popular" badge. Top-left white glare, bottom-right cool sheen. */
+.plan-glossy {
+  background:
+    radial-gradient(ellipse 70% 45% at 8% 0%, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0.06) 45%, transparent 70%),
+    radial-gradient(ellipse 55% 35% at 100% 100%, rgba(120, 160, 255, 0.17) 0%, transparent 70%),
+    linear-gradient(180deg, rgba(255, 255, 255, 0.10) 0%, rgba(255, 255, 255, 0.02) 38%, rgba(0, 0, 0, 0.28) 100%),
+    linear-gradient(145deg, #30333a 0%, #202328 55%, #15171b 100%) !important;
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.2),
+    inset 0 -1px 0 rgba(0, 0, 0, 0.6),
+    0 20px 40px rgba(8, 9, 15, 0.55) !important;
+}
+
+.plan-glossy:hover {
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.28),
+    inset 0 -1px 0 rgba(0, 0, 0, 0.6),
+    0 24px 50px rgba(8, 9, 15, 0.65) !important;
+}
